# //:sync-toolchain -- build every tool in the measured path and stage it, with
# its version string, into var/toolchain/.
#
# This is the ONLY bridge between bazel and the python runner. The runner does
# not shell out to bazel and does not read PATH; it reads
# var/toolchain/toolchain.json, which this target writes.
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# The tool entrypoints and two Liberty collections the runner needs. Yosys's
# target carries its matching `yosys-abc` helper in runfiles, so it is staged
# from there rather than from @abc//:abc (which is a static library).
# them in one filegroup per role means `sync_toolchain.sh` never hardcodes a
# label -- it discovers the declared data files in its runfiles tree.
filegroup(
    name = "tool_binaries",
    srcs = [
        "@livehd//lhd:lhd",
        "@yosys//:yosys",
        "@yosys_slang//:slang.so",
        "@verilator//:verilator",
        # Used by generated model makefiles; the BCR binary does not list it
        # in its own runtime data despite emitting this path.
        "@verilator//:bin/verilator_includer",
        "@opensta//:sta",
    ],
)

py_binary(
    name = "merge_liberty",
    srcs = ["tools/merge_liberty.py"],
    main = "tools/merge_liberty.py",
)

filegroup(
    name = "liberty",
    srcs = [
        "//tech/asap7:liberty",
        "//tech/sky130:liberty",
    ],
)

sh_binary(
    name = "sync-toolchain",
    srcs = ["tools/sync_toolchain.sh"],
    data = [
        ":liberty",
        ":tool_binaries",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
