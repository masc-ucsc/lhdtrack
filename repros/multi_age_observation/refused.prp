// Expected today: tolg-time-error at the second packed assignment.
pub mod multi_age_observation(clk:u1, `in`:u8) -> (stages:u24@[]) {
  reg q0:u8:[clock_pin=ref clk] = nil
  reg q1:u8:[clock_pin=ref clk] = nil

  mut packed:u24 = 0
  packed#[0..=7] = `in`
  packed#[8..=15] = q0
  packed#[16..=23] = q1
  stages = packed

  q1 = q0
  q0 = `in`
}
