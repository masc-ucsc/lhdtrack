package(default_visibility = ["//visibility:public"])

# ASAP7 ships one Liberty per cell-family (simple / sequential / AO / OA / INVBUF).
# All of them are needed to link a mapped netlist, so `liberty` is a set, not a
# single file; qor_endpoint passes each with its own -liberty / read_liberty.
filegroup(
    name = "liberty",
    srcs = ["@asap7sc7p5t//:tt_nldm"],
)

exports_files(["VERSION", "asap7.BUILD"])
