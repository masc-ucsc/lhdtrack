// Read-data pipe of a RAM built from 4 (depth) x 2 (width) tiles, with no
// pipeline stages. A row is valid when its middle width tile (tile 1) is
// valid; at most one row is valid, and its data is selected.
const br_mux_onehot = import("br_mux_onehot.br_mux_onehot")

pub mod br_ram_data_rd_pipe(clk:Clock, rst:Reset, tile_data:U128, tile_valid:U8) -> (data:U32@[], valid:U1@[]) {
  const row_valid:U4 = (tile_valid#[1], tile_valid#[3], tile_valid#[5], tile_valid#[7])#[..]
  valid = U1(row_valid != 0)
  data = br_mux_onehot<NumSymbolsIn=4, SymbolWidth=32>(select=row_valid, `in`=tile_data)
}
