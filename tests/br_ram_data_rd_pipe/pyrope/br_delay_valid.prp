pub mod br_delay_valid<Width=16, NumStages=0, FirstStageUngated=0, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, `in`:U16, in_valid:U1, rst:Reset) -> (out:U16@[], out_stages:U16@[], out_valid:U1@[], out_valid_stages:U1@[]) {
  mut stage_valid:U1 = 0
  mut `stage`:U16 = 0
  stage_valid = 0ub?
  `stage` = 0sb?
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = `stage`
  stage__w1#[0..=15] = `in`
  out_valid = (stage_valid__w1 >> NumStages) & 1
  out = (stage__w1 >> (NumStages*16))#[0..=15]
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
