pub mod br_flow_arb_core<NumFlows=1, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertFinalNotValid=1, EnableCoverPopBackpressure=1, ArbiterAlwaysGrants=1, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false](can_grant:U1, clk:Clock, grant:U1, pop_ready:U1, push_valid:U1, rst:Reset) -> (enable_priority_update:U1@[], pop_valid_unstable:U1@[], push_ready:U1@[], request:U1@[]) {
  const push_ready__w1 = (pop_ready & 1) & can_grant & 1
  const pop_valid_unstable__w1 = U1(push_valid != 0)
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
}
