  mut _mux_9:u5 = if unsigned((gen_wrap_or_saturate_would_out_of_bounds__w1 != 0) and (gen_wrap_or_saturate_is_net_decr__w1 == 0)) != 0 { 16 } else { value_temp__w1 }
  mut _mux_10:u5 = if unsigned((gen_wrap_or_saturate_would_out_of_bounds__w1 != 0) and (gen_wrap_or_saturate_is_net_decr__w1 != 0)) != 0 { 0 } else { _mux_9 }
  const value_next__w1 = _mux_10
