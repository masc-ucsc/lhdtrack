// One valid-qualified delay `stage`; payload storage is deliberately unreset.
// Stage-zero outputs expose the current input; packed state preserves pairing.
pub mod br_delay_valid_next_nr(clk:Clock, `in`:U64, in_valid_next:U1) -> (out:U64@[], out_stages:U128@[], out_valid_next:U1@[], out_valid_next_stages:U2@[]) {
  reg stage_valid_next___q:U2 = nil
  reg stage___q:U128 = nil
  stage_valid_next___q#[1] = in_valid_next
  // Next-valid mode captures with the previous valid, matching the reference.
  if stage_valid_next___q#[1] != 0 {
    stage___q#[64..<128] = `in`
  }
  out = stage___q#[64..]
  out_valid_next = stage_valid_next___q#[1]
  out_stages = (`in`, out)#[..]
  out_valid_next_stages = (in_valid_next, out_valid_next)#[..]
}
