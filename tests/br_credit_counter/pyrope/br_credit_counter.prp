// Credit counter (bedrock br_credit_counter, MaxValue=8, MaxChange=1).
// `value` holds the credits in use; credits can be returned (incr) and consumed (decr).
// `withhold` credits are kept back from `available`, and a decrement is only accepted
// (decr_ready) while some credit is available. Reset loads a runtime input.
pub mod br_credit_counter(clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U4, rst:U1, withhold:U4) -> (reg value:U4@[0]=nil, available:U4@[0], decr_ready:U1@[0]) {
  mut with_incr:U4 = 0
  wrap with_incr = value + if incr_valid != 0 { incr } else { 0 }

  wrap available = if with_incr > withhold { with_incr - withhold } else { 0 }
  decr_ready = U1(available > 0)

  const take = decr_valid != 0 and decr_ready != 0
  if rst != 0 {
    value = initial_value
  } elif incr_valid != 0 or take {
    wrap value = with_incr - if take { decr } else { 0 }
  }
}
