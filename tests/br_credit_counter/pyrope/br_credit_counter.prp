pub mod br_credit_counter::[timecheck=false](clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U4, rst:U1, withhold:U4) -> (available:U4@[], decr_ready:U1@[], value:U4@[]) {
  reg value:U4
  mut _mux_2:U1 = if incr_valid != 0 { incr & 1 } else { 0 }
  mut _mux_3:U1 = if decr_valid != 0 { decr & 1 } else { 0 }
  const value_plus_incr__w1 = (value + _mux_2)#[0..=3]
  mut _mux_4:U4 = if value_plus_incr__w1 > withhold { (value_plus_incr__w1 - withhold)#[0..=3] } else { 0 }
  const available__w1 = _mux_4
  mut _b2i_5 = if available__w1 > 0 { 1 } else { 0 }
  const decr_ready__w1 = _b2i_5
  mut _mux_6:U4 = if decr_ready__w1 != 0 { _mux_3 } else { 0 }
  const value_next__w1 = (value_plus_incr__w1 - _mux_6)#[0..=3]
  mut _b2i_7 = if incr_valid != 0 or (decr_valid != 0 and decr_ready__w1 != 0) { 1 } else { 0 }
  if rst != 0 {
    value = initial_value
  } elif _b2i_7 != 0 {
    value = value_next__w1
  }
  decr_ready = decr_ready__w1
  available = available__w1
}
