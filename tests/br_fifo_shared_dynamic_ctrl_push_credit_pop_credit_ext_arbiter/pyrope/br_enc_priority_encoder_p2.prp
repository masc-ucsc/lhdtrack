pub mod br_enc_priority_encoder_p2<NumRequesters=2, NumResults=1, MsbHighestPriority=1, MaxInHot=2>::[timecheck=false](clk:Clock, `in`:(e1:U1, e0:U1), rst:Reset) -> (out:U2@[]) {
  wire `out[0]`:U1 = nil
  wire `out[1]`:U1 = nil
  wire out:U2 = nil
  wire `in_internal[0]`:U1 = nil
  wire `in_internal[1]`:U1 = nil
  wire in_internal:U2 = nil
  wire `out_internal[0]`:U1 = nil
  wire `out_internal[1]`:U1 = nil
  `in_internal[0]` = `in`.e1 & 1
  `in_internal[1]` = `in`.e0 & 1
  const gen_out_internal_0_in_masked__w1 = in_internal
  `out_internal[0]` = gen_out_internal_0_in_masked__w1 & 1
  `out_internal[1]` = U1(((gen_out_internal_0_in_masked__w1 >> 1) & 1) != 0 and (gen_out_internal_0_in_masked__w1 & 1) == 0) & 1
  `out[0]` = `out_internal[1]` & 1
  `out[1]` = `out_internal[0]` & 1
  out = (`out[1]` << 1) | `out[0]`
  in_internal = (`in_internal[1]` << 1) | `in_internal[0]`
}
