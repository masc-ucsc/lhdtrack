const br_flow_checks_valid_data_impl_t = import("br_flow_checks_valid_data_impl.br_flow_checks_valid_data_impl")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")

pub mod br_flow_reg_rev::[timecheck=false](clk:u1, rst:u1, push_valid:u1, push_data:u37, pop_ready:u1) -> (push_ready:u1@[], pop_valid:u1@[], pop_data:u37@[]) {
  reg push_ready:u1
  reg reg_data:u37
  /* TODO: result 'br_flow_checks_valid_data_intg' of zero-output module 'br_flow_checks_valid_data_intg' is read */
  const pop_valid__w1 = unsigned((push_ready == 0) or (push_valid != 0))
  mut _mux_2:u37 = if push_ready != 0 { push_data } else { reg_data }
  const pop_data__w1 = _mux_2
  if rst != 0 {
    push_ready = 1
  } else {
    push_ready = unsigned((pop_ready != 0) or ((push_ready != 0) and (push_valid == 0)))
  }
  if (pop_ready == 0) and (push_ready != 0) and (push_valid != 0) {
    reg_data = push_data
  }
  /* TODO: result 'br_flow_checks_valid_data_impl' of zero-output module 'br_flow_checks_valid_data_impl' is read */
  pop_valid = pop_valid__w1
  pop_data = pop_data__w1
}
