const br_arb_rr_t = import("br_arb_rr.br_arb_rr")
const br_amba = import("br_amba")

pub mod br_amba_axil2apb::[timecheck=false](araddr:U32, arprot:U3, arvalid:U1, awaddr:U32, awprot:U3, awvalid:U1, bready:U1, clk:Clock, prdata:U32, pready:U1, pslverr:U1, rready:U1, rst:U1, wdata:U32, wstrb:U4, wvalid:U1) -> (arready:U1@[], awready:U1@[], bresp:U2@[], bvalid:U1@[], paddr:U32@[], penable:U1@[], pprot:U3@[], psel:U1@[], pstrb:U4@[], pwdata:U32@[], pwrite:U1@[], rdata:U32@[], rresp:U2@[], rvalid:U1@[], wready:U1@[]) {
  mut _rep_12:U4 = 0
  reg rdata:U32
  reg apb_state:U4:[async=false, initial=1, reset_pin=rst]
  reg addr_reg:U32
  reg data_reg:U32
  reg strb_reg:U4
  reg prot_reg:U3
  reg resp_reg:U1
  reg write_reg:U1
  reg last_grant:U2:[async=false, initial=0, reset_pin=rst]
  mut apb_state_next:U4 = 0
  apb_state_next = 0sb?
  if apb_state == 6 and pready != 0 {
    resp_reg = pslverr
  }
  if apb_state == 6 and pready != 0 {
    rdata = prdata
  }
  mut _b2i_1 = if awvalid != 0 and wvalid != 0 and apb_state == 1 { 1 } else { 0 }
  const write_req_ready__w1 = _b2i_1
  mut _b2i_2 = if arvalid != 0 and apb_state == 1 { 1 } else { 0 }
  const read_req_ready__w1 = _b2i_2
  mut _b2i_3 = if write_req_ready__w1 != 0 and (((last_grant >> 1) & 1) == 0 or read_req_ready__w1 == 0) { 1 } else { 0 }
  mut _b2i_4 = if read_req_ready__w1 != 0 and ((last_grant & 1) == 0 or write_req_ready__w1 == 0) { 1 } else { 0 }
  mut _b2i_5 = if apb_state == 8 and write_reg != 0 { 1 } else { 0 }
  mut _mux_6:U2 = if resp_reg != 0 { br_amba.AxiRespSlverr#[0..=1] } else { br_amba.AxiRespOkay#[0..=1] }
  mut _b2i_7 = if apb_state == 8 and (~write_reg) != 0 { 1 } else { 0 }
  mut _mux_8:U2 = if resp_reg != 0 { br_amba.AxiRespSlverr#[0..=1] } else { br_amba.AxiRespOkay#[0..=1] }
  const psel__w1 = (apb_state >> 1) & 1
  const penable__w1 = (apb_state >> 2) & 1
  const paddr__w1 = addr_reg
  const pwdata__w1 = data_reg
  const pwrite__w1 = write_reg
  const pprot__w1 = prot_reg
  const pstrb__w1 = strb_reg
  mut br_arb_rr = br_arb_rr_t::[name=br_arb_rr](clk=clk, rst=rst, enable_priority_update=1, request=((_b2i_3 & 1) << 1) | (_b2i_4 & 1))
  const arb_read_grant__w1 = br_arb_rr & 1
  const arb_write_grant__w1 = (br_arb_rr >> 1) & 1
  const arb_any_grant__w1 = U1(arb_write_grant__w1 != 0 or arb_read_grant__w1 != 0)
  mut _mux_10:U32 = if arb_write_grant__w1 != 0 { awaddr } else { araddr }
  mut _mux_11:U3 = if arb_write_grant__w1 != 0 { awprot } else { arprot }
  apb_state_next = apb_state
  match apb_state {
    == 1 {
      if arb_any_grant__w1 != 0 {
        apb_state_next = 2
      }
    }
    == 2 {
      apb_state_next = 6
    }
    == 6 {
      if pready != 0 {
        apb_state_next = 8
      }
    }
    == 8 {
      if (write_reg != 0 and bready != 0) or (write_reg == 0 and rready != 0) {
        apb_state_next = 1
      }
    }
    else {
      apb_state_next = 0sb?
    }
  }
  if arb_any_grant__w1 != 0 {
    addr_reg = _mux_10
  }
  if arb_any_grant__w1 != 0 {
    data_reg = wdata
  }
  if arb_any_grant__w1 != 0 {
    write_reg = arb_write_grant__w1
  }
  if arb_any_grant__w1 != 0 {
    _rep_12 = if (arb_write_grant__w1 & 1) != 0 { 15 } else { 0 }
    strb_reg = wstrb & _rep_12
  }
  if arb_any_grant__w1 != 0 {
    prot_reg = _mux_11
  }
  if not (rst != 0) {
    if arb_any_grant__w1 != 0 {
      last_grant = ((arb_write_grant__w1 & 1) << 1) | (arb_read_grant__w1 & 1)
    }
  }
  if not (rst != 0) {
    apb_state = apb_state_next
  }
  awready = arb_write_grant__w1
  wready = arb_write_grant__w1
  bresp = _mux_6
  bvalid = _b2i_5
  arready = arb_read_grant__w1
  rresp = _mux_8
  rvalid = _b2i_7
  paddr = paddr__w1
  psel = psel__w1
  penable = penable__w1
  pprot = pprot__w1
  pstrb = pstrb__w1
  pwrite = pwrite__w1
  pwdata = pwdata__w1
}
