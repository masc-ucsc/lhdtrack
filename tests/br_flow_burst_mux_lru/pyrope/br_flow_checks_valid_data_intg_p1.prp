const br_misc_unused_p5 = import("br_misc_unused_p5.br_misc_unused_p5")

pub mod br_flow_checks_valid_data_intg_p1::[timecheck=false](clk:u1, rst:u1, valid:u4, ready:u4, data:u132) -> () {
  br_misc_unused_p5::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 140) | (valid << 136) | (ready << 132) | data)
}
