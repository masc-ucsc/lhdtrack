// Holds a grant across a burst: while a held grant is live it overrides the
// arbiter, and the arbiter's priority only moves once no grant is held.
pub mod br_arb_grant_hold<NUM_REQUESTERS=2>(
  rst:u1,
  grant_hold:unsigned(bits=NUM_REQUESTERS),
  enable_grant_hold_update:bool,
  grant_from_arb:unsigned(bits=NUM_REQUESTERS)
) -> (enable_priority_update_to_arb:bool@[0], grant:unsigned(bits=NUM_REQUESTERS)@[0]) {
  reg hold:unsigned(bits=NUM_REQUESTERS):[reset_pin = ref rst] = 0

  grant = if hold != 0 { hold } else { grant_from_arb }
  if enable_grant_hold_update {
    hold = grant & grant_hold
  }
  enable_priority_update_to_arb = hold == 0 and enable_grant_hold_update
}
