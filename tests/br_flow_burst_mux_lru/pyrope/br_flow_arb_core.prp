  mut _rep_1:u4 = if (pop_ready & 1) != 0 { 15 } else { 0 }
  const push_ready__w1 = _rep_1 & can_grant
  const pop_valid_unstable__w1 = unsigned((push_valid & can_grant) != 0)
  br_misc_unused_p2::[name=br_misc_unused_grant](`in` = grant)
