const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_flow_checks_valid_data_impl::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u64) -> () {
  br_misc_unused_p2::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 68) | (valid << 66) | (ready << 64) | data)
}
