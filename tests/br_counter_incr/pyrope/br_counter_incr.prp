// Eight-bit wrapping incrementer. Reinitialization precedes the optional increment.
// Reset loads a runtime input, so it must stay in the next-state logic.
pub mod br_counter_incr(clk:Clock, incr:U1, incr_valid:U1, initial_value:U8, reinit:U1, rst:U1) -> (reg value:U8@[0]=nil, value_next:U8@[0]) {
  const base = if reinit != 0 { initial_value } else { value }
  wrap value_next = base + if incr_valid != 0 { incr } else { 0 }
  if rst != 0 {
    value = initial_value
  } elif incr_valid != 0 or reinit != 0 {
    value = value_next
  }
}
