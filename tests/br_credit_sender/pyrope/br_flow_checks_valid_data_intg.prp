const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_intg<NumFlows=4, Width=0x40, EnableCoverBackpressure=1, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U256, ready:U4, rst:U1, valid:U4) -> () {
  br_misc_unused::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 264) | (valid << 260) | (ready << 256) | data)
}
