const br_enc_countones = import("br_enc_countones.br_enc_countones")
const br_enc_priority_dynamic = import("br_enc_priority_dynamic.br_enc_priority_dynamic")
const br_mux_bin = import("br_mux_bin.br_mux_bin")

pub mod br_arb_multi_rr<NumRequesters=4, MaxGrantPerCycle=4, EnableCoverBlockPriorityUpdate=0, EnableCoverMoreRequestThanAllowed=1>::[timecheck=false](clk:Clock, enable_priority_update:U1, grant_allowed:U3, request:U4, rst:U1) -> (grant:U4@[], grant_count:U3@[], grant_ordered:U16@[]) {
  reg lowest_prio:U4:[async=false, initial=8, reset_pin=rst]
  wire grant_ordered_bits:U16 = nil
  wire grant_ordered:U16 = nil
  wire grant_valid_bits:U4 = nil
  grant_valid_bits#[0] = U1(grant_allowed > 0) & 1
  grant_valid_bits#[1] = U1(grant_allowed > 1) & 1
  grant_valid_bits#[2] = U1(grant_allowed > 2) & 1
  grant_valid_bits#[3] = U1(grant_allowed > 3) & 1
  mut u_enc_priority_dynamic = br_enc_priority_dynamic::[name=u_enc_priority_dynamic](clk=clk, rst=rst, `in`=request, lowest_prio=lowest_prio)
  const all_grants = u_enc_priority_dynamic
  mut br_enc_countones_inst = br_enc_countones::[name=br_enc_countones_inst](`in`=request)
  const request_count = br_enc_countones_inst
  mut _mux_6:U3 = if U1(request_count <= grant_allowed) != 0 { request_count#[0..=2] } else { grant_allowed }
  const grant_count__w1 = _mux_6
  mut br_mux_bin_last_grant = br_mux_bin::[name=br_mux_bin_last_grant](select=(grant_count__w1 - 1)#[0..=2]#[0..=1], `in`=all_grants)
  if not (rst != 0) {
    if U1(enable_priority_update != 0 and request != 0 and grant_allowed > 0) != 0 {
      lowest_prio = br_mux_bin_last_grant.out
    }
  }
  mut _mux_9:U4 = if (grant_valid_bits#[0] & 1) != 0 { all_grants#[0..=3] } else { 0 }
  grant_ordered_bits#[0..<4] = _mux_9#[0..<4]
  mut _mux_10:U4 = if (grant_valid_bits#[1] & 1) != 0 { all_grants#[4..=7] } else { 0 }
  grant_ordered_bits#[4..<8] = _mux_10#[0..<4]
  mut _mux_11:U4 = if (grant_valid_bits#[2] & 1) != 0 { all_grants#[8..=11] } else { 0 }
  grant_ordered_bits#[8..<12] = _mux_11#[0..<4]
  mut _mux_12:U4 = if (grant_valid_bits#[3] & 1) != 0 { all_grants#[12..=15] } else { 0 }
  grant_ordered_bits#[12..<16] = _mux_12#[0..<4]
  grant_ordered = grant_ordered_bits
  grant = (((0 | ((grant_ordered_bits#[3] << 3) | (grant_ordered_bits#[2] << 2) | (grant_ordered_bits#[1] << 1) | grant_ordered_bits#[0])) | ((grant_ordered_bits#[7] << 3) | (grant_ordered_bits#[6] << 2) | (grant_ordered_bits#[5] << 1) | grant_ordered_bits#[4])) | ((grant_ordered_bits#[11] << 3) | (grant_ordered_bits#[10] << 2) | (grant_ordered_bits#[9] << 1) | grant_ordered_bits#[8])) | ((grant_ordered_bits#[15] << 3) | (grant_ordered_bits#[14] << 2) | (grant_ordered_bits#[13] << 1) | grant_ordered_bits#[12])
  grant_count = grant_count__w1
}
