pub comb br_mux_bin<NumSymbolsIn=4, SymbolWidth=4>::[timecheck=false](`in`:U16, select:U2) -> (out:U4, out_valid:U1) {
  mut _rep_2:U4 = if (U1(select == 0) & 1) != 0 { 15 } else { 0 }
  mut _rep_4:U4 = if (U1(select == 1) & 1) != 0 { 15 } else { 0 }
  mut _rep_6:U4 = if (U1(select == 2) & 1) != 0 { 15 } else { 0 }
  mut _rep_8:U4 = if (U1(select == 3) & 1) != 0 { 15 } else { 0 }
  out = (((0 | (_rep_2 & `in`#[0..=3])) | (_rep_4 & `in`#[4..=7])) | (_rep_6 & `in`#[8..=11])) | (_rep_8 & `in`#[12..=15])
  out_valid = U1(select < NumSymbolsIn)
}
