pub comb br_mux_bin::[timecheck=false](select:u2, `in`:u16) -> (out:u4, out_valid:u1) {
  mut _rep_2:u4 = if (unsigned(select == 0) & 1) != 0 { 15 } else { 0 }
  mut _rep_4:u4 = if (unsigned(select == 1) & 1) != 0 { 15 } else { 0 }
  mut _rep_6:u4 = if (unsigned(select == 2) & 1) != 0 { 15 } else { 0 }
  mut _rep_8:u4 = if (unsigned(select == 3) & 1) != 0 { 15 } else { 0 }
  out = (((0 | (_rep_2 & `in`#[0..=3])) | (_rep_4 & `in`#[4..=7])) | (_rep_6 & `in`#[8..=11])) | (_rep_8 & `in`#[12..=15])
  out_valid = unsigned(select < 4)
}
