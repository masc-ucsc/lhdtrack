const br_arb_multi_rr = import("br_arb_multi_rr.br_arb_multi_rr")
const br_credit_counter_t = import("br_credit_counter.br_credit_counter")
pub mod br_credit_sender::[timecheck=false](clk:Clock, credit_initial:U5, credit_withhold:U5, pop_credit:U3, pop_receiver_in_reset:U1, push_data:U256, push_valid:U4, rst:U1) -> (credit_available:U5@[], credit_count:U5@[], pop_data:U256@[], pop_sender_in_reset:U1@[], pop_valid:U4@[], push_ready:U4@[]) {
  reg pop_sender_in_reset:U1:[async=false, initial=1, reset_pin=rst]
  reg pop_valid:U4:[async=false, initial=0, reset_pin=rst]
  reg pop_data:U256
  wire credit_decr:U3 = nil
  wire push_ready:U4 = nil
  wire gen_multi_flow_grant_allowed:U3 = nil
  mut _b2i_1 = if rst != 0 or pop_receiver_in_reset != 0 { 1 } else { 0 }
  const either_rst = _b2i_1
  if not (rst != 0) {
    pop_sender_in_reset = 0
  }
  mut br_credit_counter = br_credit_counter_t::[name=br_credit_counter](clk=clk, rst=either_rst, incr_valid=U1(pop_credit != 0), incr=pop_credit, decr_valid=U1(push_valid != 0), decr=credit_decr, initial_value=credit_initial, withhold=credit_withhold)
  mut gen_multi_flow_br_arb_multi_rr = br_arb_multi_rr::[name=gen_multi_flow_br_arb_multi_rr](clk=clk, rst=either_rst, enable_priority_update=1, request=push_valid, grant_allowed=gen_multi_flow_grant_allowed)
  credit_decr = gen_multi_flow_br_arb_multi_rr.grant_count
  mut _mux_4:U32 = if br_credit_counter.available < 4 { br_credit_counter.available#[0..=2] } else { 4 }
  gen_multi_flow_grant_allowed = _mux_4#[0..=2]
  mut _b2i_5 = if either_rst == 0 { 1 } else { 0 }
  mut _rep_6:U4 = if (_b2i_5 & 1) != 0 { 15 } else { 0 }
  push_ready = gen_multi_flow_br_arb_multi_rr.grant & _rep_6
  const internal_pop_valid = push_ready & push_valid
  if not (rst != 0) {
    pop_valid = internal_pop_valid
  }
  if rst != 0 {
    pop_data#[0..=63] = 0
  } elif (internal_pop_valid & 1) != 0 {
    pop_data#[0..=63] = push_data#[0..=63]
  }
  if rst != 0 {
    pop_data#[64..=127] = 0
  } elif ((internal_pop_valid >> 1) & 1) != 0 {
    pop_data#[64..=127] = push_data#[64..=127]
  }
  if rst != 0 {
    pop_data#[128..=191] = 0
  } elif ((internal_pop_valid >> 2) & 1) != 0 {
    pop_data#[128..=191] = push_data#[128..=191]
  }
  if rst != 0 {
    pop_data#[192..=255] = 0
  } elif ((internal_pop_valid >> 3) & 1) != 0 {
    pop_data#[192..=255] = push_data#[192..=255]
  }
  credit_count = br_credit_counter.value
  credit_available = br_credit_counter.available
}
