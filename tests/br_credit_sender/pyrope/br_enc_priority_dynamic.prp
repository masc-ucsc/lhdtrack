const br_enc_priority_encoder = import("br_enc_priority_encoder.br_enc_priority_encoder")
pub mod br_enc_priority_dynamic<NumRequesters=4, NumResults=4>::[timecheck=false](clk:Clock, `in`:U4, lowest_prio:U4, rst:Reset) -> (out:U16@[]) {
  wire out_bits:U16 = nil
  wire out:U16 = nil
  wire priority_mask_bits:U4 = nil
  wire priority_mask:U4 = nil
  priority_mask_bits#[0] = U1(lowest_prio != 0) & 1
  priority_mask_bits#[1] = U1(lowest_prio#[1..=3] != 0) & 1
  priority_mask_bits#[2] = U1(lowest_prio#[2..=3] != 0) & 1
  priority_mask_bits#[3] = U1(((lowest_prio >> 3) & 1) != 0) & 1
  const in_high_prio = `in` & (~priority_mask)
  const t25 = ((`in` & priority_mask) << 3) | in_high_prio#[1..=3]
  mut br_enc_priority_encoder_inst = br_enc_priority_encoder::[name=br_enc_priority_encoder_inst](clk=clk, rst=rst, `in.e6`=(t25 >> 6) & 1, `in.e5`=(t25 >> 5) & 1, `in.e4`=(t25 >> 4) & 1, `in.e3`=(t25 >> 3) & 1, `in.e2`=(t25 >> 2) & 1, `in.e1`=(t25 >> 1) & 1, `in.e0`=t25 & 1)
  const out_internal = br_enc_priority_encoder_inst
  out_bits#[0..<4] = (out_internal#[0..=6]#[3..=6] | (out_internal#[0..=6]#[0..=2] << 1))#[0..<4]
  out_bits#[4..<8] = (out_internal#[7..=13]#[3..=6] | (out_internal#[7..=13]#[0..=2] << 1))#[0..<4]
  out_bits#[8..<12] = (out_internal#[14..=20]#[3..=6] | (out_internal#[14..=20]#[0..=2] << 1))#[0..<4]
  out_bits#[12..<16] = (out_internal#[21..=27]#[3..=6] | (out_internal#[21..=27]#[0..=2] << 1))#[0..<4]
  out = out_bits
  priority_mask = priority_mask_bits
}
