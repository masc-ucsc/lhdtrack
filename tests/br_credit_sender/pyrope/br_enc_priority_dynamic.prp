  mut br_enc_priority_encoder_inst = br_enc_priority_encoder::[name=br_enc_priority_encoder_inst](clk=clk, rst=rst, `in.e6`=(t25 >> 6) & 1, `in.e5`=(t25 >> 5) & 1, `in.e4`=(t25 >> 4) & 1, `in.e3`=(t25 >> 3) & 1, `in.e2`=(t25 >> 2) & 1, `in.e1`=(t25 >> 1) & 1, `in.e0`=t25 & 1)
