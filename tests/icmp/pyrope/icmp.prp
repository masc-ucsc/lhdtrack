pub comb icmp::[timecheck=false](a:U8, b:U8) -> (eq:U1, ne:U1, sge:U1, sgt:U1, sle:U1, slt:U1, uge:U1, ugt:U1, ule:U1, ult:U1) {
  eq = U1(a == b)
  ne = U1(a != b)
  slt = U1(a#sext[0..=7] < b#sext[0..=7])
  sle = U1(a#sext[0..=7] <= b#sext[0..=7])
  sgt = U1(a#sext[0..=7] > b#sext[0..=7])
  sge = U1(a#sext[0..=7] >= b#sext[0..=7])
  ult = U1(a < b)
  ule = U1(a <= b)
  ugt = U1(a > b)
  uge = U1(a >= b)
}
