pub mod br_ram_initializer::[timecheck=false](clk:Clock, initial_value:U32, rst:U1, start:U1) -> (busy:U1@[], wr_addr:U4@[], wr_data:U32@[], wr_valid:U1@[]) {
  reg wr_addr:U4:[async=false, initial=0, reset_pin=rst]
  reg state:U1:[async=false, initial=0, reset_pin=rst]
  mut state_next:U1 = 0
  mut wr_addr_next:U4 = 0
  state_next = 0ub?
  wr_addr_next = 0sb?
  mut _b2i_1 = if state == 1 { 1 } else { 0 }
  const wr_valid__w1 = _b2i_1
  mut _b2i_2 = if state == 1 { 1 } else { 0 }
  wr_addr_next = (wr_addr + 1)#[0..=3]
  state_next = state
  match state {
    == 0 {
      if start != 0 {
        state_next = 1
      }
    }
    == 1 {
      if wr_addr == 15 {
        state_next = 0
        wr_addr_next = 0
      }
    }
    else {
      state_next = 0ub?
    }
  }
  if not (rst != 0) {
    state = state_next
  }
  if not (rst != 0) {
    if wr_valid__w1 != 0 {
      wr_addr = wr_addr_next
    }
  }
  busy = _b2i_2
  wr_valid = wr_valid__w1
  wr_data = initial_value
}
