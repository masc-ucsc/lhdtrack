const br_arb_rr_internal = import("br_arb_rr_internal.br_arb_rr_internal")
const br_flow_reg_fwd    = import("br_flow_reg_fwd.br_flow_reg_fwd")

// 8-flow round-robin valid/ready mux with a registered (stable) pop side.
// push_data packs flow i in bits [32*i, 32*i+32). The flow granted by the
// arbiter is forwarded; the priority updates only when the pop side accepts.
pub mod br_flow_mux_rr_stable(clk:u1, rst:u1, push_valid:u8, push_data:u256, pop_ready:u1) -> (
  push_ready:u8@[0],
  pop_valid:u1@[0],
  pop_data:u32@[0]
) {
  comptime const NUM_FLOWS = push_valid.[bits]
  comptime const WIDTH     = pop_data.[bits]

  wire out_ready:bool = nil
  const arb           = br_arb_rr_internal<NUM_REQUESTERS=NUM_FLOWS>(
    rst=rst, enable_priority_update=out_ready, request=push_valid
  )

  // One-hot mux of the granted flow's data.
  mut selected:u32 = 0
  for i in 0..<NUM_FLOWS {
    if arb.grant#[i] == 1 {
      selected |= push_data#[(i*WIDTH)..+WIDTH]
    }
  }

  const out_reg = br_flow_reg_fwd<T=u32>(clk=clk, rst=rst, push_valid=push_valid != 0, push_data=selected, pop_ready=pop_ready == 1)
  out_ready     = out_reg.push_ready

  push_ready = if out_ready { arb.can_grant } else { 0 }
  pop_valid  = u1(out_reg.pop_valid)
  pop_data   = out_reg.pop_data
}
