// above#[i] = |v#[(i+1)..]
comb or_above<N>(v:Unsigned(bits=N)) -> (above:Unsigned(bits=N)) {
  cassert(N <= 16)
  mut p:Unsigned(bits=N) = v >> 1
  p |= p >> 1
  p |= p >> 2
  p |= p >> 4
  p |= p >> 8
  above = p
}

// Round-robin state: the last grant (one-hot) and the thermometer mask of
// requesters at or below it.
pub mod br_rr_state_internal<NumRequesters=8>::[timecheck=false,synth.abc_pre="compress2rs"](clk:Clock, grant:U8, rst:U1, update_priority:U1) -> (last_grant:U8@[], priority_mask:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)@[]) {
  const reset = rst == 1
  reg last_grant:U8:[reset_pin=reset] = 1 << (NumRequesters - 1)
  if update_priority == 1 {
    last_grant = grant
  }

  // mask#[i] = |last_grant#[i..]
  const mask:U8 = last_grant | or_above<N=8>(v=last_grant)
  priority_mask = (e7=mask#[7], e6=mask#[6], e5=mask#[5], e4=mask#[4], e3=mask#[3], e2=mask#[2], e1=mask#[1], e0=mask#[0])
}
