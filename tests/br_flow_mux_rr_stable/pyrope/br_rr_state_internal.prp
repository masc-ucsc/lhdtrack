pub mod br_rr_state_internal<NumRequesters=8>::[timecheck=false](clk:Clock, grant:U8, rst:U1, update_priority:U1) -> (last_grant:U8@[], priority_mask:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)@[]) {
  reg last_grant:U8
  wire last_grant_init_bits:U8 = nil
  wire last_grant_init:U8 = nil
  wire `priority_mask__bpr.e7`:U1 = nil
  wire `priority_mask__bpr.e6`:U1 = nil
  wire `priority_mask__bpr.e5`:U1 = nil
  wire `priority_mask__bpr.e4`:U1 = nil
  wire `priority_mask__bpr.e3`:U1 = nil
  wire `priority_mask__bpr.e2`:U1 = nil
  wire `priority_mask__bpr.e1`:U1 = nil
  wire `priority_mask__bpr.e0`:U1 = nil
  mut _b2i_1 = if last_grant != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e0` = _b2i_1
  mut _b2i_2 = if last_grant#[1..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e1` = _b2i_2
  mut _b2i_3 = if last_grant#[2..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e2` = _b2i_3
  mut _b2i_4 = if last_grant#[3..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e3` = _b2i_4
  mut _b2i_5 = if last_grant#[4..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e4` = _b2i_5
  mut _b2i_6 = if last_grant#[5..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e5` = _b2i_6
  mut _b2i_7 = if last_grant#[6..=7] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e6` = _b2i_7
  mut _b2i_8 = if ((last_grant >> 7) & 1) != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e7` = _b2i_8
  last_grant_init_bits#[7] = 1
  last_grant_init_bits#[0] = 0
  last_grant_init_bits#[1] = 0
  last_grant_init_bits#[2] = 0
  last_grant_init_bits#[3] = 0
  last_grant_init_bits#[4] = 0
  last_grant_init_bits#[5] = 0
  last_grant_init_bits#[6] = 0
  if rst != 0 {
    last_grant = last_grant_init
  } elif update_priority != 0 {
    last_grant = grant
  }
  last_grant_init = last_grant_init_bits
  const t41 = `priority_mask__bpo.e7`
  `priority_mask__bpr.e7` = t41
  priority_mask.e7 = t41
  const t42 = `priority_mask__bpo.e6`
  `priority_mask__bpr.e6` = t42
  priority_mask.e6 = t42
  const t43 = `priority_mask__bpo.e5`
  `priority_mask__bpr.e5` = t43
  priority_mask.e5 = t43
  const t44 = `priority_mask__bpo.e4`
  `priority_mask__bpr.e4` = t44
  priority_mask.e4 = t44
  const t45 = `priority_mask__bpo.e3`
  `priority_mask__bpr.e3` = t45
  priority_mask.e3 = t45
  const t46 = `priority_mask__bpo.e2`
  `priority_mask__bpr.e2` = t46
  priority_mask.e2 = t46
  const t47 = `priority_mask__bpo.e1`
  `priority_mask__bpr.e1` = t47
  priority_mask.e1 = t47
  const t48 = `priority_mask__bpo.e0`
  `priority_mask__bpr.e0` = t48
  priority_mask.e0 = t48
}
