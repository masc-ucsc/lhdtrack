const br_rr_state_internal = import("br_rr_state_internal.br_rr_state_internal")

// below#[i] = |v#[0..<i] (log-step prefix OR, constant shifts only)
comb or_below<N>(v:Unsigned(bits=N)) -> (below:Unsigned(bits=N)) {
  cassert(N <= 16)
  mut p:Unsigned(bits=N) = v#[0..<(N - 1)] << 1
  wrap p |= p << 1
  wrap p |= p << 2
  wrap p |= p << 4
  wrap p |= p << 8
  below = p
}

// above#[i] = |v#[(i+1)..]
comb or_above<N>(v:Unsigned(bits=N)) -> (above:Unsigned(bits=N)) {
  cassert(N <= 16)
  mut p:Unsigned(bits=N) = v >> 1
  p |= p >> 1
  p |= p >> 2
  p |= p >> 4
  p |= p >> 8
  above = p
}

// Round-robin arbiter: requesters above the last grant go first (lowest index
// wins), then the wrapped-around ones from index 0.
pub mod br_arb_rr_internal<NumRequesters=8>::[timecheck=false,synth.abc_pre="compress2rs"](clk:Clock, enable_priority_update:U1, request:U8, rst:Reset) -> (can_grant:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)@[], grant:U8@[]) {
  wire granted:U8 = nil
  const gen_n_req_rr_state_internal = br_rr_state_internal(clk=clk, rst=U1(rst), update_priority=U1(enable_priority_update == 1 and request != 0), grant=granted)
  const pm = gen_n_req_rr_state_internal.priority_mask
  const mask:U8 = (pm.e0#[0], pm.e1#[0], pm.e2#[0], pm.e3#[0], pm.e4#[0], pm.e5#[0], pm.e6#[0], pm.e7#[0])#[..]
  const high:U8 = request & ~mask

  // A requester at or below the last grant is blocked by any higher request
  // and by lower-indexed requests; one above it only by lower-indexed higher
  // requests. Requester 0 always takes the first rule (the reference
  // special-cases it; this only matters for an empty mask).
  const wrapped:U8 = mask | 1
  const blocked:U8 = (wrapped & (or_below<N=8>(v=request) | or_above<N=8>(v=high))) | (~wrapped & or_below<N=8>(v=high))
  const cg:U8 = ~blocked
  granted = request & cg
  grant = granted
  can_grant = (e7=cg#[7], e6=cg#[6], e5=cg#[5], e4=cg#[4], e3=cg#[3], e2=cg#[2], e1=cg#[1], e0=cg#[0])
}
