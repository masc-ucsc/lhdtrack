// Forward-registered valid/ready slice: breaks the valid/data path with one
// register stage; ready stays combinational (full throughput).
pub mod br_flow_reg_fwd<T=u1>(clk:u1, rst:u1, push_valid:bool, push_data:T, pop_ready:bool) -> (
  push_ready:bool@[0],
  pop_valid:bool@[0],
  pop_data:T@[0]
) {
  reg valid:bool:[reset_pin = ref rst] = false
  reg data:T = nil // data needs no reset: it is only read while valid

  push_ready = pop_ready or not valid
  valid      = push_valid or not push_ready
  if push_ready and push_valid {
    data = push_data
  }
  pop_valid = valid
  pop_data  = data
}
