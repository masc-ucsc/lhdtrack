// SECDED (39,32) Hamming encoder: 32 data bits plus 7 check bits, no padding and
// no register stages (RegisterInputs = RegisterOutputs = 0), so every output is
// combinational. clk and rst are unused and kept for the external interface.
//
// PARITY_MASKS[k] selects the data bits XORed into check bit k.
comptime const PARITY_MASKS = (0x00003fff, 0x007fc01f, 0xd883c1e1, 0xb51c4e22, 0x6e64b244, 0x1fc92488, 0xe3b21910)

pub mod br_ecc_secded_encoder(clk:Clock, data:U32, data_valid:U1, rst:Reset) -> (enc_codeword:U39@[0], enc_data:U32@[0], enc_parity:U7@[0], enc_valid:U1@[0]) {
  comptime const P = enc_parity.[bits]

  mut parity:U7 = 0
  for k in 0..<P {
    parity#[k] = (data & PARITY_MASKS[k])#^[..]
  }

  enc_valid = data_valid
  enc_data = data
  enc_parity = parity
  enc_codeword = (data, parity)#[..]
}
