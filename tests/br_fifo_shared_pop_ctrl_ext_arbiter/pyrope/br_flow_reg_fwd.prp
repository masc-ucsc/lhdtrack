// Registered forward flow stage: a one-entry pipeline register between a
// valid/ready push side and a pop side. The data register has no reset.
pub mod br_flow_reg_fwd<WIDTH=1>(clk:u1, rst:u1, push_valid:bool, push_data:unsigned(bits=WIDTH), pop_ready:bool) -> (
  push_ready:bool@[0],
  pop_valid:bool@[0],
  pop_data:unsigned(bits=WIDTH)@[0]
) {
  reg valid:bool                = false
  reg data:unsigned(bits=WIDTH) = nil

  // Accept a new item when the register is empty or being drained.
  const ready = pop_ready or not valid
  if ready and push_valid {
    data = push_data
  }
  valid = push_valid or not ready

  push_ready = ready
  pop_valid  = valid
  pop_data   = data
}
