const br_fifo_shared_read_xbar = import("br_fifo_shared_read_xbar.br_fifo_shared_read_xbar")
const br_fifo_staging_buffer   = import("br_fifo_staging_buffer.br_fifo_staging_buffer")

// Pop controller of a shared-RAM multi-FIFO: 2 FIFOs share a 32-entry data RAM
// through 2 read ports. Each FIFO's staging buffer requests RAM reads for the
// entry at its linked-list head; the read crossbar arbitrates each read port
// with an external arbiter and returns the data. A popped head entry is
// deallocated one cycle later.
//
// Per-FIFO buses are packed with FIFO 0 in the low bits. Supported
// configuration: RAM read latency 1, 2-entry staging buffers with registered
// pop outputs, registered deallocation, no bypass (bypass_ready is always 0).
// clk only clocks the registers; the bypass inputs are unused.
pub mod br_fifo_shared_pop_ctrl_ext_arbiter(
  clk:u1,
  rst:u1,
  head_valid:u2,
  head:u10,
  ram_empty:u2,
  ram_items:u12,
  bypass_valid_unstable:u2,
  bypass_data_unstable:u64,
  pop_ready:u2,
  data_ram_rd_data_valid:u2,
  data_ram_rd_data:u64,
  arb_grant:u4,
  arb_can_grant:u4
) -> (
  head_ready:u2@[0],
  bypass_ready:u2@[0],
  pop_valid:u2@[0],
  pop_data:u64@[0],
  pop_empty:u2@[0],
  dealloc_valid:u2@[],  // registered (@[1]); @[] because the generated harness mixes all outputs
  dealloc_entry_id:u10@[0],
  data_ram_rd_addr_valid:u2@[0],
  data_ram_rd_addr:u10@[0],
  arb_request:u4@[0],
  arb_enable_priority_update:u2@[0]
) {
  comptime const NUM_FIFOS      = head_valid.[bits]
  comptime const NUM_READ_PORTS = data_ram_rd_addr_valid.[bits]
  comptime const ADDR_WIDTH     = head.[bits]/NUM_FIFOS
  comptime const COUNT_WIDTH    = ram_items.[bits]/NUM_FIFOS
  comptime const WIDTH          = pop_data.[bits]/NUM_FIFOS

  // Read crossbar results, used by the per-FIFO staging buffers below.
  wire rd_addr_ready:u2 = nil
  wire rd_data_valid:u2 = nil
  wire rd_data:u64      = nil

  mut rd_addr_valid:u2 = 0
  mut ready:u2         = 0
  mut valid:u2         = 0
  mut data:u64         = 0
  mut empty:u2         = 0
  for f in 0..<NUM_FIFOS {
    const stg = br_fifo_staging_buffer<WIDTH=WIDTH, COUNT_WIDTH=COUNT_WIDTH>(
      clk=clk,
      rst=rst,
      total_items=ram_items#[(f*COUNT_WIDTH)..+COUNT_WIDTH],
      ram_rd_addr_ready=rd_addr_ready#[f] == 1 and head_valid#[f] == 1,
      ram_rd_data_valid=rd_data_valid#[f] == 1,
      ram_rd_data=rd_data#[(f*WIDTH)..+WIDTH],
      pop_ready=pop_ready#[f] == 1
    )
    // A RAM read needs both a head pointer and a staging-buffer request.
    rd_addr_valid#[f]        = u1(head_valid#[f] == 1 and stg.ram_rd_addr_valid)
    ready#[f]                = u1(rd_addr_ready#[f] == 1 and stg.ram_rd_addr_valid)
    valid#[f]                = u1(stg.pop_valid)
    data#[(f*WIDTH)..+WIDTH] = stg.pop_data
    empty#[f]                = u1(ram_empty#[f] == 1 and stg.pop_empty)
  }

  const xbar = br_fifo_shared_read_xbar<
    NUM_FIFOS=NUM_FIFOS, NUM_READ_PORTS=NUM_READ_PORTS, FIFO_ID_WIDTH=1, PORT_ID_WIDTH=1, ADDR_WIDTH=ADDR_WIDTH, WIDTH=WIDTH
  >(
    clk=clk,
    rst=rst,
    push_rd_addr_valid=rd_addr_valid,
    push_rd_addr=head,
    pop_rd_data_valid=data_ram_rd_data_valid,
    pop_rd_data=data_ram_rd_data,
    arb_can_grant=arb_can_grant,
    arb_grant=arb_grant
  )
  rd_addr_ready = xbar.push_rd_addr_ready
  rd_data_valid = xbar.push_rd_data_valid
  rd_data       = xbar.push_rd_data

  // Deallocate each consumed head entry one cycle later.
  const head_fire   = head_valid & ready
  reg dealloc:u2    = 0
  reg entry_id:u10  = 0
  mut next_entry_id = entry_id
  for f in 0..<NUM_FIFOS {
    if head_fire#[f] == 1 {
      next_entry_id#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = head#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    }
  }
  dealloc  = head_fire
  entry_id = next_entry_id

  head_ready = ready
  bypass_ready               = 0
  pop_valid = valid
  pop_data = data
  pop_empty = empty
  dealloc_valid              = dealloc
  dealloc_entry_id           = entry_id
  data_ram_rd_addr_valid     = xbar.pop_rd_addr_valid
  data_ram_rd_addr           = xbar.pop_rd_addr
  arb_request                = xbar.arb_request
  arb_enable_priority_update = xbar.arb_enable_priority_update
}
