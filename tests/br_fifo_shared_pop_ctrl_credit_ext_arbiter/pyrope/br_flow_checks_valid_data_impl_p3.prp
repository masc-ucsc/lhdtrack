const br_misc_unused_p5 = import("br_misc_unused_p5.br_misc_unused_p5")

pub mod br_flow_checks_valid_data_impl_p3::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u6) -> () {
  br_misc_unused_p5::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 8) | ((valid & 1) << 7) | ((ready & 1) << 6) | data)
}
