pub comb br_demux_bin<NumSymbolsOut=2, SymbolWidth=32, EnableAssertFinalNotValid=1>::[timecheck=false](`in`:U32, in_valid:U1, select:U1) -> (out:U64, out_valid:U2) {
  out_valid = 0sb?
  mut out_valid__w1 = out_valid
  out_valid__w1#[0] = U1(in_valid != 0 and select == 0) & 1
  mut out_valid__w2 = out_valid__w1
  out_valid__w2#[1] = U1(in_valid != 0 and select == 1) & 1
  out_valid = out_valid__w2
  out = `in` | (`in` << 32)
}
