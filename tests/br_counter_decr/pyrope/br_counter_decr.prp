// Wrapping decrementer; runtime reinitialization precedes the decrement.
pub mod br_counter_decr(clk:Clock, decr:U1, decr_valid:U1, initial_value:U8, reinit:U1, rst:U1) -> (value:U8@[], value_next:U8@[]) {
  reg value:U8 = nil
  const base = if reinit != 0 { initial_value } else { value }
  wrap value_next = base - if decr_valid != 0 { decr } else { 0 }
  if rst != 0 {
    value = initial_value
  } elif decr_valid != 0 or reinit != 0 {
    value = value_next
  }
}
