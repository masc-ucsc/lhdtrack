const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_flow_checks_valid_data_impl_p1::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u4) -> () {
  br_misc_unused_p2::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 6) | ((valid & 1) << 5) | ((ready & 1) << 4) | data)
}
