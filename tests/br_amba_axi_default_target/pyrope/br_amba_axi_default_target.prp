const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")
const br_flow_reg_fwd_p1 = import("br_flow_reg_fwd_p1.br_flow_reg_fwd_p1")
const br_flow_reg_fwd_p2 = import("br_flow_reg_fwd_p2.br_flow_reg_fwd_p2")
const br_amba = import("br_amba")

pub mod br_amba_axi_default_target::[timecheck=false](clk:Clock, rst:Reset, target_arid:U4, target_arlen:U1, target_arvalid:U1, target_awid:U4, target_awlen:U1, target_awvalid:U1, target_bready:U1, target_rready:U1, target_wlast:U1, target_wvalid:U1) -> (target_arready:U1@[], target_awready:U1@[], target_bid:U4@[], target_bresp:U2@[], target_bvalid:U1@[], target_rdata:U32@[], target_rid:U4@[], target_rlast:U1@[], target_rresp:U2@[], target_rvalid:U1@[], target_wready:U1@[]) {
  wire awfifo_pop_valid:U1 = nil
  wire awfifo_pop_awid:U4 = nil
  wire wfifo_pop_valid:U1 = nil
  wire arfifo_pop_valid:U1 = nil
  const target_bvalid__w1 = U1(awfifo_pop_valid != 0 and wfifo_pop_valid != 0)
  const target_bid__w1 = awfifo_pop_awid
  const target_rvalid__w1 = arfifo_pop_valid
  mut _b2i_3 = if target_bready != 0 and target_bvalid__w1 != 0 { 1 } else { 0 }
  mut _b2i_4 = if target_bready != 0 and target_bvalid__w1 != 0 { 1 } else { 0 }
  mut br_flow_reg_fwd_ar = br_flow_reg_fwd::[name=br_flow_reg_fwd_ar](clk=clk, rst=rst, push_valid=target_arvalid, push_data=(target_arid << 1) | (target_arlen & 1), pop_ready=target_rready)
  arfifo_pop_valid = br_flow_reg_fwd_ar.pop_valid
  mut br_flow_reg_fwd_aw = br_flow_reg_fwd_p1::[name=br_flow_reg_fwd_aw](clk=clk, rst=rst, push_valid=target_awvalid, push_data=target_awid, pop_ready=_b2i_3)
  awfifo_pop_valid = br_flow_reg_fwd_aw.pop_valid
  awfifo_pop_awid = br_flow_reg_fwd_aw.pop_data
  mut br_flow_reg_fwd_w = br_flow_reg_fwd_p2::[name=br_flow_reg_fwd_w](clk=clk, rst=rst, push_valid=U1(target_wvalid != 0 and target_wlast != 0), push_data=0, pop_ready=_b2i_4)
  wfifo_pop_valid = br_flow_reg_fwd_w.pop_valid
  target_awready = br_flow_reg_fwd_aw.push_ready
  target_wready = br_flow_reg_fwd_w.push_ready
  target_bvalid = target_bvalid__w1
  target_bid = target_bid__w1
  target_bresp = br_amba.AxiRespDecerr
  target_arready = br_flow_reg_fwd_ar.push_ready
  target_rvalid = target_rvalid__w1
  target_rdata = 0
  target_rresp = br_amba.AxiRespDecerr
  target_rid = (br_flow_reg_fwd_ar.pop_data >> 1)#[0..=3]
  target_rlast = 1
}
