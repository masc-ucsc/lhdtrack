const br_counter_p2 = import("br_counter_p2.br_counter_p2")
const br_fifo_push_ctrl_core_p1 = import("br_fifo_push_ctrl_core_p1.br_fifo_push_ctrl_core_p1")

pub mod br_fifo_push_ctrl_p1<Depth=2, Width=1, EnableBypass=1, RamDepth=2, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=0, EnableAssertPushDataStability=0, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](bypass_ready:U1, clk:Clock, pop_beat:U1, push_data:U1, push_valid:U1, rst:U1) -> (bypass_data_unstable:U1@[], bypass_valid_unstable:U1@[], full:U1@[], full_next:U1@[], push_beat:U1@[], push_ready:U1@[], ram_wr_addr:U1@[], ram_wr_data:U1@[], ram_wr_valid:U1@[], slots:U2@[], slots_next:U2@[]) {
  reg full:U1:[async=false, initial=0, reset_pin=rst]
  mut br_fifo_push_ctrl_core = br_fifo_push_ctrl_core_p1::[name=br_fifo_push_ctrl_core](clk=clk, rst=rst, push_valid=push_valid, push_data=push_data, bypass_ready=bypass_ready, addr_base=0, addr_bound=(RamDepth - 1) & 1, full=full)
  mut br_counter_slots = br_counter_p2::[name=br_counter_slots](clk=clk, rst=rst, reinit=0, initial_value=Depth#[0..=1], incr_valid=pop_beat, incr=1, decr_valid=br_fifo_push_ctrl_core.push_beat, decr=1)
  const full_next__w1 = U1(br_counter_slots.value_next == 0)
  if not (rst != 0) {
    if br_fifo_push_ctrl_core.push_beat != 0 or pop_beat != 0 {
      full = full_next__w1
    }
  }
  push_ready = br_fifo_push_ctrl_core.push_ready
  full_next = full_next__w1
  slots = br_counter_slots.value
  slots_next = br_counter_slots.value_next
  bypass_valid_unstable = br_fifo_push_ctrl_core.bypass_valid_unstable
  bypass_data_unstable = br_fifo_push_ctrl_core.bypass_data_unstable
  ram_wr_valid = br_fifo_push_ctrl_core.ram_wr_valid
  ram_wr_addr = br_fifo_push_ctrl_core.ram_wr_addr
  ram_wr_data = br_fifo_push_ctrl_core.ram_wr_data
  push_beat = br_fifo_push_ctrl_core.push_beat
}
