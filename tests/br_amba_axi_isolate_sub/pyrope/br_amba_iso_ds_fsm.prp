pub mod br_amba_iso_ds_fsm::[timecheck=false](clk:u1, rst:u1, isolate_req:u1, align_and_hold_done:u1, resp_tracker_fifo_empty:u1) -> (isolate_done:u1@[], align_and_hold_req:u1@[], resp_tracker_isolate_req:u1@[]) {
  mut _mux_1:u2 = 0
  mut _mux_2:u2 = 0
  mut _mux_3:u2 = 0
  reg state:u2
  mut state_next:u2 = 0
  state_next = 0sb?
  isolate_done = 0ub?
  align_and_hold_req = 0ub?
  resp_tracker_isolate_req = 0ub?
  match state {
    == 0 {
      _mux_1 = if isolate_req != 0 { 1 } else { state }
      state_next = _mux_1
      align_and_hold_req = 0
      resp_tracker_isolate_req = 0
      isolate_done = 0
    }
    == 1 {
      _mux_2 = if isolate_req == 0 { 2 } else { state }
      state_next = _mux_2
      align_and_hold_req = 0
      resp_tracker_isolate_req = 1
      isolate_done = 1
    }
    == 2 {
      _mux_3 = if (align_and_hold_done != 0) and (resp_tracker_fifo_empty != 0) { 0 } else { state }
      state_next = _mux_3
      align_and_hold_req = 1
      resp_tracker_isolate_req = 1
      isolate_done = 1
    }
    else {
      state_next = 0
      align_and_hold_req = 0
      resp_tracker_isolate_req = 0
      isolate_done = 0
    }
  }
  state = if rst != 0 { 0 } else { state_next }
}
