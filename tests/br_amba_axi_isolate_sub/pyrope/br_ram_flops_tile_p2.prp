pub mod br_ram_flops_tile_p2<Depth=15, Width=1, NumWritePorts=1, NumReadPorts=1, EnablePartialWrite=0, WordWidth=1, EnableBypass=0, EnableReset=0, UseStructuredGates=0, EnableStructuredGatesDataQualification=1, EnableAssertFinalNotValid=1>::[timecheck=false](rd_addr:U4, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U4, wr_clk:Clock, wr_data:U1, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U1@[], rd_data_valid:U1@[]) {
  reg mem:[15]U1:[__store_clock_pin=wr_clk, __store_posclk=true, ordering="old"]
  rd_data = 0ub?
  if (wr_valid & 1) != 0 {
    if wr_addr < 15 {
      mem[wr_addr] = wr_data & 1
    }
  }
  mut _oob_read_1:U1 = if rd_addr < 15 { mem[rd_addr] } else { 0 }
  mut rd_data__w1 = rd_data
  rd_data__w1#[0] = _oob_read_1 & 1
  rd_data_valid = rd_addr_valid
  rd_data = rd_data__w1
}
