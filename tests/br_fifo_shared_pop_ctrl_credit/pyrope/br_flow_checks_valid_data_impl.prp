const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_impl<NumFlows=2, Width=5, EnableCoverBackpressure=1, NumBackpressureCheckFlows=2, EnableAssertValidStability=0, EnableAssertDataStability=0, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U10, ready:U2, rst:U1, valid:U2) -> () {
  br_misc_unused::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 14) | (valid << 12) | (ready << 10) | data)
}
