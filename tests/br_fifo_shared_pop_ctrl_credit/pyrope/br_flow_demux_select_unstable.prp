const br_flow_checks_valid_data_impl_t = import("br_flow_checks_valid_data_impl.br_flow_checks_valid_data_impl")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")

pub mod br_flow_demux_select_unstable<NumFlows=2, Width=5, EnableCoverPushBackpressure=1, NumPopBackpressureCheckFlows=2, EnableAssertPushValidStability=0, EnableAssertPushDataStability=0, EnableAssertSelectStability=0, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U2, push_data:U5, push_valid:U1, rst:Reset, select:U1) -> (pop_data_unstable:U10@[], pop_valid_unstable:U2@[], push_ready:U1@[]) {
  pop_data_unstable = 0sb?
  const push_ready__w1 = ((pop_ready << 1) >> (select + 1)) & 1
  mut _mux_1:U2 = if push_valid != 0 { (push_valid << select)#[0..=1] } else { 0 }
  const pop_valid_unstable__w1 = _mux_1
  mut pop_data_unstable__w1 = pop_data_unstable
  pop_data_unstable__w1#[0..=4] = push_data
  mut pop_data_unstable__w2 = pop_data_unstable__w1
  pop_data_unstable__w2#[5..=9] = push_data
  br_flow_checks_valid_data_impl_t::[name=br_flow_checks_valid_data_impl](clk=clk, rst=rst, valid=pop_valid_unstable__w1, ready=pop_ready, data=pop_data_unstable__w2)
  br_flow_checks_valid_data_intg_t::[name=br_flow_checks_valid_data_intg](clk=clk, rst=rst, valid=push_valid, ready=push_ready__w1, data=push_data)
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
  pop_data_unstable = pop_data_unstable__w2
}
