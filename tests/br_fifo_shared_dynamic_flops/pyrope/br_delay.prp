pub mod br_delay<Width=2, NumStages=2, InitValue=0>::[timecheck=false](clk:Clock, `in`:U2, rst:U1) -> (out:U2@[], out_stages:U6@[]) {
  reg stages___q:U6
  mut stages__composite:U6 = 0
  wire stages:U6 = nil
  stages__composite = stages___q
  mut stages__composite__w1 = stages__composite
  stages__composite__w1#[0..=1] = `in`
  if rst != 0 {
    stages___q#[2..=3] = InitValue
  } else {
    stages___q#[2..=3] = stages#[0..=1]
  }
  if rst != 0 {
    stages___q#[4..=5] = InitValue
  } else {
    stages___q#[4..=5] = stages#[2..=3]
  }
  const out__w1 = (stages >> (NumStages*2))#[0..=1]
  const out_stages__w1 = stages
  stages = stages__composite__w1
  out = out__w1
  out_stages = out_stages__w1
}
