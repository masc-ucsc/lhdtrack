const br_misc_tieoff_one = import("br_misc_tieoff_one.br_misc_tieoff_one")
const br_mux_onehot_p1 = import("br_mux_onehot_p1.br_mux_onehot_p1")

pub mod br_multi_xfer_distributor_core<NumSymbols=2, SymbolWidth=5, NumFlows=2, EnableCoverPushBackpressure=1, EnableAssertPushDataStability=1, EnableCoverMorePopReadyThanSendable=0, EnableAssertFinalNotSendable=0, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, grant:U2, grant_count:U2, grant_ordered:U4, pop_ready:U2, push_data:U10, push_sendable:U2, rst:Reset) -> (enable_priority_update:U1@[], grant_allowed:U2@[], pop_data:U10@[], pop_valid:U2@[], push_receivable:U2@[], request:U2@[]) {
  wire pop_data_bits:U10 = nil
  wire pop_data:U10 = nil
  wire grant_ordered_transposed_bits:U4 = nil
  grant_ordered_transposed_bits#[0] = grant_ordered#[0..=1] & 1
  grant_ordered_transposed_bits#[1] = grant_ordered#[2..=3] & 1
  grant_ordered_transposed_bits#[2] = (grant_ordered#[0..=1] >> 1) & 1
  grant_ordered_transposed_bits#[3] = (grant_ordered#[2..=3] >> 1) & 1
  mut br_misc_tieoff_one_enable_priority_update = br_misc_tieoff_one::[name=br_misc_tieoff_one_enable_priority_update]()
  mut gen_pop_data_0_br_mux_onehot_pop_data = br_mux_onehot_p1::[name=gen_pop_data_0_br_mux_onehot_pop_data](select=(grant_ordered_transposed_bits#[1] << 1) | grant_ordered_transposed_bits#[0], `in`=push_data)
  pop_data_bits#[0..<5] = gen_pop_data_0_br_mux_onehot_pop_data#[0..<5]
  mut gen_pop_data_1_br_mux_onehot_pop_data = br_mux_onehot_p1::[name=gen_pop_data_1_br_mux_onehot_pop_data](select=(grant_ordered_transposed_bits#[3] << 1) | grant_ordered_transposed_bits#[2], `in`=push_data)
  pop_data_bits#[5..<10] = gen_pop_data_1_br_mux_onehot_pop_data#[0..<5]
  pop_data = pop_data_bits
  push_receivable = grant_count
  pop_valid = grant
  request = pop_ready
  grant_allowed = push_sendable
  enable_priority_update = br_misc_tieoff_one_enable_priority_update
}
