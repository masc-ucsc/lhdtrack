pub mod br_delay_valid_p2<Width=32, NumStages=0, FirstStageUngated=0, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, `in`:U32, in_valid:U1, rst:Reset) -> (out:U32@[], out_stages:U32@[], out_valid:U1@[], out_valid_stages:U1@[]) {
  mut stage_valid:U1 = 0
  mut `stage`:U32 = 0
  stage_valid = 0ub?
  `stage` = 0sb?
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = `stage`
  stage__w1#[0..=31] = `in`
  out_valid = (stage_valid__w1 >> NumStages) & 1
  out = (stage__w1 >> (NumStages*32))#[0..=31]
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
