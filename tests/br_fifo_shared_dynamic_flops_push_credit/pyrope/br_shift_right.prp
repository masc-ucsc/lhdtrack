pub comb br_shift_right::[timecheck=false](`in`:u10, shift:u1, fill:u5) -> (out_valid:u1, out:u10) {
  mut stages:u20 = 0
  stages = 0sb?
  mut stages__w1 = stages
  stages__w1#[0..=9] = `in`
  mut _mux_2:u10 = if (shift & 1) != 0 { (fill << 5) | stages__w1#[0..=9]#[5..=9] } else { stages__w1#[0..=9] }
  out_valid = unsigned(shift <= 1)
  out = stages__w1#[10..=19]
}
