pub comb br_shift_right<NumSymbols=2, SymbolWidth=5, MaxShift=1>::[timecheck=false](fill:U5, `in`:U10, shift:U1) -> (out:U10, out_valid:U1) {
  wire stages_bits:U20 = nil
  stages_bits#[0..<10] = `in`#[0..<10]
  const out__w1 = (stages_bits#[19] << 9) | (stages_bits#[18] << 8) | (stages_bits#[17] << 7) | (stages_bits#[16] << 6) | (stages_bits#[15] << 5) | (stages_bits#[14] << 4) | (stages_bits#[13] << 3) | (stages_bits#[12] << 2) | (stages_bits#[11] << 1) | stages_bits#[10]
  mut _mux_1:U10 = if (shift & 1) != 0 {
    (fill << 5) | ((stages_bits#[9] << 4) | (stages_bits#[8] << 3) | (stages_bits#[7] << 2) | (stages_bits#[6] << 1) | stages_bits#[5])
  } else {
    (stages_bits#[9] << 9) | (stages_bits#[8] << 8) | (stages_bits#[7] << 7) | (stages_bits#[6] << 6) | (stages_bits#[5] << 5) | (stages_bits#[4] << 4) | (stages_bits#[3] << 3) | (stages_bits#[2] << 2) | (stages_bits#[1] << 1) | stages_bits#[0]
  }
  stages_bits#[10..<20] = _mux_1#[0..<10]
  out_valid = U1(shift <= MaxShift)
  out = out__w1
}
