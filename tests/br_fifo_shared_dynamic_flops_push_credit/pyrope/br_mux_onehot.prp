pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=32, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U64, select:U2) -> (out:U32) {
  mut _rep_1:U32 = if (select & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_2:U32 = if ((select >> 1) & 1) != 0 { 0xffffffff } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=31])) | (_rep_2 & `in`#[32..=63])
}
