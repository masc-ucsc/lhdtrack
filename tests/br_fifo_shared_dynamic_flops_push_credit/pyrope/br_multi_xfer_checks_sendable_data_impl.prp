const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_multi_xfer_checks_sendable_data_impl::[timecheck=false](clk:u1, rst:u1, receivable:u2, sendable:u2, data:u10) -> () {
  br_misc_unused_p2::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 14) | (receivable << 12) | (sendable << 10) | data)
}
