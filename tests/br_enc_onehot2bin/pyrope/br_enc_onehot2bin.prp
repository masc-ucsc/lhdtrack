pub comb br_enc_onehot2bin::[timecheck=false](clk:u1, rst:u1, `in`:u32) -> (out_valid:u1, out:u5) {
  out = 0sb?
  out = if ((`in` >> 1) & 1) != 0 { 1 } else { 0 }
  if ((`in` >> 2) & 1) != 0 {
    out = out | 2
  }
  if ((`in` >> 3) & 1) != 0 {
    out = out | 3
  }
  if ((`in` >> 4) & 1) != 0 {
    out = out | 4
  }
  if ((`in` >> 5) & 1) != 0 {
    out = out | 5
  }
  if ((`in` >> 6) & 1) != 0 {
    out = out | 6
  }
  if ((`in` >> 7) & 1) != 0 {
    out = out | 7
  }
  if ((`in` >> 8) & 1) != 0 {
    out = out | 8
  }
  if ((`in` >> 9) & 1) != 0 {
    out = out | 9
  }
  if ((`in` >> 10) & 1) != 0 {
    out = out | 10
  }
  if ((`in` >> 11) & 1) != 0 {
    out = out | 11
  }
  if ((`in` >> 12) & 1) != 0 {
    out = out | 12
  }
  if ((`in` >> 13) & 1) != 0 {
    out = out | 13
  }
  if ((`in` >> 14) & 1) != 0 {
    out = out | 14
  }
  if ((`in` >> 15) & 1) != 0 {
    out = out | 15
  }
  if ((`in` >> 16) & 1) != 0 {
    out = out | 16
  }
  if ((`in` >> 17) & 1) != 0 {
    out = out | 17
  }
  if ((`in` >> 18) & 1) != 0 {
    out = out | 18
  }
  if ((`in` >> 19) & 1) != 0 {
    out = out | 19
  }
  if ((`in` >> 20) & 1) != 0 {
    out = out | 20
  }
  if ((`in` >> 21) & 1) != 0 {
    out = out | 21
  }
  if ((`in` >> 22) & 1) != 0 {
    out = out | 22
  }
  if ((`in` >> 23) & 1) != 0 {
    out = out | 23
  }
  if ((`in` >> 24) & 1) != 0 {
    out = out | 24
  }
  if ((`in` >> 25) & 1) != 0 {
    out = out | 25
  }
  if ((`in` >> 26) & 1) != 0 {
    out = out | 26
  }
  if ((`in` >> 27) & 1) != 0 {
    out = out | 27
  }
  if ((`in` >> 28) & 1) != 0 {
    out = out | 28
  }
  if ((`in` >> 29) & 1) != 0 {
    out = out | 29
  }
  if ((`in` >> 30) & 1) != 0 {
    out = out | 30
  }
  if ((`in` >> 31) & 1) != 0 {
    out = out | 31
  }
  out_valid = unsigned(`in` != 0)
}
