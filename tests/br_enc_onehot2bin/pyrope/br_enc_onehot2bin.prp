// br_enc_onehot2bin -- onehot-0 to binary encoder (bedrock-rtl), NumValues = 32.
//
// `out` is the index of the set bit of `in`; an all-zero `in` gives out = 0
// with out_valid = 0. Upstream only defines onehot-0 inputs, but its RTL ORs
// together the indices of every set bit, and that is kept here so LEC matches.
//
// clk and rst are unused (upstream uses them only for assertions); they stay
// so the ports line up with verilog/br_enc_onehot2bin.sv.

pub comb br_enc_onehot2bin(clk:u1, rst:u1, `in`:u32) -> (out_valid:u1, out:u5) {
  out = 0
  for i in 1..<`in`.[bits] {
    if `in`#[i] != 0 {
      out |= i
    }
  }
  out_valid = `in`#|[..]
}
