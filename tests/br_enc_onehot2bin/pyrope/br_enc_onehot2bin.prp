pub comb br_enc_onehot2bin::[timecheck=false](clk:u1, rst:u1, `in`:u32) -> (out_valid:u1, out:u5) {
  // The Verilog loop ORs the binary index of every asserted input. Spell that
  // per result bit so the five independent reduction trees stay parallel.
  const b0:u1 = (((`in`#[1] | `in`#[3]) | (`in`#[5] | `in`#[7]))
               | ((`in`#[9] | `in`#[11]) | (`in`#[13] | `in`#[15])))
              | (((`in`#[17] | `in`#[19]) | (`in`#[21] | `in`#[23]))
               | ((`in`#[25] | `in`#[27]) | (`in`#[29] | `in`#[31])))
  const b1:u1 = (((`in`#[2] | `in`#[3]) | (`in`#[6] | `in`#[7]))
               | ((`in`#[10] | `in`#[11]) | (`in`#[14] | `in`#[15])))
              | (((`in`#[18] | `in`#[19]) | (`in`#[22] | `in`#[23]))
               | ((`in`#[26] | `in`#[27]) | (`in`#[30] | `in`#[31])))
  const b2:u1 = (((`in`#[4] | `in`#[5]) | (`in`#[6] | `in`#[7]))
               | ((`in`#[12] | `in`#[13]) | (`in`#[14] | `in`#[15])))
              | (((`in`#[20] | `in`#[21]) | (`in`#[22] | `in`#[23]))
               | ((`in`#[28] | `in`#[29]) | (`in`#[30] | `in`#[31])))
  const b3:u1 = (((`in`#[8] | `in`#[9]) | (`in`#[10] | `in`#[11]))
               | ((`in`#[12] | `in`#[13]) | (`in`#[14] | `in`#[15])))
              | (((`in`#[24] | `in`#[25]) | (`in`#[26] | `in`#[27]))
               | ((`in`#[28] | `in`#[29]) | (`in`#[30] | `in`#[31])))
  const b4:u1 = (((`in`#[16] | `in`#[17]) | (`in`#[18] | `in`#[19]))
               | ((`in`#[20] | `in`#[21]) | (`in`#[22] | `in`#[23])))
              | (((`in`#[24] | `in`#[25]) | (`in`#[26] | `in`#[27]))
               | ((`in`#[28] | `in`#[29]) | (`in`#[30] | `in`#[31])))

  out = 0
  out#[0] = b0
  out#[1] = b1
  out#[2] = b2
  out#[3] = b3
  out#[4] = b4
  out_valid = unsigned(`in` != 0)
}
