const br_misc_unused_p3 = import("br_misc_unused_p3.br_misc_unused_p3")

pub mod br_flow_checks_valid_data_intg_p1::[timecheck=false](clk:u1, rst:u1, valid:u4, ready:u4, data:u128) -> () {
  br_misc_unused_p3::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 136) | (valid << 132) | (ready << 128) | data)
}
