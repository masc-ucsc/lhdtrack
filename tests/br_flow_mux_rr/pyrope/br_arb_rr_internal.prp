const br_rr_state_internal = import("br_rr_state_internal.br_rr_state_internal")

pub mod br_arb_rr_internal<NumRequesters=4>::[timecheck=false](clk:Clock, enable_priority_update:U1, request:U4, rst:Reset) -> (can_grant:(e3:U1, e2:U1, e1:U1, e0:U1)@[], grant:U4@[]) {
  wire can_grant__bpr:(e3:U1, e2:U1, e1:U1, e0:U1) = nil
  wire request_priority_bits:U16 = nil
  grant = 0sb?
  request_priority_bits#[5] = 0
  request_priority_bits#[10] = 0
  mut `can_grant__bpo.e0` = U1(not (((request_priority_bits#[3] << 3) | (request_priority_bits#[2] << 2) | (request_priority_bits#[1] << 1) | request_priority_bits#[0]) != 0))
  mut _b2i_3 = if not (((request_priority_bits#[7] << 3) | (request_priority_bits#[6] << 2) | (request_priority_bits#[5] << 1) | request_priority_bits#[4]) != 0) {
    1
  } else {
    0
  }
  mut `can_grant__bpo.e1` = _b2i_3
  mut _b2i_4 = if not (((request_priority_bits#[11] << 3) | (request_priority_bits#[10] << 2) | (request_priority_bits#[9] << 1) | request_priority_bits#[8]) != 0) {
    1
  } else {
    0
  }
  mut `can_grant__bpo.e2` = _b2i_4
  mut _b2i_5 = if not (((request_priority_bits#[15] << 3) | (request_priority_bits#[14] << 2) | (request_priority_bits#[13] << 1) | request_priority_bits#[12]) != 0) {
    1
  } else {
    0
  }
  mut `can_grant__bpo.e3` = _b2i_5
  const grant__w1 = request & ((can_grant__bpr.e3 << 3) | (can_grant__bpr.e2 << 2) | (can_grant__bpr.e1 << 1) | can_grant__bpr.e0)
  mut gen_n_req_rr_state_internal = br_rr_state_internal::[name=gen_n_req_rr_state_internal](clk=clk, rst=rst, update_priority=U1(enable_priority_update != 0 and request != 0), grant=grant__w1)
  const gen_n_req_priority_mask = (gen_n_req_rr_state_internal.priority_mask.e3 << 3) | (gen_n_req_rr_state_internal.priority_mask.e2 << 2) | (gen_n_req_rr_state_internal.priority_mask.e1 << 1) | gen_n_req_rr_state_internal.priority_mask.e0
  const gen_n_req_request_high = request & (~gen_n_req_priority_mask#[0..=3])
  const t46 = gen_n_req_request_high#[1..=3] << 1
  request_priority_bits#[0..<4] = t46#[0..<4]
  mut _mux_6:U4 = if ((gen_n_req_priority_mask >> (NumRequesters - 1)) & 1) != 0 { request#[0..=2] }
    else { gen_n_req_request_high#[0..=2] }
  request_priority_bits#[12..<16] = _mux_6#[0..<4]
  mut _mux_7:U1 = if ((gen_n_req_priority_mask >> 1) & 1) != 0 { request & 1 } else { gen_n_req_request_high & 1 }
  request_priority_bits#[4] = _mux_7 & 1
  mut _mux_8:U2 = if ((gen_n_req_priority_mask >> 1) & 1) != 0 { gen_n_req_request_high#[2..=3] } else { 0 }
  request_priority_bits#[6] = _mux_8 & 1
  request_priority_bits#[7] = (_mux_8 >> 1) & 1
  mut _mux_9:U2 = if ((gen_n_req_priority_mask >> 2) & 1) != 0 { request#[0..=1] } else { gen_n_req_request_high#[0..=1] }
  request_priority_bits#[8] = _mux_9 & 1
  request_priority_bits#[9] = (_mux_9 >> 1) & 1
  mut _mux_10:U1 = if ((gen_n_req_priority_mask >> 2) & 1) != 0 { (gen_n_req_request_high >> 3) & 1 } else { 0 }
  request_priority_bits#[11] = _mux_10 & 1
  const t97 = `can_grant__bpo.e3`
  can_grant__bpr.e3 = t97
  can_grant.e3 = t97
  const t98 = `can_grant__bpo.e2`
  can_grant__bpr.e2 = t98
  can_grant.e2 = t98
  const t99 = `can_grant__bpo.e1`
  can_grant__bpr.e1 = t99
  can_grant.e1 = t99
  const t100 = `can_grant__bpo.e0`
  can_grant__bpr.e0 = t100
  can_grant.e0 = t100
  grant = grant__w1
}
