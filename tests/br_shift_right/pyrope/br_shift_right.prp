pub comb br_shift_right::[timecheck=false](`in`:u16, shift:u4, fill:u1) -> (out_valid:u1, out:u16) {
  const fill2:u2 = if fill { 3 } else { 0 }
  const fill4:u4 = if fill { 15 } else { 0 }
  const fill8:u8 = if fill { 0xff } else { 0 }
  const stage1:u16 = if shift#[0] != 0 { (fill << 15) | `in`#[1..=15] } else { `in` }
  const stage2:u16 = if shift#[1] != 0 { (fill2 << 14) | stage1#[2..=15] } else { stage1 }
  const stage3:u16 = if shift#[2] != 0 { (fill4 << 12) | stage2#[4..=15] } else { stage2 }
  const stage4:u16 = if shift#[3] != 0 { (fill8 << 8) | stage3#[8..=15] } else { stage3 }
  out_valid = unsigned(shift <= 15)
  out = stage4
}
