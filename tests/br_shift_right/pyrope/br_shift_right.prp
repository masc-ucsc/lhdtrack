pub comb br_shift_right::[timecheck=false](`in`:u16, shift:u4, fill:u1) -> (out_valid:u1, out:u16) {
  mut stages:u80 = 0
  stages = 0sb?
  mut stages__w1 = stages
  stages__w1#[0..=15] = `in`
  mut _mux_1:u16 = if (shift & 1) != 0 { ((fill & 1) << 15) | stages__w1#[0..=15]#[1..=15] } else { stages__w1#[0..=15] }
  mut stages__w2 = stages__w1
  stages__w2#[16..=31] = _mux_1
  mut _rep_2:u2 = if (fill & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u16 = if ((shift >> 1) & 1) != 0 { (_rep_2 << 14) | stages__w2#[16..=31]#[2..=15] } else { stages__w2#[16..=31] }
  mut stages__w3 = stages__w2
  stages__w3#[32..=47] = _mux_3
  mut _rep_4:u4 = if (fill & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u16 = if ((shift >> 2) & 1) != 0 { (_rep_4 << 12) | stages__w3#[32..=47]#[4..=15] } else { stages__w3#[32..=47] }
  mut stages__w4 = stages__w3
  stages__w4#[48..=63] = _mux_5
  mut _rep_6:u8 = if (fill & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u16 = if ((shift >> 3) & 1) != 0 { (_rep_6 << 8) | stages__w4#[48..=63]#[8..=15] } else { stages__w4#[48..=63] }
  mut stages__w5 = stages__w4
  stages__w5#[64..=79] = _mux_7
  out_valid = unsigned(shift <= 15)
  out = stages__w5#[64..=79]
}
