// Logical shift with a configurable fill bit and a four-bit shift count.
pub comb br_shift_right(fill:U1, `in`:U16, shift:U4) -> (out:U16, out_valid:U1) {
  const fill_bits:U16 = if fill != 0 { 0xffff } else { 0 }
  wrap out = (`in` >> shift) | (fill_bits << (`in`.[bits] - shift))
  out_valid = 1
}
