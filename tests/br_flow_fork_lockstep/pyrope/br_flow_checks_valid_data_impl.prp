const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_flow_checks_valid_data_impl<NumFlows=16, Width=1, EnableCoverBackpressure=1, NumBackpressureCheckFlows=16, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U16, ready:U16, rst:U1, valid:U16) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 48) | (valid << 32) | (ready << 16) | data)
}
