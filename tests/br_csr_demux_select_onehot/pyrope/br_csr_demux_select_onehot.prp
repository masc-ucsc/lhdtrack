// CSR demux steered by an external one-hot select (4 downstreams, no retime
// stages). The request is broadcast to every downstream with valid gated by
// the select; the selected response returns upstream, or a decode error one
// cycle after a request that selected no downstream.
const br_mux_onehot = import("br_mux_onehot.br_mux_onehot")

pub mod br_csr_demux_select_onehot(clk:Clock, downstream_resp_decerr:U4, downstream_resp_rdata:U128, downstream_resp_slverr:U4, downstream_resp_valid:U4, rst:U1, select_onehot:U4, upstream_req_abort:U1, upstream_req_addr:U16, upstream_req_privileged:U1, upstream_req_secure:U1, upstream_req_valid:U1, upstream_req_wdata:U32, upstream_req_write:U1, upstream_req_wstrb:U4) -> (downstream_req_abort:U4@[], downstream_req_addr:U64@[], downstream_req_privileged:U4@[], downstream_req_secure:U4@[], downstream_req_valid:U4@[], downstream_req_wdata:U128@[], downstream_req_write:U4@[], downstream_req_wstrb:U16@[], upstream_resp_decerr:U1@[], upstream_resp_rdata:U32@[], upstream_resp_slverr:U1@[], upstream_resp_valid:U1@[]) {
  // Every downstream sees the request; only the selected one sees it valid.
  downstream_req_valid = if upstream_req_valid == 1 { select_onehot } else { 0 }
  downstream_req_write = if upstream_req_write == 1 { 0xf } else { 0 }
  downstream_req_privileged = if upstream_req_privileged == 1 { 0xf } else { 0 }
  downstream_req_secure = if upstream_req_secure == 1 { 0xf } else { 0 }
  downstream_req_abort = if upstream_req_abort == 1 { 0xf } else { 0 }
  downstream_req_addr = (upstream_req_addr, upstream_req_addr, upstream_req_addr, upstream_req_addr)#[..]
  downstream_req_wdata = (upstream_req_wdata, upstream_req_wdata, upstream_req_wdata, upstream_req_wdata)#[..]
  downstream_req_wstrb = (upstream_req_wstrb, upstream_req_wstrb, upstream_req_wstrb, upstream_req_wstrb)#[..]

  reg decerr_resp_valid:U1:[reset_pin=rst] = 0
  decerr_resp_valid = U1(upstream_req_valid == 1 and select_onehot == 0)

  // Response lane i packs (slverr, decerr, rdata) from the LSB; lane 4 is the decode error.
  const resp0:U34 = (downstream_resp_slverr#[0], downstream_resp_decerr#[0], downstream_resp_rdata#[0..<32])#[..]
  const resp1:U34 = (downstream_resp_slverr#[1], downstream_resp_decerr#[1], downstream_resp_rdata#[32..<64])#[..]
  const resp2:U34 = (downstream_resp_slverr#[2], downstream_resp_decerr#[2], downstream_resp_rdata#[64..<96])#[..]
  const resp3:U34 = (downstream_resp_slverr#[3], downstream_resp_decerr#[3], downstream_resp_rdata#[96..<128])#[..]
  const decerr_resp:U34 = 0ub10
  const resp_select:U5 = (downstream_resp_valid, decerr_resp_valid)#[..]
  const resp_lanes:U170 = (resp0, resp1, resp2, resp3, decerr_resp)#[..]
  const resp = br_mux_onehot<NumSymbolsIn=5, SymbolWidth=34>(select=resp_select, `in`=resp_lanes)
  upstream_resp_valid = U1(decerr_resp_valid == 1 or downstream_resp_valid != 0)
  upstream_resp_slverr = resp#[0]
  upstream_resp_decerr = resp#[1]
  upstream_resp_rdata = resp#[2..<34]
}
