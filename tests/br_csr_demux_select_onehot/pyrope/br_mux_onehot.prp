pub comb br_mux_onehot::[timecheck=false](select:u5, `in`:u170) -> (out:u34) {
  mut _rep_1:u34 = if (select & 1) != 0 { 0x3ffffffff } else { 0 }
  mut _rep_2:u34 = if ((select >> 1) & 1) != 0 { 0x3ffffffff } else { 0 }
  mut _rep_3:u34 = if ((select >> 2) & 1) != 0 { 0x3ffffffff } else { 0 }
  mut _rep_4:u34 = if ((select >> 3) & 1) != 0 { 0x3ffffffff } else { 0 }
  mut _rep_5:u34 = if ((select >> 4) & 1) != 0 { 0x3ffffffff } else { 0 }
  out = ((((0 | (_rep_1 & `in`#[0..=33])) | (_rep_2 & `in`#[34..=67])) | (_rep_3 & `in`#[68..=101])) | (_rep_4 & `in`#[102..=135])) | (_rep_5 & `in`#[136..=169])
}
