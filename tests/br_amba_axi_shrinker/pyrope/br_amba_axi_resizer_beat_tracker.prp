const br_counter_incr_p2 = import("br_counter_incr_p2.br_counter_incr_p2")
const br_counter_incr_p3 = import("br_counter_incr_p3.br_counter_incr_p3")
const br_amba = import("br_amba")

pub mod br_amba_axi_resizer_beat_tracker<WideBytes=8, NarrowBytes=4>::[timecheck=false](beat_valid:U1, burst:U2, clk:Clock, rst:U1, shift:U1, size:U3, start_offset:U3, start_valid:U1) -> (beat_lane:U1@[], beat_last:U1@[]) {
  reg size_reg:U3:[async=false, initial=0, reset_pin=rst]
  reg burst_reg:U2:[async=false, initial=3, reset_pin=rst]
  reg shift_reg:U1:[async=false, initial=0, reset_pin=rst]
  wire beat_id:U1 = nil
  if not (rst != 0) {
    if start_valid != 0 {
      size_reg = size
    }
  }
  if not (rst != 0) {
    if start_valid != 0 {
      burst_reg = burst
    }
  }
  if not (rst != 0) {
    if start_valid != 0 {
      shift_reg = shift
    }
  }
  const beats_per_wide_minus1_ext = ((1 << shift_reg)#[0..=1] - 1)#[0..=1]
  const beats_per_wide_minus1 = beats_per_wide_minus1_ext & 1
  mut _b2i_1 = if beat_valid != 0 and burst_reg != br_amba.AxiBurstFixed { 1 } else { 0 }
  const beat_offset_incr_ext = (1 << size_reg)#[0..=7]
  mut _mux_2:U3 = if rst != 0 { 0 } else { start_offset }
  mut br_counter_incr_beat_offset = br_counter_incr_p2::[name=br_counter_incr_beat_offset](clk=clk, rst=rst, reinit=start_valid, initial_value=_mux_2, incr_valid=_b2i_1, incr=beat_offset_incr_ext#[0..=2])
  mut _b2i_3 = if start_valid != 0 or (beat_valid != 0 and beat_id == beats_per_wide_minus1) { 1 } else { 0 }
  mut _b2i_4 = if beat_id == beats_per_wide_minus1 { 1 } else { 0 }
  mut br_counter_incr_beat_id = br_counter_incr_p3::[name=br_counter_incr_beat_id](clk=clk, rst=rst, reinit=_b2i_3, initial_value=0, incr_valid=beat_valid, incr=1)
  beat_id = br_counter_incr_beat_id.value
  beat_lane = (br_counter_incr_beat_offset.value >> 2) & 1
  beat_last = _b2i_4
}
