pub mod br_enc_bin2onehot<NumValues=4, EnableInputRangeCheck=1, EnableAssertFinalNotValid=1, BinWidth=2>::[timecheck=false](clk:Clock, `in`:U2, in_valid:U1, rst:Reset) -> (out:U4@[]) {
  out = 0sb?
  mut out__w1 = out
  out__w1#[0] = U1(in_valid != 0 and `in` == 0) & 1
  mut out__w2 = out__w1
  out__w2#[1] = U1(in_valid != 0 and `in` == 1) & 1
  mut out__w3 = out__w2
  out__w3#[2] = U1(in_valid != 0 and `in` == 2) & 1
  mut out__w4 = out__w3
  out__w4#[3] = U1(in_valid != 0 and `in` == 3) & 1
  out = out__w4
}
