pub comb br_mux_bin_p2<NumSymbolsIn=4, SymbolWidth=0x44>::[timecheck=false](`in`:U272, select:U2) -> (out:U68, out_valid:U1) {
  mut _rep_2:U68 = if (U1(select == 0) & 1) != 0 { 0xfffffffffffffffff } else { 0 }
  mut _rep_4:U68 = if (U1(select == 1) & 1) != 0 { 0xfffffffffffffffff } else { 0 }
  mut _rep_6:U68 = if (U1(select == 2) & 1) != 0 { 0xfffffffffffffffff } else { 0 }
  mut _rep_8:U68 = if (U1(select == 3) & 1) != 0 { 0xfffffffffffffffff } else { 0 }
  out = (((0 | (_rep_2 & `in`#[0..=67])) | (_rep_4 & `in`#[68..=135])) | (_rep_6 & `in`#[136..=203])) | (_rep_8 & `in`#[204..=271])
  out_valid = U1(select < NumSymbolsIn)
}
