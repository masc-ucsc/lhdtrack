pub comb br_shift_left<NumSymbols=8, SymbolWidth=1, MaxShift=1>::[timecheck=false](fill:U1, `in`:U8, shift:U1) -> (out:U8, out_valid:U1) {
  wire stages_bits:U16 = nil
  stages_bits#[0..<8] = `in`#[0..<8]
  const out__w1 = (stages_bits#[15] << 7) | (stages_bits#[14] << 6) | (stages_bits#[13] << 5) | (stages_bits#[12] << 4) | (stages_bits#[11] << 3) | (stages_bits#[10] << 2) | (stages_bits#[9] << 1) | stages_bits#[8]
  mut _mux_1:U8 = if (shift & 1) != 0 {
    (((stages_bits#[6] << 6) | (stages_bits#[5] << 5) | (stages_bits#[4] << 4) | (stages_bits#[3] << 3) | (stages_bits#[2] << 2) | (stages_bits#[1] << 1) | stages_bits#[0]) << 1) | (fill & 1)
  } else {
    (stages_bits#[7] << 7) | (stages_bits#[6] << 6) | (stages_bits#[5] << 5) | (stages_bits#[4] << 4) | (stages_bits#[3] << 3) | (stages_bits#[2] << 2) | (stages_bits#[1] << 1) | stages_bits#[0]
  }
  stages_bits#[8..<16] = _mux_1#[0..<8]
  out_valid = U1(shift <= MaxShift)
  out = out__w1
}
