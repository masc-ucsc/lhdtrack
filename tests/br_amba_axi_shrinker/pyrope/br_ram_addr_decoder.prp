const br_delay_valid = import("br_delay_valid.br_delay_valid")
const br_delay_valid_p1 = import("br_delay_valid.br_delay_valid")

pub mod br_ram_addr_decoder<Depth=4, DataWidth=9, Tiles=1, Stages=0, EnableDatapath=1, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, in_addr:U2, in_data:U9, in_data_valid:U1, in_valid:U1, rst:Reset) -> (out_addr:U2@[], out_data:U9@[], out_data_valid:U1@[], out_valid:U1@[]) {
  mut gen_tiles_eq1_br_delay_valid_addr = br_delay_valid<Width=2>(in_valid=in_valid, `in`=in_addr)
  mut gen_tiles_eq1_gen_datapath_br_delay_valid_data = br_delay_valid_p1<Width=9>(in_valid=in_data_valid, `in`=in_data)
  out_valid = gen_tiles_eq1_br_delay_valid_addr.out_valid
  out_addr = gen_tiles_eq1_br_delay_valid_addr.out
  out_data_valid = gen_tiles_eq1_gen_datapath_br_delay_valid_data.out_valid
  out_data = gen_tiles_eq1_gen_datapath_br_delay_valid_data.out
}
