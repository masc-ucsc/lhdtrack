pub comb br_mux_bin_p1<NumSymbolsIn=2, SymbolWidth=4>::[timecheck=false](`in`:U8, select:U1) -> (out:U4, out_valid:U1) {
  mut _rep_2:U4 = if (U1(select == 0) & 1) != 0 { 15 } else { 0 }
  mut _rep_4:U4 = if (U1(select == 1) & 1) != 0 { 15 } else { 0 }
  out = (0 | (_rep_2 & `in`#[0..=3])) | (_rep_4 & `in`#[4..=7])
  out_valid = U1(select < NumSymbolsIn)
}
