pub comb br_mux_bin<NumSymbolsIn=2, SymbolWidth=32>::[timecheck=false](`in`:U64, select:U1) -> (out:U32, out_valid:U1) {
  mut _rep_2:U32 = if (U1(select == 0) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_4:U32 = if (U1(select == 1) & 1) != 0 { 0xffffffff } else { 0 }
  out = (0 | (_rep_2 & `in`#[0..=31])) | (_rep_4 & `in`#[32..=63])
  out_valid = U1(select < NumSymbolsIn)
}
