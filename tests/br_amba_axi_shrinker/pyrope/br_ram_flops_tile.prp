pub mod br_ram_flops_tile<Depth=4, Width=9, NumWritePorts=1, NumReadPorts=1, EnablePartialWrite=0, WordWidth=9, EnableBypass=0, EnableReset=0, UseStructuredGates=0, EnableStructuredGatesDataQualification=1, EnableAssertFinalNotValid=1>::[timecheck=false](rd_addr:U2, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U2, wr_clk:Clock, wr_data:U9, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U9@[], rd_data_valid:U1@[]) {
  reg mem:[4]U9:[__store_clock_pin=wr_clk, __store_posclk=true, ordering="old"]
  rd_data = 0sb?
  if (wr_valid & 1) != 0 {
    mem[wr_addr] = wr_data
  }
  mut rd_data__w1 = rd_data
  rd_data__w1#[0..=8] = mem[rd_addr]
  rd_data_valid = rd_addr_valid
  rd_data = rd_data__w1
}
