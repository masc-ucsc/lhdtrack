pub comb br_shift_left_p1::[timecheck=false](`in`:u64, shift:u1, fill:u32) -> (out_valid:u1, out:u64) {
  mut stages:u128 = 0
  stages = 0sb?
  mut stages__w1 = stages
  stages__w1#[0..=63] = `in`
  mut _mux_2:u64 = if (shift & 1) != 0 { (stages__w1#[0..=63]#[0..=31] << 32) | fill } else { stages__w1#[0..=63] }
  out_valid = unsigned(shift <= 1)
  out = stages__w1#[64..=127]
}
