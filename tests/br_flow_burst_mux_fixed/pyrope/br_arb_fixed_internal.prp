// below#[i] = |v#[0..<i] (log-step prefix OR, constant shifts only)
comb or_below<N>(v:Unsigned(bits=N)) -> (below:Unsigned(bits=N)) {
  cassert(N <= 16)
  mut p:Unsigned(bits=N) = v#[0..<(N - 1)] << 1
  wrap p |= p << 1
  wrap p |= p << 2
  wrap p |= p << 4
  wrap p |= p << 8
  below = p
}

pub comb br_arb_fixed_internal<NumRequesters=4>::[timecheck=false](request:U4) -> (can_grant:(e3:U1, e2:U1, e1:U1, e0:U1), grant:U4) {
  // Lowest index wins: a requester may be granted when no lower one requests.
  const cg:U4 = ~or_below<N=4>(v=request)
  grant = request & cg
  can_grant = (e3=cg#[3], e2=cg#[2], e1=cg#[1], e0=cg#[0])
}
