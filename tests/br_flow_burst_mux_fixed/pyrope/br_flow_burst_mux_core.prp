const br_arb_grant_hold_t = import("br_arb_grant_hold.br_arb_grant_hold")
const br_flow_mux_core_t = import("br_flow_mux_core.br_flow_mux_core")

pub mod br_flow_burst_mux_core<NumFlows=4, Width=32, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, grant_from_arb:U4, pop_ready:U1, push_data:U128, push_last:(e3:U1, e2:U1, e1:U1, e0:U1), push_valid:U4, rst:Reset) -> (enable_priority_update:U1@[], pop_data_unstable:U32@[], pop_last_unstable:U1@[], pop_valid_unstable:U1@[], push_ready:U4@[], request:U4@[]) {
  wire push_payload_bits:U132 = nil
  wire push_payload:U132 = nil
  wire grant:U4 = nil
  wire enable_priority_update_from_mux:U1 = nil
  const t18 = ((push_last.e0 & 1) << 32) | push_data#[0..=31]
  push_payload_bits#[0..<33] = t18#[0..<33]
  const t87 = ((push_last.e1 & 1) << 32) | push_data#[32..=63]
  push_payload_bits#[33..<66] = t87#[0..<33]
  const t156 = ((push_last.e2 & 1) << 32) | push_data#[64..=95]
  push_payload_bits#[66..<99] = t156#[0..<33]
  const t225 = ((push_last.e3 & 1) << 32) | push_data#[96..=127]
  push_payload_bits#[99..<132] = t225#[0..<33]
  mut _b2i_1 = if enable_priority_update_from_mux != 0 and (grant & push_valid) != 0 { 1 } else { 0 }
  mut br_arb_grant_hold = br_arb_grant_hold_t::[name=br_arb_grant_hold](clk=clk, rst=rst, grant_hold=~(push_valid & ((push_last.e3 << 3) | (push_last.e2 << 2) | (push_last.e1 << 1) | push_last.e0))#[0..=3], enable_grant_hold_update=_b2i_1, grant_from_arb=grant_from_arb)
  grant = br_arb_grant_hold.grant
  mut br_flow_mux_core = br_flow_mux_core_t::[name=br_flow_mux_core](clk=clk, rst=rst, can_grant=grant, grant=grant, push_valid=push_valid, push_data=push_payload, pop_ready=pop_ready)
  enable_priority_update_from_mux = br_flow_mux_core.enable_priority_update
  push_payload = push_payload_bits
  request = br_flow_mux_core.request
  enable_priority_update = br_arb_grant_hold.enable_priority_update_to_arb
  push_ready = br_flow_mux_core.push_ready
  pop_valid_unstable = br_flow_mux_core.pop_valid_unstable
  pop_last_unstable = (br_flow_mux_core.pop_data_unstable >> 32) & 1
  pop_data_unstable = br_flow_mux_core.pop_data_unstable#[0..=31]
}
