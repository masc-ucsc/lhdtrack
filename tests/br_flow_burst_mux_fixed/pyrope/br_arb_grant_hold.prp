pub mod br_arb_grant_hold<NumRequesters=4>::[timecheck=false](clk:Clock, enable_grant_hold_update:U1, grant_from_arb:U4, grant_hold:U4, rst:U1) -> (enable_priority_update_to_arb:U1@[], grant:U4@[]) {
  reg hold:U4:[async=false, initial=0, reset_pin=rst]
  // A live held grant overrides the arbiter, whose priority only moves once
  // nothing is held.
  const granted:U4 = if hold != 0 { hold } else { grant_from_arb }
  if rst == 0 and enable_grant_hold_update == 1 {
    hold = granted & grant_hold
  }
  grant = granted
  enable_priority_update_to_arb = U1(hold == 0 and enable_grant_hold_update == 1)
}
