const br_arb_fixed_internal_t = import("br_arb_fixed_internal.br_arb_fixed_internal")
const br_flow_burst_mux_core_t = import("br_flow_burst_mux_core.br_flow_burst_mux_core")

pub mod br_flow_burst_mux_fixed::[timecheck=false](clk:u1, rst:u1, push_valid:u4, push_last:u4, push_data:u128, pop_ready:u1) -> (push_ready:u4@[], pop_valid_unstable:u1@[], pop_last_unstable:u1@[], pop_data_unstable:u32@[]) {
  wire request:u4
  mut br_arb_fixed_internal = br_arb_fixed_internal_t::[name=br_arb_fixed_internal](request = request)
  mut br_flow_burst_mux_core = br_flow_burst_mux_core_t::[name=br_flow_burst_mux_core](clk = clk, rst = rst, grant_from_arb = br_arb_fixed_internal.grant, push_valid = push_valid, `push_last.e3` = (push_last >> 3) & 1, `push_last.e2` = (push_last >> 2) & 1, `push_last.e1` = (push_last >> 1) & 1, `push_last.e0` = push_last & 1, push_data = push_data, pop_ready = pop_ready)
  request = br_flow_burst_mux_core.request
  push_ready = br_flow_burst_mux_core.push_ready
  pop_valid_unstable = br_flow_burst_mux_core.pop_valid_unstable
  pop_last_unstable = br_flow_burst_mux_core.pop_last_unstable
  pop_data_unstable = br_flow_burst_mux_core.pop_data_unstable
}
