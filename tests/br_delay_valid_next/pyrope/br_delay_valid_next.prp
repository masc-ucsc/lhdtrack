// One-stage delay line with valid-next (bedrock br_delay_valid_next, Width=64, NumStages=1).
//
// valid_next runs one cycle ahead of the data: when it is set, the data is valid on the
// following cycle. The valid bit is reset; the datapath is not, and only loads while the
// registered valid_next is set (clock-gating enable in the reference).
// Entry 0 of each *_stages vector is the input, entry 1 the registered stage.
// Outputs are declared @[] because the generated lhdtrack harness mixes the registered
// outputs with same-cycle values.
pub mod br_delay_valid_next(clk:Clock, `in`:U64, in_valid_next:U1, rst:U1) -> (out:U64@[], out_stages:U128@[], out_valid_next:U1@[], out_valid_next_stages:U2@[]) {
  reg valid_next:U1:[reset_pin=rst] = 0
  reg data:U64 = nil

  valid_next = in_valid_next
  if valid_next != 0 {
    data = `in`
  }

  out_valid_next = valid_next
  out = data
  out_valid_next_stages = (in_valid_next, valid_next)#[..]
  out_stages = (`in`, data)#[..]
}
