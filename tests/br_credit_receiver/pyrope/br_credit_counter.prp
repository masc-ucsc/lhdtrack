pub mod br_credit_counter<MaxValueWidth=32, MaxChangeWidth=32, MaxValue=16, MaxChange=4, MaxIncrement=4, MaxDecrement=4, EnableCoverZeroIncrement=0, EnableCoverZeroDecrement=1, EnableCoverDecrementBackpressure=0, EnableCoverWithhold=1, EnableAssertAlwaysDecr=0, EnableAssertFinalNotValid=0, CoverMaxValue=16, EnableAssertFinalMaxValue=0, EnableAssertFinalMinValue=1, EnableAssertNoDecrementBackpressure=1>::[timecheck=false](clk:Clock, decr:U3, decr_valid:U1, incr:U3, incr_valid:U1, initial_value:U5, rst:U1, withhold:U5) -> (available:U5@[], decr_ready:U1@[], value:U5@[]) {
  reg value:U5
  mut _mux_1:U3 = if incr_valid != 0 { incr } else { 0 }
  mut _mux_2:U3 = if decr_valid != 0 { decr } else { 0 }
  const decr_internal__w1 = _mux_2
  const value_plus_incr__w1 = (value + _mux_1)#[0..=4]
  mut _mux_3:U5 = if value_plus_incr__w1 > withhold { (value_plus_incr__w1 - withhold)#[0..=4] } else { 0 }
  const available__w1 = _mux_3
  mut _b2i_4 = if decr_internal__w1 <= available__w1 { 1 } else { 0 }
  const decr_ready__w1 = _b2i_4
  mut _mux_5:U5 = if decr_ready__w1 != 0 { decr_internal__w1 } else { 0 }
  const value_next__w1 = (value_plus_incr__w1 - _mux_5)#[0..=4]
  mut _b2i_6 = if incr_valid != 0 or (decr_valid != 0 and decr_ready__w1 != 0) { 1 } else { 0 }
  if rst != 0 {
    value = initial_value
  } elif _b2i_6 != 0 {
    value = value_next__w1
  }
  decr_ready = decr_ready__w1
  available = available__w1
}
