pub mod br_lru_state_internal::[timecheck=false](clk:Clock, grant:(e1:U1, e0:U1), rst:U1, update_priority:U1) -> (state:U4@[]) {
  reg state_reg___q:U4 = nil
  mut state_reg:U4 = 0
  mut state_reg_next:U4 = 0
  state_reg = state_reg___q
  state_reg_next = 0sb?
  state = 0sb?
  mut state__w1 = state
  state__w1#[0] = 0
  mut state_reg__w1 = state_reg
  state_reg__w1#[0] = 0
  mut state_reg_next__w1 = state_reg_next
  state_reg_next__w1#[0] = 0
  mut state__w2 = state__w1
  state__w2#[1] = (state_reg__w1#[0..=1] >> 1) & 1
  mut state__w3 = state__w2
  state__w3#[2] = Unsigned(((state_reg__w1#[0..=1] >> 1) & 1) == 0) & 1
  mut state_reg__w2 = state_reg__w1
  state_reg__w2#[2] = 0
  mut _mux_2:U1 = if grant.e1 != 0 { 1 } else { (state__w3#[0..=1] >> 1) & 1 }
  mut _mux_3:U1 = if grant.e0 != 0 { 0 } else { _mux_2 & 1 }
  mut state_reg_next__w2 = state_reg_next__w1
  state_reg_next__w2#[1] = _mux_3 & 1
  if rst != 0 {
    state_reg___q#[1] = 1
  } elif update_priority != 0 {
    state_reg___q#[1] = (state_reg_next__w2#[0..=1] >> 1) & 1
  }
  mut state_reg_next__w3 = state_reg_next__w2
  state_reg_next__w3#[2] = 0
  mut state__w4 = state__w3
  state__w4#[3] = 0
  mut state_reg__w3 = state_reg__w2
  state_reg__w3#[3] = 0
  mut state_reg_next__w4 = state_reg_next__w3
  state_reg_next__w4#[3] = 0
  state = state__w4
}
