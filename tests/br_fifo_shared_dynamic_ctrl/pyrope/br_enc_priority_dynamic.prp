const br_enc_priority_encoder_fn = import("br_enc_priority_encoder.br_enc_priority_encoder")

pub mod br_enc_priority_dynamic::[timecheck=false](clk:Clock, `in`:U2, lowest_prio:U2, rst:U1) -> (out:U4@[]) {
  mut priority_mask:U2 = 0
  priority_mask = 0sb?
  out = 0sb?
  mut priority_mask__w1 = priority_mask
  priority_mask__w1#[0] = Unsigned(lowest_prio != 0) & 1
  mut priority_mask__w2 = priority_mask__w1
  priority_mask__w2#[1] = Unsigned(((lowest_prio >> 1) & 1) != 0) & 1
  const in_high_prio__w1 = `in` & (~priority_mask__w2#[0..=1])#[0..=1]
  const t17 = ((`in` & priority_mask__w2) << 1) | ((in_high_prio__w1 >> 1) & 1)
  mut br_enc_priority_encoder_inst = br_enc_priority_encoder_fn<count=2, high=false, n=3>(request=((((t17 >> 2) & 1) << 2) | (((t17 >> 1) & 1) << 1) | (t17 & 1))#[0..<3])
  const out_internal__w1 = br_enc_priority_encoder_inst
  mut out__w1 = out
  out__w1#[0..=1] = out_internal__w1#[0..=2]#[1..=2] | ((out_internal__w1#[0..=2] & 1) << 1)
  mut out__w2 = out__w1
  out__w2#[2..=3] = out_internal__w1#[3..=5]#[1..=2] | ((out_internal__w1#[3..=5] & 1) << 1)
  out = out__w2
}
