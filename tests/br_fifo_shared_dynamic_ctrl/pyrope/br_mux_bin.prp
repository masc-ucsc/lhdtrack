pub comb br_mux_bin::[timecheck=false](`in`:U4, select:U1) -> (out:U2, out_valid:U1) {
  mut _rep_2:U2 = if (Unsigned(select == 0) & 1) != 0 { 3 } else { 0 }
  mut _rep_4:U2 = if (Unsigned(select == 1) & 1) != 0 { 3 } else { 0 }
  out = (0 | (_rep_2 & `in`#[0..=1])) | (_rep_4 & `in`#[2..=3])
  out_valid = Unsigned(select < 2)
}
