pub comb br_shift_right::[timecheck=false](fill:U5, `in`:U10, shift:U1) -> (out:U10, out_valid:U1) {
  mut stages:U20 = 0
  stages = 0sb?
  mut stages__w1 = stages
  stages__w1#[0..=9] = `in`
  mut _mux_1:U10 = if (shift & 1) != 0 { (fill << 5) | stages__w1#[0..=9]#[5..=9] } else { stages__w1#[0..=9] }
  mut stages__w2 = stages__w1
  stages__w2#[10..=19] = _mux_1
  out_valid = Unsigned(shift <= 1)
  out = stages__w2#[10..=19]
}
