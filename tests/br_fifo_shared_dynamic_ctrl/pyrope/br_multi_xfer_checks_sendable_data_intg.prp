const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_multi_xfer_checks_sendable_data_intg::[timecheck=false](clk:u1, rst:u1, receivable:u2, sendable:u2, data:u10) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 14) | (receivable << 12) | (sendable << 10) | data)
}
