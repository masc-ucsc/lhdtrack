// OR the selected packed lanes; lane zero occupies the least significant bits.
pub comb br_mux_onehot<n=2, width=1>(`in`:Unsigned(bits=n*width), select:Unsigned(bits=n)) -> (out:Unsigned(bits=width)) {
  out = 0
  for lane in 0..<n {
    if select#[lane] != 0 {
      out |= `in`#[(lane*width)..+width]
    }
  }
}
