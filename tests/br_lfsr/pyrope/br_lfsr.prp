pub mod br_lfsr::[timecheck=false](advance:U1, clk:Clock, initial_state:U32, reinit:U1, rst:U1, taps:U32) -> (out:U1@[], out_state:U32@[]) {
  reg state:U32
  const out__w1 = state & 1
  const out_state__w1 = state
  const advanced_state__w1 = state
  const t15 = (advanced_state__w1 & taps)#^[..]
  mut _mux_3:U32 = if reinit != 0 { initial_state } else { (advanced_state__w1#[0..=30] << 1) | Unsigned((t15)#[0]) }
  if rst != 0 {
    state = initial_state
  } elif advance != 0 or reinit != 0 {
    state = _mux_3
  }
  out = out__w1
  out_state = out_state__w1
}
