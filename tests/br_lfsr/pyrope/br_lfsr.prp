// Fibonacci LFSR (Width = 32, one step per advance). The next bit shifted into
// bit 0 is the parity of the tapped state bits. State has no reset value: reset
// and `reinit` both load the runtime `initial_state`, so they stay in the logic.
pub mod br_lfsr(advance:U1, clk:Clock, initial_state:U32, reinit:U1, rst:U1, taps:U32) -> (reg out_state:U32@[0]=nil, out:U1@[0]) {
  out = out_state#[0]
  mut stepped:U32 = 0
  wrap stepped = (out_state << 1) | (out_state & taps)#^[..]
  if rst != 0 or reinit != 0 {
    out_state = initial_state
  } elif advance != 0 {
    out_state = stepped
  }
}
