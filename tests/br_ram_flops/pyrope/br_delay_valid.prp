// Delay a valid/data pair by one cycle. The data register only loads when
// in_valid is set, so it holds its last value while idle; it has no reset.
// The registers bind to the clk/rst inputs (implicit clock and reset).
// timecheck=false: the gated data register counts as state (@[0]) while the
// valid counts as a stage (@[1]), so the pair has no single landing cycle.
pub mod br_delay_valid<T=u1>::[timecheck = false](clk:u1, rst:u1, in_valid:bool, data_in:T) -> (out_valid:bool@[], out:T@[]) {
  reg valid:bool = false
  reg data:T     = nil
  valid          = in_valid
  if in_valid {
    data = data_in
  }
  out_valid = valid
  out       = data
}
