comptime const WORD_WIDTH = 8

// Replace the words of `old` whose word_en bit is set with the words of `new`.
comb merge_words(old:u32, new:u32, word_en:u4) -> (merged:u32) {
  mut m:u32 = old
  for w in 0..<word_en.[bits] {
    if word_en#[w] == 1 {
      m#[(w*WORD_WIDTH)..+WORD_WIDTH] = new#[(w*WORD_WIDTH)..+WORD_WIDTH]
    }
  }
  merged = m
}

// One 16x32 tile of a flop RAM: one write port with byte enables, one read
// port, and same-cycle write-to-read bypass. The storage has no reset and is
// clocked by wr_clk; the read side is combinational.
pub mod br_ram_flops_tile::[timecheck = false](
  wr_clk:u1,
  wr_rst:u1,
  wr_valid:u1,
  wr_addr:u4,
  wr_data:u32,
  wr_word_en:u4,
  rd_clk:u1,
  rd_rst:u1,
  rd_addr_valid:u1,
  rd_addr:u4
) -> (rd_data_valid:u1@[], rd_data:u32@[]) {
  reg mem:[16]u32:[ordering = "old", clock_pin = ref wr_clk] = nil
  if wr_valid == 1 {
    mem[wr_addr] = merge_words(old=mem[wr_addr], new=wr_data, word_en=wr_word_en)
  }

  // Words written this cycle to the address being read bypass the storage.
  const bypass_en = if wr_valid == 1 and wr_addr == rd_addr { wr_word_en } else { 0 }
  rd_data_valid   = rd_addr_valid
  rd_data         = merge_words(old=mem[rd_addr], new=wr_data, word_en=bypass_en)
}
