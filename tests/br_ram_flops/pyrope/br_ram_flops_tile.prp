const cfg = import("lhdtrack_cfg")

// One 16x32 tile of a flop RAM: one write port with 8-bit word enables, one
// read port, and same-cycle write-to-read bypass. The storage has no reset and
// is clocked by wr_clk; the read side is combinational.
pub mod br_ram_flops_tile<Depth=16, Width=32, NumWritePorts=1, NumReadPorts=1, EnablePartialWrite=1, WordWidth=8, EnableBypass=1, EnableReset=0, UseStructuredGates=0, EnableStructuredGatesDataQualification=1, EnableAssertFinalNotValid=1>::[timecheck=false](rd_addr:U4, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U4, wr_clk:Clock, wr_data:U32, wr_rst:U1, wr_valid:U1, wr_word_en:U4) -> (rd_data:U32@[], rd_data_valid:U1@[]) {
  if cfg.no_loop {
    reg mem:[16]U32:[__store_clock_pin=wr_clk, __store_posclk=true, ordering="old", wensize=4]
    wire rd_data_bits:U32 = nil
    wire rd_data:U32 = nil
    mut gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match:U1 = 0
    gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match = 0ub?
    if (wr_valid & 1) != 0 {
      if (wr_word_en & 1) != 0 {
        mem[wr_addr][wr_data#[0..=7]] = 0
      }
      if ((wr_word_en >> 1) & 1) != 0 {
        mem[wr_addr][wr_data#[8..=15] << 8] = 1
      }
      if ((wr_word_en >> 2) & 1) != 0 {
        mem[wr_addr][wr_data#[16..=23] << 16] = 2
      }
      if ((wr_word_en >> 3) & 1) != 0 {
        mem[wr_addr][wr_data#[24..=31] << 24] = 3
      }
    }
    const gen_multi_entry_gen_read_port_0_rd_data_mem = mem[rd_addr]
    mut gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1 = gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match
    gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1#[0] = U1((wr_valid & 1) != 0 and wr_addr == rd_addr) & 1
    mut _mux_2:U8 = if gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1 != 0 and (wr_word_en & 1) != 0 { wr_data#[0..=7] }
      else { gen_multi_entry_gen_read_port_0_rd_data_mem#[0..=7] }
    rd_data_bits#[0..<8] = _mux_2#[0..<8]
    mut _mux_3:U8 = if gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1 != 0 and ((wr_word_en >> 1) & 1) != 0 {
      wr_data#[8..=15]
    } else {
      gen_multi_entry_gen_read_port_0_rd_data_mem#[8..=15]
    }
    rd_data_bits#[8..<16] = _mux_3#[0..<8]
    mut _mux_4:U8 = if gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1 != 0 and ((wr_word_en >> 2) & 1) != 0 {
      wr_data#[16..=23]
    } else {
      gen_multi_entry_gen_read_port_0_rd_data_mem#[16..=23]
    }
    rd_data_bits#[16..<24] = _mux_4#[0..<8]
    mut _mux_5:U8 = if gen_multi_entry_gen_read_port_0_gen_bypass_wr_addr_match__w1 != 0 and ((wr_word_en >> 3) & 1) != 0 {
      wr_data#[24..=31]
    } else {
      gen_multi_entry_gen_read_port_0_rd_data_mem#[24..=31]
    }
    rd_data_bits#[24..<32] = _mux_5#[0..<8]
    rd_data = rd_data_bits
    rd_data_valid = rd_addr_valid
  } else {
    // Loop form (hand-written).
    comptime const WORD_WIDTH = wr_data.[bits] / wr_word_en.[bits]

    reg mem:[16]U32:[ordering="old", clock_pin=wr_clk] = nil

    // Replace the enabled words of the addressed entry (whole-word write).
    mut written:U32 = mem[wr_addr]
    // Words written this cycle to the address being read bypass the storage.
    mut data:U32 = mem[rd_addr]
    for w in 0..<wr_word_en.[bits] {
      if wr_word_en#[w] == 1 {
        written#[(w*WORD_WIDTH)..+WORD_WIDTH] = wr_data#[(w*WORD_WIDTH)..+WORD_WIDTH]
        if wr_valid == 1 and wr_addr == rd_addr {
          data#[(w*WORD_WIDTH)..+WORD_WIDTH] = wr_data#[(w*WORD_WIDTH)..+WORD_WIDTH]
        }
      }
    }
    if wr_valid == 1 {
      mem[wr_addr] = written
    }
    rd_data_valid = rd_addr_valid
    rd_data       = data
  }
}
