const br_delay_valid    = import("br_delay_valid.br_delay_valid")
const br_ram_flops_tile = import("br_ram_flops_tile.br_ram_flops_tile")

// 64x64 flop RAM with byte write enables, built from a 4x2 grid of 16x32
// tiles. The decoded address (and write data) is registered once before the
// tiles; the read data is registered once per tile and once per tile row, so
// reads take three cycles and a read sees a same-cycle write (tile bypass).
// Write-side registers run on wr_clk, read-side ones on rd_clk.
pub mod br_ram_flops(
  wr_clk:u1,
  wr_rst:u1,
  wr_valid:u1,
  wr_addr:u6,
  wr_data:u64,
  wr_word_en:u8,
  rd_clk:u1,
  rd_rst:u1,
  rd_addr_valid:u1,
  rd_addr:u6
) -> (rd_data_valid:u1@[0], rd_data:u64@[0]) {
  comptime const DEPTH_TILES    = 4
  comptime const WIDTH_TILES    = 2
  comptime const TILE_ADDR_BITS = wr_addr.[bits] - 2 // log2(DEPTH_TILES)
  comptime const TILE_WIDTH     = wr_data.[bits] / WIDTH_TILES
  comptime const TILE_WORDS     = wr_word_en.[bits] / WIDTH_TILES

  type Write = (addr:u4, data:u64, word_en:u8)

  mut valid    = false
  mut data:u64 = 0
  for row in 0..<DEPTH_TILES {
    // Address decode: the top address bits select the tile row.
    const wr = br_delay_valid<T=Write>(
      clk=wr_clk,
      rst=wr_rst,
      in_valid=wr_valid == 1 and wr_addr#[TILE_ADDR_BITS..] == row,
      data_in=(addr=wr_addr#[0..<TILE_ADDR_BITS], data=wr_data, word_en=wr_word_en)
    )
    const rd = br_delay_valid<T=u4>(
      clk=rd_clk,
      rst=rd_rst,
      in_valid=rd_addr_valid == 1 and rd_addr#[TILE_ADDR_BITS..] == row,
      data_in=rd_addr#[0..<TILE_ADDR_BITS]
    )

    mut row_valid    = false
    mut row_data:u64 = 0
    for col in 0..<WIDTH_TILES {
      const tile = br_ram_flops_tile(
        wr_clk=wr_clk,
        wr_valid=wr.out_valid,
        wr_addr=wr.out.addr,
        wr_data=wr.out.data#[(col * TILE_WIDTH)..+TILE_WIDTH],
        wr_word_en=wr.out.word_en#[(col * TILE_WORDS)..+TILE_WORDS],
        rd_addr_valid=rd.out_valid,
        rd_addr=rd.out
      )
      // Width stage: register each tile's read data.
      const tile_q = br_delay_valid<T=u32>(
        clk=rd_clk, rst=rd_rst, in_valid=tile.rd_data_valid, data_in=tile.rd_data
      )
      row_data#[(col * TILE_WIDTH)..+TILE_WIDTH] = tile_q.out
      // Every tile in a row is valid together; the middle one speaks for the row.
      if col == WIDTH_TILES / 2 {
        row_valid = tile_q.out_valid
      }
    }

    // Depth stage, then a one-hot mux across the rows.
    const row_q = br_delay_valid<T=u64>(clk=rd_clk, rst=rd_rst, in_valid=row_valid, data_in=row_data)
    valid       = valid or row_q.out_valid
    if row_q.out_valid {
      data |= row_q.out
    }
  }
  rd_data_valid = u1(valid)
  rd_data       = data
}
