pub mod br_ram_flops_tile::[timecheck=false](rd_addr:U5, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U5, wr_clk:Clock, wr_data:U32, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U32@[], rd_data_valid:U1@[]) {
  reg mem:[32]U32:[clock_pin=wr_clk, ordering="old"] = nil
  rd_data = 0sb?
  if (wr_valid & 1) != 0 {
    mem[wr_addr] = wr_data
  }
  mut rd_data__w1 = rd_data
  rd_data__w1#[0..=31] = mem[rd_addr]#[0..=31]
  rd_data_valid = rd_addr_valid
  rd_data = rd_data__w1
}
