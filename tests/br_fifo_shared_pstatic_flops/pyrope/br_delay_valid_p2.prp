pub comb br_delay_valid_p2::[timecheck=false](clk:U1, `in`:U32, in_valid:U1, rst:U1) -> (out:U32, out_stages:U32, out_valid:U1, out_valid_stages:U1) {
  mut stage_valid:U1 = 0
  mut `stage`:U32 = 0
  stage_valid = 0ub?
  `stage` = 0sb?
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = `stage`
  stage__w1#[0..=31] = `in`
  out_valid = stage_valid__w1 & 1
  out = stage__w1#[0..=31]
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
