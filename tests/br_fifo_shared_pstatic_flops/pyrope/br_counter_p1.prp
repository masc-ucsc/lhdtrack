pub mod br_counter_p1::[timecheck=false](clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U2, reinit:U1, rst:U1) -> (value:U2@[], value_next:U2@[]) {
  reg value:U2 = nil
  mut _mux_1:U1 = if incr_valid != 0 { incr & 1 } else { 0 }
  mut _mux_2:U1 = if decr_valid != 0 { decr & 1 } else { 0 }
  mut _mux_3:U2 = if reinit != 0 { initial_value } else { value }
  const value_next__w1 = ((_mux_3 + _mux_1)#[0..=1] - _mux_2)#[0..=1]
  if rst != 0 {
    value = initial_value
  } elif Unsigned(reinit != 0 or incr_valid != 0 or decr_valid != 0) != 0 {
    value = value_next__w1
  }
  value_next = value_next__w1
}
