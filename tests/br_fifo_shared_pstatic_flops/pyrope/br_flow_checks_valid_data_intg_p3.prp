const br_misc_unused_p9 = import("br_misc_unused_p9.br_misc_unused_p9")

pub mod br_flow_checks_valid_data_intg_p3::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u12) -> () {
  br_misc_unused_p9::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 16) | (valid << 14) | (ready << 12) | data)
}
