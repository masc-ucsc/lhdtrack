pub mod br_flow_arb_core::[timecheck=false](can_grant:U2, clk:Clock, grant:U2, pop_ready:U1, push_valid:U2, rst:U1) -> (enable_priority_update:U1@[], pop_valid_unstable:U1@[], push_ready:U2@[], request:U2@[]) {
  mut _rep_1:U2 = if (pop_ready & 1) != 0 { 3 } else { 0 }
  const push_ready__w1 = _rep_1 & can_grant
  const pop_valid_unstable__w1 = Unsigned(push_valid != 0)
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
}
