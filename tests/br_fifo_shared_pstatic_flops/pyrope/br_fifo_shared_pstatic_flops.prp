const br_fifo_shared_pstatic_ctrl = import("br_fifo_shared_pstatic_ctrl.br_fifo_shared_pstatic_ctrl")
const br_ram_flops = import("br_ram_flops.br_ram_flops")

pub mod br_fifo_shared_pstatic_flops::[timecheck=false](clk:u1, rst:u1, config_base:u10, config_bound:u10, push_valid:u1, push_data:u32, push_fifo_id:u1, pop_ready:u2) -> (config_error:u1@[], push_ready:u1@[], push_full:u2@[], pop_valid:u2@[], pop_data:u64@[], pop_empty:u2@[]) {
  wire ram_wr_valid:u1
  wire ram_wr_addr:u5
  wire ram_wr_data:u32
  wire ram_rd_addr_valid:u1
  wire ram_rd_addr:u5
  mut br_ram_flops_data = br_ram_flops::[name=br_ram_flops_data](wr_clk = clk, wr_rst = rst, wr_valid = ram_wr_valid, wr_addr = ram_wr_addr, wr_data = ram_wr_data, wr_word_en = 1, rd_clk = clk, rd_rst = rst, rd_addr_valid = ram_rd_addr_valid, rd_addr = ram_rd_addr)
  mut br_fifo_shared_pstatic_ctrl_inst = br_fifo_shared_pstatic_ctrl::[name=br_fifo_shared_pstatic_ctrl_inst](clk = clk, rst = rst, config_base = config_base, config_bound = config_bound, push_valid = push_valid, push_data = push_data, push_fifo_id = push_fifo_id, pop_ready = pop_ready, ram_rd_data_valid = br_ram_flops_data.rd_data_valid, ram_rd_data = br_ram_flops_data.rd_data)
  ram_wr_valid = br_fifo_shared_pstatic_ctrl_inst.ram_wr_valid
  ram_wr_addr = br_fifo_shared_pstatic_ctrl_inst.ram_wr_addr
  ram_wr_data = br_fifo_shared_pstatic_ctrl_inst.ram_wr_data
  ram_rd_addr_valid = br_fifo_shared_pstatic_ctrl_inst.ram_rd_addr_valid
  ram_rd_addr = br_fifo_shared_pstatic_ctrl_inst.ram_rd_addr
  config_error = br_fifo_shared_pstatic_ctrl_inst.config_error
  push_ready = br_fifo_shared_pstatic_ctrl_inst.push_ready
  push_full = br_fifo_shared_pstatic_ctrl_inst.push_full
  pop_valid = br_fifo_shared_pstatic_ctrl_inst.pop_valid
  pop_data = br_fifo_shared_pstatic_ctrl_inst.pop_data
  pop_empty = br_fifo_shared_pstatic_ctrl_inst.pop_empty
}
