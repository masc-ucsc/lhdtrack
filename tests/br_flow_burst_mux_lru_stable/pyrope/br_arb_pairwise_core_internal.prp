pub comb br_arb_pairwise_core_internal<NumRequesters=8>::[timecheck=false](priority_matrix:U64, request:U8) -> (can_grant:U8, grant:U8) {
  // Requester i may be granted when every other active requester loses to it.
  comptime const ALL = 0xff
  const idle:U8 = ~request
  mut can:U8 = 0
  can#[0] = U1((priority_matrix#[0..<8] | idle | 1) == ALL)
  can#[1] = U1((priority_matrix#[8..<16] | idle | 2) == ALL)
  can#[2] = U1((priority_matrix#[16..<24] | idle | 4) == ALL)
  can#[3] = U1((priority_matrix#[24..<32] | idle | 8) == ALL)
  can#[4] = U1((priority_matrix#[32..<40] | idle | 16) == ALL)
  can#[5] = U1((priority_matrix#[40..<48] | idle | 32) == ALL)
  can#[6] = U1((priority_matrix#[48..<56] | idle | 64) == ALL)
  can#[7] = U1((priority_matrix#[56..<64] | idle | 128) == ALL)
  can_grant = can
  grant = request & can
}
