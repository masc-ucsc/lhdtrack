pub mod br_flow_arb_core<NumFlows=8, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertFinalNotValid=1, EnableCoverPopBackpressure=1, ArbiterAlwaysGrants=0, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false](can_grant:U8, clk:Clock, grant:U8, pop_ready:U1, push_valid:U8, rst:Reset) -> (enable_priority_update:U1@[], pop_valid_unstable:U1@[], push_ready:U8@[], request:U8@[]) {
  mut _rep_1:U8 = if (pop_ready & 1) != 0 { 0xff } else { 0 }
  const push_ready__w1 = _rep_1 & can_grant
  const pop_valid_unstable__w1 = U1((push_valid & can_grant) != 0)
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
}
