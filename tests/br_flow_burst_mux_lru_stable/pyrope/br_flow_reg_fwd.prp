// Forward-registered flow stage: holds one beat; ready when empty or draining.
pub mod br_flow_reg_fwd<Width=33, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=0, EnableAssertPushDataKnown=1, EnableCoverPopBackpressure=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U33, push_valid:U1, rst:U1) -> (pop_data:U33@[], pop_valid:U1@[], push_ready:U1@[]) {
  reg pop_valid:U1:[async=false, initial=0, reset_pin=rst]
  reg pop_data:U33
  const ready = pop_ready == 1 or pop_valid == 0
  if rst == 0 {
    pop_valid = U1(push_valid == 1 or not ready)
  }
  if ready and push_valid == 1 {
    pop_data = push_data
  }
  push_ready = U1(ready)
}
