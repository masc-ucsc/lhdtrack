const br_arb_pairwise_core_internal = import("br_arb_pairwise_core_internal.br_arb_pairwise_core_internal")
const br_lru_state_internal = import("br_lru_state_internal.br_lru_state_internal")

pub mod br_arb_lru_internal<NumRequesters=8>::[timecheck=false](clk:Clock, enable_priority_update:U1, request:U8, rst:Reset) -> (can_grant:U8@[], grant:U8@[]) {
  wire granted:U8 = nil
  const gen_n_req_br_lru_state_internal = br_lru_state_internal(clk=clk, rst=U1(rst), update_priority=U1(enable_priority_update == 1 and request != 0), grant=(e7=granted#[7], e6=granted#[6], e5=granted#[5], e4=granted#[4], e3=granted#[3], e2=granted#[2], e1=granted#[1], e0=granted#[0]))
  const gen_n_req_br_arb_pairwise_core_internal = br_arb_pairwise_core_internal(request=request, priority_matrix=gen_n_req_br_lru_state_internal)
  granted = gen_n_req_br_arb_pairwise_core_internal.grant
  grant = granted
  can_grant = gen_n_req_br_arb_pairwise_core_internal.can_grant
}
