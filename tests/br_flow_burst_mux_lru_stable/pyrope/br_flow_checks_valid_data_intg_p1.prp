const br_misc_unused_p6 = import("br_misc_unused_p6.br_misc_unused_p6")

pub mod br_flow_checks_valid_data_intg_p1::[timecheck=false](clk:u1, rst:u1, valid:u8, ready:u8, data:u264) -> () {
  br_misc_unused_p6::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 280) | (valid << 272) | (ready << 264) | data)
}
