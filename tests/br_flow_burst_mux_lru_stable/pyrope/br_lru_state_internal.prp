pub mod br_lru_state_internal<NumRequesters=8>::[timecheck=false](clk:Clock, grant:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), rst:U1, update_priority:U1) -> (state:U64@[]) {
  // Pairwise LRU priority, packed row-major: bit i*N+j is set when requester i
  // beats j. Only the upper triangle (i < j) is stored; the lower triangle is
  // its complement and the diagonal is zero.
  comptime const UPPER = 0x80c0e0f0f8fcfe  // bits i*N+j with i < j
  const g:U8 = (grant.e0, grant.e1, grant.e2, grant.e3, grant.e4, grant.e5, grant.e6, grant.e7)#[..]
  // After reset every lower-numbered requester beats every higher one.
  const reset = rst == 1
  reg state_reg:U64:[reset_pin=reset] = UPPER
  if update_priority == 1 {
    // The granted requester loses to everyone; everyone beats a granted one.
    state_reg#[1..<8] = if g#[0] == 1 { 0 } else { state_reg#[1..<8] | g#[1..] }
    state_reg#[10..<16] = if g#[1] == 1 { 0 } else { state_reg#[10..<16] | g#[2..] }
    state_reg#[19..<24] = if g#[2] == 1 { 0 } else { state_reg#[19..<24] | g#[3..] }
    state_reg#[28..<32] = if g#[3] == 1 { 0 } else { state_reg#[28..<32] | g#[4..] }
    state_reg#[37..<40] = if g#[4] == 1 { 0 } else { state_reg#[37..<40] | g#[5..] }
    state_reg#[46..<48] = if g#[5] == 1 { 0 } else { state_reg#[46..<48] | g#[6..] }
    state_reg#[55..<56] = if g#[6] == 1 { 0 } else { state_reg#[55..<56] | g#[7..] }
  }

  // Row i of the lower triangle is the complement of column i above it.
  const low0:U8 = 0
  const low1:U8 = (state_reg#[1])#[..] ^ 0x1
  const low2:U8 = (state_reg#[2], state_reg#[10])#[..] ^ 0x3
  const low3:U8 = (state_reg#[3], state_reg#[11], state_reg#[19])#[..] ^ 0x7
  const low4:U8 = (state_reg#[4], state_reg#[12], state_reg#[20], state_reg#[28])#[..] ^ 0xf
  const low5:U8 = (state_reg#[5], state_reg#[13], state_reg#[21], state_reg#[29], state_reg#[37])#[..] ^ 0x1f
  const low6:U8 = (state_reg#[6], state_reg#[14], state_reg#[22], state_reg#[30], state_reg#[38], state_reg#[46])#[..] ^ 0x3f
  const low7:U8 = (state_reg#[7], state_reg#[15], state_reg#[23], state_reg#[31], state_reg#[39], state_reg#[47], state_reg#[55])#[..] ^ 0x7f
  state = (state_reg & UPPER) | (low0, low1, low2, low3, low4, low5, low6, low7)#[..]
}
