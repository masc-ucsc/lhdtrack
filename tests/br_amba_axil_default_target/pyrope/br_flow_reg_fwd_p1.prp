const br_flow_checks_valid_data_impl_p1 = import("br_flow_checks_valid_data_impl_p1.br_flow_checks_valid_data_impl_p1")
const br_flow_checks_valid_data_intg_p1 = import("br_flow_checks_valid_data_intg_p1.br_flow_checks_valid_data_intg_p1")

pub mod br_flow_reg_fwd_p1::[timecheck=false](clk:u1, rst:u1, push_valid:u1, push_data:u1, pop_ready:u1) -> (push_ready:u1@[], pop_valid:u1@[], pop_data:u1@[]) {
  reg pop_valid:u1
  reg pop_data:u1
  const push_ready__w1 = unsigned((pop_ready != 0) or (pop_valid == 0))
  pop_valid = if rst != 0 { 0 } else { unsigned((push_valid != 0) or (push_ready__w1 == 0)) }
  if unsigned((push_ready__w1 != 0) and (push_valid != 0)) != 0 {
    pop_data = push_data
  }
  br_flow_checks_valid_data_impl_p1::[name=br_flow_checks_valid_data_impl](clk = clk, rst = rst, valid = pop_valid, ready = pop_ready, data = pop_data)
  br_flow_checks_valid_data_intg_p1::[name=br_flow_checks_valid_data_intg](clk = clk, rst = rst, valid = push_valid, ready = push_ready__w1, data = push_data)
  push_ready = push_ready__w1
}
