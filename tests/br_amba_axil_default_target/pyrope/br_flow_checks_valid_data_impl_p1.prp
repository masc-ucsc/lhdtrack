const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_flow_checks_valid_data_impl_p1<NumFlows=1, Width=1, EnableCoverBackpressure=1, NumBackpressureCheckFlows=1, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U1, ready:U1, rst:U1, valid:U1) -> () {
  br_misc_unused_p2::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 3) | ((valid & 1) << 2) | ((ready & 1) << 1) | (data & 1))
