pub comb br_mux_onehot<NumSymbolsIn=4, SymbolWidth=32, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U128, select:U4) -> (out:U32) {
  mut _rep_1:U32 = if (select & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_2:U32 = if ((select >> 1) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_3:U32 = if ((select >> 2) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_4:U32 = if ((select >> 3) & 1) != 0 { 0xffffffff } else { 0 }
  out = (((0 | (_rep_1 & `in`#[0..=31])) | (_rep_2 & `in`#[32..=63])) | (_rep_3 & `in`#[64..=95])) | (_rep_4 & `in`#[96..=127])
}
