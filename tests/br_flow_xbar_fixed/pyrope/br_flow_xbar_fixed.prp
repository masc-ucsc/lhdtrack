const cfg = import("lhdtrack_cfg")

// One-hot (or zero) select of a 32-bit push flow.
mod pick(grant:U4, data:U128) -> (out:U32@[0]) {
  if cfg.no_loop {
    out = (if grant#[0] == 1 { data#[0..<32] } else { 0 })
        | (if grant#[1] == 1 { data#[32..<64] } else { 0 })
        | (if grant#[2] == 1 { data#[64..<96] } else { 0 })
        | (if grant#[3] == 1 { data#[96..<128] } else { 0 })
  } else {
    comptime const W = out.[bits]
    mut acc:U32 = 0
    for i in 0..<grant.[bits] {
      acc |= if grant#[i] == 1 { data#[(i*W)..+W] } else { 0 }
    }
    out = acc
  }
}

// Push flows (bit i) whose destination is pop flow J.
comb dest_is<J=0>(dest:U8) -> (hit:U4) {
  hit = (U1(dest#[0..<2] == J), U1(dest#[2..<4] == J), U1(dest#[4..<6] == J), U1(dest#[6..<8] == J))#[..]
}

// Fixed-priority arbitration: requester i can be granted when no lower
// requester is requesting (log-step prefix OR, no adder).
mod clear_below(request:U4) -> (can_grant:U4@[0]) {
  wrap const p1:U4 = request | (request << 1)
  wrap const p2:U4 = p1 | (p1 << 2)
  wrap const below:U4 = p2 << 1
  can_grant = ~below
}

// 4x4 valid/ready crossbar of 32-bit flows with a fixed-priority arbiter per
// pop flow (lowest push flow wins). Push flow i goes to pop flow
// push_dest_id[i]. All vectors are packed with flow 0 in the low bits.
pub mod br_flow_xbar_fixed(clk:Clock, pop_ready:U4, push_data:U128, push_dest_id:U8, push_valid:U4, rst:Reset) -> (pop_data:U128@[], pop_valid:U4@[], push_ready:U4@[]) {
  const to0 = dest_is<J=0>(dest=push_dest_id)
  const to1 = dest_is<J=1>(dest=push_dest_id)
  const to2 = dest_is<J=2>(dest=push_dest_id)
  const to3 = dest_is<J=3>(dest=push_dest_id)

  // Requests at each pop flow, one bit per push flow.
  const req0:U4 = push_valid & to0
  const req1:U4 = push_valid & to1
  const req2:U4 = push_valid & to2
  const req3:U4 = push_valid & to3
  const can_grant0 = clear_below(request=req0)
  const can_grant1 = clear_below(request=req1)
  const can_grant2 = clear_below(request=req2)
  const can_grant3 = clear_below(request=req3)

  pop_valid = (U1(req0 != 0), U1(req1 != 0), U1(req2 != 0), U1(req3 != 0))#[..]
  const data0 = pick(grant=req0 & can_grant0, data=push_data)
  const data1 = pick(grant=req1 & can_grant1, data=push_data)
  const data2 = pick(grant=req2 & can_grant2, data=push_data)
  const data3 = pick(grant=req3 & can_grant3, data=push_data)
  pop_data = (data0, data1, data2, data3)#[..]

  // A lane is ready when its pop flow is ready and could grant it; a push
  // flow is ready when the lane to its destination is.
  const ready0:U4 = if pop_ready#[0] == 1 { can_grant0 } else { 0 }
  const ready1:U4 = if pop_ready#[1] == 1 { can_grant1 } else { 0 }
  const ready2:U4 = if pop_ready#[2] == 1 { can_grant2 } else { 0 }
  const ready3:U4 = if pop_ready#[3] == 1 { can_grant3 } else { 0 }
  const lanes = (ready0, ready1, ready2, ready3)
  const sel0:U4 = lanes[push_dest_id#[0..<2]]
  const sel1:U4 = lanes[push_dest_id#[2..<4]]
  const sel2:U4 = lanes[push_dest_id#[4..<6]]
  const sel3:U4 = lanes[push_dest_id#[6..<8]]
  push_ready = (sel0#[0], sel1#[1], sel2#[2], sel3#[3])#[..]
}
