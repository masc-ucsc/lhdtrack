pub mod br_flow_serializer::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U64, push_last:U1, push_last_dont_care_count:U3, push_metadata:U8, push_valid:U1, rst:Reset) -> (pop_data:U8@[], pop_last:U1@[], pop_metadata:U8@[], pop_valid:U1@[], push_ready:U1@[]) {
  wire gen_sr_gt_1_pop_flit_id:U3 = nil
  mut _mux_2:U3 = 0
  _mux_2 = gen_sr_gt_1_pop_flit_id
  mut gen_sr_gt_1_br_mux_bin = br_mux_bin::[name=gen_sr_gt_1_br_mux_bin](select=_mux_2, `in`=push_data)
  const pop_valid__w1 = push_valid
  mut _mux_3:U3 = if push_last != 0 { push_last_dont_care_count } else { 0 }
  const gen_sr_gt_1_pop_flit_id_plus_dont_care_count__w1 = (gen_sr_gt_1_pop_flit_id + _mux_3)#[0..=2]
  mut _b2i_4 = if push_last != 0 and gen_sr_gt_1_pop_flit_id_plus_dont_care_count__w1 == 7 { 1 } else { 0 }
  const pop_last__w1 = _b2i_4
  const pop_metadata__w1 = push_metadata
  mut _b2i_5 = if pop_ready != 0 and gen_sr_gt_1_pop_flit_id_plus_dont_care_count__w1 == 7 { 1 } else { 0 }
  const push_ready__w1 = _b2i_5
  br_flow_checks_valid_data_impl_t::[name=br_flow_checks_valid_data_impl](clk=clk, rst=rst, valid=pop_valid__w1, ready=pop_ready, data=(gen_sr_gt_1_br_mux_bin.out#[0..=7] << 9) | ((pop_last__w1 & 1) << 8) | pop_metadata__w1)
  br_flow_checks_valid_data_intg_t::[name=br_flow_checks_valid_data_intg](clk=clk, rst=rst, valid=push_valid, ready=push_ready__w1, data=(push_data << 12) | ((push_last & 1) << 11) | (push_last_dont_care_count << 8) | push_metadata)
  mut _b2i_6 = if pop_ready != 0 and pop_valid__w1 != 0 and pop_last__w1 != 0 { 1 } else { 0 }
  mut _b2i_7 = if pop_ready != 0 and pop_valid__w1 != 0 and pop_last__w1 == 0 { 1 } else { 0 }
