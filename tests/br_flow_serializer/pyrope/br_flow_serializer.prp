const br_counter_incr = import("br_counter_incr.br_counter_incr")
const br_mux_bin = import("br_mux_bin.br_mux_bin")

pub mod br_flow_serializer::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U64, push_last:U1, push_last_dont_care_count:U3, push_metadata:U8, push_valid:U1, rst:Reset) -> (pop_data:U8@[], pop_last:U1@[], pop_metadata:U8@[], pop_valid:U1@[], push_ready:U1@[]) {
  wire gen_sr_gt_1_pop_flit_id:U3 = nil
  mut _mux_2:U3 = 0
  _mux_2 = gen_sr_gt_1_pop_flit_id
  mut gen_sr_gt_1_br_mux_bin = br_mux_bin::[name=gen_sr_gt_1_br_mux_bin](select=_mux_2, `in`=push_data)
  mut _mux_3:U3 = if push_last != 0 { push_last_dont_care_count } else { 0 }
  const gen_sr_gt_1_pop_flit_id_plus_dont_care_count = (gen_sr_gt_1_pop_flit_id + _mux_3)#[0..=2]
  mut _b2i_4 = if push_last != 0 and gen_sr_gt_1_pop_flit_id_plus_dont_care_count == 7 { 1 } else { 0 }
  const pop_last__w1 = _b2i_4
  mut _b2i_5 = if pop_ready != 0 and gen_sr_gt_1_pop_flit_id_plus_dont_care_count == 7 { 1 } else { 0 }
  const push_ready__w1 = _b2i_5
  mut _b2i_6 = if pop_ready != 0 and push_valid != 0 and pop_last__w1 != 0 { 1 } else { 0 }
  mut _b2i_7 = if pop_ready != 0 and push_valid != 0 and pop_last__w1 == 0 { 1 } else { 0 }
  mut gen_sr_gt_1_br_counter_incr_pop_flit_id = br_counter_incr::[name=gen_sr_gt_1_br_counter_incr_pop_flit_id](clk=clk, rst=rst, reinit=_b2i_6, initial_value=0, incr_valid=_b2i_7, incr=1)
  gen_sr_gt_1_pop_flit_id = gen_sr_gt_1_br_counter_incr_pop_flit_id.value
  push_ready = push_ready__w1
  pop_valid = push_valid
  pop_data = gen_sr_gt_1_br_mux_bin.out
  pop_last = pop_last__w1
  pop_metadata = push_metadata
}
