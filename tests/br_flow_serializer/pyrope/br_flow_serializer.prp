// Serialize each 64-bit push word into eight 8-bit pop flits, least significant
// flit first. A last word may end early: its final push_last_dont_care_count
// flits are skipped. Metadata rides along with every flit. clk only fed the
// upstream assertions.
pub mod br_flow_serializer(
  clk:u1,
  rst:u1,
  push_valid:u1,
  push_data:u64,
  push_last:u1,
  push_last_dont_care_count:u3,
  push_metadata:u8,
  pop_ready:u1
) -> (push_ready:u1@[0], pop_valid:u1@[0], pop_data:u8@[0], pop_last:u1@[0], pop_metadata:u8@[0]) {
  comptime const FLIT_WIDTH = pop_data.[bits]
  comptime const LAST_FLIT  = push_data.[bits]/FLIT_WIDTH - 1

  // Flit of the current push word being offered.
  reg flit_id:u3:[reset_pin = ref rst] = 0

  const skipped   = if push_last == 1 { push_last_dont_care_count } else { 0 }
  mut position:u3 = 0
  wrap position   = flit_id + skipped
  const word_done = position == LAST_FLIT
  const last_flit = push_last == 1 and word_done

  pop_valid    = push_valid
  pop_data     = push_data#[(flit_id*FLIT_WIDTH)..+FLIT_WIDTH]
  pop_last     = u1(last_flit)
  pop_metadata = push_metadata
  // The push word is consumed with its final flit.
  push_ready = u1(pop_ready == 1 and word_done)

  if pop_ready == 1 and push_valid == 1 {
    wrap flit_id = if last_flit { 0 } else { flit_id + 1 }
  }
}
