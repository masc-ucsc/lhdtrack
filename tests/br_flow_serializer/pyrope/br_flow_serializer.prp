  gen_sr_gt_1_pop_flit_id = gen_sr_gt_1_br_counter_incr_pop_flit_id.value
  push_ready = push_ready__w1
  pop_valid = pop_valid__w1
  pop_data = gen_sr_gt_1_br_mux_bin.out
