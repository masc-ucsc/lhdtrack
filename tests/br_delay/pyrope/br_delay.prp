// Four-stage, 8-bit delay line with synchronous reset to zero.
//
// `stages` holds the input in byte 0 (never stored, so it is never written) and
// stage i in byte i. Keeping the reference's single 40-bit register, rather than
// a 32-bit shift register, lets LEC pair the state and prove unbounded.
//
// out and out_stages deliberately land at `@[]`: they mix the live input with
// registered stages, which one `@[N]` cannot express.
pub mod br_delay(clk:Clock, `in`:U8, rst:U1) -> (out:U8@[], out_stages:U40@[]) {
  reg stages:U40:[reset_pin=rst] = 0
  stages#[8..<40] = (stages#[8..<32] << 8) | `in`
  out = stages#[32..<40]
  out_stages = (stages#[8..<40] << 8) | `in`
}
