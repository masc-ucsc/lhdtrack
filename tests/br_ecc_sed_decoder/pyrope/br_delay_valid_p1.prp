pub comb br_delay_valid_p1::[timecheck=false](clk:u1, rst:u1, in_valid:u1, `in`:u35) -> (out_valid:u1, out:u35, out_valid_stages:u1, out_stages:u35) {
  mut stage_valid:u1 = 0
  mut stage:u35 = 0
  stage_valid = 0ub?
  stage = 0sb?
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = stage
  stage__w1#[0..=34] = `in`
  out_valid = stage_valid__w1 & 1
  out = stage__w1#[0..=34]
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
