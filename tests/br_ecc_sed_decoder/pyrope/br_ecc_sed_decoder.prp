const br_delay_valid = import("br_delay_valid.br_delay_valid")
const br_delay_valid_p1 = import("br_delay_valid.br_delay_valid")

pub mod br_ecc_sed_decoder::[timecheck=false](clk:Clock, rcv_codeword:U33, rcv_valid:U1, rst:Reset) -> (dec_codeword:U33@[], dec_data:U32@[], dec_error_due:U1@[], dec_error_syndrome:U1@[], dec_valid:U1@[]) {
  mut br_delay_valid_inputs = br_delay_valid<Width=33>(in_valid=rcv_valid, `in`=rcv_codeword)
  const t8 = br_delay_valid_inputs.out#[0..=32]#^[..]
  mut br_delay_valid_outputs = br_delay_valid_p1<Width=35>(in_valid=br_delay_valid_inputs.out_valid, `in`=(br_delay_valid_inputs.out#[0..=32] << 2) | ((t8 & 1) << 1) | (U1(t8 != 0) & 1))
  const dec_codeword__w1 = (br_delay_valid_outputs.out >> 2)#[0..=32]
  dec_valid = br_delay_valid_outputs.out_valid
  dec_codeword = dec_codeword__w1
  dec_error_due = br_delay_valid_outputs.out & 1
  dec_error_syndrome = (br_delay_valid_outputs.out >> 1) & 1
  dec_data = dec_codeword__w1#[0..=31]
}
