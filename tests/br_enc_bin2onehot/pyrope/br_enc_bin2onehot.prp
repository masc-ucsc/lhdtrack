// Binary to one-hot decoder (NumValues = 32). All zero when in_valid is low.
// clk and rst are unused (upstream uses them only for assertions); they stay on
// this external top so the ports line up with the Verilog.
pub mod br_enc_bin2onehot(clk:Clock, `in`:U5, in_valid:U1, rst:Reset) -> (out:U32@[0]) {
  out = if in_valid != 0 { 1 << `in` } else { 0 }
}
