// Lockstep fork, 16 flows: one push is broadcast to every pop, and it only
// completes (push_ready) once all pops are ready. A pop is offered the push
// (pop_valid_unstable) only while every OTHER pop is ready, so the flows
// advance together. All outputs are combinational; clk and rst are unused.
pub mod br_flow_fork(clk:Clock, pop_ready:U16, push_valid:U1, rst:Reset) -> (pop_valid_unstable:U16@[0], push_ready:U1@[0]) {
  comptime const N = pop_ready.[bits]

  push_ready = pop_ready#&[..]
  for i in 0..<N {
    const others_ready:Unsigned(bits=N) = pop_ready | (1 << i)
    pop_valid_unstable#[i] = push_valid & others_ready#&[..]
  }
}
