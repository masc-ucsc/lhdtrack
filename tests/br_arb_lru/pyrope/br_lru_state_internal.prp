// Least-recently-granted state as a pairwise priority matrix, packed row-major:
// bit i*N+j is 1 when requester i beats requester j. Only the upper triangle
// (i < j) is stored; the lower triangle is its complement, the diagonal zero.

// Every upper-triangle bit (column > row) of a packed size x size matrix.
comb upper_triangle(size) -> (mask) {
  mut m = 0
  for row in 0..<size {
    const above_diagonal = ((1 << size) - 1) & ~((1 << (row + 1)) - 1)
    m |= above_diagonal << (row*size)
  }
  mask = m
}

pub mod br_lru_state_internal<NUM_REQUESTERS=2>(
  rst:u1,
  update_priority:bool,
  grant:unsigned(bits=NUM_REQUESTERS)
) -> (state:unsigned(bits=NUM_REQUESTERS * NUM_REQUESTERS)@[0]) {
  comptime const N = NUM_REQUESTERS

  // After reset every lower-numbered requester beats every higher one.
  comptime const STORED = upper_triangle(size=N)
  reg wins:unsigned(bits=N * N):[reset_pin = ref rst] = STORED

  mut next_wins = wins
  if update_priority {
    for i in 0..<N {
      // The granted requester loses to everyone; everyone beats a granted one.
      next_wins#[(i*N)..+N] = if grant#[i] == 1 { 0 } else { wins#[(i*N)..+N] | grant }
    }
  }
  // Bits outside the upper triangle are never stored.
  wins = next_wins & STORED

  mut matrix:unsigned(bits=N * N) = 0
  for i in 0..<N {
    for j in 0..<N {
      if i < j {
        matrix#[i*N + j] = wins#[i*N + j]
      } elif i > j {
        matrix#[i*N + j] = ~wins#[j*N + i] & 1
      }
    }
  }
  state = matrix
}
