const br_arb_pairwise_core_internal_t = import("br_arb_pairwise_core_internal.br_arb_pairwise_core_internal")
const br_lru_state_internal_t = import("br_lru_state_internal.br_lru_state_internal")

pub mod br_arb_lru_internal::[timecheck=false](clk:u1, rst:u1, enable_priority_update:u1, request:u16) -> (can_grant:u16@[], grant:u16@[]) {
  wire grant:u16
  mut br_lru_state_internal = br_lru_state_internal_t::[name=br_lru_state_internal](clk = clk, rst = rst, update_priority = unsigned((enable_priority_update != 0) and (request != 0)), `grant.e15` = (grant >> 15) & 1, `grant.e14` = (grant >> 14) & 1, `grant.e13` = (grant >> 13) & 1, `grant.e12` = (grant >> 12) & 1, `grant.e11` = (grant >> 11) & 1, `grant.e10` = (grant >> 10) & 1, `grant.e9` = (grant >> 9) & 1, `grant.e8` = (grant >> 8) & 1, `grant.e7` = (grant >> 7) & 1, `grant.e6` = (grant >> 6) & 1, `grant.e5` = (grant >> 5) & 1, `grant.e4` = (grant >> 4) & 1, `grant.e3` = (grant >> 3) & 1, `grant.e2` = (grant >> 2) & 1, `grant.e1` = (grant >> 1) & 1, `grant.e0` = grant & 1)
  mut br_arb_pairwise_core_internal = br_arb_pairwise_core_internal_t::[name=br_arb_pairwise_core_internal](request = request, priority_matrix = br_lru_state_internal)
  grant = br_arb_pairwise_core_internal.grant
  can_grant = br_arb_pairwise_core_internal.can_grant
}
