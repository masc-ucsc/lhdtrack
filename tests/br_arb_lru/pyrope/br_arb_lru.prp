const br_arb_lru_internal = import("br_arb_lru_internal.br_arb_lru_internal")

// 16-requester least-recently-used arbiter. clk only fed the upstream assertions.
pub mod br_arb_lru(clk:u1, rst:u1, enable_priority_update:u1, request:u16) -> (grant:u16@[0]) {
  comptime const NUM_REQUESTERS = request.[bits]
  const arb = br_arb_lru_internal<NUM_REQUESTERS=NUM_REQUESTERS>(
    rst=rst, enable_priority_update=enable_priority_update == 1, request=request
  )
  grant = arb.grant
}
