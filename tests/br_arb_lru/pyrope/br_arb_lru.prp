// Least-recently-used arbiter, 16 requesters, zero latency from request to grant.
// A pairwise priority matrix remembers, for every pair, which requester was
// granted less recently; the requester that loses to nobody else requesting wins.
// enable_priority_update gates the matrix update; grants are made either way.
//
// N x N bit matrices are flat words, bit i*N + j = row i, column j. The logic
// is whole-matrix operations with comptime masks.

// Reset matrix: for i < j requester i outranks j (bit i*N + j); everything else 0.
comb upper_triangle<N=16>() -> (m:Unsigned(bits=N*N)) {
  m = 0
  for i in 0..<N {
    for j in (i + 1)..<N {
      m#[i*N + j] = 1
    }
  }
}

// Cells (r, c) with bit S of r clear and bit S of c set: the top-right S x S
// sub-blocks that a transpose step swaps with their bottom-left partner.
comb swap_mask<N=16, S=8>() -> (m:Unsigned(bits=N*N)) {
  m = 0
  for r in 0..<N {
    for c in 0..<N {
      if (r & S) == 0 and (c & S) != 0 {
        m#[r*N + c] = 1
      }
    }
  }
}

// One transpose step: swap each top-right S x S sub-block with its partner
// S*(N-1) bits further up.
comb swap_blocks<N=16, S=8>(x:Unsigned(bits=N*N)) -> (y:Unsigned(bits=N*N)) {
  comptime const D = S*(N - 1)
  comptime const M = swap_mask<N=N, S=S>()
  comptime const KEEP = ~(M | (M << D)) & ((1 << (N*N)) - 1)
  wrap y = (x & KEEP) | ((x >> D) & M) | ((x & M) << D)
}

// Transpose of a 16 x 16 bit matrix.
comb transpose(x:U256) -> (y:U256) {
  y = swap_blocks<N=16, S=1>(x=swap_blocks<N=16, S=2>(x=swap_blocks<N=16, S=4>(x=swap_blocks<N=16, S=8>(x=x))))
}

pub mod br_arb_lru(clk:Clock, enable_priority_update:U1, request:U16, rst:Reset) -> (grant:U16@[]) {
  comptime const UPPER = upper_triangle<N=16>()

  // Only the strict upper triangle is state; the lower triangle is its mirror
  // (outranks(i, j) == not outranks(j, i)) and the diagonal is unused.
  reg state:U256 = UPPER
  const upper:U256 = state & UPPER

  // Column j of every row carries request#[j].
  const req_cols:U256 = (request, request, request, request, request, request, request, request,
                         request, request, request, request, request, request, request, request)#[..]

  // loses#[i*16 + j]: requester j is requesting and outranks i.
  const loses:U256 = req_cols & ((UPPER & ~upper) | transpose(x=upper))

  // Row i is clear when i loses to nobody: OR the rows of the transpose.
  const by_col = transpose(x=loses)
  const h8:U128 = by_col#[0..<128] | by_col#[128..<256]
  const h4:U64 = h8#[0..<64] | h8#[64..<128]
  const h2:U32 = h4#[0..<32] | h4#[32..<64]
  const blocked:U16 = h2#[0..<16] | h2#[16..<32]
  grant = request & ~blocked

  // The granted requester becomes the lowest priority against everyone:
  // row i clears when i is granted, else column j sets when j is granted.
  if enable_priority_update == 1 and request != 0 {
    const g_cols:U256 = (grant, grant, grant, grant, grant, grant, grant, grant,
                         grant, grant, grant, grant, grant, grant, grant, grant)#[..]
    const g_rows = transpose(x=g_cols)
    const change:U256 = UPPER & (g_rows | g_cols)
    state = (state & ~change) | (change & g_cols & ~g_rows)
  }
}
