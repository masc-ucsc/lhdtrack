// Fork to selected consumers; each valid waits for the other consumers' readiness.
pub comb br_flow_fork_select_multihot(pop_ready:U16, push_select_multihot:U16, push_valid:U1) -> (pop_valid_unstable:U16, push_ready:U1) {
  const ready:U16 = pop_ready | ~push_select_multihot
  push_ready = ready#&[..]
  for lane in 0..<pop_ready.[bits] {
    const others:U16 = ready | (1 << lane)
    pop_valid_unstable#[lane] = U1(push_valid != 0 and push_select_multihot#[lane] == 1 and others#&[..] == 1)
  }
}
