// Generated by tools/gen_testbench.py, then hand-adjusted for an explicit clock. Simulation only.
//
// `lhd sim` driver. The design input is supplied ahead of this file by the
// flow, so `import("lg:...")` names whichever library was just compiled --
// the Pyrope tree under sim_lhd_pyrope, the Verilog one under sim_lhd_verilog.
// Identical driver, identical work, either way.
const dut = import("lg:br_cdc_bit_pulse_harness")

test bench.run(cycles:u32=1000000) {
  mut acc = dut
  mut result:u64 = 0

  tick cycles {
    // `u1(...)`, not `int(...)`: this lhd build removed the `int` cast in
    // favour of sized/sign-explicit ones.
    acc.rst = u1(clock < 4)
    // One LiveHD step is one complete clock period.  Keep the explicit clock
    // asserted for the CDC harness; two steps would commit every flop twice.
    acc.clk = 1
    step
    result = acc.checksum
  }

  puts("LHDTRACK-DONE cycles={} checksum={}", cycles, result)
}
