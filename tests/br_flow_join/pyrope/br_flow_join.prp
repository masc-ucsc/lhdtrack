const br_flow_join_select_multihot = import("br_flow_join_select_multihot.br_flow_join_select_multihot")

// Join 16 valid/ready flows into one; every flow is always selected.
// clk and rst only fed the upstream assertions.
pub mod br_flow_join(clk:u1, rst:u1, push_valid:u16, pop_ready:u1) -> (push_ready:u16@[0], pop_valid:u1@[0]) {
  comptime const NUM_FLOWS = 16

  const join = br_flow_join_select_multihot<NUM_FLOWS=NUM_FLOWS,ALLOW_EMPTY_SELECT=false>(
    select_multihot=(1 << NUM_FLOWS) - 1
    ,push_valid=push_valid
    ,pop_ready=pop_ready == 1
  )
  push_ready = join.push_ready
  pop_valid  = u1(join.pop_valid_unstable)
}
