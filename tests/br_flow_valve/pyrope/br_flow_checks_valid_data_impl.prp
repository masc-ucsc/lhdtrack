const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_impl<NumFlows=16, Width=1, EnableCoverBackpressure=0, NumBackpressureCheckFlows=16, EnableAssertValidStability=0, EnableAssertDataStability=0, EnableAssertDataKnown=1, EnableAssertFinalNotValid=0, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U16, ready:U16, rst:U1, valid:U16) -> () {
  br_misc_unused::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 48) | (valid << 32) | (ready << 16) | data)
}
