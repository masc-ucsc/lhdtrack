// APB demux: decode the upstream address into a one-hot downstream select
// over 4 address windows, then steer request and response through it.
const br_apb_demux_select_onehot_t = import("br_apb_demux_select_onehot.br_apb_demux_select_onehot")
const br_demux_addr_decode_t = import("br_demux_addr_decode.br_demux_addr_decode")

pub mod br_apb_demux::[timecheck=false, synth.abc_pre="resyn2"](clk:U1, downstream_addr_base:U48, downstream_addr_size:U48, downstream_prdata:U128, downstream_pready:U4, downstream_pslverr:U4, rst:Reset, upstream_paddr:U12, upstream_penable:U1, upstream_pprot:U3, upstream_psel:U1, upstream_pstrb:U4, upstream_pwdata:U32, upstream_pwrite:U1) -> (downstream_paddr:U48@[], downstream_penable:U4@[], downstream_pprot:U12@[], downstream_psel:U4@[], downstream_pstrb:U16@[], downstream_pwdata:U128@[], downstream_pwrite:U4@[], upstream_prdata:U32@[], upstream_pready:U1@[], upstream_pslverr:U1@[]) {
  // The broadcast request address returns through the decoder's address translation.
  wire paddr_bcast:U48 = nil
  const br_demux_addr_decode = br_demux_addr_decode_t(addr_valid=upstream_psel, clk, rst=U1(rst), upstream_addr=upstream_paddr, downstream_addr_base, downstream_addr_size, downstream_addr_in=paddr_bcast)
  const br_apb_demux_select_onehot = br_apb_demux_select_onehot_t(select_onehot=br_demux_addr_decode.select_onehot, upstream_paddr, upstream_psel, upstream_penable, upstream_pprot, upstream_pstrb, upstream_pwrite, upstream_pwdata, downstream_prdata, downstream_pready, downstream_pslverr)
  upstream_prdata = br_apb_demux_select_onehot.upstream_prdata
  upstream_pready = br_apb_demux_select_onehot.upstream_pready
  upstream_pslverr = br_apb_demux_select_onehot.upstream_pslverr
  downstream_psel = br_apb_demux_select_onehot.downstream_psel
  downstream_penable = br_apb_demux_select_onehot.downstream_penable
  downstream_pprot = br_apb_demux_select_onehot.downstream_pprot
  downstream_pstrb = br_apb_demux_select_onehot.downstream_pstrb
  downstream_pwrite = br_apb_demux_select_onehot.downstream_pwrite
  downstream_pwdata = br_apb_demux_select_onehot.downstream_pwdata
  paddr_bcast = br_apb_demux_select_onehot.downstream_paddr
  downstream_paddr = br_demux_addr_decode.downstream_addr_out
}
