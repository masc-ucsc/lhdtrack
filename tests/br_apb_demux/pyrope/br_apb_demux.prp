const br_apb_demux_select_onehot = import("br_apb_demux_select_onehot.br_apb_demux_select_onehot")
const br_demux_addr_decode       = import("br_demux_addr_decode.br_demux_addr_decode")

// APB demux: one upstream APB requester, four downstream completers, each
// owning the 12-bit address window [base, base + size). Per-downstream buses
// are packed with downstream 0 in the low bits. clk and rst only fed the
// upstream assertions.
pub mod br_apb_demux(
  clk:u1,
  rst:u1,
  upstream_paddr:u12,
  upstream_psel:u1,
  upstream_penable:u1,
  upstream_pprot:u3,
  upstream_pstrb:u4,
  upstream_pwrite:u1,
  upstream_pwdata:u32,
  downstream_addr_base:u48,
  downstream_addr_size:u48,
  downstream_prdata:u128,
  downstream_pready:u4,
  downstream_pslverr:u4
) -> (
  upstream_prdata:u32@[0],
  upstream_pready:u1@[0],
  upstream_pslverr:u1@[0],
  downstream_paddr:u48@[0],
  downstream_psel:u4@[0],
  downstream_penable:u4@[0],
  downstream_pprot:u12@[0],
  downstream_pstrb:u16@[0],
  downstream_pwrite:u4@[0],
  downstream_pwdata:u128@[0]
) {
  comptime const ADDR_WIDTH      = upstream_paddr.[bits]
  comptime const NUM_DOWNSTREAMS = downstream_psel.[bits]

  const select_onehot = br_demux_addr_decode<ADDR_WIDTH=ADDR_WIDTH,NUM_DOWNSTREAMS=NUM_DOWNSTREAMS>(
    upstream_addr=upstream_paddr
    ,downstream_addr_base=downstream_addr_base
    ,downstream_addr_size=downstream_addr_size
  )
  const demux = br_apb_demux_select_onehot<NUM_DOWNSTREAMS=NUM_DOWNSTREAMS>(
    select_onehot=select_onehot
    ,psel=upstream_psel == 1
    ,penable=upstream_penable == 1
    ,req=(
      paddr   = upstream_paddr
      ,pprot  = upstream_pprot
      ,pstrb  = upstream_pstrb
      ,pwrite = upstream_pwrite == 1
      ,pwdata = upstream_pwdata
    )
    ,downstream_prdata=downstream_prdata
    ,downstream_pready=downstream_pready
    ,downstream_pslverr=downstream_pslverr
  )

  upstream_prdata    = demux.resp.rdata
  upstream_pready    = u1(demux.resp.ready)
  upstream_pslverr   = u1(demux.resp.slverr)
  downstream_paddr   = demux.downstream_paddr
  downstream_psel    = demux.downstream_psel
  downstream_penable = demux.downstream_penable
  downstream_pprot   = demux.downstream_pprot
  downstream_pstrb   = demux.downstream_pstrb
  downstream_pwrite  = demux.downstream_pwrite
  downstream_pwdata  = demux.downstream_pwdata
}
