const br_demux_addr_decode_t = import("br_demux_addr_decode.br_demux_addr_decode")
const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_apb_demux::[timecheck=false](clk:U1, downstream_addr_base:U48, downstream_addr_size:U48, downstream_prdata:U128, downstream_pready:U4, downstream_pslverr:U4, rst:Reset, upstream_paddr:U12, upstream_penable:U1, upstream_pprot:U3, upstream_psel:U1, upstream_pstrb:U4, upstream_pwdata:U32, upstream_pwrite:U1) -> (downstream_paddr:U48@[], downstream_penable:U4@[], downstream_pprot:U12@[], downstream_psel:U4@[], downstream_pstrb:U16@[], downstream_pwdata:U128@[], downstream_pwrite:U4@[], upstream_prdata:U32@[], upstream_pready:U1@[], upstream_pslverr:U1@[]) {
  wire downstream_paddr_unmasked:U48 = nil
  wire upstream_pready:U1 = nil
  mut _b2i_2 = if upstream_psel != 0 and (upstream_penable == 0 or upstream_pready == 0) { 1 } else { 0 }
  br_misc_unused::[name=br_misc_unused_upstream_request_pending](`in`=_b2i_2)
  mut br_demux_addr_decode = br_demux_addr_decode_t::[name=br_demux_addr_decode](clk=clk, rst=rst, addr_valid=upstream_psel, upstream_addr=upstream_paddr, downstream_addr_base=downstream_addr_base, downstream_addr_size=downstream_addr_size, downstream_addr_in=downstream_paddr_unmasked)
  mut br_apb_demux_select_onehot = br_apb_demux_select_onehot_t::[name=br_apb_demux_select_onehot](clk=clk, rst=rst, select_onehot=br_demux_addr_decode.select_onehot, upstream_paddr=upstream_paddr, upstream_psel=upstream_psel, upstream_penable=upstream_penable, upstream_pprot=upstream_pprot, upstream_pstrb=upstream_pstrb, upstream_pwrite=upstream_pwrite, upstream_pwdata=upstream_pwdata, downstream_prdata=downstream_prdata, `downstream_pready.e3`=(downstream_pready >> 3) & 1, `downstream_pready.e2`=(downstream_pready >> 2) & 1, `downstream_pready.e1`=(downstream_pready >> 1) & 1, `downstream_pready.e0`=downstream_pready & 1, `downstream_pslverr.e3`=(downstream_pslverr >> 3) & 1, `downstream_pslverr.e2`=(downstream_pslverr >> 2) & 1, `downstream_pslverr.e1`=(downstream_pslverr >> 1) & 1, `downstream_pslverr.e0`=downstream_pslverr & 1)
  upstream_pready = br_apb_demux_select_onehot.upstream_pready
