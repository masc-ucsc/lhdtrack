// APB request fields that every downstream receives unchanged.
pub type Apb_req = (paddr:u12, pprot:u3, pstrb:u4, pwrite:bool, pwdata:u32)

// Place `copies` copies of `value` side by side, each `width` bits wide.
comb replicate(value, width, copies) -> (out) {
  mut packed = 0
  for i in 0..<copies {
    packed |= value << (i*width)
  }
  out = packed
}

// Route one APB request to the downstream picked by select_onehot, and the
// selected downstream's response back upstream. A request that selects no
// downstream completes at once with a decode error (pslverr).
//
// Supported configuration: no retiming stages, decode error enabled.
pub mod br_apb_demux_select_onehot<NUM_DOWNSTREAMS=1>(
  select_onehot:unsigned(bits=NUM_DOWNSTREAMS),
  psel:bool,
  penable:bool,
  req:Apb_req,
  downstream_prdata:unsigned(bits=32 * NUM_DOWNSTREAMS),
  downstream_pready:unsigned(bits=NUM_DOWNSTREAMS),
  downstream_pslverr:unsigned(bits=NUM_DOWNSTREAMS)
) -> 
(
  // The selected downstream's (or the decode-error) response.
  resp:(rdata:u32, ready:bool, slverr:bool)@[0],
  downstream_paddr:unsigned(bits=12 * NUM_DOWNSTREAMS)@[0],
  downstream_psel:unsigned(bits=NUM_DOWNSTREAMS)@[0],
  downstream_penable:unsigned(bits=NUM_DOWNSTREAMS)@[0],
  downstream_pprot:unsigned(bits=3 * NUM_DOWNSTREAMS)@[0],
  downstream_pstrb:unsigned(bits=4 * NUM_DOWNSTREAMS)@[0],
  downstream_pwrite:unsigned(bits=NUM_DOWNSTREAMS)@[0],
  downstream_pwdata:unsigned(bits=32 * NUM_DOWNSTREAMS)@[0]
) {
  comptime const ALL = (1 << NUM_DOWNSTREAMS) - 1
  const valid        = if psel { select_onehot } else { 0 }

  downstream_psel    = valid
  downstream_penable = if penable { valid } else { 0 }
  downstream_paddr   = replicate(value=req.paddr, width=req.paddr.[bits], copies=NUM_DOWNSTREAMS)
  downstream_pprot   = replicate(value=req.pprot, width=req.pprot.[bits], copies=NUM_DOWNSTREAMS)
  downstream_pstrb   = replicate(value=req.pstrb, width=req.pstrb.[bits], copies=NUM_DOWNSTREAMS)
  downstream_pwrite  = if req.pwrite { ALL } else { 0 }
  downstream_pwdata  = replicate(value=req.pwdata, width=req.pwdata.[bits], copies=NUM_DOWNSTREAMS)

  // One-hot response mux: OR together the responses of the valid downstreams.
  mut rdata:u32 = 0
  mut ready     = false
  mut slverr    = false
  for i in 0..<NUM_DOWNSTREAMS {
    if valid#[i] == 1 {
      rdata |= downstream_prdata#[(i*32)..+32]
      ready  = ready or downstream_pready#[i] == 1
      slverr = slverr or downstream_pslverr#[i] == 1
    }
  }
  const decode_miss = psel and select_onehot == 0

  // A transfer completes only in its access phase.
  const access = psel and penable
  resp         = (rdata=rdata, ready=access and (ready or decode_miss), slverr=access and (slverr or decode_miss))
}
