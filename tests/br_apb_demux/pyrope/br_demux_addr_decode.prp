// Address decoder: select the downstream whose [base, base + size) window
// holds the upstream address. A zero-size window is disabled. Windows are
// packed per downstream, ADDR_WIDTH bits each (downstream 0 in the low bits).
//
// Supported configuration: no default downstream, all-ones address masks, no
// address normalization (so each downstream address is the upstream one).
pub mod br_demux_addr_decode<ADDR_WIDTH=1, NUM_DOWNSTREAMS=1>(
  upstream_addr:unsigned(bits=ADDR_WIDTH),
  downstream_addr_base:unsigned(bits=ADDR_WIDTH * NUM_DOWNSTREAMS),
  downstream_addr_size:unsigned(bits=ADDR_WIDTH * NUM_DOWNSTREAMS)
) -> (select_onehot:unsigned(bits=NUM_DOWNSTREAMS)@[0]) {
  mut select:unsigned(bits=NUM_DOWNSTREAMS) = 0
  for i in 0..<NUM_DOWNSTREAMS {
    const base = downstream_addr_base#[(i*ADDR_WIDTH)..+ADDR_WIDTH]
    const size = downstream_addr_size#[(i*ADDR_WIDTH)..+ADDR_WIDTH]
    // The last address of the window, wrapping at ADDR_WIDTH bits.
    mut limit:unsigned(bits=ADDR_WIDTH) = 0
    wrap limit = base + size - 1
    select#[i] = u1(size != 0 and upstream_addr >= base and upstream_addr <= limit)
  }
  select_onehot = select
}
