const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_impl<NumFlows=4, Width=32, EnableCoverBackpressure=1, NumBackpressureCheckFlows=4, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U128, ready:U4, rst:U1, valid:U4) -> () {
  br_misc_unused::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 136) | (valid << 132) | (ready << 128) | data)
}
