const br_credit_counter_t = import("br_credit_counter.br_credit_counter")

pub mod br_credit_receiver<NumFlows=1, Width=0x40, MaxCredit=32, RegisterPushOutputs=1, PushCreditMaxChange=1, PopCreditMaxChange=32, EnableCoverCreditWithhold=1, EnableCoverPushSenderInReset=1, EnableCoverPushCreditStall=1, CoverMaxCredit=32, EnableAssertFinalNotValid=1, EnableAssertFinalMinValue=1>::[timecheck=false](clk:Clock, credit_initial:U6, credit_withhold:U6, pop_credit:U6, push_credit_stall:U1, push_data:U64, push_sender_in_reset:U1, push_valid:U1, rst:U1) -> (credit_available:U6@[], credit_count:U6@[], pop_data:U64@[], pop_valid:U1@[], push_credit:U1@[], push_receiver_in_reset:U1@[]) {
  reg push_receiver_in_reset:U1:[async=false, initial=1, reset_pin=rst]
  reg push_credit:U1:[async=false, initial=0, reset_pin=rst]
  mut _b2i_1 = if rst != 0 or push_sender_in_reset != 0 { 1 } else { 0 }
  const either_rst = _b2i_1
  const credit_decr_valid = U1(push_credit_stall == 0)
  mut _b2i_4 = if either_rst == 0 { 1 } else { 0 }
  if not (rst != 0) {
    push_receiver_in_reset = 0
  }
  mut br_credit_counter = br_credit_counter_t::[name=br_credit_counter](clk=clk, rst=either_rst, incr_valid=U1(pop_credit != 0), incr=pop_credit, decr_valid=credit_decr_valid, decr=1, initial_value=credit_initial, withhold=credit_withhold)
  mut _b2i_5 = if credit_decr_valid != 0 and br_credit_counter.decr_ready != 0 and either_rst == 0 { 1 } else { 0 }
  if not (rst != 0) {
    push_credit = _b2i_5
  }
  pop_valid = push_valid & (_b2i_4 & 1) & 1
  pop_data = push_data
  credit_count = br_credit_counter.value
  credit_available = br_credit_counter.available
}
