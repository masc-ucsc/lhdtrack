const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")

// Staging buffer between a RAM read port with one cycle of latency and a
// registered pop interface. It prefetches reads while the FIFO holds entries
// that are not yet staged, and absorbs a returning read in a one-entry skid
// buffer when the output register cannot take it.
// Configuration implemented: no bypass, two staged entries (skid entry plus
// output register), ram_rd_addr always ready.
pub mod br_fifo_staging_buffer<WIDTH=1, COUNT_WIDTH=2>(
  clk:u1,
  rst:u1,
  total_items:unsigned(bits=COUNT_WIDTH),
  ram_rd_data_valid:bool,
  ram_rd_data:unsigned(bits=WIDTH),
  pop_ready:bool
) -> (ram_rd_addr_valid:bool@[], pop_valid:bool@[], pop_data:unsigned(bits=WIDTH)@[]) {
  comptime const BUFFER_DEPTH = 2

  wire out_ready:bool = nil
  wire out_valid:bool = nil
  const pop_beat      = out_valid and pop_ready

  // Entries read (or being read) from the RAM and not yet popped.
  reg staged_items:u2:[reset_pin = ref rst] = 0
  const space_available = staged_items < BUFFER_DEPTH or pop_beat
  const read_beat = space_available and staged_items < total_items
  if read_beat or pop_beat {
    wrap staged_items = staged_items + u1(read_beat) - u1(pop_beat)
  }

  // Skid entry: holds returned read data the output register cannot take.
  reg skid_valid:bool:[reset_pin = ref rst]                = false
  reg skid_data:unsigned(bits=WIDTH):[reset_pin = ref rst] = 0
  const skid_valid_next = if skid_valid { ram_rd_data_valid or not out_ready } else { ram_rd_data_valid and not out_ready }
  skid_valid = skid_valid_next
  if skid_valid_next and (not skid_valid or out_ready) {
    skid_data = ram_rd_data
  }

  const out = br_flow_reg_fwd<WIDTH=WIDTH>(
    clk=clk, rst=rst, push_valid=skid_valid or ram_rd_data_valid, push_data=if skid_valid { skid_data } else { ram_rd_data }, pop_ready=pop_ready
  )
  out_ready = out.push_ready
  out_valid = out.pop_valid

  ram_rd_addr_valid = read_beat
  pop_valid         = out.pop_valid
  pop_data          = out.pop_data
}
