const br_cdc_fifo_push_flag_mgr = import("br_cdc_fifo_push_flag_mgr.br_cdc_fifo_push_flag_mgr")

// Push side of a CDC FIFO controller: accepts data while not full and writes
// it to consecutive RAM entries. Every flop is in the clk (push) domain.
// timecheck=false: works around a false combinational-loop report through the
// registered flag-manager child (LiveHD bug).
pub mod br_cdc_fifo_push_ctrl<DEPTH=2, WIDTH=1, ADDR_WIDTH=1, COUNT_WIDTH=2, PUSH_COUNT_DELAY=2>::[timecheck = false](
  clk:u1,
  rst:u1,
  push_valid:bool,
  push_data:unsigned(bits=WIDTH),
  pop_count_gray:unsigned(bits=COUNT_WIDTH),
  reset_active_pop:bool
) -> (
  push_ready:bool@[],
  full:bool@[],
  slots:unsigned(bits=COUNT_WIDTH)@[],
  ram_wr_valid:bool@[],
  ram_wr_addr:unsigned(bits=ADDR_WIDTH)@[],
  ram_wr_data:unsigned(bits=WIDTH)@[],
  push_count_gray:unsigned(bits=COUNT_WIDTH)@[],
  reset_active_push:bool@[]
) {
  wire push_beat:bool = nil
  const flags         = br_cdc_fifo_push_flag_mgr<DEPTH=DEPTH,COUNT_WIDTH=COUNT_WIDTH,PUSH_COUNT_DELAY=PUSH_COUNT_DELAY>(
    clk=clk, rst=rst, push_beat=push_beat, pop_count_gray=pop_count_gray, reset_active_pop=reset_active_pop
  )
  push_beat = push_valid and not flags.full

  // Write address walks the RAM entries 0..DEPTH-1 and wraps.
  reg wr_addr:unsigned(bits=ADDR_WIDTH):[reset_pin = ref rst] = 0
  if push_beat {
    wrap wr_addr = if wr_addr == DEPTH - 1 { 0 } else { wr_addr + 1 }
  }

  push_ready        = not flags.full
  full              = flags.full
  slots             = flags.slots
  ram_wr_valid      = push_beat
  ram_wr_addr       = wr_addr
  ram_wr_data       = push_data
  push_count_gray   = flags.push_count_gray
  reset_active_push = flags.reset_active_push
}
