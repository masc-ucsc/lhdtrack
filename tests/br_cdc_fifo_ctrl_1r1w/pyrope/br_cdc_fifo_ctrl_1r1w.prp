const br_cdc_fifo_ctrl_pop_1r1w  = import("br_cdc_fifo_ctrl_pop_1r1w.br_cdc_fifo_ctrl_pop_1r1w")
const br_cdc_fifo_ctrl_push_1r1w = import("br_cdc_fifo_ctrl_push_1r1w.br_cdc_fifo_ctrl_push_1r1w")

// Clock-domain-crossing FIFO controller for an external 1R1W RAM: 32 entries
// of 64 bits. The halves exchange Gray-coded push/pop counts and reset status.
pub mod br_cdc_fifo_ctrl_1r1w(
  push_clk:u1,
  push_rst:u1,
  push_valid:u1,
  push_data:u64,
  pop_clk:u1,
  pop_rst:u1,
  pop_ready:u1,
  pop_ram_rd_data_valid:u1,
  pop_ram_rd_data:u64
) -> (
  push_ready:u1@[],
  push_full:u1@[],
  push_slots:u6@[],
  push_ram_wr_valid:u1@[],
  push_ram_wr_addr:u5@[],
  push_ram_wr_data:u64@[],
  pop_valid:u1@[],
  pop_data:u64@[],
  pop_empty:u1@[],
  pop_items:u6@[],
  pop_ram_rd_addr_valid:u1@[],
  pop_ram_rd_addr:u5@[]
) {
  comptime const DEPTH           = 32
  comptime const WIDTH           = push_data.[bits]
  comptime const COUNT_WIDTH     = push_slots.[bits]
  comptime const NUM_SYNC_STAGES = 3

  wire pop_pop_count_gray:unsigned(bits=COUNT_WIDTH) = nil
  wire pop_reset_active_pop:bool = nil

  const push = br_cdc_fifo_ctrl_push_1r1w<DEPTH=DEPTH,WIDTH=WIDTH,COUNT_WIDTH=COUNT_WIDTH,NUM_SYNC_STAGES=NUM_SYNC_STAGES,PUSH_COUNT_DELAY=2>(
    push_clk=push_clk, push_rst=push_rst, push_valid=push_valid == 1, push_data=push_data, pop_reset_active_pop=pop_reset_active_pop,
    pop_pop_count_gray=pop_pop_count_gray
  )
  const pop = br_cdc_fifo_ctrl_pop_1r1w<DEPTH=DEPTH,WIDTH=WIDTH,COUNT_WIDTH=COUNT_WIDTH,NUM_SYNC_STAGES=NUM_SYNC_STAGES,POP_COUNT_DELAY=2>(
    push_push_count_gray=push.push_push_count_gray, push_reset_active_push=push.push_reset_active_push, pop_clk=pop_clk, pop_rst=pop_rst,
    pop_ready=pop_ready == 1, pop_ram_rd_data_valid=pop_ram_rd_data_valid == 1, pop_ram_rd_data=pop_ram_rd_data
  )
  pop_pop_count_gray   = pop.pop_pop_count_gray
  pop_reset_active_pop = pop.pop_reset_active_pop

  push_ready            = u1(push.push_ready)
  push_full             = u1(push.push_full)
  push_slots            = push.push_slots
  push_ram_wr_valid     = u1(push.push_ram_wr_valid)
  push_ram_wr_addr      = push.push_ram_wr_addr
  push_ram_wr_data      = push.push_ram_wr_data
  pop_valid             = u1(pop.pop_valid)
  pop_data              = pop.pop_data
  pop_empty             = u1(pop.pop_empty)
  pop_items             = pop.pop_items
  pop_ram_rd_addr_valid = u1(pop.pop_ram_rd_addr_valid)
  pop_ram_rd_addr       = pop.pop_ram_rd_addr
}
