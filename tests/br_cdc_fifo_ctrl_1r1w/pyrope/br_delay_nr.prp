// Delay a WIDTH-bit value by NUM_STAGES cycles through flops without reset.
// stages holds the pipeline, newest value in the low WIDTH bits; all flops
// are clocked by clk (the implicit clock binds to an input named clk).
pub mod br_delay_nr<WIDTH=1, NUM_STAGES=1>(clk:u1, `in`:unsigned(bits=WIDTH)) -> (out:unsigned(bits=WIDTH)@[]) {
  cassert(NUM_STAGES >= 1)

  reg stages:unsigned(bits=WIDTH * NUM_STAGES) = nil
  wrap stages = (stages << WIDTH) | `in`
  // Shift, not a bit slice: a one-bit slice at bit 0 does not lower (LiveHD bug).
  out = stages >> (WIDTH*(NUM_STAGES - 1))
}
