const br_counter_incr = import("br_counter_incr.br_counter_incr")
const br_delay_nr = import("br_delay_nr.br_delay_nr")
const br_delay_nr_p1 = import("br_delay_nr_p1.br_delay_nr_p1")
const br_enc_bin2gray = import("br_enc_bin2gray.br_enc_bin2gray")
const br_enc_gray2bin = import("br_enc_gray2bin.br_enc_gray2bin")
pub mod br_cdc_fifo_pop_flag_mgr<Depth=32, RegisterResetActive=1, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, pop_beat:U1, push_count_gray:U6, reset_active_push:U1, rst:U1) -> (empty:U1@[], items:U6@[], pop_count_gray:U6@[], reset_active_pop:U1@[]) {
  reg push_count_saved:U6:[async=false, initial=0, reset_pin=rst]
  reset_active_pop = 0ub?
  mut br_counter_incr_pop_count = br_counter_incr::[name=br_counter_incr_pop_count](clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=pop_beat, incr=1)
  mut br_enc_gray2bin_inst = br_enc_gray2bin::[name=br_enc_gray2bin_inst](gray=push_count_gray)
  const push_count = (br_enc_gray2bin_inst.bin.e5 << 5) | (br_enc_gray2bin_inst.bin.e4 << 4) | (br_enc_gray2bin_inst.bin.e3 << 3) | (br_enc_gray2bin_inst.bin.e2 << 2) | (br_enc_gray2bin_inst.bin.e1 << 1) | br_enc_gray2bin_inst.bin.e0
  mut br_enc_bin2gray_inst = br_enc_bin2gray::[name=br_enc_bin2gray_inst](bin=br_counter_incr_pop_count.value_next)
  mut br_delay_nr_reset_active_pop = br_delay_nr::[name=br_delay_nr_reset_active_pop](clk=clk, `in`=rst)
  mut br_delay_nr_pop_count_gray = br_delay_nr_p1::[name=br_delay_nr_pop_count_gray](clk=clk, `in`=br_enc_bin2gray_inst)
  mut _mux_1:U6 = if reset_active_push != 0 { push_count_saved } else { push_count#[0..=5] }
  const pop_count_ext = br_counter_incr_pop_count.value#[0..=5]
  const push_count_visible_ext = _mux_1
  mut _mux_2:U7 = if push_count_visible_ext >= pop_count_ext { (push_count_visible_ext - pop_count_ext)#[0..=6] }
    else { ((push_count_visible_ext + 0x40)#[0..=6] - pop_count_ext)#[0..=6] }
  const items_ext = _mux_2
  mut _mux_3:U6 = if rst != 0 { 0 } else { items_ext#[0..=5] }
  const items__w1 = _mux_3
  mut _b2i_4 = if items__w1 == 0 { 1 } else { 0 }
  if not (rst != 0) {
    if reset_active_push == 0 {
      push_count_saved = push_count
    }
  }
  pop_count_gray = br_delay_nr_pop_count_gray.out
  items = items__w1
  empty = _b2i_4
  reset_active_pop = br_delay_nr_reset_active_pop.out
}
