const br_delay_nr     = import("br_delay_nr.br_delay_nr")
const br_enc_bin2gray = import("br_enc_bin2gray.br_enc_bin2gray")
const br_enc_gray2bin = import("br_enc_gray2bin.br_enc_gray2bin")

// Pop-side occupancy of a CDC FIFO. Push and pop counts wrap at
// 2^COUNT_WIDTH and cross domains Gray-coded; items = push - pop.
pub mod br_cdc_fifo_pop_flag_mgr<COUNT_WIDTH=2, POP_COUNT_DELAY=2>(
  clk:u1,
  rst:u1,
  pop_beat:bool,
  push_count_gray:unsigned(bits=COUNT_WIDTH),
  reset_active_push:bool
) -> (pop_count_gray:unsigned(bits=COUNT_WIDTH)@[], items:unsigned(bits=COUNT_WIDTH)@[], empty:bool@[], reset_active_pop:bool@[]) {
  reg pop_count:unsigned(bits=COUNT_WIDTH):[reset_pin = ref rst] = 0
  wrap const pop_count_next:unsigned(bits=COUNT_WIDTH) = pop_count + u1(pop_beat)
  if pop_beat {
    pop_count = pop_count_next
  }

  const next_gray   = br_enc_bin2gray<WIDTH=COUNT_WIDTH>(bin=pop_count_next)
  const count_delay = br_delay_nr<WIDTH=COUNT_WIDTH,NUM_STAGES=POP_COUNT_DELAY>(clk=clk, `in`=next_gray.gray)
  pop_count_gray    = count_delay.out
  const reset_delay = br_delay_nr<WIDTH=1,NUM_STAGES=1>(clk=clk, `in`=rst)
  reset_active_pop  = reset_delay.out == 1

  // While the push side is in reset its count is meaningless: use the last
  // one seen before the reset.
  const push_decoded = br_enc_gray2bin<WIDTH=COUNT_WIDTH>(gray=push_count_gray)
  const push_count = push_decoded.bin
  reg push_count_saved:unsigned(bits=COUNT_WIDTH):[reset_pin = ref rst] = 0
  if not reset_active_push {
    push_count_saved = push_count
  }
  const push_count_visible = if reset_active_push { push_count_saved } else { push_count }

  wrap const count:unsigned(bits=COUNT_WIDTH) = push_count_visible - pop_count
  const current = if rst == 1 { 0 } else { count }
  items = current
  empty = current == 0
}
