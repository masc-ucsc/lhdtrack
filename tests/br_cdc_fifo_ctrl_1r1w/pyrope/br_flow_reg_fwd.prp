// Valid/ready pipeline register that breaks the forward (valid and data)
// path. It accepts a new beat whenever it is empty or being drained.
pub mod br_flow_reg_fwd<WIDTH=1>(clk:u1, rst:u1, push_valid:bool, push_data:unsigned(bits=WIDTH), pop_ready:bool) -> (
  push_ready:bool@[],
  pop_valid:bool@[],
  pop_data:unsigned(bits=WIDTH)@[]
) {
  reg valid:bool:[reset_pin = ref rst] = false
  reg data:unsigned(bits=WIDTH)        = nil

  const ready = pop_ready or not valid
  valid       = push_valid or not ready
  if ready and push_valid {
    data = push_data
  }

  push_ready = ready
  pop_valid  = valid
  pop_data   = data
}
