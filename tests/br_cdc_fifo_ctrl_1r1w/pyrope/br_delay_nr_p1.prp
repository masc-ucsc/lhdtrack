pub mod br_delay_nr_p1<Width=6, NumStages=2>::[timecheck=false](clk:Clock, `in`:U6) -> (out:U6@[], out_stages:U18@[]) {
  reg stages___q:U18
  mut stages__composite:U18 = 0
  wire stages:U18 = nil
  stages__composite = stages___q
  mut stages__composite__w1 = stages__composite
  stages__composite__w1#[0..=5] = `in`
  stages___q#[6..=11] = stages#[0..=5]
  stages___q#[12..=17] = stages#[6..=11]
  const out__w1 = (stages >> (NumStages*6))#[0..=5]
  const out_stages__w1 = stages
  stages = stages__composite__w1
  out = out__w1
  out_stages = out_stages__w1
}
