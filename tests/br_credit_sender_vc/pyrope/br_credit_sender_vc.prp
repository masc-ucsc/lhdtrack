const br_credit_counter = import("br_credit_counter.br_credit_counter")
const br_delay_nr = import("br_delay_nr.br_delay_nr")
const br_delay_valid = import("br_delay_valid.br_delay_valid")
const br_enc_onehot2bin = import("br_enc_onehot2bin.br_enc_onehot2bin")
const br_flow_fork = import("br_flow_fork.br_flow_fork")
const br_flow_mux_core = import("br_flow_mux_core.br_flow_mux_core")

pub mod br_credit_sender_vc::[timecheck=false](can_grant:U4, clk:Clock, credit_initial:U20, credit_withhold:U20, grant:U4, pop_credit:U12, pop_receiver_in_reset:U1, push_data:U256, push_valid:U4, rst:U1) -> (credit_available:U20@[], credit_count:U20@[], enable_priority_update:U1@[], pop_data:U64@[], pop_sender_in_reset:U1@[], pop_valid:U1@[], pop_vc:U2@[], push_ready:U4@[], request:U4@[]) {
  wire push_ready_bits:U4 = nil
  wire push_ready:U4 = nil
  wire credit_count_bits:U20 = nil
  wire credit_count:U20 = nil
  wire credit_available_bits:U20 = nil
  wire credit_available:U20 = nil
  wire mux_push_valid_bits:U4 = nil
  wire mux_push_valid:U4 = nil
  wire credit_decr_ready_bits:U4 = nil
  wire credit_decr_valid_bits:U4 = nil
  wire credit_decr_bits:U12 = nil
  wire credit_incr_valid_bits:U4 = nil
  wire credit_incr_bits:U12 = nil
  mut _b2i_1 = if rst != 0 or pop_receiver_in_reset != 0 { 1 } else { 0 }
  const either_rst = _b2i_1
  credit_incr_valid_bits#[0] = U1(pop_credit#[0..=2] != 0) & 1
  credit_incr_bits#[0..<3] = pop_credit#[0..=2]#[0..<3]
  credit_decr_bits#[0] = 1
  credit_decr_bits#[1] = 0
  credit_decr_bits#[2] = 0
  credit_decr_ready_bits#[0] = U1(((credit_available_bits#[4] << 4) | (credit_available_bits#[3] << 3) | (credit_available_bits#[2] << 2) | (credit_available_bits#[1] << 1) | credit_available_bits#[0]) > 0) & 1
  mut gen_credit_counters_0_br_credit_counter = br_credit_counter::[name=gen_credit_counters_0_br_credit_counter](clk=clk, rst=either_rst, incr_valid=credit_incr_valid_bits#[0] & 1, incr=(credit_incr_bits#[2] << 2) | (credit_incr_bits#[1] << 1) | credit_incr_bits#[0], decr_valid=credit_decr_valid_bits#[0] & 1, decr=(credit_decr_bits#[2] << 2) | (credit_decr_bits#[1] << 1) | credit_decr_bits#[0], initial_value=credit_initial#[0..=4], withhold=credit_withhold#[0..=4])
  credit_count_bits#[0..<5] = gen_credit_counters_0_br_credit_counter.value#[0..<5]
  credit_available_bits#[0..<5] = gen_credit_counters_0_br_credit_counter.available#[0..<5]
  credit_incr_valid_bits#[1] = U1(pop_credit#[3..=5] != 0) & 1
  credit_incr_bits#[3..<6] = pop_credit#[3..=5]#[0..<3]
  credit_decr_bits#[3] = 1
  credit_decr_bits#[4] = 0
  credit_decr_bits#[5] = 0
  credit_decr_ready_bits#[1] = U1(((credit_available_bits#[9] << 4) | (credit_available_bits#[8] << 3) | (credit_available_bits#[7] << 2) | (credit_available_bits#[6] << 1) | credit_available_bits#[5]) > 0) & 1
  mut gen_credit_counters_1_br_credit_counter = br_credit_counter::[name=gen_credit_counters_1_br_credit_counter](clk=clk, rst=either_rst, incr_valid=credit_incr_valid_bits#[1] & 1, incr=(credit_incr_bits#[5] << 2) | (credit_incr_bits#[4] << 1) | credit_incr_bits#[3], decr_valid=credit_decr_valid_bits#[1] & 1, decr=(credit_decr_bits#[5] << 2) | (credit_decr_bits#[4] << 1) | credit_decr_bits#[3], initial_value=credit_initial#[5..=9], withhold=credit_withhold#[5..=9])
  credit_count_bits#[5..<10] = gen_credit_counters_1_br_credit_counter.value#[0..<5]
  credit_available_bits#[5..<10] = gen_credit_counters_1_br_credit_counter.available#[0..<5]
  credit_incr_valid_bits#[2] = U1(pop_credit#[6..=8] != 0) & 1
  credit_incr_bits#[6..<9] = pop_credit#[6..=8]#[0..<3]
  credit_decr_bits#[6] = 1
  credit_decr_bits#[7] = 0
  credit_decr_bits#[8] = 0
  credit_decr_ready_bits#[2] = U1(((credit_available_bits#[14] << 4) | (credit_available_bits#[13] << 3) | (credit_available_bits#[12] << 2) | (credit_available_bits#[11] << 1) | credit_available_bits#[10]) > 0) & 1
  mut gen_credit_counters_2_br_credit_counter = br_credit_counter::[name=gen_credit_counters_2_br_credit_counter](clk=clk, rst=either_rst, incr_valid=credit_incr_valid_bits#[2] & 1, incr=(credit_incr_bits#[8] << 2) | (credit_incr_bits#[7] << 1) | credit_incr_bits#[6], decr_valid=credit_decr_valid_bits#[2] & 1, decr=(credit_decr_bits#[8] << 2) | (credit_decr_bits#[7] << 1) | credit_decr_bits#[6], initial_value=credit_initial#[10..=14], withhold=credit_withhold#[10..=14])
  credit_count_bits#[10..<15] = gen_credit_counters_2_br_credit_counter.value#[0..<5]
  credit_available_bits#[10..<15] = gen_credit_counters_2_br_credit_counter.available#[0..<5]
  credit_incr_valid_bits#[3] = U1(pop_credit#[9..=11] != 0) & 1
  credit_incr_bits#[9..<12] = pop_credit#[9..=11]#[0..<3]
  credit_decr_bits#[9] = 1
  credit_decr_bits#[10] = 0
  credit_decr_bits#[11] = 0
  credit_decr_ready_bits#[3] = U1(((credit_available_bits#[19] << 4) | (credit_available_bits#[18] << 3) | (credit_available_bits#[17] << 2) | (credit_available_bits#[16] << 1) | credit_available_bits#[15]) > 0) & 1
  mut gen_credit_counters_3_br_credit_counter = br_credit_counter::[name=gen_credit_counters_3_br_credit_counter](clk=clk, rst=either_rst, incr_valid=credit_incr_valid_bits#[3] & 1, incr=(credit_incr_bits#[11] << 2) | (credit_incr_bits#[10] << 1) | credit_incr_bits#[9], decr_valid=credit_decr_valid_bits#[3] & 1, decr=(credit_decr_bits#[11] << 2) | (credit_decr_bits#[10] << 1) | credit_decr_bits#[9], initial_value=credit_initial#[15..=19], withhold=credit_withhold#[15..=19])
  credit_count_bits#[15..<20] = gen_credit_counters_3_br_credit_counter.value#[0..<5]
  credit_available_bits#[15..<20] = gen_credit_counters_3_br_credit_counter.available#[0..<5]
  mut br_flow_mux_core_push = br_flow_mux_core::[name=br_flow_mux_core_push](clk=clk, rst=rst, can_grant=can_grant, grant=grant, push_valid=mux_push_valid, push_data=push_data, pop_ready=1)
  mut br_enc_onehot2bin_pop_vc = br_enc_onehot2bin::[name=br_enc_onehot2bin_pop_vc](clk=clk, rst=rst, `in`=grant)
  mut br_delay_valid_pop = br_delay_valid::[name=br_delay_valid_pop](clk=clk, rst=rst, in_valid=br_flow_mux_core_push.pop_valid_unstable, `in`=(br_flow_mux_core_push.pop_data_unstable#[0..=63] << 2) | br_enc_onehot2bin_pop_vc.out#[0..=1])
  mut br_delay_nr_pop_sender_in_reset = br_delay_nr::[name=br_delay_nr_pop_sender_in_reset](clk=clk, `in`=rst)
  mut gen_credit_counters_0_br_flow_fork_push = br_flow_fork::[name=gen_credit_counters_0_br_flow_fork_push](clk=clk, rst=rst, push_valid=push_valid & 1, pop_ready=((credit_decr_ready_bits#[0] & 1) << 1) | (br_flow_mux_core_push.push_ready & 1))
  push_ready_bits#[0] = gen_credit_counters_0_br_flow_fork_push.push_ready & 1
  mux_push_valid_bits#[0] = gen_credit_counters_0_br_flow_fork_push.pop_valid_unstable & 1
  credit_decr_valid_bits#[0] = (gen_credit_counters_0_br_flow_fork_push.pop_valid_unstable >> 1) & 1
  mut gen_credit_counters_1_br_flow_fork_push = br_flow_fork::[name=gen_credit_counters_1_br_flow_fork_push](clk=clk, rst=rst, push_valid=(push_valid >> 1) & 1, pop_ready=((credit_decr_ready_bits#[1] & 1) << 1) | ((br_flow_mux_core_push.push_ready >> 1) & 1))
  push_ready_bits#[1] = gen_credit_counters_1_br_flow_fork_push.push_ready & 1
  mux_push_valid_bits#[1] = gen_credit_counters_1_br_flow_fork_push.pop_valid_unstable & 1
  credit_decr_valid_bits#[1] = (gen_credit_counters_1_br_flow_fork_push.pop_valid_unstable >> 1) & 1
  mut gen_credit_counters_2_br_flow_fork_push = br_flow_fork::[name=gen_credit_counters_2_br_flow_fork_push](clk=clk, rst=rst, push_valid=(push_valid >> 2) & 1, pop_ready=((credit_decr_ready_bits#[2] & 1) << 1) | ((br_flow_mux_core_push.push_ready >> 2) & 1))
  push_ready_bits#[2] = gen_credit_counters_2_br_flow_fork_push.push_ready & 1
  mux_push_valid_bits#[2] = gen_credit_counters_2_br_flow_fork_push.pop_valid_unstable & 1
  credit_decr_valid_bits#[2] = (gen_credit_counters_2_br_flow_fork_push.pop_valid_unstable >> 1) & 1
  mut gen_credit_counters_3_br_flow_fork_push = br_flow_fork::[name=gen_credit_counters_3_br_flow_fork_push](clk=clk, rst=rst, push_valid=(push_valid >> 3) & 1, pop_ready=((credit_decr_ready_bits#[3] & 1) << 1) | ((br_flow_mux_core_push.push_ready >> 3) & 1))
  push_ready_bits#[3] = gen_credit_counters_3_br_flow_fork_push.push_ready & 1
  mux_push_valid_bits#[3] = gen_credit_counters_3_br_flow_fork_push.pop_valid_unstable & 1
  credit_decr_valid_bits#[3] = (gen_credit_counters_3_br_flow_fork_push.pop_valid_unstable >> 1) & 1
  push_ready = push_ready_bits
  credit_count = credit_count_bits
  credit_available = credit_available_bits
  mux_push_valid = mux_push_valid_bits
  request = br_flow_mux_core_push.request
  enable_priority_update = br_flow_mux_core_push.enable_priority_update
  pop_sender_in_reset = br_delay_nr_pop_sender_in_reset.out
  pop_valid = br_delay_valid_pop.out_valid
  pop_data = (br_delay_valid_pop.out >> 2)#[0..=63]
  pop_vc = br_delay_valid_pop.out#[0..=1]
}
