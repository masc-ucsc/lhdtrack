pub comb br_enc_onehot2bin::[timecheck=false](clk:u1, rst:u1, `in`:u4) -> (out_valid:u1, out:u2) {
  out = 0sb?
  out = if ((`in` >> 1) & 1) != 0 { 1 } else { 0 }
  if ((`in` >> 2) & 1) != 0 {
    out = out | 2
  }
  if ((`in` >> 3) & 1) != 0 {
    out = out | 3
  }
  out_valid = unsigned(`in` != 0)
}
