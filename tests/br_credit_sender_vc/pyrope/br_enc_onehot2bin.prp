pub mod br_enc_onehot2bin<NumValues=4, BinWidth=2>::[timecheck=false](clk:Clock, `in`:U4, rst:Reset) -> (out:U2@[], out_valid:U1@[]) {
  out = 0sb?
  out = if ((`in` >> 1) & 1) != 0 { 1 } else { 0 }
  if ((`in` >> 2) & 1) != 0 {
    out = out | 2
  }
  if ((`in` >> 3) & 1) != 0 {
    out = out | 3
  }
  out_valid = U1(`in` != 0)
}
