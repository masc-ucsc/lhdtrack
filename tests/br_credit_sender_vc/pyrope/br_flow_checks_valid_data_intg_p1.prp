const br_misc_unused_p3 = import("br_misc_unused_p3.br_misc_unused_p3")

pub mod br_flow_checks_valid_data_intg_p1<NumFlows=4, Width=0x40, EnableCoverBackpressure=1, EnableAssertValidStability=0, EnableAssertDataStability=0, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U256, ready:U4, rst:U1, valid:U4) -> () {
  br_misc_unused_p3::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 264) | (valid << 260) | (ready << 256) | data)
}
