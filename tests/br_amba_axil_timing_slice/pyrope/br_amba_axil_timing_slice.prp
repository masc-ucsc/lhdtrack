const br_flow_reg_both = import("br_flow_reg_both.br_flow_reg_both")
const br_flow_reg_both_p1 = import("br_flow_reg_both_p1.br_flow_reg_both_p1")
const br_flow_reg_both_p2 = import("br_flow_reg_both_p2.br_flow_reg_both_p2")
const br_flow_reg_both_p3 = import("br_flow_reg_both_p3.br_flow_reg_both_p3")

pub mod br_amba_axil_timing_slice::[timecheck=false](clk:Clock, init_arready:U1, init_awready:U1, init_bresp:U2, init_buser:U1, init_bvalid:U1, init_rdata:U32, init_rresp:U2, init_ruser:U1, init_rvalid:U1, init_wready:U1, rst:Reset, target_araddr:U32, target_arprot:U3, target_aruser:U1, target_arvalid:U1, target_awaddr:U32, target_awprot:U3, target_awuser:U1, target_awvalid:U1, target_bready:U1, target_rready:U1, target_wdata:U32, target_wstrb:U4, target_wuser:U1, target_wvalid:U1) -> (init_araddr:U32@[], init_arprot:U3@[], init_aruser:U1@[], init_arvalid:U1@[], init_awaddr:U32@[], init_awprot:U3@[], init_awuser:U1@[], init_awvalid:U1@[], init_bready:U1@[], init_rready:U1@[], init_wdata:U32@[], init_wstrb:U4@[], init_wuser:U1@[], init_wvalid:U1@[], target_arready:U1@[], target_awready:U1@[], target_bresp:U2@[], target_buser:U1@[], target_bvalid:U1@[], target_rdata:U32@[], target_rresp:U2@[], target_ruser:U1@[], target_rvalid:U1@[], target_wready:U1@[]) {
  mut br_flow_reg_both_aw_slice = br_flow_reg_both::[name=br_flow_reg_both_aw_slice](clk=clk, rst=rst, push_valid=target_awvalid, push_data=(target_awaddr << 4) | (target_awprot << 1) | (target_awuser & 1), pop_ready=init_awready)
  mut br_flow_reg_both_w_slice = br_flow_reg_both_p1::[name=br_flow_reg_both_w_slice](clk=clk, rst=rst, push_valid=target_wvalid, push_data=(target_wdata << 5) | (target_wstrb << 1) | (target_wuser & 1), pop_ready=init_wready)
  mut b_slice = br_flow_reg_both_p2::[name=b_slice](clk=clk, rst=rst, push_valid=init_bvalid, push_data=(init_bresp << 1) | (init_buser & 1), pop_ready=target_bready)
  mut br_flow_reg_both_ar_slice = br_flow_reg_both::[name=br_flow_reg_both_ar_slice](clk=clk, rst=rst, push_valid=target_arvalid, push_data=(target_araddr << 4) | (target_arprot << 1) | (target_aruser & 1), pop_ready=init_arready)
  mut br_flow_reg_both_r_slice = br_flow_reg_both_p3::[name=br_flow_reg_both_r_slice](clk=clk, rst=rst, push_valid=init_rvalid, push_data=(init_rdata << 3) | (init_rresp << 1) | (init_ruser & 1), pop_ready=target_rready)
  target_awready = br_flow_reg_both_aw_slice.push_ready
  target_wready = br_flow_reg_both_w_slice.push_ready
  target_bresp = (b_slice.pop_data >> 1)#[0..=1]
  target_buser = b_slice.pop_data & 1
  target_bvalid = b_slice.pop_valid
  target_arready = br_flow_reg_both_ar_slice.push_ready
  target_rdata = (br_flow_reg_both_r_slice.pop_data >> 3)#[0..=31]
  target_rresp = (br_flow_reg_both_r_slice.pop_data >> 1)#[0..=1]
  target_ruser = br_flow_reg_both_r_slice.pop_data & 1
  target_rvalid = br_flow_reg_both_r_slice.pop_valid
  init_awaddr = (br_flow_reg_both_aw_slice.pop_data >> 4)#[0..=31]
  init_awprot = (br_flow_reg_both_aw_slice.pop_data >> 1)#[0..=2]
  init_awuser = br_flow_reg_both_aw_slice.pop_data & 1
  init_awvalid = br_flow_reg_both_aw_slice.pop_valid
  init_wdata = (br_flow_reg_both_w_slice.pop_data >> 5)#[0..=31]
  init_wstrb = (br_flow_reg_both_w_slice.pop_data >> 1)#[0..=3]
  init_wuser = br_flow_reg_both_w_slice.pop_data & 1
  init_wvalid = br_flow_reg_both_w_slice.pop_valid
  init_bready = b_slice.push_ready
  init_araddr = (br_flow_reg_both_ar_slice.pop_data >> 4)#[0..=31]
  init_arprot = (br_flow_reg_both_ar_slice.pop_data >> 1)#[0..=2]
  init_aruser = br_flow_reg_both_ar_slice.pop_data & 1
  init_arvalid = br_flow_reg_both_ar_slice.pop_valid
  init_rready = br_flow_reg_both_r_slice.push_ready
}
