pub mod br_flow_reg_rev::[timecheck=false](clk:u1, rst:u1, push_valid:u1, push_data:u36, pop_ready:u1) -> (push_ready:u1@[], pop_valid:u1@[], pop_data:u36@[]) {
  reg push_ready:u1
  reg reg_data:u36
