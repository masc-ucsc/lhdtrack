  mut _mux_2:u36 = if push_ready != 0 { push_data } else { reg_data }
  const pop_data__w1 = _mux_2
  if rst != 0 {
    push_ready = 1
  } else {
    push_ready = unsigned((pop_ready != 0) or ((push_ready != 0) and (push_valid == 0)))
  }
  if (pop_ready == 0) and (push_ready != 0) and (push_valid != 0) {
