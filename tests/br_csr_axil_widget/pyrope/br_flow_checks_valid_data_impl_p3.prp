const br_misc_unused_p6 = import("br_misc_unused_p6.br_misc_unused_p6")

pub mod br_flow_checks_valid_data_impl_p3::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u55) -> () {
  br_misc_unused_p6::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 57) | ((valid & 1) << 56) | ((ready & 1) << 55) | data)
}
