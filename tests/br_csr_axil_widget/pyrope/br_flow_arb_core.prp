const br_flow_checks_valid_data_impl_p2 = import("br_flow_checks_valid_data_impl_p2.br_flow_checks_valid_data_impl_p2")
const br_flow_checks_valid_data_intg_p1 = import("br_flow_checks_valid_data_intg_p1.br_flow_checks_valid_data_intg_p1")
const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_arb_core::[timecheck=false](clk:u1, rst:u1, can_grant:u2, grant:u2, push_valid:u2, pop_ready:u1) -> (request:u2@[], enable_priority_update:u1@[], push_ready:u2@[], pop_valid_unstable:u1@[]) {
  mut _rep_1:u2 = if (pop_ready & 1) != 0 { 3 } else { 0 }
  const push_ready__w1 = _rep_1 & can_grant
  const pop_valid_unstable__w1 = unsigned(push_valid != 0)
  br_misc_unused::[name=br_misc_unused_grant](`in` = grant)
  br_flow_checks_valid_data_impl_p2::[name=br_flow_checks_valid_data_impl](clk = clk, rst = rst, valid = pop_valid_unstable__w1, ready = pop_ready, data = 0)
  br_flow_checks_valid_data_intg_p1::[name=br_flow_checks_valid_data_intg](clk = clk, rst = rst, valid = push_valid, ready = push_ready__w1, data = 0)
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
}
