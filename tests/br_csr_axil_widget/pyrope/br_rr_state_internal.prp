pub mod br_rr_state_internal::[timecheck=false](clk:u1, rst:u1, update_priority:u1, grant:u2) -> (last_grant:u2@[], priority_mask:(e1:u1, e0:u1)@[]) {
  reg last_grant:u2
  mut last_grant_init:u2 = 0
  last_grant_init = 0sb?
  mut `priority_mask__bpo.e0` = unsigned(last_grant != 0)
  mut `priority_mask__bpo.e1` = unsigned(((last_grant >> 1) & 1) != 0)
  if rst != 0 {
    last_grant = 2
  } elif update_priority != 0 {
    last_grant = grant
  }
  priority_mask.e1 = `priority_mask__bpo.e1`
  priority_mask.e0 = `priority_mask__bpo.e0`
}
