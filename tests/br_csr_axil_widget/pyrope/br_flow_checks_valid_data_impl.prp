const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_flow_checks_valid_data_impl<NumFlows=2, Width=34, EnableCoverBackpressure=1, NumBackpressureCheckFlows=2, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U68, ready:U2, rst:U1, valid:U2) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 72) | (valid << 70) | (ready << 68) | data)
}
