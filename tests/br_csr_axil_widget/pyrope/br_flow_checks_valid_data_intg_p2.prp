const br_misc_unused_p7 = import("br_misc_unused_p7.br_misc_unused_p7")

pub mod br_flow_checks_valid_data_intg_p2<NumFlows=2, Width=55, EnableCoverBackpressure=1, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U110, ready:U2, rst:U1, valid:U2) -> () {
  br_misc_unused_p7::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 114) | (valid << 112) | (ready << 110) | data)
}
