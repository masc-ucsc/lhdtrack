const br_flow_checks_valid_data_impl_p1 = import("br_flow_checks_valid_data_impl_p1.br_flow_checks_valid_data_impl_p1")
const br_flow_checks_valid_data_intg_p1 = import("br_flow_checks_valid_data_intg_p1.br_flow_checks_valid_data_intg_p1")

pub mod br_flow_join_select_multihot<NumFlows=2, AllowEmptySelect=0, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U1, push_valid:U2, rst:Reset, select_multihot:(e1:U1, e0:U1)) -> (pop_valid_unstable:U1@[], push_ready:(e1:U1, e0:U1)@[]) {
  wire push_ready__bpr:(e1:U1, e0:U1) = nil
  const push_valid_or_unselected__w1 = push_valid | (~((select_multihot.e1 << 1) | select_multihot.e0)#[0..=1])
  mut `push_ready__bpo.e0` = U1(pop_ready != 0 and select_multihot.e0 != 0)
  const `push_ready__bpo.e0__w1` = `push_ready__bpo.e0` & (push_valid_or_unselected__w1 >> 1) & 1 & 1
  mut `push_ready__bpo.e1` = U1(pop_ready != 0 and select_multihot.e1 != 0)
  const `push_ready__bpo.e1__w1` = `push_ready__bpo.e1` & push_valid_or_unselected__w1 & 1 & 1
  const pop_valid_unstable__w1 = U1(push_valid_or_unselected__w1 == 3)
  br_flow_checks_valid_data_impl_p1::[name=br_flow_checks_valid_data_impl](clk=clk, rst=rst, valid=pop_valid_unstable__w1, ready=pop_ready, data=0)
  br_flow_checks_valid_data_intg_p1::[name=br_flow_checks_valid_data_intg](clk=clk, rst=rst, valid=push_valid, ready=(push_ready__bpr.e1 << 1) | push_ready__bpr.e0, data=0)
  const t33 = `push_ready__bpo.e1__w1`
  push_ready__bpr.e1 = t33
  push_ready.e1 = t33
  const t34 = `push_ready__bpo.e0__w1`
  push_ready__bpr.e0 = t34
  push_ready.e0 = t34
  pop_valid_unstable = pop_valid_unstable__w1
}
