const br_arb_lru_internal_t = import("br_arb_lru_internal.br_arb_lru_internal")
const br_flow_mux_core_t = import("br_flow_mux_core.br_flow_mux_core")

pub mod br_flow_mux_lru::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U128, push_valid:U4, rst:Reset) -> (pop_data_unstable:U32@[], pop_valid_unstable:U1@[], push_ready:U4@[]) {
  wire request:U4 = nil
  wire enable_priority_update:U1 = nil
  mut br_arb_lru_internal = br_arb_lru_internal_t::[name=br_arb_lru_internal](clk=clk, rst=rst, enable_priority_update=enable_priority_update, request=request)
  mut br_flow_mux_core = br_flow_mux_core_t::[name=br_flow_mux_core](clk=clk, rst=rst, can_grant=br_arb_lru_internal.can_grant, grant=br_arb_lru_internal.grant, push_valid=push_valid, push_data=push_data, pop_ready=pop_ready)
  request = br_flow_mux_core.request
  enable_priority_update = br_flow_mux_core.enable_priority_update
  push_ready = br_flow_mux_core.push_ready
  pop_valid_unstable = br_flow_mux_core.pop_valid_unstable
  pop_data_unstable = br_flow_mux_core.pop_data_unstable
}
