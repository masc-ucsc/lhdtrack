const br_misc_unused_p3 = import("br_misc_unused_p3.br_misc_unused_p3")

pub mod br_flow_checks_valid_data_intg::[timecheck=false](clk:u1, rst:u1, valid:u4, ready:u4, data:u4) -> () {
  br_misc_unused_p3::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 12) | (valid << 8) | (ready << 4) | data)
}
