// Round-robin priority state: remembers the last grant and derives the mask of
// requesters at or below it (the ones that lose priority next cycle).
pub mod br_rr_state_internal<NUM_REQUESTERS=2>(rst:u1, update_priority:bool, grant:unsigned(bits=NUM_REQUESTERS)) -> (
  priority_mask:unsigned(bits=NUM_REQUESTERS)@[0]
) {
  // After reset the top requester counts as last granted, so requester 0 leads.
  reg last_grant:unsigned(bits=NUM_REQUESTERS):[reset_pin = ref rst] = 1 << (NUM_REQUESTERS - 1)
  if update_priority {
    last_grant = grant
  }

  mut mask:unsigned(bits=NUM_REQUESTERS) = 0
  for i in 0..<NUM_REQUESTERS {
    mask#[i] = last_grant#|[i..]
  }
  priority_mask = mask
}
