// Round-robin arbiter, 16 requesters, zero latency from request to grant.
// Requester 0 starts with the highest priority. After a grant, the granted index
// becomes the lowest priority and the next higher index (mod 16) the highest.
// enable_priority_update gates that rotation; grants are made either way.
pub mod br_arb_rr(clk:Clock, enable_priority_update:U1, request:U16, rst:Reset) -> (grant:U16@[]) {
  comptime const N = request.[bits]

  // One-hot index of the last grant; N-1 initially so that requester 0 leads.
  reg last_grant:Unsigned(bits=N) = 1 << (N - 1)

  // mask#[i] is set for every index at or below the last grant.
  mut mask:Unsigned(bits=N) = 0
  for i in 0..<N {
    mask#[i] = last_grant#|[i..]
  }

  // Requests above the last grant outrank all the others.
  const high = request & ~mask

  // A requester wins if nothing that outranks it is requesting. For index i
  // that is the requesters below it when the last grant is at or above i, plus
  // the ones above it that the last grant has already passed over.
  for i in 0..<N {
    const blocked = if i == 0 { high#[1..] != 0 } elif mask#[i] == 1 { request#[0..<i] != 0 or high#[(i + 1)..] != 0 } else { high#[0..<i] != 0 }
    grant#[i] = U1(request#[i] == 1 and not blocked)
  }

  if enable_priority_update == 1 and request != 0 {
    last_grant = grant
  }
}
