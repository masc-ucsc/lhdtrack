// Round-robin arbiter, 16 requesters, zero latency from request to grant.
// Requester 0 starts with the highest priority. After a grant, the granted index
// becomes the lowest priority and the next higher index (mod 16) the highest.
// enable_priority_update gates that rotation; grants are made either way.

// Bit i of the result is set when any bit of v at or above i is set
// (log-step prefix-OR, no adder).
comb or_down(v:U16) -> (r:U16) {
  mut s:U16 = v
  s |= s >> 1
  s |= s >> 2
  s |= s >> 4
  s |= s >> 8
  r = s
}
// Bit i of the result is set when any bit of v at or below i is set
// (radix-4 prefix-OR).
comb or_up(v:U16) -> (r:U16) {
  mut s:U16 = 0
  wrap s = v | (v << 1) | (v << 2) | (v << 3)
  wrap r = s | (s << 4) | (s << 8) | (s << 12)
}

pub mod br_arb_rr::[synth.color="x"](clk:Clock, enable_priority_update:U1, request:U16, rst:Reset) -> (grant:U16@[]) {
  // One-hot index of the last grant; bit 15 initially so that requester 0 leads.
  reg last_grant:U16 = 0x8000

  // Every index at or below the last grant; requests above it outrank the rest.
  const mask = or_down(v=last_grant)
  const high:U16 = request & ~mask

  // A requester at or below the last grant is blocked by any lower request or
  // any higher one above the last grant; one above it only by a lower request
  // above the last grant.
  mut req_up:U16 = 0
  wrap req_up = request << 1
  mut high_up:U16 = 0
  wrap high_up = high << 1
  const req_below = or_up(v=req_up)           // bit i: request#[0..<i] != 0
  const high_above = or_down(v=high >> 1)     // bit i: high#[(i + 1)..] != 0
  // bit i: high#[0..<i] != 0; requester 0 checks the higher ones instead, as
  // in the reference (only matters with no last grant).
  const high_below = or_up(v=high_up) | (high_above & 1)
  const blocked:U16 = (mask & (req_below | high_above)) | (~mask & high_below)
  grant = request & ~blocked

  if enable_priority_update == 1 and request != 0 {
    last_grant = grant
  }
}
