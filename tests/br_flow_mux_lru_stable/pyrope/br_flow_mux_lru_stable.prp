const br_arb_lru_internal_t = import("br_arb_lru_internal.br_arb_lru_internal")
const br_flow_mux_core_stable_t = import("br_flow_mux_core_stable.br_flow_mux_core_stable")

pub mod br_flow_mux_lru_stable::[timecheck=false](clk:u1, rst:u1, push_valid:u8, push_data:u256, pop_ready:u1) -> (push_ready:u8@[], pop_valid:u1@[], pop_data:u32@[]) {
  wire request:u8
  wire enable_priority_update:u1
  mut br_arb_lru_internal = br_arb_lru_internal_t::[name=br_arb_lru_internal](clk = clk, rst = rst, enable_priority_update = enable_priority_update, request = request)
  mut br_flow_mux_core_stable = br_flow_mux_core_stable_t::[name=br_flow_mux_core_stable](clk = clk, rst = rst, can_grant = br_arb_lru_internal.can_grant, grant = br_arb_lru_internal.grant, push_valid = push_valid, push_data = push_data, pop_ready = pop_ready)
  request = br_flow_mux_core_stable.request
  enable_priority_update = br_flow_mux_core_stable.enable_priority_update
  push_ready = br_flow_mux_core_stable.push_ready
  pop_valid = br_flow_mux_core_stable.pop_valid
  pop_data = br_flow_mux_core_stable.pop_data
}
