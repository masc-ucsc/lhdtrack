const br_misc_unused_p5 = import("br_misc_unused_p5.br_misc_unused_p5")

pub mod br_flow_checks_valid_data_intg::[timecheck=false](clk:u1, rst:u1, valid:u8, ready:u8, data:u8) -> () {
  br_misc_unused_p5::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 24) | (valid << 16) | (ready << 8) | data)
}
