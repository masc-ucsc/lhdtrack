pub comb br_mux_onehot::[timecheck=false](select:u8, `in`:u256) -> (out:u32) {
  mut _rep_1:u32 = if (select & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_2:u32 = if ((select >> 1) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_3:u32 = if ((select >> 2) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_4:u32 = if ((select >> 3) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_5:u32 = if ((select >> 4) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_6:u32 = if ((select >> 5) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_7:u32 = if ((select >> 6) & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_8:u32 = if ((select >> 7) & 1) != 0 { 0xffffffff } else { 0 }
  out = (((((((0 | (_rep_1 & `in`#[0..=31])) | (_rep_2 & `in`#[32..=63])) | (_rep_3 & `in`#[64..=95])) | (_rep_4 & `in`#[96..=127])) | (_rep_5 & `in`#[128..=159])) | (_rep_6 & `in`#[160..=191])) | (_rep_7 & `in`#[192..=223])) | (_rep_8 & `in`#[224..=255])
}
