pub mod br_counter_p1<MaxValueWidth=32, MaxChangeWidth=32, MaxValue=16, MaxChange=1, MaxIncrement=1, MaxDecrement=1, EnableWrap=0, EnableReinitAndChange=1, EnableSaturate=0, EnableAssertFinalNotValid=1, EnableCoverZeroChange=0, EnableCoverReinit=0, EnableCoverReinitAndChange=0, EnableCoverReinitNoChange=0, EnableCoverIncrementAndDecrement=1, EnableAssertFinalInitialValue=1>::[timecheck=false](clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U5, reinit:U1, rst:U1) -> (value:U5@[], value_next:U5@[]) {
  reg value:U5
  mut _mux_2:U1 = if incr_valid != 0 { incr & 1 } else { 0 }
  mut _mux_3:U1 = if decr_valid != 0 { decr & 1 } else { 0 }
  mut _mux_4:U5 = if reinit != 0 { initial_value } else { value }
  const value_next__w1 = ((_mux_4 + _mux_2)#[0..=4] - _mux_3)#[0..=4]
  if rst != 0 {
    value = initial_value
  } elif U1(reinit != 0 or incr_valid != 0 or decr_valid != 0) != 0 {
    value = value_next__w1
  }
  value_next = value_next__w1
}
