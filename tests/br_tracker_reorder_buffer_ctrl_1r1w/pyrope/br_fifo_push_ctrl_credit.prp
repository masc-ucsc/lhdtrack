const br_counter = import("br_counter.br_counter")
const br_credit_receiver_t = import("br_credit_receiver.br_credit_receiver")
const br_fifo_push_ctrl_core_t = import("br_fifo_push_ctrl_core.br_fifo_push_ctrl_core")

pub mod br_fifo_push_ctrl_credit<Depth=2, Width=32, EnableBypass=1, MaxCredit=2, RegisterPushOutputs=1, RamDepth=2, EnableAssertPushDataKnown=1, EnableCoverCreditWithhold=0, EnableCoverPushSenderInReset=1, EnableCoverPushCreditStall=0, EnableAssertFinalNotValid=1>::[timecheck=false](bypass_ready:U1, clk:Clock, credit_initial_push:U2, credit_withhold_push:U2, pop_beat:U1, push_credit_stall:U1, push_data:U32, push_sender_in_reset:U1, push_valid:U1, rst:U1) -> (bypass_data_unstable:U32@[], bypass_valid_unstable:U1@[], credit_available_push:U2@[], credit_count_push:U2@[], full:U1@[], full_next:U1@[], push_beat:U1@[], push_credit:U1@[], push_receiver_in_reset:U1@[], ram_wr_addr:U1@[], ram_wr_data:U32@[], ram_wr_valid:U1@[], slots:U2@[], slots_next:U2@[]) {
  wire either_rst__w1
  reg full:U1:[async=false, initial=0, reset_pin=either_rst__w1]
  mut _b2i_1 = if rst != 0 or push_sender_in_reset != 0 { 1 } else { 0 }
  either_rst__w1 = _b2i_1
  mut br_credit_receiver = br_credit_receiver_t::[name=br_credit_receiver](clk=clk, rst=rst, push_sender_in_reset=push_sender_in_reset, push_credit_stall=push_credit_stall, push_valid=push_valid, push_data=push_data, pop_credit=pop_beat, credit_initial=credit_initial_push, credit_withhold=credit_withhold_push)
  mut br_fifo_push_ctrl_core = br_fifo_push_ctrl_core_t::[name=br_fifo_push_ctrl_core](clk=clk, rst=either_rst__w1, push_valid=br_credit_receiver.pop_valid, push_data=br_credit_receiver.pop_data, bypass_ready=bypass_ready, addr_base=0, addr_bound=(RamDepth - 1) & 1, full=full)
  mut br_counter_slots = br_counter::[name=br_counter_slots](clk=clk, rst=either_rst__w1, reinit=0, initial_value=Depth#[0..=1], incr_valid=pop_beat, incr=1, decr_valid=br_fifo_push_ctrl_core.push_beat, decr=1)
  const full_next__w1 = U1(br_counter_slots.value_next == 0)
  if not (either_rst__w1 != 0) {
    if br_fifo_push_ctrl_core.push_beat != 0 or pop_beat != 0 {
      full = full_next__w1
    }
  }
  push_receiver_in_reset = br_credit_receiver.push_receiver_in_reset
  push_credit = br_credit_receiver.push_credit
  full_next = full_next__w1
  slots = br_counter_slots.value
  slots_next = br_counter_slots.value_next
  credit_count_push = br_credit_receiver.credit_count
  credit_available_push = br_credit_receiver.credit_available
  bypass_valid_unstable = br_fifo_push_ctrl_core.bypass_valid_unstable
  bypass_data_unstable = br_fifo_push_ctrl_core.bypass_data_unstable
  ram_wr_valid = br_fifo_push_ctrl_core.ram_wr_valid
  ram_wr_addr = br_fifo_push_ctrl_core.ram_wr_addr
  ram_wr_data = br_fifo_push_ctrl_core.ram_wr_data
  push_beat = br_fifo_push_ctrl_core.push_beat
}
