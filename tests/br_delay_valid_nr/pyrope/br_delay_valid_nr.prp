// One valid-qualified delay `stage`; payload storage is deliberately unreset.
// Stage-zero outputs expose the current input; packed state preserves pairing.
pub mod br_delay_valid_nr(clk:Clock, `in`:U8, in_valid:U1) -> (out:U8@[], out_stages:U16@[], out_valid:U1@[], out_valid_stages:U2@[]) {
  reg stage_valid___q:U2 = nil
  reg stage___q:U16 = nil
  stage_valid___q#[1] = in_valid
  // Next-valid mode captures with the previous valid, matching the reference.
  if in_valid != 0 {
    stage___q#[8..<16] = `in`
  }
  out = stage___q#[8..]
  out_valid = stage_valid___q#[1]
  out_stages = (`in`, out)#[..]
  out_valid_stages = (in_valid, out_valid)#[..]
}
