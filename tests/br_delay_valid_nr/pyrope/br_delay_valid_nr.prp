pub mod br_delay_valid_nr::[timecheck=false](clk:Clock, `in`:U8, in_valid:U1) -> (out:U8@[], out_stages:U16@[], out_valid:U1@[], out_valid_stages:U2@[]) {
  reg stage_valid___q:U2
