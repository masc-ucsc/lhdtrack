// 8-bit up/down counter that wraps modulo 256 (bedrock br_counter, MaxValue=255, MaxChange=1).
// `reinit` reloads initial_value and the same-cycle incr/decr apply to that value.
// Reset loads a runtime input, so it stays in the next-state logic.
pub mod br_counter(clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U8, reinit:U1, rst:U1) -> (reg value:U8@[0]=nil, value_next:U8@[0]) {
  const base = if reinit != 0 { initial_value } else { value }
  const up = if incr_valid != 0 { incr } else { 0 }
  const down = if decr_valid != 0 { decr } else { 0 }
  wrap value_next = base + up - down
  if rst != 0 {
    value = initial_value
  } elif reinit != 0 or incr_valid != 0 or decr_valid != 0 {
    value = value_next
  }
}
