// One-stage valid/data delay: the valid register resets to false; the data
// register has no reset and only loads when in_valid is set. A conditionally
// written register is state, so `out` lands at @[0] while `out_valid` is a
// one-cycle stage at @[1].
pub mod br_delay_valid<T=u1>(rst:u1, in_valid:bool, `in`:T) -> (out_valid:bool@[1], out:T@[0]) {
  reg stage_valid:bool = false
  reg `stage`:T        = nil
  stage_valid          = in_valid
  if in_valid {
    `stage` = `in`
  }
  out_valid = stage_valid
  out       = `stage`
}
