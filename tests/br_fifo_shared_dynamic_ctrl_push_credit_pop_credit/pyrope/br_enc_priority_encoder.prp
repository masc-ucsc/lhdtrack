// Bit-order reversal of a width-bit value.
comb reverse_bits(value, width) -> (reversed) {
  mut r = 0
  for i in 0..<width {
    r |= value#[i] << (width - 1 - i)
  }
  reversed = r
}

// Priority encoder: result k is the k-th highest-priority set bit of `in`, as
// a one-hot row. Rows are packed with result 0 in the low bits. Bit 0 has the
// highest priority unless MSB_HIGHEST_PRIORITY.
pub comb br_enc_priority_encoder<NUM_REQUESTERS=2, NUM_RESULTS=1, MSB_HIGHEST_PRIORITY=false>(`in`:unsigned(bits=NUM_REQUESTERS)) -> (
  out:unsigned(bits=NUM_RESULTS * NUM_REQUESTERS)
) {
  comptime const N = NUM_REQUESTERS

  mut remaining:unsigned(bits=N)          = if MSB_HIGHEST_PRIORITY { reverse_bits(value=`in`, width=N) } else { `in` }
  mut rows:unsigned(bits=NUM_RESULTS * N) = 0
  for k in 0..<NUM_RESULTS {
    const lowest     = remaining & -remaining
    rows#[(k*N)..+N] = if MSB_HIGHEST_PRIORITY { reverse_bits(value=lowest, width=N) } else { lowest }
    remaining       &= ~lowest
  }
  out = rows
}
