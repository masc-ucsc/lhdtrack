const br_enc_onehot2bin       = import("br_enc_onehot2bin.br_enc_onehot2bin")
const br_enc_priority_encoder = import("br_enc_priority_encoder.br_enc_priority_encoder")
const br_multi_xfer_reg_fwd   = import("br_multi_xfer_reg_fwd.br_multi_xfer_reg_fwd")

// Free-list tracker: hands out up to NUM_ALLOC free entry ids per cycle (lowest
// numbered first) through a registered multi-transfer stage, and takes back up
// to NUM_DEALLOC ids per cycle. Configuration: 32 entries, 2 alloc and 2
// dealloc ports, registered alloc outputs, no bypass, no preallocated entries,
// dealloc_count delayed one cycle. Ports are packed, port 0 in the low bits.
pub mod br_tracker_freelist(clk:u1, rst:u1, alloc_receivable:u2, dealloc_valid:u2, dealloc_entry_id:u10) -> (
  alloc_sendable:u2@[0],
  alloc_entry_id:u10@[0],
  dealloc_count:u2@[]
) {
  comptime const NUM_ENTRIES = 32
  comptime const ID_WIDTH    = 5
  comptime const NUM_ALLOC   = alloc_entry_id.[bits]/ID_WIDTH
  comptime const NUM_DEALLOC = dealloc_valid.[bits]

  // Every entry starts free.
  reg unstaged_free_entries:u32 = (1 << NUM_ENTRIES) - 1

  // The lowest free entries, one one-hot row per alloc port.
  const free_rows   = br_enc_priority_encoder<NUM_REQUESTERS=NUM_ENTRIES,NUM_RESULTS=NUM_ALLOC>(`in`=unstaged_free_entries)
  mut push_valid:u2 = 0
  mut push_id:u10   = 0
  for p in 0..<NUM_ALLOC {
    const id = br_enc_onehot2bin<NUM_VALUES=NUM_ENTRIES,BIN_WIDTH=ID_WIDTH>(`in`=free_rows#[(p*NUM_ENTRIES)..+NUM_ENTRIES])
    push_valid#[p] = u1(id.out_valid)
    push_id#[(p*ID_WIDTH)..+ID_WIDTH] = id.out
  }
  const alloc_reg = br_multi_xfer_reg_fwd(
    clk=clk, rst=rst, push_sendable=push_valid#+[..], push_data=push_id, pop_receivable=alloc_receivable
  )

  // Entries taken by the alloc register leave the free set; freed ones return.
  mut allocated:u32 = 0
  for p in 0..<NUM_ALLOC {
    if alloc_reg.push_receivable > p {
      allocated |= free_rows#[(p*NUM_ENTRIES)..+NUM_ENTRIES]
    }
  }
  mut freed:u32 = 0
  for p in 0..<NUM_DEALLOC {
    if dealloc_valid#[p] == 1 {
      freed |= 1 << dealloc_entry_id#[(p*ID_WIDTH)..+ID_WIDTH]
    }
  }
  if (push_valid != 0 and alloc_reg.push_receivable > 0) or dealloc_valid != 0 {
    unstaged_free_entries = (unstaged_free_entries | freed) & ~allocated
  }

  // The register is the output: deallocations are reported a cycle later.
  // `@[]`: the parent feeds this count back as credits next to cycle-0 values.
  reg dealloc_count:u2 = 0
  dealloc_count        = dealloc_valid#+[..]

  alloc_sendable = alloc_reg.pop_sendable
  alloc_entry_id = alloc_reg.pop_data
}
