const br_multi_xfer_distributor_rr = import("br_multi_xfer_distributor_rr.br_multi_xfer_distributor_rr")
const br_tracker_freelist          = import("br_tracker_freelist.br_tracker_freelist")

// Push side of the shared dynamic FIFO: allocates a free RAM entry for each
// valid write port, writes the data there and reports the entry as the next
// tail of its FIFO. Freed entries come back through dealloc_*.
// next_tail_valid/next_tail are packed [fifo][port], port 0 of fifo 0 lowest.
pub mod br_fifo_shared_dynamic_push_ctrl(
  clk:u1,
  rst:u1,
  push_valid:u2,
  push_data:u64,
  push_fifo_id:u2,
  dealloc_valid:u2,
  dealloc_entry_id:u10
) -> (
  push_ready:u2@[0],
  push_full:u1@[0],
  data_ram_wr_valid:u2@[0],
  data_ram_wr_addr:u10@[0],
  data_ram_wr_data:u64@[0],
  next_tail_valid:u4@[0],
  next_tail:u20@[0],
  dealloc_count:u2@[]
) {
  comptime const NUM_PORTS  = push_valid.[bits]
  comptime const NUM_FIFOS  = dealloc_valid.[bits]
  comptime const ADDR_WIDTH = data_ram_wr_addr.[bits]/NUM_PORTS

  wire alloc_receivable:u2 = nil
  const freelist           = br_tracker_freelist(
    clk=clk, rst=rst, alloc_receivable=alloc_receivable, dealloc_valid=dealloc_valid, dealloc_entry_id=dealloc_entry_id
  )
  // Hand the allocated entries to the valid write ports, round-robin.
  const mapping = br_multi_xfer_distributor_rr(
    clk=clk, rst=rst, push_sendable=freelist.alloc_sendable, push_data=freelist.alloc_entry_id, pop_ready=push_valid
  )
  alloc_receivable = mapping.push_receivable

  const wr_valid = push_valid & mapping.pop_valid

  // Each written entry becomes the next tail of its FIFO.
  mut tail_valid:u4 = 0
  mut tail:u20      = 0
  for p in 0..<NUM_PORTS {
    for f in 0..<NUM_FIFOS {
      const lane = f*NUM_PORTS + p
      tail_valid#[lane] = u1(wr_valid#[p] == 1 and push_fifo_id#[p] == f)
      tail#[(lane*ADDR_WIDTH)..+ADDR_WIDTH] = mapping.pop_data#[(p*ADDR_WIDTH)..+ADDR_WIDTH]
    }
  }

  push_ready        = mapping.pop_valid
  push_full         = u1(freelist.alloc_sendable == 0)
  data_ram_wr_valid = wr_valid
  data_ram_wr_addr  = mapping.pop_data
  data_ram_wr_data  = push_data
  next_tail_valid   = tail_valid
  next_tail         = tail
  dealloc_count     = freelist.dealloc_count
}
