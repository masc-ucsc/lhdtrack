// Multi-symbol forwarding register: holds up to NUM_SYMBOLS symbols. Each
// cycle the pop side takes some from the front and the push side appends new
// ones behind those left. Symbol 0 (the oldest) is in the low bits.
pub mod br_multi_xfer_reg_fwd(clk:u1, rst:u1, push_sendable:u2, push_data:u10, pop_receivable:u2) -> (
  push_receivable:u2@[0],
  pop_sendable:u2@[0],
  pop_data:u10@[0]
) {
  comptime const NUM_SYMBOLS  = 2
  comptime const SYMBOL_WIDTH = push_data.[bits]/NUM_SYMBOLS

  // The registers are the pop-side outputs.
  reg pop_sendable:u2 = 0
  reg pop_data:u10    = 0

  const pop_xfer = if pop_sendable < pop_receivable { pop_sendable } else { pop_receivable }
  mut kept:u2    = 0
  wrap kept         = pop_sendable - pop_xfer
  mut receivable:u2 = 0
  wrap receivable = NUM_SYMBOLS - kept
  const push_xfer = if push_sendable < receivable { push_sendable } else { receivable }

  // Only the symbols actually pushed count; the rest of push_data is ignored.
  mut pushed:u10 = 0
  for i in 0..<NUM_SYMBOLS {
    if push_sendable > i {
      pushed#[(i*SYMBOL_WIDTH)..+SYMBOL_WIDTH] = push_data#[(i*SYMBOL_WIDTH)..+SYMBOL_WIDTH]
    }
  }

  if push_xfer != 0 or pop_xfer != 0 {
    wrap pop_sendable = kept + push_xfer
    wrap pop_data = (pop_data >> (pop_xfer*SYMBOL_WIDTH)) | (pushed << (kept*SYMBOL_WIDTH))
  }
  push_receivable = receivable
}
