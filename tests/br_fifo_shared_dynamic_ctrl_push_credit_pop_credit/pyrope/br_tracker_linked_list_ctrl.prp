// Linked-list controller for one list stored in a pointer RAM. Write ports
// append entries at the tail (several per cycle, chained in port order through
// the pointer RAM); popping the head reads its successor from the pointer RAM.
// Configuration: one list, pointer-RAM read latency 1. Ports are packed, port
// 0 in the low bits.
pub mod br_tracker_linked_list_ctrl(
  clk:u1,
  rst:u1,
  next_tail_valid:u2,
  next_tail:u10,
  head_ready:u1,
  ptr_ram_rd_data_valid:u1,
  ptr_ram_rd_data:u5
) -> (
  head_valid:u1@[0],
  head:u5@[0],
  empty:u1@[0],
  items:u6@[0],
  ptr_ram_wr_valid:u2@[0],
  ptr_ram_wr_addr:u10@[0],
  ptr_ram_wr_data:u10@[0],
  ptr_ram_rd_addr_valid:u1@[0],
  ptr_ram_rd_addr:u5@[0]
) {
  comptime const NUM_PORTS  = next_tail_valid.[bits]
  comptime const ADDR_WIDTH = head.[bits]

  reg ll_count:u6        = 0
  reg ll_empty:bool      = true
  reg ll_head_valid:bool = false
  reg ll_head:u5         = 0
  reg ll_tail:u5         = 0

  const valid      = ll_head_valid and not ll_empty
  const pop        = valid and head_ready == 1
  const head_last  = ll_count == 1
  const any_append = next_tail_valid != 0

  // Entry count: appends add, a pop removes one.
  mut count_next:u6 = 0
  wrap count_next = ll_count + next_tail_valid#+[..] - (if pop { 1 } else { 0 })
  if any_append or pop {
    ll_count = count_next
  }
  ll_empty = count_next == 0

  // Chain the appended entries: each one is linked from the tail as it stands
  // after the earlier ports in this cycle.
  mut wr_valid:u2     = 0
  mut wr_addr:u10     = 0
  mut first_append:u5 = 0
  mut tail_so_far:u5  = ll_tail
  mut appended_before = false
  for p in 0..<NUM_PORTS {
    const append = next_tail_valid#[p] == 1
    const entry = next_tail#[(p*ADDR_WIDTH)..+ADDR_WIDTH]
    wr_valid#[p] = u1(append and (not ll_empty or appended_before))
    wr_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = tail_so_far
    if append {
      if not appended_before {
        first_append = entry
      }
      tail_so_far     = entry
      appended_before = true
    }
  }
  if any_append {
    ll_tail = tail_so_far
  }

  // The head comes from the appended entries when the list is (about to be)
  // empty, else from the pointer RAM read issued when the head was popped.
  const bypass      = ll_empty or (head_last and ll_head_valid and head_ready == 1)
  const head_update = (any_append and bypass) or ptr_ram_rd_data_valid == 1
  if head_update {
    ll_head = if bypass { first_append } else { ptr_ram_rd_data }
  }
  ll_head_valid = (ll_head_valid and not pop) or head_update

  head_valid            = u1(valid)
  head = ll_head
  empty = u1(ll_empty)
  items = ll_count
  ptr_ram_wr_valid      = wr_valid
  ptr_ram_wr_addr       = wr_addr
  ptr_ram_wr_data       = next_tail
  ptr_ram_rd_addr_valid = u1(pop and not head_last)
  ptr_ram_rd_addr       = ll_head
}
