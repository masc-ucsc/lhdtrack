const br_counter = import("br_counter.br_counter")
const br_enc_countones = import("br_enc_countones.br_enc_countones")
const br_enc_priority_encoder_p2 = import("br_enc_priority_encoder_p2.br_enc_priority_encoder_p2")
const br_enc_priority_encoder_p3 = import("br_enc_priority_encoder_p3.br_enc_priority_encoder_p3")
const br_mux_onehot = import("br_mux_onehot.br_mux_onehot")
const cfg = import("lhdtrack_cfg")

// Linked-list controller for one list stored in a pointer RAM. Write ports
// append entries at the tail (several per cycle, chained in port order through
// the pointer RAM); popping the head reads its successor from the pointer RAM.
// One list, pointer-RAM read latency 1. Ports are packed, port 0 in the low bits.
pub mod br_tracker_linked_list_ctrl<Depth=32, NumWritePorts=2, NumLinkedLists=1, RamReadLatency=1>::[timecheck=false](clk:Clock, head_ready:U1, next_tail:U10, next_tail_valid:(e1:U1, e0:U1), ptr_ram_rd_data:U5, ptr_ram_rd_data_valid:U1, rst:U1) -> (empty:U1@[], head:U5@[], head_valid:U1@[], items:U6@[], ptr_ram_rd_addr:U5@[], ptr_ram_rd_addr_valid:U1@[], ptr_ram_wr_addr:U10@[], ptr_ram_wr_data:U10@[], ptr_ram_wr_valid:(e1:U1, e0:U1)@[]) {
  reg ll_empty:U1:[async=false, initial=1, reset_pin=rst]
  reg ll_head_valid:U1:[async=false, initial=0, reset_pin=rst]
  if cfg.no_loop {
    reg ll_head:[1]U5:[ordering="old"]
    reg ll_tail:[1]U5:[ordering="old"]
    wire ptr_ram_wr_addr_bits:U10 = nil
    wire ptr_ram_wr_addr:U10 = nil
    wire ptr_ram_wr_data_bits:U10 = nil
    wire ptr_ram_wr_data:U10 = nil
    wire `ll_next_tail_valid_transpose[0]`:U1 = nil
    wire `ll_next_tail_valid_transpose[1]`:U1 = nil
    wire `ll_ptr_ram_wr_valid[0]`:U1 = nil
    wire `ll_ptr_ram_wr_valid[1]`:U1 = nil
    wire ll_ptr_ram_wr_addr_bits:U10 = nil
    mut ll_empty_next:U1 = 0
    mut ll_head_bypass:U1 = 0
    mut ll_head_last:U1 = 0
    wire `ptr_ram_wr_valid__bpr.e1`:U1 = nil
    wire `ptr_ram_wr_valid__bpr.e0`:U1 = nil
    mut ll_count__wtmp:U6 = 0sb?
    wire ll_count:U6 = nil
    mut ll_count_next__wtmp:U6 = 0sb?
    wire ll_count_next:U6 = nil
    ll_empty_next = 0ub?
    ll_head_bypass = 0ub?
    ll_head_last = 0ub?
    const ll_next_tail_valid = ((next_tail_valid.e1 << 1) | next_tail_valid.e0) & 3
    `ll_next_tail_valid_transpose[0]` = ll_next_tail_valid & 1
    `ll_next_tail_valid_transpose[1]` = (ll_next_tail_valid >> 1) & 1
    mut gen_linked_list_0_br_enc_countones_ll_next_tail_valid = br_enc_countones::[name=gen_linked_list_0_br_enc_countones_ll_next_tail_valid](`in`=(`ll_next_tail_valid_transpose[1]` << 1) | `ll_next_tail_valid_transpose[0]`)
    const gen_linked_list_0_ll_tail_update = U1(((`ll_next_tail_valid_transpose[1]` << 1) | `ll_next_tail_valid_transpose[0]`) != 0)
    mut ll_head_last__w1 = ll_head_last
    ll_head_last__w1#[0] = U1(ll_count == 1) & 1
    mut _b2i_5 = if (ll_empty & 1) != 0 or ((ll_head_last__w1 & 1) != 0 and (ll_head_valid & 1) != 0 and true and head_ready != 0) {
      1
    } else {
      0
    }
    mut ll_head_bypass__w1 = ll_head_bypass
    ll_head_bypass__w1#[0] = _b2i_5 & 1
    mut _b2i_6 = if (ll_next_tail_valid & 1) != 0 and (ll_empty & 1) == 0 { 1 } else { 0 }
    `ll_ptr_ram_wr_valid[0]` = _b2i_6 & 1
    ll_ptr_ram_wr_addr_bits#[0..<5] = ll_tail[0]#[0..<5]
    mut _b2i_7 = if ((ll_next_tail_valid >> 1) & 1) != 0 and ((ll_empty & 1) == 0 or (ll_next_tail_valid & 1) != 0) { 1 } else { 0 }
    `ll_ptr_ram_wr_valid[1]` = _b2i_7 & 1
    mut _mux_8:U5 = if (ll_next_tail_valid & 1) != 0 { next_tail#[0..=4] } else { ll_tail[0] }
    ll_ptr_ram_wr_addr_bits#[5..<10] = _mux_8#[0..<5]
    const t76 = (`ll_next_tail_valid_transpose[1]` << 1) | `ll_next_tail_valid_transpose[0]`
    mut gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_tail_next_select = br_enc_priority_encoder_p2::[name=gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_tail_next_select](clk=clk, rst=rst, `in.e1`=(t76 >> 1) & 1, `in.e0`=t76 & 1)
    mut gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_next_tail = br_mux_onehot::[name=gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_next_tail](select=gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_tail_next_select, `in`=next_tail)
    const t80 = (`ll_next_tail_valid_transpose[1]` << 1) | `ll_next_tail_valid_transpose[0]`
    mut gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_head_next_select = br_enc_priority_encoder_p3::[name=gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_head_next_select](clk=clk, rst=rst, `in.e1`=(t80 >> 1) & 1, `in.e0`=t80 & 1)
    mut gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_head_next = br_mux_onehot::[name=gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_head_next](select=gen_linked_list_0_gen_tail_update_chaining_br_enc_priority_encoder_ll_head_next_select, `in`=next_tail)
    mut _mux_9:U5 = if (ll_head_bypass__w1 & 1) != 0 { gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_head_next#[0..=4] }
      else { ptr_ram_rd_data }
    mut _b2i_10 = if gen_linked_list_0_ll_tail_update != 0 and (ll_head_bypass__w1 & 1) != 0 { 1 } else { 0 }
    mut _b2i_12 = if _b2i_10 != 0 or U1(ptr_ram_rd_data_valid != 0 and true) != 0 { 1 } else { 0 }
    const gen_linked_list_0_ll_head_update = _b2i_12
    if rst != 0 {
      ll_tail[0] = 0
    } elif gen_linked_list_0_ll_tail_update != 0 {
      ll_tail[0] = gen_linked_list_0_gen_tail_update_chaining_br_mux_onehot_ll_next_tail
    }
    if rst != 0 {
      ll_head[0] = 0
    } elif gen_linked_list_0_ll_head_update != 0 {
      ll_head[0] = _mux_9
    }
    mut _b2i_13 = if (1 & (~ll_empty) & 1 & ll_head_valid & 1) != 0 { 1 } else { 0 }
    const head_valid__w1 = _b2i_13
    mut _b2i_14 = if (1 & (~ll_head_last__w1#[0]) & 1) != 0 { 1 } else { 0 }
    mut _b2i_15 = if head_valid__w1 != 0 and head_ready != 0 and _b2i_14 != 0 { 1 } else { 0 }
    const head__w1 = ll_head[0]
    mut _b2i_16 = if (`ll_ptr_ram_wr_valid[0]` & 1) != 0 { 1 } else { 0 }
    mut `ptr_ram_wr_valid__bpo.e0` = _b2i_16
    const t121 = (ll_ptr_ram_wr_addr_bits#[4] << 4) | (ll_ptr_ram_wr_addr_bits#[3] << 3) | (ll_ptr_ram_wr_addr_bits#[2] << 2) | (ll_ptr_ram_wr_addr_bits#[1] << 1) | ll_ptr_ram_wr_addr_bits#[0]
    ptr_ram_wr_addr_bits#[0..<5] = t121#[0..<5]
    ptr_ram_wr_data_bits#[0..<5] = next_tail#[0..=4]#[0..<5]
    mut _b2i_17 = if (`ll_ptr_ram_wr_valid[1]` & 1) != 0 { 1 } else { 0 }
    mut `ptr_ram_wr_valid__bpo.e1` = _b2i_17
    const t143 = (ll_ptr_ram_wr_addr_bits#[9] << 4) | (ll_ptr_ram_wr_addr_bits#[8] << 3) | (ll_ptr_ram_wr_addr_bits#[7] << 2) | (ll_ptr_ram_wr_addr_bits#[6] << 1) | ll_ptr_ram_wr_addr_bits#[5]
    ptr_ram_wr_addr_bits#[5..<10] = t143#[0..<5]
    ptr_ram_wr_data_bits#[5..<10] = next_tail#[5..=9]#[0..<5]
    mut _b2i_18 = if ll_empty == 1 { 1 } else { 0 }
    const items__w2 = (0 + ll_count)#[0..=5]
    mut _b2i_19 = if head_valid__w1 != 0 and head_ready != 0 and true { 1 } else { 0 }
    mut gen_linked_list_0_br_counter_ll_count = br_counter::[name=gen_linked_list_0_br_counter_ll_count](clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=U1(((`ll_next_tail_valid_transpose[1]` << 1) | `ll_next_tail_valid_transpose[0]`) != 0), incr=gen_linked_list_0_br_enc_countones_ll_next_tail_valid, decr_valid=_b2i_19, decr=1)
    ll_count__wtmp#[0..=5] = gen_linked_list_0_br_counter_ll_count.value#[0..=5]
    ll_count_next__wtmp#[0..=5] = gen_linked_list_0_br_counter_ll_count.value_next#[0..=5]
    mut ll_empty_next__w1 = ll_empty_next
    ll_empty_next__w1#[0] = U1(ll_count_next == 0) & 1
    if not (rst != 0) {
      ll_empty#[0] = ll_empty_next__w1 & 1
    }
    mut _b2i_21 = if head_valid__w1 != 0 and head_ready != 0 and true { 1 } else { 0 }
    mut _b2i_22 = if ((ll_head_valid & 1) != 0 and _b2i_21 == 0) or gen_linked_list_0_ll_head_update != 0 { 1 } else { 0 }
    if not (rst != 0) {
      ll_head_valid#[0] = _b2i_22 & 1
    }
    ptr_ram_wr_addr = ptr_ram_wr_addr_bits
    ptr_ram_wr_data = ptr_ram_wr_data_bits
    ll_count = ll_count__wtmp
    ll_count_next = ll_count_next__wtmp
    const t203 = `ptr_ram_wr_valid__bpo.e1`
    `ptr_ram_wr_valid__bpr.e1` = t203
    ptr_ram_wr_valid.e1 = t203
    const t204 = `ptr_ram_wr_valid__bpo.e0`
    `ptr_ram_wr_valid__bpr.e0` = t204
    ptr_ram_wr_valid.e0 = t204
    head_valid = head_valid__w1
    head = head__w1
    empty = _b2i_18
    items = items__w2
    ptr_ram_rd_addr_valid = _b2i_15
    ptr_ram_rd_addr = head__w1
  } else {
    comptime const ADDR_WIDTH = head.[bits]

    const tail_valid:U2 = (next_tail_valid.e0#[0], next_tail_valid.e1#[0])#[..]
    reg ll_count:U6:[reset_pin=rst] = 0
    reg ll_head:U5:[reset_pin=rst]  = 0
    reg ll_tail:U5:[reset_pin=rst]  = 0

    const valid      = ll_head_valid == 1 and ll_empty == 0
    const pop        = valid and head_ready == 1
    const head_last  = ll_count == 1
    const any_append = tail_valid != 0

    // Entry count: appends add, a pop removes one.
    mut count_next:U6 = 0
    wrap count_next = ll_count + tail_valid#+[..] - (if pop { 1 } else { 0 })
    if any_append or pop {
      ll_count = count_next
    }
    ll_empty = U1(count_next == 0)

    // Chain the appended entries: each one is linked from the tail as it stands
    // after the earlier ports in this cycle.
    mut wr_valid:U2     = 0
    mut wr_addr:U10     = 0
    mut first_append:U5 = 0
    mut tail_so_far:U5  = ll_tail
    mut appended_before = false
    for p in 0..<NumWritePorts {
      const append = tail_valid#[p] == 1
      const entry  = next_tail#[(p*ADDR_WIDTH)..+ADDR_WIDTH]
      wr_valid#[p] = U1(append and (ll_empty == 0 or appended_before))
      wr_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = tail_so_far
      if append {
        if not appended_before {
          first_append = entry
        }
        tail_so_far     = entry
        appended_before = true
      }
    }
    if any_append {
      ll_tail = tail_so_far
    }

    // The head comes from the appended entries when the list is (about to be)
    // empty, else from the pointer RAM read issued when the head was popped.
    const bypass      = ll_empty == 1 or (head_last and ll_head_valid == 1 and head_ready == 1)
    const head_update = (any_append and bypass) or ptr_ram_rd_data_valid == 1
    if head_update {
      ll_head = if bypass { first_append } else { ptr_ram_rd_data }
    }
    ll_head_valid = U1((ll_head_valid == 1 and not pop) or head_update)

    head_valid            = U1(valid)
    head                  = ll_head
    empty                 = ll_empty
    items                 = ll_count
    ptr_ram_wr_valid      = (e1=wr_valid#[1], e0=wr_valid#[0])
    ptr_ram_wr_addr       = wr_addr
    ptr_ram_wr_data       = next_tail
    ptr_ram_rd_addr_valid = U1(pop and not head_last)
    ptr_ram_rd_addr       = ll_head
  }
}
