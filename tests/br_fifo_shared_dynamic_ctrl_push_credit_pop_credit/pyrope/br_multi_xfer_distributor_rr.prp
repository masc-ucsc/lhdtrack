const br_arb_multi_rr = import("br_arb_multi_rr.br_arb_multi_rr")
const br_mux_onehot   = import("br_mux_onehot.br_mux_onehot")

// Distribute up to NUM_SYMBOLS pushed symbols per cycle to the ready pop flows,
// picking flows round-robin: symbol k goes to the k-th granted flow. Symbols
// and flows are packed with index 0 in the low bits.
pub mod br_multi_xfer_distributor_rr(clk:u1, rst:u1, push_sendable:u2, push_data:u10, pop_ready:u2) -> (
  push_receivable:u2@[0],
  pop_valid:u2@[0],
  pop_data:u10@[0]
) {
  comptime const NUM_FLOWS    = pop_ready.[bits]
  comptime const SYMBOL_WIDTH = pop_data.[bits]/NUM_FLOWS
  comptime const NUM_SYMBOLS  = push_data.[bits]/SYMBOL_WIDTH

  const arb = br_arb_multi_rr(clk=clk, rst=rst, enable_priority_update=1, request=pop_ready, grant_allowed=push_sendable)

  mut data:u10 = 0
  for f in 0..<NUM_FLOWS {
    // The symbol whose ordered grant went to flow f.
    mut select:unsigned(bits=NUM_SYMBOLS) = 0
    for k in 0..<NUM_SYMBOLS {
      select#[k] = arb.grant_ordered#[k*NUM_FLOWS + f]
    }
    data#[(f*SYMBOL_WIDTH)..+SYMBOL_WIDTH] = br_mux_onehot<NUM_INPUTS=NUM_SYMBOLS,WIDTH=SYMBOL_WIDTH>(select=select, `in`=push_data)
  }

  push_receivable = arb.grant_count
  pop_valid       = arb.grant
  pop_data        = data
}
