const br_enc_priority_encoder_p1 = import("br_enc_priority_encoder_p1.br_enc_priority_encoder_p1")
const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_enc_priority_dynamic<NumRequesters=2, NumResults=2>::[timecheck=false](clk:Clock, `in`:U2, lowest_prio:U2, rst:Reset) -> (out:U4@[]) {
  wire `out[0]`:U1 = nil
  wire `out[1]`:U1 = nil
  wire `out[2]`:U1 = nil
  wire `out[3]`:U1 = nil
  wire out:U4 = nil
  wire `priority_mask[0]`:U1 = nil
  wire `priority_mask[1]`:U1 = nil
  wire priority_mask:U2 = nil
  `priority_mask[0]` = U1(lowest_prio != 0) & 1
  `priority_mask[1]` = U1(((lowest_prio >> 1) & 1) != 0) & 1
  const in_high_prio__w1 = `in` & (~priority_mask)
  const t20 = ((`in` & priority_mask) << 1) | ((in_high_prio__w1 >> 1) & 1)
  mut br_enc_priority_encoder_inst = br_enc_priority_encoder_p1::[name=br_enc_priority_encoder_inst](clk=clk, rst=rst, `in.e2`=(t20 >> 2) & 1, `in.e1`=(t20 >> 1) & 1, `in.e0`=t20 & 1)
  const out_internal__w1 = br_enc_priority_encoder_inst
  br_misc_unused::[name=br_misc_unused_in_high_prio_lsb](`in`=in_high_prio__w1 & 1)
  `out[0]` = (out_internal__w1#[0..=2]#[1..=2] | ((out_internal__w1#[0..=2] & 1) << 1)) & 1
  `out[1]` = ((out_internal__w1#[0..=2]#[1..=2] | ((out_internal__w1#[0..=2] & 1) << 1)) >> 1) & 1
  `out[2]` = (out_internal__w1#[3..=5]#[1..=2] | ((out_internal__w1#[3..=5] & 1) << 1)) & 1
  `out[3]` = ((out_internal__w1#[3..=5]#[1..=2] | ((out_internal__w1#[3..=5] & 1) << 1)) >> 1) & 1
  out = (`out[3]` << 3) | (`out[2]` << 2) | (`out[1]` << 1) | `out[0]`
  priority_mask = (`priority_mask[1]` << 1) | `priority_mask[0]`
}
