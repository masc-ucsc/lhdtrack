const br_misc_unused_p5 = import("br_misc_unused_p5.br_misc_unused_p5")

pub mod br_flow_checks_valid_data_intg_p4<NumFlows=2, Width=1, EnableCoverBackpressure=1, EnableAssertValidStability=0, EnableAssertDataStability=0, EnableAssertDataKnown=1, EnableAssertFinalNotValid=0, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U2, ready:U2, rst:U1, valid:U2) -> () {
  br_misc_unused_p5::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 6) | (valid << 4) | (ready << 2) | data)
}
