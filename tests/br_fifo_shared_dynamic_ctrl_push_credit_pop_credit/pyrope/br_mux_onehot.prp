pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=5, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U10, select:U2) -> (out:U5) {
  mut _rep_1:U5 = if (select & 1) != 0 { 31 } else { 0 }
  mut _rep_2:U5 = if ((select >> 1) & 1) != 0 { 31 } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=4])) | (_rep_2 & `in`#[5..=9])
}
