// One-hot mux: OR together the WIDTH-bit symbols whose select bit is set.
// `in` packs NUM_INPUTS symbols, symbol 0 in the low bits.
pub comb br_mux_onehot<NUM_INPUTS=2, WIDTH=1>(select:unsigned(bits=NUM_INPUTS), `in`:unsigned(bits=NUM_INPUTS * WIDTH)) -> (
  out:unsigned(bits=WIDTH)
) {
  mut o:unsigned(bits=WIDTH) = 0
  for i in 0..<NUM_INPUTS {
    if select#[i] == 1 {
      o |= `in`#[(i*WIDTH)..+WIDTH]
    }
  }
  out = o
}
