const cfg = import("lhdtrack_cfg")

// One-hot mux: OR together the symbols whose select bit is set. `in` packs
// NumSymbolsIn symbols, symbol 0 in the low bits.
pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=5, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U10, select:U2) -> (out:U5) {
  if cfg.no_loop {
    mut _rep_1:U5 = if (select & 1) != 0 { 31 } else { 0 }
    mut _rep_2:U5 = if ((select >> 1) & 1) != 0 { 31 } else { 0 }
    out = (0 | (_rep_1 & `in`#[0..=4])) | (_rep_2 & `in`#[5..=9])
  } else {
    mut o:Unsigned(bits=SymbolWidth) = 0
    for i in 0..<NumSymbolsIn {
      if select#[i] == 1 {
        o |= `in`#[(i*SymbolWidth)..+SymbolWidth]
      }
    }
    out = o
  }
}
