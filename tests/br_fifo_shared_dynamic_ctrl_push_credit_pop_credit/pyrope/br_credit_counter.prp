// Credit counter: incr adds credits, decr takes them when enough are
// available above the withheld amount. Reset (re)loads initial_value.
// UNIT_DECREMENT is the bedrock MaxDecrement == 1 (with withhold) case, where
// a decrement is accepted whenever any credit is available.
pub mod br_credit_counter<VALUE_WIDTH=1, CHANGE_WIDTH=1, UNIT_DECREMENT=false>(
  rst:u1,
  incr_valid:bool,
  incr:unsigned(bits=CHANGE_WIDTH),
  decr_valid:bool,
  decr:unsigned(bits=CHANGE_WIDTH),
  initial_value:unsigned(bits=VALUE_WIDTH),
  withhold:unsigned(bits=VALUE_WIDTH)
) -> (decr_ready:bool@[0], value:unsigned(bits=VALUE_WIDTH)@[0], available:unsigned(bits=VALUE_WIDTH)@[0]) {
  // The counter register is the `value` output. Its reset value is an input,
  // so the reset is written out explicitly.
  reg value:unsigned(bits=VALUE_WIDTH) = nil

  const incr_amount = if incr_valid { incr } else { 0 }
  const decr_amount = if decr_valid { decr } else { 0 }
  mut plus_incr:unsigned(bits=VALUE_WIDTH) = 0
  wrap plus_incr = value + incr_amount

  // Guarded by the comparison, but the range analysis is path-insensitive.
  mut above_withhold:unsigned(bits=VALUE_WIDTH) = 0
  if plus_incr > withhold {
    wrap above_withhold = plus_incr - withhold
  }
  const ready = if UNIT_DECREMENT { above_withhold > 0 } else { decr_amount <= above_withhold }

  if rst == 1 {
    value = initial_value
  }
  elif incr_valid or (decr_valid and ready) {
    wrap value = plus_incr - (if ready { decr_amount } else { 0 })
  }

  decr_ready = ready
  available  = above_withhold
}
