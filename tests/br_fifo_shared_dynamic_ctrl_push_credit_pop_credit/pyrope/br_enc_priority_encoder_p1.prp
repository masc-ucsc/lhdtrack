pub mod br_enc_priority_encoder_p1<NumRequesters=3, NumResults=2, MsbHighestPriority=0, MaxInHot=2>::[timecheck=false](clk:Clock, `in`:(e2:U1, e1:U1, e0:U1), rst:Reset) -> (out:U6@[]) {
  wire out_internal_bits:U6 = nil
  wire out_internal:U6 = nil
  const in_internal = (`in`.e2 << 2) | (`in`.e1 << 1) | `in`.e0
  out_internal_bits#[0] = in_internal & 1
  out_internal_bits#[1] = U1(((in_internal >> 1) & 1) != 0 and (in_internal & 1) == 0) & 1
  out_internal_bits#[2] = U1(((in_internal >> 2) & 1) != 0 and in_internal#[0..=1] == 0) & 1
  const gen_out_internal_1_in_masked = in_internal & (~((out_internal_bits#[2] << 2) | (out_internal_bits#[1] << 1) | out_internal_bits#[0])#[0..=2])
  out_internal_bits#[3] = 0
  out_internal_bits#[4] = (gen_out_internal_1_in_masked >> 1) & 1
  mut _b2i_3 = if ((gen_out_internal_1_in_masked >> 2) & 1) != 0 and ((gen_out_internal_1_in_masked >> 1) & 1) == 0 { 1 } else { 0 }
  out_internal_bits#[5] = _b2i_3 & 1
  const out__w1 = out_internal
  out_internal = out_internal_bits
  out = out__w1
}
