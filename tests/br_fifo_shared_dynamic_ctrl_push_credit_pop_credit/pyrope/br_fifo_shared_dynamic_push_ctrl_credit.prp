const br_credit_receiver               = import("br_credit_receiver.br_credit_receiver")
const br_fifo_shared_dynamic_push_ctrl = import("br_fifo_shared_dynamic_push_ctrl.br_fifo_shared_dynamic_push_ctrl")

// Credit-based push side: the sender pushes only with credits from the credit
// receiver, and every entry freed by the pop side returns as a credit.
// Configuration: registered push outputs (so no initial credit delay).
pub mod br_fifo_shared_dynamic_push_ctrl_credit(
  clk:u1,
  rst:u1,
  push_sender_in_reset:u1,
  push_credit_stall:u1,
  push_valid:u2,
  push_data:u64,
  push_fifo_id:u2,
  credit_initial_push:u6,
  credit_withhold_push:u6,
  dealloc_valid:u2,
  dealloc_entry_id:u10
) -> (
  push_receiver_in_reset:u1@[1],
  push_credit:u2@[1],
  push_full:u1@[0],
  credit_available_push:u6@[0],
  credit_count_push:u6@[0],
  data_ram_wr_valid:u2@[0],
  data_ram_wr_addr:u10@[0],
  data_ram_wr_data:u64@[0],
  next_tail_valid:u4@[0],
  next_tail:u20@[0]
) {
  wire pop_credit:u2 = nil
  const receiver     = br_credit_receiver(
    clk=clk, rst=rst, push_sender_in_reset=push_sender_in_reset, push_credit_stall=push_credit_stall, push_valid=push_valid, pop_credit=pop_credit,
    credit_initial=credit_initial_push, credit_withhold=credit_withhold_push
  )
  const push = br_fifo_shared_dynamic_push_ctrl(
    clk=clk, rst=u1(rst == 1 or push_sender_in_reset == 1), push_valid=receiver.pop_valid, push_data=push_data, push_fifo_id=push_fifo_id,
    dealloc_valid=dealloc_valid, dealloc_entry_id=dealloc_entry_id
  )
  // Every freed entry returns to the sender as a credit.
  pop_credit = push.dealloc_count

  push_receiver_in_reset = receiver.push_receiver_in_reset
  push_credit            = receiver.push_credit
  push_full              = push.push_full
  credit_available_push  = receiver.credit_available
  credit_count_push      = receiver.credit_count
  data_ram_wr_valid      = push.data_ram_wr_valid
  data_ram_wr_addr       = push.data_ram_wr_addr
  data_ram_wr_data       = push.data_ram_wr_data
  next_tail_valid        = push.next_tail_valid
  next_tail              = push.next_tail
}
