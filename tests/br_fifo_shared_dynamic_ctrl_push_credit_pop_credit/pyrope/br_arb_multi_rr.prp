const br_enc_priority_dynamic = import("br_enc_priority_dynamic.br_enc_priority_dynamic")

// Multi-grant round-robin arbiter: grants up to `grant_allowed` requesters per
// cycle in round-robin order; the last one granted becomes the lowest priority.
// grant_ordered packs the grants in priority order, grant 0 in the low bits.
pub mod br_arb_multi_rr(clk:u1, rst:u1, enable_priority_update:u1, request:u2, grant_allowed:u2) -> (
  grant:u2@[0],
  grant_ordered:u4@[0],
  grant_count:u2@[0]
) {
  comptime const N          = request.[bits]
  comptime const MAX_GRANTS = grant_ordered.[bits]/N

  // After reset the last requester is the lowest priority, so requester 0 leads.
  reg lowest_prio:u2 = 1 << (N - 1)

  const all_grants    = br_enc_priority_dynamic(`in`=request, lowest_prio=lowest_prio)
  const request_count = request#+[..]
  const count         = if request_count <= grant_allowed { request_count } else { grant_allowed }

  // The last grant given this cycle becomes the lowest priority.
  const last = (count - 1)#[0..<1] // clog2(MAX_GRANTS) bits
  if enable_priority_update == 1 and request != 0 and grant_allowed > 0 {
    for k in 0..<MAX_GRANTS {
      if last == k {
        lowest_prio = all_grants#[(k*N)..+N]
      }
    }
  }

  mut ordered:u4 = 0
  mut any:u2     = 0
  for k in 0..<MAX_GRANTS {
    if grant_allowed > k {
      ordered#[(k*N)..+N] = all_grants#[(k*N)..+N]
      any                |= all_grants#[(k*N)..+N]
    }
  }
  grant         = any
  grant_ordered = ordered
  grant_count   = count
}
