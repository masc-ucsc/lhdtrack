const br_mux_onehot = import("br_mux_onehot.br_mux_onehot")

// Read crossbar: each FIFO's data-RAM read goes to the read port selected by
// its address' low bits; FIFOs competing for a port are arbitrated by an
// external arbiter (arb_*, packed [port][fifo]). The read data is returned by
// the caller, so this only steers addresses. The pop side is always ready.
pub mod br_fifo_shared_read_xbar(clk:u1, rst:u1, push_rd_addr_valid:u2, push_rd_addr:u10, arb_can_grant:u4, arb_grant:u4) -> (
  push_rd_addr_ready:u2@[0],
  pop_rd_addr_valid:u2@[0],
  pop_rd_addr:u10@[0],
  arb_request:u4@[0],
  arb_enable_priority_update:u2@[0]
) {
  comptime const NUM_FIFOS  = push_rd_addr_valid.[bits]
  comptime const NUM_PORTS  = pop_rd_addr_valid.[bits]
  comptime const ADDR_WIDTH = push_rd_addr.[bits]/NUM_FIFOS

  // Request and ready are computed in separate loops: in one rolled loop the
  // arbiter feedback (request -> arbiter -> can_grant -> ready) looks like a
  // combinational cycle to `lhd sim` (see suggestions2.md).
  mut request:u4 = 0
  for f in 0..<NUM_FIFOS {
    const port = push_rd_addr#[f*ADDR_WIDTH] // clog2(NUM_PORTS) low address bits
    for p in 0..<NUM_PORTS {
      if port == p {
        request#[p*NUM_FIFOS + f] = push_rd_addr_valid#[f]
      }
    }
  }

  mut addr_valid:u2 = 0
  mut addr:u10      = 0
  for p in 0..<NUM_PORTS {
    const port_request = request#[(p*NUM_FIFOS)..+NUM_FIFOS]
    addr_valid#[p]     = u1(port_request != 0)
    addr#[(p*ADDR_WIDTH)
      ..+ADDR_WIDTH] = br_mux_onehot<NUM_INPUTS=NUM_FIFOS,WIDTH=ADDR_WIDTH>(
      select=arb_grant#[(p*NUM_FIFOS)..+NUM_FIFOS], `in`=push_rd_addr
    )
  }

  mut ready:u2 = 0
  for f in 0..<NUM_FIFOS {
    const port = push_rd_addr#[f*ADDR_WIDTH]
    for p in 0..<NUM_PORTS {
      if port == p {
        ready#[f] = arb_can_grant#[p*NUM_FIFOS + f]
      }
    }
  }

  push_rd_addr_ready         = ready
  pop_rd_addr_valid          = addr_valid
  pop_rd_addr                = addr
  arb_request                = request
  arb_enable_priority_update = (1 << NUM_PORTS) - 1
}
