const br_credit_counter        = import("br_credit_counter.br_credit_counter")
const br_delay_valid           = import("br_delay_valid.br_delay_valid")
const br_enc_onehot2bin        = import("br_enc_onehot2bin.br_enc_onehot2bin")
const br_fifo_shared_read_xbar = import("br_fifo_shared_read_xbar.br_fifo_shared_read_xbar")

// Pop side of the shared dynamic FIFO with credit-based pop flow control and
// an external read-port arbiter (arb_*, packed [port][fifo]): a FIFO head is
// read from the data RAM when it has a pop credit, the popped entry is
// deallocated one cycle later, and the read data goes out tagged with its
// FIFO id. Configuration: 2 FIFOs, 2 read ports, 4 pop credits per FIFO,
// data-RAM read latency 1, registered deallocation.
pub mod br_fifo_shared_pop_ctrl_credit_ext_arbiter(
  clk:u1,
  rst:u1,
  head_valid:u2,
  head:u10,
  ram_empty:u2,
  pop_receiver_in_reset:u1,
  pop_credit:u2,
  credit_initial_pop:u6,
  credit_withhold_pop:u6,
  data_ram_rd_data_valid:u2,
  data_ram_rd_data:u64,
  arb_grant:u4,
  arb_can_grant:u4
) -> (
  head_ready:u2@[0],
  pop_sender_in_reset:u1@[0],
  pop_valid:u2@[0],
  pop_fifo_id:u2@[0],
  pop_data:u64@[0],
  pop_empty:u2@[0],
  credit_available_pop:u6@[0],
  credit_count_pop:u6@[0],
  dealloc_valid:u2@[],
  dealloc_entry_id:u10@[],
  data_ram_rd_addr_valid:u2@[0],
  data_ram_rd_addr:u10@[0],
  arb_request:u4@[0],
  arb_enable_priority_update:u2@[0]
) {
  comptime const NUM_FIFOS    = head_valid.[bits]
  comptime const NUM_PORTS    = data_ram_rd_data_valid.[bits]
  comptime const ADDR_WIDTH   = head.[bits]/NUM_FIFOS
  comptime const CREDIT_WIDTH = credit_count_pop.[bits]/NUM_FIFOS

  const either_rst = u1(pop_receiver_in_reset == 1 or rst == 1)

  // A FIFO requests a data-RAM read when its head is valid and it holds a pop
  // credit; the crossbar accepts it (driven below).
  wire rd_ready:u2    = nil
  mut rd_request:u2   = 0
  mut ready:u2        = 0
  mut credit_count:u6 = 0
  mut credit_avail:u6 = 0
  for f in 0..<NUM_FIFOS {
    const credits = br_credit_counter<VALUE_WIDTH=CREDIT_WIDTH,CHANGE_WIDTH=1,UNIT_DECREMENT=true>(
      rst=either_rst, incr_valid=pop_credit#[f] == 1, incr=1, decr_valid=rd_ready#[f] == 1 and head_valid#[f] == 1, decr=1, initial_value=credit_initial_pop#[(f
        * CREDIT_WIDTH)
        ..+CREDIT_WIDTH], withhold=credit_withhold_pop#[(f*CREDIT_WIDTH)..+CREDIT_WIDTH]
    )
    rd_request#[f] = u1(head_valid#[f] == 1 and credits.decr_ready)
    ready#[f] = u1(rd_ready#[f] == 1 and credits.decr_ready)
    credit_count#[(f*CREDIT_WIDTH)..+CREDIT_WIDTH] = credits.value
    credit_avail#[(f*CREDIT_WIDTH)..+CREDIT_WIDTH] = credits.available
  }

  const xbar = br_fifo_shared_read_xbar(
    clk=clk, rst=either_rst, push_rd_addr_valid=rd_request, push_rd_addr=head, arb_can_grant=arb_can_grant, arb_grant=arb_grant
  )
  rd_ready = xbar.push_rd_addr_ready

  // The FIFO a read port served, delayed to line up with the returning data.
  mut fifo_ids:u2 = 0
  for p in 0..<NUM_PORTS {
    const granted = br_enc_onehot2bin<NUM_VALUES=NUM_FIFOS,BIN_WIDTH=1>(`in`=arb_grant#[(p*NUM_FIFOS)..+NUM_FIFOS])
    const id      = br_delay_valid<T=u1>(rst=either_rst, in_valid=xbar.pop_rd_addr_valid#[p] == 1, `in`=granted.out)
    fifo_ids#[p]  = id.out
  }

  // Registered deallocation of the popped heads. `@[]`: fed back to the push
  // side as returning entries next to cycle-0 values.
  const popped = head_valid & ready
  reg dealloc_valid:u2:[reset_pin = ref either_rst]     = 0
  reg dealloc_entry_id:u10:[reset_pin = ref either_rst] = 0
  dealloc_valid = popped
  for f in 0..<NUM_FIFOS {
    if popped#[f] == 1 {
      dealloc_entry_id#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = head#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    }
  }

  head_ready = ready
  pop_sender_in_reset        = rst
  pop_valid = data_ram_rd_data_valid
  pop_fifo_id                = fifo_ids
  pop_data = data_ram_rd_data
  pop_empty = ram_empty
  credit_available_pop       = credit_avail
  credit_count_pop           = credit_count
  data_ram_rd_addr_valid     = xbar.pop_rd_addr_valid
  data_ram_rd_addr           = xbar.pop_rd_addr
  arb_request                = xbar.arb_request
  arb_enable_priority_update = xbar.arb_enable_priority_update
}
