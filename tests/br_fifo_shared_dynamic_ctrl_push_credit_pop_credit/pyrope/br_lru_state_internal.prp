const cfg = import("lhdtrack_cfg")
// Every upper-triangle bit (column > row) of a packed size x size matrix.
comb upper_triangle(size) -> (mask) {
  mut m = 0
  for row in 0..<size {
    const above_diagonal = ((1 << size) - 1) & ~((1 << (row + 1)) - 1)
    m |= above_diagonal << (row*size)
  }
  mask = m
}

// Least-recently-granted state as a pairwise priority matrix, packed row-major:
// bit i*N+j is 1 when requester i beats requester j. Only the upper triangle
// (i < j) is stored; the lower triangle is its complement, the diagonal zero.
pub mod br_lru_state_internal<NumRequesters=2>::[timecheck=false](clk:Clock, grant:(e1:U1, e0:U1), rst:U1, update_priority:U1) -> (state:U4@[]) {
  reg state_reg___q:U4
  if cfg.no_loop {
    mut state_reg__composite:U4 = 0
    wire state_reg:U4 = nil
    wire state_bits:U4 = nil
    wire state:U4 = nil
    wire state_reg_next_bits:U4 = nil
    state_reg__composite = state_reg___q
    state_bits#[0] = 0
    mut state_reg__composite__w1 = state_reg__composite
    state_reg__composite__w1#[0] = 0
    state_reg_next_bits#[0] = 0
    mut _mux_1:U1 = if grant.e1 != 0 { 1 } else { state_bits#[1] & 1 }
    mut _mux_2:U1 = if grant.e0 != 0 { 0 } else { _mux_1 & 1 }
    state_reg_next_bits#[1] = _mux_2 & 1
    if rst != 0 {
      state_reg___q#[1] = 1
    } elif update_priority != 0 {
      state_reg___q#[1] = state_reg_next_bits#[1] & 1
    }
    state_bits#[1] = (state_reg#[0..=1] >> 1) & 1
    mut _b2i_3 = if ((state_reg#[0..=1] >> 1) & 1) == 0 { 1 } else { 0 }
    state_bits#[2] = _b2i_3 & 1
    state_reg_next_bits#[2] = 0
    mut state_reg__composite__w2 = state_reg__composite__w1
    state_reg__composite__w2#[2] = 0
    state_bits#[3] = 0
    mut state_reg__composite__w3 = state_reg__composite__w2
    state_reg__composite__w3#[3] = 0
    state_reg_next_bits#[3] = 0
    state = state_bits
    state_reg = state_reg__composite__w3
  } else {
    comptime const N = NumRequesters
    // After reset every lower-numbered requester beats every higher one. Only
    // the upper-triangle bits are reset and updated; the others are never read.
    comptime const STORED = upper_triangle(size=N)

    const granted:U2 = (grant.e0#[0], grant.e1#[0])#[..]
    if rst == 1 {
      state_reg___q = state_reg___q | STORED
    } elif update_priority == 1 {
      mut next_wins:U4 = state_reg___q
      for i in 0..<N {
        // The granted requester loses to everyone; everyone beats a granted one.
        next_wins#[(i*N)..+N] = if granted#[i] == 1 { 0 } else { state_reg___q#[(i*N)..+N] | granted }
      }
      state_reg___q = (next_wins & STORED) | (state_reg___q & ~STORED)
    }

    mut matrix:U4 = 0
    for i in 0..<N {
      for j in 0..<N {
        if i < j {
          matrix#[i*N + j] = state_reg___q#[i*N + j]
        } elif i > j {
          matrix#[i*N + j] = ~state_reg___q#[j*N + i]
        }
      }
    }
    state = matrix
  }
}
