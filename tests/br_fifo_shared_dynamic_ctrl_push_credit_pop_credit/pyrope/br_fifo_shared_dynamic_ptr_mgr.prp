    fifo_ptr_ram_rd_data_bits#[15..<20] = gen_read_mux_1_rport_fifo_ptr_ram_rd_data#[5..=9]#[0..<5]
    ptr_ram_wr_addr = ptr_ram_wr_addr_bits
    ptr_ram_wr_data = ptr_ram_wr_data_bits
    ptr_ram_rd_addr = ptr_ram_rd_addr_bits
    head = head_bits
    items = items_bits
    wport_fifo_ptr_ram_wr_valid = (`wport_fifo_ptr_ram_wr_valid[1]` << 1) | `wport_fifo_ptr_ram_wr_valid[0]`
    wport_fifo_ptr_ram_wr_valid_s1 = (`wport_fifo_ptr_ram_wr_valid_s1[1]` << 1) | `wport_fifo_ptr_ram_wr_valid_s1[0]`
    wport_fifo_ptr_ram_wr_addr = wport_fifo_ptr_ram_wr_addr_bits
    wport_fifo_ptr_ram_wr_addr_s1 = wport_fifo_ptr_ram_wr_addr_s1_bits
    wport_fifo_ptr_ram_wr_data = wport_fifo_ptr_ram_wr_data_bits
    wport_fifo_ptr_ram_wr_data_s1 = wport_fifo_ptr_ram_wr_data_s1_bits
    rport_fifo_ptr_ram_rd_addr_valid = (`rport_fifo_ptr_ram_rd_addr_valid[1]` << 1) | `rport_fifo_ptr_ram_rd_addr_valid[0]`
    rport_fifo_ptr_ram_rd_addr_valid_s1 = (`rport_fifo_ptr_ram_rd_addr_valid_s1[1]` << 1) | `rport_fifo_ptr_ram_rd_addr_valid_s1[0]`
    rport_fifo_ptr_ram_rd_addr = rport_fifo_ptr_ram_rd_addr_bits
    rport_fifo_ptr_ram_rd_addr_s1 = rport_fifo_ptr_ram_rd_addr_s1_bits
    const t503 = `ptr_ram_wr_valid__bpo.e1`
    `ptr_ram_wr_valid__bpr.e1` = t503
    ptr_ram_wr_valid.e1 = t503
    const t504 = `ptr_ram_wr_valid__bpo.e0`
    `ptr_ram_wr_valid__bpr.e0` = t504
    ptr_ram_wr_valid.e0 = t504
    const t505 = `ptr_ram_rd_addr_valid__bpo.e1`
    ptr_ram_rd_addr_valid__bpr.e1 = t505
    ptr_ram_rd_addr_valid.e1 = t505
    const t506 = `ptr_ram_rd_addr_valid__bpo.e0`
    ptr_ram_rd_addr_valid__bpr.e0 = t506
    ptr_ram_rd_addr_valid.e0 = t506
    const t507 = gen_ll_ctrl_1_br_tracker_linked_list_ctrl.head_valid
    `head_valid__bpr.e1` = t507
    head_valid.e1 = t507
    const t508 = gen_ll_ctrl_0_br_tracker_linked_list_ctrl.head_valid
    `head_valid__bpr.e0` = t508
    head_valid.e0 = t508
    const t509 = gen_ll_ctrl_1_br_tracker_linked_list_ctrl.empty
    `empty__bpr.e1` = t509
    empty.e1 = t509
    const t510 = gen_ll_ctrl_0_br_tracker_linked_list_ctrl.empty
    `empty__bpr.e0` = t510
    empty.e0 = t510
  } else {
    comptime const ADDR_WIDTH  = head.[bits] / NumFifos
    comptime const COUNT_WIDTH = items.[bits] / NumFifos
    comptime const LANES       = NumWritePorts*ADDR_WIDTH

    const head_ready_bits:U2 = (head_ready.e0#[0], head_ready.e1#[0])#[..]
    const rd_valid_in:U2     = (ptr_ram_rd_data_valid.e0#[0], ptr_ram_rd_data_valid.e1#[0])#[..]

    // Pointer-RAM read data routed back to each list (driven below).
    wire list_rd_valid:U2 = nil
    wire list_rd_data:U10 = nil

    mut list_wr_valid:U4 = 0
    mut list_wr_addr:U20 = 0
    mut list_wr_data:U20 = 0
    mut list_rd_req:U2   = 0
    mut list_rd_addr:U10 = 0
    mut heads_valid:U2   = 0
    mut heads:U10        = 0
    mut empties:U2       = 0
    mut counts:U12       = 0
    for f in 0..<NumFifos {
      const list = br_tracker_linked_list_ctrl(
        clk=clk,
        rst=rst,
        `next_tail_valid.e1`=next_tail_valid#[f*NumWritePorts + 1],
        `next_tail_valid.e0`=next_tail_valid#[f*NumWritePorts],
        next_tail=next_tail#[(f*LANES)..+LANES],
        head_ready=head_ready_bits#[f],
        ptr_ram_rd_data_valid=list_rd_valid#[f],
        ptr_ram_rd_data=list_rd_data#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      )
      list_wr_valid#[(f*NumWritePorts)..+NumWritePorts] = (list.ptr_ram_wr_valid.e0#[0], list.ptr_ram_wr_valid.e1#[0])#[..]
      list_wr_addr#[(f*LANES)..+LANES]                  = list.ptr_ram_wr_addr
      list_wr_data#[(f*LANES)..+LANES]                  = list.ptr_ram_wr_data
      list_rd_req#[f]                                   = list.ptr_ram_rd_addr_valid
      list_rd_addr#[(f*ADDR_WIDTH)..+ADDR_WIDTH]        = list.ptr_ram_rd_addr
      heads_valid#[f]                                   = list.head_valid
      heads#[(f*ADDR_WIDTH)..+ADDR_WIDTH]               = list.head
      empties#[f]                                       = list.empty
      counts#[(f*COUNT_WIDTH)..+COUNT_WIDTH]            = list.items
    }

    // Write port p carries whichever list appended through it.
    mut wr_valid:U2 = 0
    mut wr_addr:U10 = 0
    mut wr_data:U10 = 0
    for p in 0..<NumWritePorts {
      mut any = false
      mut addr:Unsigned(bits=ADDR_WIDTH) = 0
      mut data:Unsigned(bits=ADDR_WIDTH) = 0
      for f in 0..<NumFifos {
        const lane = f*NumWritePorts + p
        if list_wr_valid#[lane] == 1 {
          any   = true
          addr |= list_wr_addr#[(lane*ADDR_WIDTH)..+ADDR_WIDTH]
          data |= list_wr_data#[(lane*ADDR_WIDTH)..+ADDR_WIDTH]
        }
      }
      wr_valid#[p]                          = U1(any)
      wr_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = addr
      wr_data#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = data
    }

    // Read port r serves the lists whose head address has low bits == r; the
    // requesting list is remembered for the data returning a cycle later.
    mut rd_valid:U2       = 0
    mut rd_addr:U10       = 0
    mut returned_valid:U2 = 0
    mut returned_data:U10 = 0
    for r in 0..<NumReadPorts {
      mut requesters:U2 = 0
      mut addr:Unsigned(bits=ADDR_WIDTH) = 0
      for f in 0..<NumFifos {
        const req      = list_rd_req#[f] == 1 and list_rd_addr#[f*ADDR_WIDTH] == r
        requesters#[f] = U1(req)
        if req {
          addr |= list_rd_addr#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
        }
      }
      rd_valid#[r]                          = U1(requesters != 0)
      rd_addr#[(r*ADDR_WIDTH)..+ADDR_WIDTH] = addr

      const requester = br_delay_valid(clk=clk, rst=rst, in_valid=U1(requesters != 0), `in`=requesters)
      const to_lists  = if rd_valid_in#[r] == 1 { requester.out } else { 0 }
      returned_valid |= to_lists
      for f in 0..<NumFifos {
        if to_lists#[f] == 1 {
          returned_data#[(f*ADDR_WIDTH)..+ADDR_WIDTH] |= ptr_ram_rd_data#[(r*ADDR_WIDTH)..+ADDR_WIDTH]
        }
      }
    }
    list_rd_valid = returned_valid
    list_rd_data  = returned_data

    ptr_ram_wr_valid      = (e1=wr_valid#[1], e0=wr_valid#[0])
    ptr_ram_wr_addr       = wr_addr
    ptr_ram_wr_data       = wr_data
    ptr_ram_rd_addr_valid = (e1=rd_valid#[1], e0=rd_valid#[0])
    ptr_ram_rd_addr       = rd_addr
    head_valid            = (e1=heads_valid#[1], e0=heads_valid#[0])
    head                  = heads
    empty                 = (e1=empties#[1], e0=empties#[0])
    items                 = counts
  }
}
