const br_delay_valid              = import("br_delay_valid.br_delay_valid")
const br_mux_onehot               = import("br_mux_onehot.br_mux_onehot")
const br_tracker_linked_list_ctrl = import("br_tracker_linked_list_ctrl.br_tracker_linked_list_ctrl")

// Pointer manager of the shared dynamic FIFO: one linked list per FIFO, all
// sharing one pointer RAM. Write ports carry each list's links; a list reads
// its next pointer through the read port selected by the head address' low
// bit. Buses are packed [fifo][port] or [port], index 0 in the low bits.
pub mod br_fifo_shared_dynamic_ptr_mgr(
  clk:u1,
  rst:u1,
  next_tail_valid:u4,
  next_tail:u20,
  ptr_ram_rd_data_valid:u2,
  ptr_ram_rd_data:u10,
  head_ready:u2
) -> (
  ptr_ram_wr_valid:u2@[0],
  ptr_ram_wr_addr:u10@[0],
  ptr_ram_wr_data:u10@[0],
  ptr_ram_rd_addr_valid:u2@[0],
  ptr_ram_rd_addr:u10@[0],
  head_valid:u2@[0],
  head:u10@[0],
  empty:u2@[0],
  items:u12@[0]
) {
  comptime const NUM_FIFOS   = head_ready.[bits]
  comptime const NUM_WPORTS  = ptr_ram_wr_valid.[bits]
  comptime const NUM_RPORTS  = ptr_ram_rd_data_valid.[bits]
  comptime const ADDR_WIDTH  = head.[bits]/NUM_FIFOS
  comptime const COUNT_WIDTH = items.[bits]/NUM_FIFOS
  comptime const LANES       = NUM_WPORTS*ADDR_WIDTH

  // Pointer-RAM read data routed back to each list (driven below).
  wire list_rd_valid:u2 = nil
  wire list_rd_data:u10 = nil

  mut list_wr_valid:u4 = 0
  mut list_wr_addr:u20 = 0
  mut list_wr_data:u20 = 0
  mut list_rd_req:u2   = 0
  mut list_rd_addr:u10 = 0
  mut heads_valid:u2   = 0
  mut heads:u10        = 0
  mut empties:u2       = 0
  mut counts:u12       = 0
  for f in 0..<NUM_FIFOS {
    const list = br_tracker_linked_list_ctrl(
      clk=clk, rst=rst, next_tail_valid=next_tail_valid#[(f*NUM_WPORTS)..+NUM_WPORTS], next_tail=next_tail#[(f*LANES)..+LANES], head_ready=head_ready#[f],
      ptr_ram_rd_data_valid=list_rd_valid#[f], ptr_ram_rd_data=list_rd_data#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    )
    list_wr_valid#[(f*NUM_WPORTS)..+NUM_WPORTS] = list.ptr_ram_wr_valid
    list_wr_addr#[(f*LANES)..+LANES]            = list.ptr_ram_wr_addr
    list_wr_data#[(f*LANES)..+LANES]            = list.ptr_ram_wr_data
    list_rd_req#[f] = list.ptr_ram_rd_addr_valid
    list_rd_addr#[(f*ADDR_WIDTH)..+ADDR_WIDTH]  = list.ptr_ram_rd_addr
    heads_valid#[f] = list.head_valid
    heads#[(f*ADDR_WIDTH)..+ADDR_WIDTH]         = list.head
    empties#[f] = list.empty
    counts#[(f*COUNT_WIDTH)..+COUNT_WIDTH]      = list.items
  }

  // Write port p carries whichever list appended through it.
  mut wr_valid:u2 = 0
  mut wr_addr:u10 = 0
  mut wr_data:u10 = 0
  for p in 0..<NUM_WPORTS {
    mut select:u2 = 0
    mut addrs:u10 = 0
    mut datas:u10 = 0
    for f in 0..<NUM_FIFOS {
      select#[f] = list_wr_valid#[f*NUM_WPORTS + p]
      addrs#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = list_wr_addr#[((f*NUM_WPORTS + p)*ADDR_WIDTH)..+ADDR_WIDTH]
      datas#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = list_wr_data#[((f*NUM_WPORTS + p)*ADDR_WIDTH)..+ADDR_WIDTH]
    }
    wr_valid#[p] = u1(select != 0)
    wr_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = br_mux_onehot<NUM_INPUTS=NUM_FIFOS,WIDTH=ADDR_WIDTH>(select=select, `in`=addrs)
    wr_data#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = br_mux_onehot<NUM_INPUTS=NUM_FIFOS,WIDTH=ADDR_WIDTH>(select=select, `in`=datas)
  }

  // Read port r serves the lists whose head address has low bits == r; the
  // requesting list is remembered for the data returning a cycle later.
  mut rd_valid:u2       = 0
  mut rd_addr:u10       = 0
  mut returned_valid:u2 = 0
  mut returned_data:u10 = 0
  for r in 0..<NUM_RPORTS {
    mut requesters:u2 = 0
    for f in 0..<NUM_FIFOS {
      requesters#[f] = u1(list_rd_req#[f] == 1 and list_rd_addr#[f*ADDR_WIDTH] == r)
    }
    rd_valid#[r] = u1(requesters != 0)
    rd_addr#[(r*ADDR_WIDTH)..+ADDR_WIDTH] = br_mux_onehot<NUM_INPUTS=NUM_FIFOS,WIDTH=ADDR_WIDTH>(select=requesters, `in`=list_rd_addr)

    const requester = br_delay_valid<T=u2>(rst=rst, in_valid=requesters != 0, `in`=requesters)
    const to_lists  = if ptr_ram_rd_data_valid#[r] == 1 { requester.out } else { 0 }
    returned_valid |= to_lists
    for f in 0..<NUM_FIFOS {
      if to_lists#[f] == 1 {
        returned_data#[(f*ADDR_WIDTH)
          ..+ADDR_WIDTH] = returned_data#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
          | ptr_ram_rd_data#[(r*ADDR_WIDTH)..+ADDR_WIDTH]
      }
    }
  }
  list_rd_valid = returned_valid
  list_rd_data  = returned_data

  ptr_ram_wr_valid      = wr_valid
  ptr_ram_wr_addr       = wr_addr
  ptr_ram_wr_data       = wr_data
  ptr_ram_rd_addr_valid = rd_valid
  ptr_ram_rd_addr       = rd_addr
  head_valid            = heads_valid
  head = heads
  empty = empties
  items = counts
}
