// One-hot to binary: the index of the set bit (OR of all set indices).
// BIN_WIDTH is clog2(NUM_VALUES), passed in because Pyrope has no clog2.
pub comb br_enc_onehot2bin<NUM_VALUES=2, BIN_WIDTH=1>(`in`:unsigned(bits=NUM_VALUES)) -> (
  out_valid:bool,
  out:unsigned(bits=BIN_WIDTH)
) {
  mut index:unsigned(bits=BIN_WIDTH) = 0
  for i in 1..<NUM_VALUES {
    if `in`#[i] == 1 {
      index |= i
    }
  }
  out_valid = `in` != 0
  out       = index
}
