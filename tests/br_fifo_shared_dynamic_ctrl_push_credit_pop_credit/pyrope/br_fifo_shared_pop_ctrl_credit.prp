const br_arb_lru_internal = import("br_arb_lru_internal.br_arb_lru_internal")
const br_fifo_shared_pop_ctrl_credit_ext_arbiter = import("br_fifo_shared_pop_ctrl_credit_ext_arbiter.br_fifo_shared_pop_ctrl_credit_ext_arbiter")

// Pop control with credits: the external-arbiter pop control plus one
// least-recently-used arbiter per data-RAM read port.
pub mod br_fifo_shared_pop_ctrl_credit(
  clk:u1,
  rst:u1,
  head_valid:u2,
  head:u10,
  ram_empty:u2,
  pop_receiver_in_reset:u1,
  pop_credit:u2,
  credit_initial_pop:u6,
  credit_withhold_pop:u6,
  data_ram_rd_data_valid:u2,
  data_ram_rd_data:u64
) -> (
  head_ready:u2@[0],
  pop_sender_in_reset:u1@[0],
  pop_valid:u2@[0],
  pop_fifo_id:u2@[0],
  pop_data:u64@[0],
  pop_empty:u2@[0],
  credit_available_pop:u6@[0],
  credit_count_pop:u6@[0],
  dealloc_valid:u2@[],
  dealloc_entry_id:u10@[],
  data_ram_rd_addr_valid:u2@[0],
  data_ram_rd_addr:u10@[0]
) {
  comptime const NUM_FIFOS = head_valid.[bits]
  comptime const NUM_PORTS = data_ram_rd_data_valid.[bits]

  wire arb_grant:u4     = nil
  wire arb_can_grant:u4 = nil
  const pop             = br_fifo_shared_pop_ctrl_credit_ext_arbiter(
    clk=clk, rst=rst, head_valid=head_valid, head=head, ram_empty=ram_empty, pop_receiver_in_reset=pop_receiver_in_reset, pop_credit=pop_credit,
    credit_initial_pop=credit_initial_pop, credit_withhold_pop=credit_withhold_pop, data_ram_rd_data_valid=data_ram_rd_data_valid, data_ram_rd_data=data_ram_rd_data,
    arb_grant=arb_grant, arb_can_grant=arb_can_grant
  )

  // One LRU arbiter per read port, over the FIFOs requesting that port.
  mut grants:u4     = 0
  mut can_grants:u4 = 0
  for p in 0..<NUM_PORTS {
    const arb = br_arb_lru_internal<NUM_REQUESTERS=NUM_FIFOS>(
      rst=u1(pop_receiver_in_reset == 1 or rst == 1), enable_priority_update=pop.arb_enable_priority_update#[p] == 1, request=pop.arb_request#[(p
        * NUM_FIFOS)
        ..+NUM_FIFOS]
    )
    grants#[(p*NUM_FIFOS)..+NUM_FIFOS]     = arb.grant
    can_grants#[(p*NUM_FIFOS)..+NUM_FIFOS] = arb.can_grant
  }
  arb_grant     = grants
  arb_can_grant = can_grants

  head_ready             = pop.head_ready
  pop_sender_in_reset    = pop.pop_sender_in_reset
  pop_valid              = pop.pop_valid
  pop_fifo_id            = pop.pop_fifo_id
  pop_data               = pop.pop_data
  pop_empty              = pop.pop_empty
  credit_available_pop   = pop.credit_available_pop
  credit_count_pop       = pop.credit_count_pop
  dealloc_valid          = pop.dealloc_valid
  dealloc_entry_id       = pop.dealloc_entry_id
  data_ram_rd_addr_valid = pop.data_ram_rd_addr_valid
  data_ram_rd_addr       = pop.data_ram_rd_addr
}
