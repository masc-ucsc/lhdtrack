  } else {
    push_full_next#[1] = unsigned(tail_next#[5..=9] == head#[5..=9]) & 1
    empty_next#[1] = 0
  }
  push_full_q = if rst != 0 { 0 } else { push_full_next }
  empty_q = if rst != 0 { 3 } else { empty_next }
  head = head__wtmp__w1
  head_valid = head_valid__w1
  items = items__w2
}
