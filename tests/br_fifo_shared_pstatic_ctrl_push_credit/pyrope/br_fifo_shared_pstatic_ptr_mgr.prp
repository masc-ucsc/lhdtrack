const br_counter_incr = import("br_counter_incr.br_counter_incr")

pub mod br_fifo_shared_pstatic_ptr_mgr::[timecheck=false](clk:u1, rst:u1, config_base:u10, config_bound:u10, config_size:u12, advance_tail:(e1:u1, e0:u1), tail_next:u10, tail:u10, head_ready:u2) -> (push_full:(e1:u1, e0:u1)@[], head_valid:u2@[], head:u10@[], empty:(e1:u1, e0:u1)@[], items:u12@[]) {
  reg push_full_q:u2
  reg empty_q:u2
  mut reinit_head:u2 = 0
  mut head_next:u10 = 0
  mut push_full_next:u2 = 0
  mut empty_next:u2 = 0
  mut head__wtmp:u10 = 0sb?
  wire head:u10
  push_full.e1 = (push_full_q >> 1) & 1
  push_full.e0 = push_full_q & 1
  empty.e1 = (empty_q >> 1) & 1
  empty.e0 = empty_q & 1
  reinit_head = 0sb?
