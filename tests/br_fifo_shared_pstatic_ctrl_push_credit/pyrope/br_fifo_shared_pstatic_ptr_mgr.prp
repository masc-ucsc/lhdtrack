  mut head_next__w2 = head_next__w1
  head_next__w2#[0..=4] = gen_fifo_pointers_0_br_counter_incr_head.value_next#[0..=4]
  if (advance_head__w1 & 1) == advance_tail.e0 {
    push_full_next#[0] = push_full_q & 1
    empty_next#[0] = empty_q & 1
  } elif (advance_head__w1 & 1) != 0 {
    push_full_next#[0] = 0
    empty_next#[0] = unsigned(head_next__w2#[0..=4] == tail#[0..=4]) & 1
  } else {
    push_full_next#[0] = unsigned(tail_next#[0..=4] == head#[0..=4]) & 1
    empty_next#[0] = 0
  }
  if ((advance_head__w1 >> 1) & 1) == advance_tail.e1 {
    push_full_next#[1] = (push_full_q >> 1) & 1
