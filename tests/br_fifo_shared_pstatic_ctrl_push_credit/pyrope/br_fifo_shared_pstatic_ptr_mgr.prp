  push_full_next = 0sb?
  empty_next = 0sb?
  items = 0sb?
  const head_valid__w1 = (~empty_q)#[0..=1]
  mut _mux_1:u6 = if tail#[0..=4] >= head#[0..=4] { (tail#[0..=4] - head#[0..=4])#[0..=4] } else { (config_size#[0..=5] - (head#[0..=4] - tail#[0..=4])#[0..=4])#[0..=5] }
  mut _mux_2:u6 = if (push_full_q & 1) != 0 { config_size#[0..=5] } else { _mux_1 }
  mut items__w1 = items
  items__w1#[0..=5] = _mux_2
  mut _mux_3:u6 = if tail#[5..=9] >= head#[5..=9] { (tail#[5..=9] - head#[5..=9])#[0..=4] } else { (config_size#[6..=11] - (head#[5..=9] - tail#[5..=9])#[0..=4])#[0..=5] }
  mut _mux_4:u6 = if ((push_full_q >> 1) & 1) != 0 { config_size#[6..=11] } else { _mux_3 }
  mut items__w2 = items__w1
  items__w2#[6..=11] = _mux_4
  const advance_head__w1 = head_ready & head_valid__w1
  mut reinit_head__w1 = reinit_head
  reinit_head__w1#[0] = unsigned(((advance_head__w1 & 1) != 0) and (head#[0..=4] == config_bound#[0..=4])) & 1
  mut reinit_head__w2 = reinit_head__w1
  reinit_head__w2#[1] = unsigned((((advance_head__w1 >> 1) & 1) != 0) and (head#[5..=9] == config_bound#[5..=9])) & 1
  mut gen_fifo_pointers_1_br_counter_incr_head = br_counter_incr::[name=gen_fifo_pointers_1_br_counter_incr_head](clk = clk, rst = rst, reinit = (reinit_head__w2 >> 1) & 1, initial_value = config_base#[5..=9], incr_valid = (advance_head__w1 >> 1) & 1, incr = 1)
  head__wtmp#[5..=9] = gen_fifo_pointers_1_br_counter_incr_head.value#[0..=4]
  mut head_next__w1 = head_next
  head_next__w1#[5..=9] = gen_fifo_pointers_1_br_counter_incr_head.value_next#[0..=4]
  mut gen_fifo_pointers_0_br_counter_incr_head = br_counter_incr::[name=gen_fifo_pointers_0_br_counter_incr_head](clk = clk, rst = rst, reinit = reinit_head__w2 & 1, initial_value = config_base#[0..=4], incr_valid = advance_head__w1 & 1, incr = 1)
  mut head__wtmp__w1 = head__wtmp
