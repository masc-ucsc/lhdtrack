const br_counter_incr = import("br_counter_incr.br_counter_incr")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")
const br_misc_tieoff_zero = import("br_misc_tieoff_zero.br_misc_tieoff_zero")
const br_misc_tieoff_zero_p1 = import("br_misc_tieoff_zero_p1.br_misc_tieoff_zero_p1")
const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_fifo_push_ctrl_core::[timecheck=false](clk:u1, rst:u1, push_valid:u1, push_data:u32, bypass_ready:u1, addr_base:u5, addr_bound:u5, full:u1) -> (push_ready:u1@[], bypass_valid_unstable:u1@[], bypass_data_unstable:u32@[], ram_wr_valid:u1@[], ram_wr_addr_next:u5@[], ram_wr_addr:u5@[], ram_wr_data:u32@[], push_beat:u1@[]) {
  wire ram_wr_addr:u5
  const push_ready__w1 = unsigned(full == 0)
  br_misc_unused_p1::[name=br_misc_unused_bypass_ready](`in` = bypass_ready)
  mut br_misc_tieoff_zero_bypass_valid_unstable = br_misc_tieoff_zero::[name=br_misc_tieoff_zero_bypass_valid_unstable]()
  mut br_misc_tieoff_zero_bypass_data_unstable = br_misc_tieoff_zero_p1::[name=br_misc_tieoff_zero_bypass_data_unstable]()
  /* TODO: result 'br_flow_checks_valid_data_intg' of zero-output module 'br_flow_checks_valid_data_intg' is read */
  const push_beat__w1 = unsigned((push_ready__w1 != 0) and (push_valid != 0))
  const ram_wr_valid__w1 = push_beat__w1
  mut br_counter_incr_wr_addr = br_counter_incr::[name=br_counter_incr_wr_addr](clk = clk, rst = rst, reinit = unsigned((ram_wr_valid__w1 != 0) and (ram_wr_addr == addr_bound)), initial_value = addr_base, incr_valid = ram_wr_valid__w1, incr = 1)
  ram_wr_addr = br_counter_incr_wr_addr.value
  push_ready = push_ready__w1
  bypass_valid_unstable = br_misc_tieoff_zero_bypass_valid_unstable
  bypass_data_unstable = br_misc_tieoff_zero_bypass_data_unstable
  ram_wr_valid = ram_wr_valid__w1
  ram_wr_addr_next = br_counter_incr_wr_addr.value_next
  ram_wr_data = push_data
  push_beat = push_beat__w1
}
