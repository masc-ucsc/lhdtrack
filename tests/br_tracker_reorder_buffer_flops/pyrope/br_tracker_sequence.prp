const br_counter_incr_p2 = import("br_counter_incr_p2.br_counter_incr_p2")
const br_counter_p1 = import("br_counter_p1.br_counter_p1")

pub mod br_tracker_sequence<NumEntries=16, MaxAllocSize=1, EntryIdWidth=4, EnableAssertFinalNotDeallocValid=0>::[timecheck=false](alloc_receivable:U1, clk:Clock, dealloc_size:U1, dealloc_valid:U1, rst:Reset) -> (alloc_entry_id:U4@[], alloc_sendable:U1@[], allocated_entry_count:U5@[], free_entry_count:U5@[]) {
  mut _mux_1:S32 = 0
  wire alloc_counter_value:U4 = nil
  wire free_entry_count:U5 = nil
  _mux_1 = MaxAllocSize#sext[0..=31]
  alloc_entry_id = 0sb?
  mut alloc_entry_id__w1 = alloc_entry_id
  alloc_entry_id__w1#[0..=3] = alloc_counter_value
  const allocated_entry_count__w1 = (NumEntries#[0..=4] - free_entry_count)#[0..=4]
  mut _mux_2:U32 = if free_entry_count > MaxAllocSize { MaxAllocSize } else { free_entry_count & 1 }
  const alloc_sendable__w1 = _mux_2 & 1
  mut _b2i_3 = if alloc_receivable > 0 and alloc_sendable__w1 > 0 { 1 } else { 0 }
  const alloc_beat = _b2i_3
  mut _mux_4:U1 = if alloc_receivable > alloc_sendable__w1 { alloc_sendable__w1 & 1 } else { alloc_receivable & 1 }
  const alloc_size = _mux_4
  mut br_counter_incr_allocate_counter = br_counter_incr_p2::[name=br_counter_incr_allocate_counter](clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=alloc_beat, incr=alloc_size)
  alloc_counter_value = br_counter_incr_allocate_counter.value
  mut br_counter_free_entry_counter = br_counter_p1::[name=br_counter_free_entry_counter](clk=clk, rst=rst, reinit=0, initial_value=NumEntries#[0..=4], incr_valid=dealloc_valid, incr=dealloc_size, decr_valid=alloc_beat, decr=alloc_size)
  free_entry_count = br_counter_free_entry_counter.value
  alloc_sendable = alloc_sendable__w1
  alloc_entry_id = alloc_entry_id__w1
  allocated_entry_count = allocated_entry_count__w1
}
