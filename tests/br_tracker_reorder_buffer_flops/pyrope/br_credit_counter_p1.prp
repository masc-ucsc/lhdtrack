pub mod br_credit_counter_p1<MaxValueWidth=32, MaxChangeWidth=32, MaxValue=2, MaxChange=1, MaxIncrement=1, MaxDecrement=1, EnableCoverZeroIncrement=0, EnableCoverZeroDecrement=0, EnableCoverDecrementBackpressure=1, EnableCoverWithhold=0, EnableAssertAlwaysDecr=1, EnableAssertFinalNotValid=0, CoverMaxValue=2, EnableAssertFinalMaxValue=0, EnableAssertFinalMinValue=1, EnableAssertNoDecrementBackpressure=0>::[timecheck=false](clk:Clock, decr:U1, decr_valid:U1, incr:U1, incr_valid:U1, initial_value:U2, rst:U1, withhold:U2) -> (available:U2@[], decr_ready:U1@[], value:U2@[]) {
  reg value:U2
  mut _mux_1:U1 = if incr_valid != 0 { incr & 1 } else { 0 }
  mut _mux_2:U1 = if decr_valid != 0 { decr & 1 } else { 0 }
  const value_plus_incr__w1 = (value + _mux_1)#[0..=1]
  mut _mux_3:U2 = if value_plus_incr__w1 > withhold { (value_plus_incr__w1 - withhold)#[0..=1] } else { 0 }
  mut _b2i_4 = if value != 0 or incr_valid != 0 { 1 } else { 0 }
  const decr_ready__w1 = _b2i_4
  mut _mux_5:U2 = if decr_ready__w1 != 0 { _mux_2 } else { 0 }
  const value_next__w1 = (value_plus_incr__w1 - _mux_5)#[0..=1]
  mut _b2i_6 = if incr_valid != 0 or (decr_valid != 0 and decr_ready__w1 != 0) { 1 } else { 0 }
  if rst != 0 {
    value = initial_value
  } elif _b2i_6 != 0 {
    value = value_next__w1
  }
  decr_ready = decr_ready__w1
  available = _mux_3
}
