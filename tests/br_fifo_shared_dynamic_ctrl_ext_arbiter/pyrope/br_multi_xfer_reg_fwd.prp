const br_shift_left = import("br_shift_left.br_shift_left")
const br_shift_right = import("br_shift_right.br_shift_right")

pub mod br_multi_xfer_reg_fwd<NumSymbols=2, SymbolWidth=5, EnableCoverPushBackpressure=1, EnableAssertPushDataStability=0, EnableAssertFinalNotSendable=0, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_receivable:U2, push_data:U10, push_sendable:U2, rst:U1) -> (pop_data:U10@[], pop_sendable:U2@[], push_receivable:U2@[]) {
  reg pop_sendable:U2:[async=false, initial=0, reset_pin=rst]
  reg pop_data:U10:[async=false, initial=0, reset_pin=rst]
  wire push_data_qual_bits:U10 = nil
  wire push_data_qual:U10 = nil
  mut _mux_1:U2 = if pop_sendable < pop_receivable { pop_sendable } else { pop_receivable }
  const pop_xfer_count = _mux_1
  const pop_sendable_after_xfer = (pop_sendable - pop_xfer_count)#[0..=1]
  const push_receivable__w1 = (NumSymbols - pop_sendable_after_xfer)#[0..=31]#[0..=1]
  mut _mux_2:U2 = if push_sendable < push_receivable__w1 { push_sendable } else { push_receivable__w1 }
  const push_xfer_count = _mux_2
  const pop_sendable_next = (pop_sendable_after_xfer + push_xfer_count)#[0..=1]
  mut br_shift_right_data = br_shift_right::[name=br_shift_right_data](`in`=pop_data, shift=pop_xfer_count & 1, fill=0)
  mut _mux_3:U10 = if pop_xfer_count == NumSymbols { 0 } else { br_shift_right_data.out#[0..=9] }
  mut _mux_4:U5 = if push_sendable > 0 { push_data#[0..=4] } else { 0 }
  push_data_qual_bits#[0..<5] = _mux_4#[0..<5]
  mut _mux_5:U5 = if push_sendable > 1 { push_data#[5..=9] } else { 0 }
  push_data_qual_bits#[5..<10] = _mux_5#[0..<5]
  mut br_shift_left_data = br_shift_left::[name=br_shift_left_data](`in`=push_data_qual, shift=pop_sendable_after_xfer & 1, fill=0)
  mut _mux_6:U10 = if pop_sendable_after_xfer == NumSymbols { 0 } else { br_shift_left_data.out#[0..=9] }
  mut _b2i_7 = if push_xfer_count != 0 or pop_xfer_count != 0 { 1 } else { 0 }
  const pop_update = _b2i_7
  if not (rst != 0) {
    if pop_update != 0 {
      pop_sendable = pop_sendable_next
    }
  }
  if not (rst != 0) {
    if pop_update != 0 {
      pop_data = _mux_3 | _mux_6
    }
  }
  push_data_qual = push_data_qual_bits
  push_receivable = push_receivable__w1
}
