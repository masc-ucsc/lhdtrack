const br_arb_pairwise_core_internal = import("br_arb_pairwise_core_internal.br_arb_pairwise_core_internal")
const br_arb_weight_handler = import("br_arb_weight_handler.br_arb_weight_handler")
const br_lru_state_internal = import("br_lru_state_internal.br_lru_state_internal")

pub mod br_arb_weighted_lru<NumRequesters=4, MaxWeight=4, MaxAccumulatedWeight=16>::[timecheck=false,synth.abc_pre="resyn2"](clk:Clock, enable_priority_update:U1, request:U4, request_weight:U12, rst:Reset) -> (grant:U4@[]) {
  wire priority_matrix:U16 = nil
  const gen_n_req_br_arb_pairwise_core_internal = br_arb_pairwise_core_internal(request=request, priority_matrix=priority_matrix)
  const granted:U4 = gen_n_req_br_arb_pairwise_core_internal.grant
  const gen_n_req_br_arb_weight_handler = br_arb_weight_handler(clk=clk, rst=rst, enable_priority_update=enable_priority_update, request=request, request_weight=request_weight, grant=granted)
  const priority = gen_n_req_br_arb_weight_handler.request_priority
  const rp:U4 = (priority.e0#[0], priority.e1#[0], priority.e2#[0], priority.e3#[0])#[..]
  const gen_n_req_br_lru_state_internal = br_lru_state_internal(clk=clk, rst=U1(rst), update_priority=U1(enable_priority_update == 1 and request != 0), grant=(e3=granted#[3], e2=granted#[2], e1=granted#[1], e0=granted#[0]))
  const state:U16 = gen_n_req_br_lru_state_internal

  // A requester with accumulated weight beats one without; between equals the
  // LRU order decides.
  const row0:U4 = if rp#[0] == 1 { state#[0..<4] | ~rp } else { state#[0..<4] & ~rp }
  const row1:U4 = if rp#[1] == 1 { state#[4..<8] | ~rp } else { state#[4..<8] & ~rp }
  const row2:U4 = if rp#[2] == 1 { state#[8..<12] | ~rp } else { state#[8..<12] & ~rp }
  const row3:U4 = if rp#[3] == 1 { state#[12..<16] | ~rp } else { state#[12..<16] & ~rp }
  priority_matrix = (row0, row1, row2, row3)#[..]
  grant = granted
}
