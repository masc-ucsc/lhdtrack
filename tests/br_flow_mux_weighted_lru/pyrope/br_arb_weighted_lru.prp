pub mod br_arb_weighted_lru<NumRequesters=4, MaxWeight=4, MaxAccumulatedWeight=16>::[timecheck=false](clk:Clock, enable_priority_update:U1, request:U4, request_weight:U12, rst:Reset) -> (grant:U4@[]) {
  wire priority_matrix_bits:U16 = nil
  wire priority_matrix:U16 = nil
  grant = 0sb?
  mut gen_n_req_br_arb_pairwise_core_internal = br_arb_pairwise_core_internal::[name=gen_n_req_br_arb_pairwise_core_internal](request=request, priority_matrix=priority_matrix)
