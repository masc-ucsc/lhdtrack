  const gen_n_req_request_priority = (gen_n_req_br_arb_weight_handler.request_priority.e3 << 3) | (gen_n_req_br_arb_weight_handler.request_priority.e2 << 2) | (gen_n_req_br_arb_weight_handler.request_priority.e1 << 1) | gen_n_req_br_arb_weight_handler.request_priority.e0
  mut _b2i_1 = if enable_priority_update != 0 and request != 0 { 1 } else { 0 }
  mut gen_n_req_br_lru_state_internal = br_lru_state_internal::[name=gen_n_req_br_lru_state_internal](clk=clk, rst=rst, update_priority=_b2i_1, `grant.e3`=(gen_n_req_br_arb_pairwise_core_internal.grant >> 3) & 1, `grant.e2`=(gen_n_req_br_arb_pairwise_core_internal.grant >> 2) & 1, `grant.e1`=(gen_n_req_br_arb_pairwise_core_internal.grant >> 1) & 1, `grant.e0`=gen_n_req_br_arb_pairwise_core_internal.grant & 1)
  const gen_n_req_state = gen_n_req_br_lru_state_internal
  mut _mux_2:U1 = if (gen_n_req_request_priority & 1) == (gen_n_req_request_priority & 1) { gen_n_req_state#[0..=3] & 1 }
    else { gen_n_req_request_priority & 1 }
  priority_matrix_bits#[0] = _mux_2 & 1
  mut _mux_3:U1 = if (gen_n_req_request_priority & 1) == ((gen_n_req_request_priority >> 1) & 1) {
    (gen_n_req_state#[0..=3] >> 1) & 1
  } else {
    gen_n_req_request_priority & 1
  }
  priority_matrix_bits#[1] = _mux_3 & 1
  mut _mux_4:U1 = if (gen_n_req_request_priority & 1) == ((gen_n_req_request_priority >> 2) & 1) {
    (gen_n_req_state#[0..=3] >> 2) & 1
  } else {
    gen_n_req_request_priority & 1
  }
