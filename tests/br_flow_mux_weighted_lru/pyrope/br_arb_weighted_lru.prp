  priority_matrix_bits#[7] = _mux_9 & 1
  mut _mux_10:U1 = if ((gen_n_req_request_priority >> 2) & 1) == (gen_n_req_request_priority & 1) { gen_n_req_state#[8..=11] & 1 }
    else { (gen_n_req_request_priority >> 2) & 1 }
  priority_matrix_bits#[8] = _mux_10 & 1
  mut _mux_11:U1 = if ((gen_n_req_request_priority >> 2) & 1) == ((gen_n_req_request_priority >> 1) & 1) {
    (gen_n_req_state#[8..=11] >> 1) & 1
  } else {
    (gen_n_req_request_priority >> 2) & 1
  }
  priority_matrix_bits#[9] = _mux_11 & 1
  mut _mux_12:U1 = if ((gen_n_req_request_priority >> 2) & 1) == ((gen_n_req_request_priority >> 2) & 1) {
    (gen_n_req_state#[8..=11] >> 2) & 1
  } else {
    (gen_n_req_request_priority >> 2) & 1
  }
  priority_matrix_bits#[10] = _mux_12 & 1
  mut _mux_13:U1 = if ((gen_n_req_request_priority >> 2) & 1) == ((gen_n_req_request_priority >> 3) & 1) {
    (gen_n_req_state#[8..=11] >> 3) & 1
  } else {
    (gen_n_req_request_priority >> 2) & 1
  }
  priority_matrix_bits#[11] = _mux_13 & 1
  mut _mux_14:U1 = if ((gen_n_req_request_priority >> 3) & 1) == (gen_n_req_request_priority & 1) { gen_n_req_state#[12..=15] & 1 }
    else { (gen_n_req_request_priority >> 3) & 1 }
  priority_matrix_bits#[12] = _mux_14 & 1
  mut _mux_15:U1 = if ((gen_n_req_request_priority >> 3) & 1) == ((gen_n_req_request_priority >> 1) & 1) {
    (gen_n_req_state#[12..=15] >> 1) & 1
  } else {
    (gen_n_req_request_priority >> 3) & 1
  }
  priority_matrix_bits#[13] = _mux_15 & 1
  mut _mux_16:U1 = if ((gen_n_req_request_priority >> 3) & 1) == ((gen_n_req_request_priority >> 2) & 1) {
