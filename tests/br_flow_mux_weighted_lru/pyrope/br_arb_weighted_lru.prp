  priority_matrix_bits#[3] = _mux_5 & 1
  mut _mux_6:U1 = if ((gen_n_req_request_priority >> 1) & 1) == (gen_n_req_request_priority & 1) { gen_n_req_state#[4..=7] & 1 }
    else { (gen_n_req_request_priority >> 1) & 1 }
  priority_matrix_bits#[4] = _mux_6 & 1
  mut _mux_7:U1 = if ((gen_n_req_request_priority >> 1) & 1) == ((gen_n_req_request_priority >> 1) & 1) {
