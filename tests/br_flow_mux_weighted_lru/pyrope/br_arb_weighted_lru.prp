  }
  priority_matrix_bits#[5] = _mux_7 & 1
  mut _mux_8:U1 = if ((gen_n_req_request_priority >> 1) & 1) == ((gen_n_req_request_priority >> 2) & 1) {
    (gen_n_req_state#[4..=7] >> 2) & 1
  } else {
    (gen_n_req_request_priority >> 1) & 1
  }
  priority_matrix_bits#[6] = _mux_8 & 1
  mut _mux_9:U1 = if ((gen_n_req_request_priority >> 1) & 1) == ((gen_n_req_request_priority >> 3) & 1) {
    (gen_n_req_state#[4..=7] >> 3) & 1
  } else {
