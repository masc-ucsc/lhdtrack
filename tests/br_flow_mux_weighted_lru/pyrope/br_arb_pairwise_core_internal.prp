  mut can_grant__w4 = can_grant__w3
  can_grant__w4#[0] = can_grant__w3 & 1 & U1(((request >> 3) & 1) == 0 or ((priority_matrix#[0..=3] >> 3) & 1) != 0) & 1
  mut can_grant__w5 = can_grant__w4
  can_grant__w5#[1] = (can_grant__w4 >> 1) & 1 & U1((request & 1) == 0 or (priority_matrix#[4..=7] & 1) != 0) & 1
  mut can_grant__w6 = can_grant__w5
  can_grant__w6#[1] = (can_grant__w5 >> 1) & 1 & U1(((request >> 2) & 1) == 0 or ((priority_matrix#[4..=7] >> 2) & 1) != 0) & 1
  mut can_grant__w7 = can_grant__w6
  can_grant__w7#[1] = (can_grant__w6 >> 1) & 1 & U1(((request >> 3) & 1) == 0 or ((priority_matrix#[4..=7] >> 3) & 1) != 0) & 1
  mut can_grant__w8 = can_grant__w7
  can_grant__w8#[2] = (can_grant__w7 >> 2) & 1 & U1((request & 1) == 0 or (priority_matrix#[8..=11] & 1) != 0) & 1
  const t88 = (can_grant__w8 >> 2) & 1 & U1(((request >> 1) & 1) == 0 or ((priority_matrix#[8..=11] >> 1) & 1) != 0)
  const t89 = t88 & 1
  mut can_grant__w9 = can_grant__w8
  can_grant__w9#[2] = t89
  const t90 = can_grant__w9 >> 2
  const t91 = t90 & 1
  const t100 = t91 & U1(((request >> 3) & 1) == 0 or ((priority_matrix#[8..=11] >> 3) & 1) != 0)
  const t101 = t100 & 1
  mut can_grant__w10 = can_grant__w9
  can_grant__w10#[2] = t101
  const t102 = can_grant__w10 >> 3
  const t103 = t102 & 1
  const t110 = t103 & U1((request & 1) == 0 or (priority_matrix#[12..=15] & 1) != 0)
