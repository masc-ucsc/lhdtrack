  const t122 = t113 & U1(((request >> 1) & 1) == 0 or ((priority_matrix#[12..=15] >> 1) & 1) != 0)
  const t123 = t122 & 1
  mut can_grant__w12 = can_grant__w11
  can_grant__w12#[3] = t123
