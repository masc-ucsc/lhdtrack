pub comb br_arb_pairwise_core_internal<NumRequesters=4>::[timecheck=false,synth.abc_pre="resyn2"](priority_matrix:U16, request:U4) -> (can_grant:U4, grant:U4) {
  // Requester i may be granted when every other active requester loses to it.
  comptime const ALL = 0xf
  const idle:U4 = ~request
  mut can:U4 = 0
  can#[0] = U1((priority_matrix#[0..<4] | idle | 1) == ALL)
  can#[1] = U1((priority_matrix#[4..<8] | idle | 2) == ALL)
  can#[2] = U1((priority_matrix#[8..<12] | idle | 4) == ALL)
  can#[3] = U1((priority_matrix#[12..<16] | idle | 8) == ALL)
  can_grant = can
  grant = request & can
}
