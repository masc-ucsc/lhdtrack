const br_arb_weighted_lru = import("br_arb_weighted_lru.br_arb_weighted_lru")
const br_flow_mux_core_t = import("br_flow_mux_core.br_flow_mux_core")

pub mod br_flow_mux_weighted_lru::[timecheck=false](clk:u1, rst:u1, cfg_weight:u12, push_valid:u4, push_data:u128, pop_ready:u1) -> (push_ready:u4@[], pop_valid_unstable:u1@[], pop_data_unstable:u32@[]) {
  wire request:u4
  wire enable_priority_update:u1
  mut br_arb_weighted_lru_inst = br_arb_weighted_lru::[name=br_arb_weighted_lru_inst](clk = clk, rst = rst, enable_priority_update = enable_priority_update, request = request, request_weight = cfg_weight)
  const grant__w1 = br_arb_weighted_lru_inst
  mut br_flow_mux_core = br_flow_mux_core_t::[name=br_flow_mux_core](clk = clk, rst = rst, can_grant = grant__w1, grant = grant__w1, push_valid = push_valid, push_data = push_data, pop_ready = pop_ready)
  request = br_flow_mux_core.request
  enable_priority_update = br_flow_mux_core.enable_priority_update
  push_ready = br_flow_mux_core.push_ready
  pop_valid_unstable = br_flow_mux_core.pop_valid_unstable
  pop_data_unstable = br_flow_mux_core.pop_data_unstable
}
