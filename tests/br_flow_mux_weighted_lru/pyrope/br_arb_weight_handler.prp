const br_counter = import("br_counter.br_counter")

pub mod br_arb_weight_handler<NumRequesters=4, MaxWeight=4, MaxAccumulatedWeight=16>::[timecheck=false,synth.abc_pre="resyn2"](clk:Clock, enable_priority_update:U1, grant:U4, request:U4, request_weight:U12, rst:Reset) -> (request_priority:(e3:U1, e2:U1, e1:U1, e0:U1)@[]) {
  // Each requester accumulates its weight when nobody with weight left is
  // requesting, and spends one unit per grant.
  wire priority:U4 = nil
  const decr:U4 = if enable_priority_update == 1 { grant } else { 0 }
  const incr = U1(enable_priority_update == 1 and request != 0 and (request & priority) == 0)
  mut has_weight:U4 = 0
  const gen_accumulated_weight_0_br_counter = br_counter(clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=incr, incr=request_weight#[0..<3], decr_valid=decr#[0], decr=1)
  has_weight#[0] = U1(gen_accumulated_weight_0_br_counter.value != 0)
  const gen_accumulated_weight_1_br_counter = br_counter(clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=incr, incr=request_weight#[3..<6], decr_valid=decr#[1], decr=1)
  has_weight#[1] = U1(gen_accumulated_weight_1_br_counter.value != 0)
  const gen_accumulated_weight_2_br_counter = br_counter(clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=incr, incr=request_weight#[6..<9], decr_valid=decr#[2], decr=1)
  has_weight#[2] = U1(gen_accumulated_weight_2_br_counter.value != 0)
  const gen_accumulated_weight_3_br_counter = br_counter(clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=incr, incr=request_weight#[9..<12], decr_valid=decr#[3], decr=1)
  has_weight#[3] = U1(gen_accumulated_weight_3_br_counter.value != 0)
  priority = has_weight
  request_priority = (e3=priority#[3], e2=priority#[2], e1=priority#[1], e0=priority#[0])
}
