pub mod br_flow_arb_core<NumFlows=4, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertFinalNotValid=1, EnableCoverPopBackpressure=1, ArbiterAlwaysGrants=1, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false,synth.abc_pre="resyn2"](can_grant:U4, clk:Clock, grant:U4, pop_ready:U1, push_valid:U4, rst:Reset) -> (enable_priority_update:U1@[], pop_valid_unstable:U1@[], push_ready:U4@[], request:U4@[]) {
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = if pop_ready == 1 { can_grant } else { 0 }
  pop_valid_unstable = U1(push_valid != 0)
}
