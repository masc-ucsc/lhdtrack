const br_counter = import("br_counter.br_counter")
const br_fifo_pop_ctrl_core_t = import("br_fifo_pop_ctrl_core.br_fifo_pop_ctrl_core")

pub mod br_fifo_pop_ctrl<Depth=16, Width=0x40, EnableBypass=0, RamReadLatency=0, RegisterPopOutputs=1, RamDepth=16, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1>::[timecheck=false](bypass_data_unstable:U64, bypass_valid_unstable:U1, clk:Clock, pop_ready:U1, push_beat:U1, ram_rd_data:U64, ram_rd_data_valid:U1, rst:U1) -> (bypass_ready:U1@[], empty:U1@[], empty_next:U1@[], items:U5@[], items_next:U5@[], pop_beat:U1@[], pop_data:U64@[], pop_valid:U1@[], ram_rd_addr:U4@[], ram_rd_addr_valid:U1@[]) {
  reg empty:U1:[async=false, initial=1, reset_pin=rst]
  wire items:U5 = nil
  mut br_fifo_pop_ctrl_core = br_fifo_pop_ctrl_core_t::[name=br_fifo_pop_ctrl_core](clk=clk, rst=rst, pop_ready=pop_ready, bypass_valid_unstable=bypass_valid_unstable, bypass_data_unstable=bypass_data_unstable, ram_rd_data_valid=ram_rd_data_valid, ram_rd_data=ram_rd_data, empty=empty, items=items)
  mut br_counter_items = br_counter::[name=br_counter_items](clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=push_beat, incr=1, decr_valid=br_fifo_pop_ctrl_core.pop_beat, decr=1)
  items = br_counter_items.value
  const empty_next__w1 = U1(br_counter_items.value_next == 0)
  if not (rst != 0) {
    if push_beat != 0 or br_fifo_pop_ctrl_core.pop_beat != 0 {
      empty = empty_next__w1
    }
  }
  pop_valid = br_fifo_pop_ctrl_core.pop_valid
  pop_data = br_fifo_pop_ctrl_core.pop_data
  empty_next = empty_next__w1
  items_next = br_counter_items.value_next
  bypass_ready = br_fifo_pop_ctrl_core.bypass_ready
  ram_rd_addr_valid = br_fifo_pop_ctrl_core.ram_rd_addr_valid
  ram_rd_addr = br_fifo_pop_ctrl_core.ram_rd_addr
  pop_beat = br_fifo_pop_ctrl_core.pop_beat
}
