const br_counter_p1 = import("br_counter_p1.br_counter_p1")
const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")
const br_misc_tieoff_zero = import("br_misc_tieoff_zero.br_misc_tieoff_zero")
const br_misc_unused = import("br_misc_unused.br_misc_unused")
const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_fifo_staging_buffer::[timecheck=false](clk:u1, rst:u1, total_items:u5, bypass_valid_unstable:u1, bypass_data_unstable:u64, ram_rd_addr_ready:u1, ram_rd_data_valid:u1, ram_rd_data:u64, pop_ready:u1) -> (bypass_ready:u1@[], ram_rd_addr_valid:u1@[], pop_valid:u1@[], pop_data:u64@[], pop_empty:u1@[]) {
  reg pop_empty:u1
  wire staged_items:u1
  wire pop_valid:u1
  const pop_beat__w1 = unsigned((pop_valid != 0) and (pop_ready != 0))
  mut gen_no_bypass_push_br_misc_tieoff_zero_bypass_ready = br_misc_tieoff_zero::[name=gen_no_bypass_push_br_misc_tieoff_zero_bypass_ready]()
  const bypass_ready__w1 = gen_no_bypass_push_br_misc_tieoff_zero_bypass_ready
  mut gen_pop_reg_br_flow_reg_fwd = br_flow_reg_fwd::[name=gen_pop_reg_br_flow_reg_fwd](clk = clk, rst = rst, push_valid = ram_rd_data_valid, push_data = ram_rd_data, pop_ready = pop_ready)
  pop_valid = gen_pop_reg_br_flow_reg_fwd.pop_valid
  br_misc_unused::[name=gen_pop_reg_br_misc_unused_internal_pop_valid_nonbypass](`in` = ram_rd_data_valid)
  br_misc_unused::[name=gen_zero_lat_space_available_br_misc_unused_pop_valid_nonbypass](`in` = pop_valid)
  const ram_rd_addr_valid__w1 = unsigned((unsigned((staged_items < 1) or (pop_ready != 0)) != 0) and (unsigned(staged_items < total_items) != 0) and (bypass_ready__w1 == 0))
  const staged_items_incr__w1 = unsigned((ram_rd_addr_valid__w1 != 0) and (ram_rd_addr_ready != 0))
  br_misc_unused_p2::[name=gen_no_bypass_push_br_misc_unused_bypass_inputs](`in` = ((unsigned((bypass_valid_unstable != 0) and (bypass_ready__w1 != 0)) & 1) << 65) | ((bypass_valid_unstable & 1) << 64) | bypass_data_unstable)
  br_misc_unused::[name=gen_no_buffer_br_misc_unused_internal_pop_ready](`in` = gen_pop_reg_br_flow_reg_fwd.push_ready)
  mut br_counter_staged_items = br_counter_p1::[name=br_counter_staged_items](clk = clk, rst = rst, reinit = 0, initial_value = 0, incr_valid = staged_items_incr__w1, incr = 1, decr_valid = pop_beat__w1, decr = 1)
  staged_items = br_counter_staged_items.value
  if rst != 0 {
    pop_empty = 1
  } elif (staged_items_incr__w1 != 0) or (pop_beat__w1 != 0) {
    pop_empty = unsigned(br_counter_staged_items.value_next == 0)
  }
  bypass_ready = bypass_ready__w1
  ram_rd_addr_valid = ram_rd_addr_valid__w1
  pop_data = gen_pop_reg_br_flow_reg_fwd.pop_data
}
