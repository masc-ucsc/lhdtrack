const br_counter_p2 = import("br_counter_p2.br_counter_p2")

pub mod br_amba_iso_req_tracker<MaxOutstanding=16>::[timecheck=false](clk:Clock, downstream_axready:U1, downstream_xlast:U1, downstream_xvalid:U1, isolate_req:U1, rst:U1, upstream_axvalid:U1, upstream_xready:U1) -> (downstream_axvalid:U1@[], downstream_xready:U1@[], isolate_done:U1@[], upstream_axready:U1@[], upstream_xlast:U1@[], upstream_xvalid:U1@[]) {
  reg isolate_done:U1:[async=false, initial=0, reset_pin=rst]
  wire expected_resp_count:U5 = nil
  const count_max__w1 = U1(expected_resp_count == MaxOutstanding)
  mut _mux_3:U1 = if isolate_done != 0 { U1(not (expected_resp_count == 0 and isolate_req == 0)) & 1 } else { isolate_req & 1 }
  mut _b2i_4 = if isolate_req != 0 or isolate_done != 0 { 1 } else { 0 }
  const isolated__w1 = _b2i_4
  mut _b2i_5 = if downstream_axready != 0 and isolated__w1 == 0 and count_max__w1 == 0 { 1 } else { 0 }
  mut _b2i_6 = if upstream_axvalid != 0 and isolated__w1 == 0 and count_max__w1 == 0 { 1 } else { 0 }
  const downstream_axvalid__w1 = _b2i_6
  mut _b2i_7 = if downstream_xvalid != 0 and isolated__w1 == 0 { 1 } else { 0 }
  mut _b2i_8 = if upstream_xready != 0 or isolated__w1 != 0 { 1 } else { 0 }
  const downstream_xready__w1 = _b2i_8
  if not (rst != 0) {
    isolate_done = _mux_3
  }
  mut _b2i_9 = if downstream_axvalid__w1 != 0 and downstream_axready != 0 { 1 } else { 0 }
  mut _b2i_10 = if downstream_xvalid != 0 and downstream_xready__w1 != 0 and downstream_xlast != 0 { 1 } else { 0 }
  mut br_counter_exp_resp_count = br_counter_p2::[name=br_counter_exp_resp_count](clk=clk, rst=rst, reinit=0, initial_value=0, incr_valid=_b2i_9, incr=1, decr_valid=_b2i_10, decr=1)
  expected_resp_count = br_counter_exp_resp_count.value
  upstream_axready = _b2i_5
  upstream_xvalid = _b2i_7
  upstream_xlast = downstream_xlast
  downstream_axvalid = downstream_axvalid__w1
  downstream_xready = downstream_xready__w1
}
