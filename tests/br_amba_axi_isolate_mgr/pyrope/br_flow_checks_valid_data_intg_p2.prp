const br_misc_unused_p4 = import("br_misc_unused_p4.br_misc_unused_p4")

pub mod br_flow_checks_valid_data_intg_p2::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u38) -> () {
  br_misc_unused_p4::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 40) | ((valid & 1) << 39) | ((ready & 1) << 38) | data)
}
