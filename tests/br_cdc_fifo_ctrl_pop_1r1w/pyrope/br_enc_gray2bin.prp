pub comb br_enc_gray2bin<Width=6>::[timecheck=false](gray:U6) -> (bin:(e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) {
  wire `bin__bpr.e5`:U1 = nil
  wire `bin__bpr.e4`:U1 = nil
  wire `bin__bpr.e3`:U1 = nil
  wire `bin__bpr.e2`:U1 = nil
  wire `bin__bpr.e1`:U1 = nil
  wire `bin__bpr.e0`:U1 = nil
  mut `bin__bpo.e5` = (gray >> (Width - 1)) & 1
  const t12 = gray#[4..=5]#^[..]
  mut `bin__bpo.e4` = t12
  const t15 = gray#[3..=5]#^[..]
  mut `bin__bpo.e3` = t15
  const t18 = gray#[2..=5]#^[..]
  mut `bin__bpo.e2` = t18
  const t21 = gray#[1..=5]#^[..]
  mut `bin__bpo.e1` = t21
  const t24 = gray#^[..]
  mut `bin__bpo.e0` = t24
  const t25 = `bin__bpo.e5`
  `bin__bpr.e5` = t25
  bin.e5 = t25
  const t26 = `bin__bpo.e4`
  `bin__bpr.e4` = t26
  bin.e4 = t26
  const t27 = `bin__bpo.e3`
  `bin__bpr.e3` = t27
  bin.e3 = t27
  const t28 = `bin__bpo.e2`
  `bin__bpr.e2` = t28
  bin.e2 = t28
  const t29 = `bin__bpo.e1`
  `bin__bpr.e1` = t29
  bin.e1 = t29
  const t30 = `bin__bpo.e0`
  `bin__bpr.e0` = t30
  bin.e0 = t30
}
