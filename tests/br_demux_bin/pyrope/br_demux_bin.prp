// Steer one valid 32-bit symbol to one of 16 outputs by binary index. Every
// output lane carries the data; only the selected lane is valid.
pub comb br_demux_bin(select:u4, in_valid:u1, `in`:u32) -> (out_valid:u16, out:u512) {
  out_valid = if in_valid == 1 { 1 << select } else { 0 }

  mut lanes:u512 = 0
  for i in 0..<out_valid.[bits] {
    lanes#[(i*`in`.[bits])..+`in`.[bits]] = `in`
  }
  out = lanes
}
