// Binary-select demux over 16 symbols: every output slot carries `in`, and only the
// slot picked by `select` is marked valid (and only while in_valid is set).
pub comb br_demux_bin(`in`:U32, in_valid:U1, select:U4) -> (out:U512, out_valid:U16) {
  comptime const WIDTH = `in`.[bits]
  comptime const SLOTS = out_valid.[bits]
  out_valid = if in_valid != 0 { 1 << select } else { 0 }
  for i in 0..<SLOTS {
    out#[(i*WIDTH)..+WIDTH] = `in`
  }
}
