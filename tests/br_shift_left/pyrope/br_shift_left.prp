pub comb br_shift_left::[timecheck=false](`in`:u16, shift:u4, fill:u1) -> (out_valid:u1, out:u16) {
  const fill2:u2 = if fill { 3 } else { 0 }
  const fill4:u4 = if fill { 15 } else { 0 }
  const fill8:u8 = if fill { 0xff } else { 0 }
  const stage1:u16 = if shift#[0] != 0 { (`in`#[0..=14] << 1) | fill } else { `in` }
  const stage2:u16 = if shift#[1] != 0 { (stage1#[0..=13] << 2) | fill2 } else { stage1 }
  const stage3:u16 = if shift#[2] != 0 { (stage2#[0..=11] << 4) | fill4 } else { stage2 }
  const stage4:u16 = if shift#[3] != 0 { (stage3#[0..=7] << 8) | fill8 } else { stage3 }
  out_valid = unsigned(shift <= 15)
  out = stage4
}
