pub mod br_enc_priority_encoder<NumRequesters=16, NumResults=1, MsbHighestPriority=0, MaxInHot=16>::[timecheck=false](clk:Clock, `in`:(e15:U1, e14:U1, e13:U1, e12:U1, e11:U1, e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), rst:Reset) -> (out:U16@[]) {
  wire out_internal_bits:U16 = nil
  wire out_internal:U16 = nil
  const gen_out_internal_0_in_masked = (`in`.e15 << 15) | (`in`.e14 << 14) | (`in`.e13 << 13) | (`in`.e12 << 12) | (`in`.e11 << 11) | (`in`.e10 << 10) | (`in`.e9 << 9) | (`in`.e8 << 8) | (`in`.e7 << 7) | (`in`.e6 << 6) | (`in`.e5 << 5) | (`in`.e4 << 4) | (`in`.e3 << 3) | (`in`.e2 << 2) | (`in`.e1 << 1) | `in`.e0
  out_internal_bits#[0] = gen_out_internal_0_in_masked & 1
  out_internal_bits#[1] = U1(((gen_out_internal_0_in_masked >> 1) & 1) != 0 and (gen_out_internal_0_in_masked & 1) == 0) & 1
  out_internal_bits#[2] = U1(((gen_out_internal_0_in_masked >> 2) & 1) != 0 and gen_out_internal_0_in_masked#[0..=1] == 0) & 1
  out_internal_bits#[3] = U1(((gen_out_internal_0_in_masked >> 3) & 1) != 0 and gen_out_internal_0_in_masked#[0..=2] == 0) & 1
  out_internal_bits#[4] = U1(((gen_out_internal_0_in_masked >> 4) & 1) != 0 and gen_out_internal_0_in_masked#[0..=3] == 0) & 1
  out_internal_bits#[5] = U1(((gen_out_internal_0_in_masked >> 5) & 1) != 0 and gen_out_internal_0_in_masked#[0..=4] == 0) & 1
  out_internal_bits#[6] = U1(((gen_out_internal_0_in_masked >> 6) & 1) != 0 and gen_out_internal_0_in_masked#[0..=5] == 0) & 1
  out_internal_bits#[7] = U1(((gen_out_internal_0_in_masked >> 7) & 1) != 0 and gen_out_internal_0_in_masked#[0..=6] == 0) & 1
  out_internal_bits#[8] = U1(((gen_out_internal_0_in_masked >> 8) & 1) != 0 and gen_out_internal_0_in_masked#[0..=7] == 0) & 1
  out_internal_bits#[9] = U1(((gen_out_internal_0_in_masked >> 9) & 1) != 0 and gen_out_internal_0_in_masked#[0..=8] == 0) & 1
  out_internal_bits#[10] = U1(((gen_out_internal_0_in_masked >> 10) & 1) != 0 and gen_out_internal_0_in_masked#[0..=9] == 0) & 1
  out_internal_bits#[11] = U1(((gen_out_internal_0_in_masked >> 11) & 1) != 0 and gen_out_internal_0_in_masked#[0..=10] == 0) & 1
  out_internal_bits#[12] = U1(((gen_out_internal_0_in_masked >> 12) & 1) != 0 and gen_out_internal_0_in_masked#[0..=11] == 0) & 1
  out_internal_bits#[13] = U1(((gen_out_internal_0_in_masked >> 13) & 1) != 0 and gen_out_internal_0_in_masked#[0..=12] == 0) & 1
  out_internal_bits#[14] = U1(((gen_out_internal_0_in_masked >> 14) & 1) != 0 and gen_out_internal_0_in_masked#[0..=13] == 0) & 1
  out_internal_bits#[15] = U1(((gen_out_internal_0_in_masked >> 15) & 1) != 0 and gen_out_internal_0_in_masked#[0..=14] == 0) & 1
  const out__w1 = out_internal
  out_internal = out_internal_bits
  out = out__w1
}
