// Free-list tracker: hands out the lowest-numbered free entry id and takes
// entries back on deallocation. This is the single-alloc-port, single-dealloc-
// port configuration with unregistered alloc outputs, no bypass and no
// preallocated entries; other bedrock configurations are not implemented.
// clk only fed the upstream assertions. dealloc_count is registered (it lands
// at @[1]); it is declared @[] because the generated harness mixes it with the
// same-cycle outputs, which a @[1] declaration rejects.
pub mod br_tracker_freelist(clk:u1, rst:u1, alloc_receivable:u1, dealloc_valid:u1, dealloc_entry_id:u4) -> (
  alloc_sendable:u1@[0],
  alloc_entry_id:u4@[0],
  dealloc_count:u1@[]
) {
  comptime const NUM_ENTRIES = 1 << dealloc_entry_id.[bits]
  comptime const ALL         = (1 << NUM_ENTRIES) - 1

  // Every entry starts free.
  reg free_entries:unsigned(bits=NUM_ENTRIES):[reset_pin = ref rst] = ALL

  // Offer the lowest-numbered free entry.
  const offered     = free_entries & -free_entries
  mut offered_id:u4 = 0
  for i in 1..<NUM_ENTRIES {
    if offered#[i] == 1 {
      offered_id |= i
    }
  }
  const alloc_fire = free_entries != 0 and alloc_receivable == 1
  alloc_sendable   = u1(free_entries != 0)
  alloc_entry_id   = offered_id

  const allocated   = if alloc_receivable == 1 { offered } else { 0 }
  const deallocated = if dealloc_valid == 1 { 1 << dealloc_entry_id } else { 0 }
  if alloc_fire or dealloc_valid == 1 {
    free_entries = (free_entries | deallocated) & ~allocated & ALL
  }

  // Deallocations are reported one cycle later, when the entry can be reused.
  reg dealloc_delayed:u1:[reset_pin = ref rst] = 0
  dealloc_delayed = dealloc_valid
  dealloc_count = dealloc_delayed
}
