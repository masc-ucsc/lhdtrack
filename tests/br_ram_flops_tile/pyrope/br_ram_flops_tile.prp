// Sixteen unreset 32-bit words, written on wr_clk and read asynchronously.
// This pinned configuration has no read pipeline or per-word write mask.
// Both physical clock ports stay present; only wr_clk owns storage.
pub mod br_ram_flops_tile(rd_addr:U4, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U4, wr_clk:Clock, wr_data:U32, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U32@[0], rd_data_valid:U1@[0]) {
  reg mem:[16]U32:[clock_pin=wr_clk, ordering="old"] = nil
  if wr_valid != 0 {
    mem[wr_addr] = wr_data
  }
  rd_data = mem[rd_addr]
  rd_data_valid = rd_addr_valid
}
