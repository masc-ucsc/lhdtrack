// One unreset delay `stage`. Stage zero remains the current input.
// Packed state retains the reference's unused low half for LEC pairing.
pub mod br_delay_nr(clk:Clock, `in`:U64) -> (out:U64@[], out_stages:U128@[]) {
  reg stages___q:U128 = nil
  stages___q#[64..<128] = `in`
  out = stages___q#[64..]
  out_stages = (`in`, out)#[..]
}
