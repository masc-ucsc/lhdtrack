// Four address tiles, no pipeline or data path in this pinned configuration.
// Tile i occupies address bits [3*i, 3*i+3); all tiles see the low address.
pub comb br_ram_addr_decoder(clk:U1, in_addr:U5, in_data:U32, in_data_valid:U1, in_valid:U1, rst:U1) -> (out_addr:U12, out_data:U128, out_data_valid:U4, out_valid:U4) {
  comptime const address_bits = out_addr.[bits]/out_valid.[bits]
  out_valid = if in_valid != 0 { 1 << in_addr#[address_bits..] } else { 0 }
  for tile in 0..<out_valid.[bits] {
    out_addr#[(tile*address_bits)..+address_bits] = in_addr#[0..<address_bits]
  }
  out_data_valid = 0
  out_data = 0
}
