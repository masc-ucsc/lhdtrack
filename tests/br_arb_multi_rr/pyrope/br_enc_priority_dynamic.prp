const br_enc_priority_encoder = import("br_enc_priority_encoder.br_enc_priority_encoder")
pub mod br_enc_priority_dynamic<NumRequesters=16, NumResults=2>::[timecheck=false](clk:Clock, `in`:U16, lowest_prio:U16, rst:Reset) -> (out:U32@[]) {
  wire out_bits:U32 = nil
  wire out:U32 = nil
  wire priority_mask_bits:U16 = nil
  wire priority_mask:U16 = nil
  priority_mask_bits#[0] = U1(lowest_prio != 0) & 1
  priority_mask_bits#[1] = U1(lowest_prio#[1..=15] != 0) & 1
  priority_mask_bits#[2] = U1(lowest_prio#[2..=15] != 0) & 1
  priority_mask_bits#[3] = U1(lowest_prio#[3..=15] != 0) & 1
  priority_mask_bits#[4] = U1(lowest_prio#[4..=15] != 0) & 1
  priority_mask_bits#[5] = U1(lowest_prio#[5..=15] != 0) & 1
  priority_mask_bits#[6] = U1(lowest_prio#[6..=15] != 0) & 1
  priority_mask_bits#[7] = U1(lowest_prio#[7..=15] != 0) & 1
  priority_mask_bits#[8] = U1(lowest_prio#[8..=15] != 0) & 1
  priority_mask_bits#[9] = U1(lowest_prio#[9..=15] != 0) & 1
  priority_mask_bits#[10] = U1(lowest_prio#[10..=15] != 0) & 1
  priority_mask_bits#[11] = U1(lowest_prio#[11..=15] != 0) & 1
  priority_mask_bits#[12] = U1(lowest_prio#[12..=15] != 0) & 1
  priority_mask_bits#[13] = U1(lowest_prio#[13..=15] != 0) & 1
  priority_mask_bits#[14] = U1(lowest_prio#[14..=15] != 0) & 1
  priority_mask_bits#[15] = U1(((lowest_prio >> 15) & 1) != 0) & 1
  const in_high_prio = `in` & (~priority_mask)
  const t61 = ((`in` & priority_mask) << 15) | in_high_prio#[1..=15]
  mut br_enc_priority_encoder_inst = br_enc_priority_encoder::[name=br_enc_priority_encoder_inst](clk=clk, rst=rst, `in.e30`=(t61 >> 30) & 1, `in.e29`=(t61 >> 29) & 1, `in.e28`=(t61 >> 28) & 1, `in.e27`=(t61 >> 27) & 1, `in.e26`=(t61 >> 26) & 1, `in.e25`=(t61 >> 25) & 1, `in.e24`=(t61 >> 24) & 1, `in.e23`=(t61 >> 23) & 1, `in.e22`=(t61 >> 22) & 1, `in.e21`=(t61 >> 21) & 1, `in.e20`=(t61 >> 20) & 1, `in.e19`=(t61 >> 19) & 1, `in.e18`=(t61 >> 18) & 1, `in.e17`=(t61 >> 17) & 1, `in.e16`=(t61 >> 16) & 1, `in.e15`=(t61 >> 15) & 1, `in.e14`=(t61 >> 14) & 1, `in.e13`=(t61 >> 13) & 1, `in.e12`=(t61 >> 12) & 1, `in.e11`=(t61 >> 11) & 1, `in.e10`=(t61 >> 10) & 1, `in.e9`=(t61 >> 9) & 1, `in.e8`=(t61 >> 8) & 1, `in.e7`=(t61 >> 7) & 1, `in.e6`=(t61 >> 6) & 1, `in.e5`=(t61 >> 5) & 1, `in.e4`=(t61 >> 4) & 1, `in.e3`=(t61 >> 3) & 1, `in.e2`=(t61 >> 2) & 1, `in.e1`=(t61 >> 1) & 1, `in.e0`=t61 & 1)
  const out_internal = br_enc_priority_encoder_inst
  out_bits#[0..<16] = (out_internal#[0..=30]#[15..=30] | (out_internal#[0..=30]#[0..=14] << 1))#[0..<16]
  out_bits#[16..<32] = (out_internal#[31..=61]#[15..=30] | (out_internal#[31..=61]#[0..=14] << 1))#[0..<16]
  out = out_bits
  priority_mask = priority_mask_bits
}
