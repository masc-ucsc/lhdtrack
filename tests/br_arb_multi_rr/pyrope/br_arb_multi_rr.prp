const br_enc_countones = import("br_enc_countones.br_enc_countones")
const br_enc_priority_dynamic = import("br_enc_priority_dynamic.br_enc_priority_dynamic")
const br_mux_bin = import("br_mux_bin.br_mux_bin")

pub mod br_arb_multi_rr::[timecheck=false](clk:Clock, enable_priority_update:U1, grant_allowed:U2, request:U16, rst:U1) -> (grant:U16@[], grant_count:U2@[], grant_ordered:U32@[]) {
  reg lowest_prio:U16:[async=false, initial=32768, reset_pin=rst]
  wire grant_ordered_bits:U32 = nil
  wire grant_ordered:U32 = nil
  wire `grant_valid[0]`:U1 = nil
  wire `grant_valid[1]`:U1 = nil
  `grant_valid[0]` = U1(grant_allowed > 0) & 1
  `grant_valid[1]` = U1(grant_allowed > 1) & 1
  mut u_enc_priority_dynamic = br_enc_priority_dynamic::[name=u_enc_priority_dynamic](clk=clk, rst=rst, `in`=request, lowest_prio=lowest_prio)
  const all_grants = u_enc_priority_dynamic
  mut br_enc_countones_inst = br_enc_countones::[name=br_enc_countones_inst](`in`=request)
  const request_count = br_enc_countones_inst
  mut _mux_4:U2 = if U1(request_count <= grant_allowed) != 0 { request_count#[0..=1] } else { grant_allowed }
  const grant_count__w1 = _mux_4
  mut br_mux_bin_last_grant = br_mux_bin::[name=br_mux_bin_last_grant](select=(grant_count__w1 - 1)#[0..=1] & 1, `in`=all_grants)
  if not (rst != 0) {
    if U1(enable_priority_update != 0 and request != 0 and grant_allowed > 0) != 0 {
      lowest_prio = br_mux_bin_last_grant.out
    }
  }
  mut _mux_7:U16 = if (`grant_valid[0]` & 1) != 0 { all_grants#[0..=15] } else { 0 }
  grant_ordered_bits#[0..<16] = _mux_7#[0..<16]
  mut _mux_8:U16 = if (`grant_valid[1]` & 1) != 0 { all_grants#[16..=31] } else { 0 }
  grant_ordered_bits#[16..<32] = _mux_8#[0..<16]
  grant_ordered = grant_ordered_bits
  grant = (0 | ((grant_ordered_bits#[15] << 15) | (grant_ordered_bits#[14] << 14) | (grant_ordered_bits#[13] << 13) | (grant_ordered_bits#[12] << 12) | (grant_ordered_bits#[11] << 11) | (grant_ordered_bits#[10] << 10) | (grant_ordered_bits#[9] << 9) | (grant_ordered_bits#[8] << 8) | (grant_ordered_bits#[7] << 7) | (grant_ordered_bits#[6] << 6) | (grant_ordered_bits#[5] << 5) | (grant_ordered_bits#[4] << 4) | (grant_ordered_bits#[3] << 3) | (grant_ordered_bits#[2] << 2) | (grant_ordered_bits#[1] << 1) | grant_ordered_bits#[0])) | ((grant_ordered_bits#[31] << 15) | (grant_ordered_bits#[30] << 14) | (grant_ordered_bits#[29] << 13) | (grant_ordered_bits#[28] << 12) | (grant_ordered_bits#[27] << 11) | (grant_ordered_bits#[26] << 10) | (grant_ordered_bits#[25] << 9) | (grant_ordered_bits#[24] << 8) | (grant_ordered_bits#[23] << 7) | (grant_ordered_bits#[22] << 6) | (grant_ordered_bits#[21] << 5) | (grant_ordered_bits#[20] << 4) | (grant_ordered_bits#[19] << 3) | (grant_ordered_bits#[18] << 2) | (grant_ordered_bits#[17] << 1) | grant_ordered_bits#[16])
  grant_count = grant_count__w1
}
