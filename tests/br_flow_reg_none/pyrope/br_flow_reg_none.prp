// Fall-through buffer: bypass when empty, retain a beat under backpressure.
// Payload is deliberately unreset, including writes during reset.
pub mod br_flow_reg_none(clk:Clock, pop_ready:U1, push_data:U32, push_valid:U1, rst:U1) -> (pop_data:U32@[], pop_valid:U1@[], push_ready:U1@[]) {
  reg buf_valid:U1:[reset_pin=rst] = 0
  reg buf_data:U32 = nil
  const ready = pop_ready != 0 or buf_valid == 0
  const capture = push_valid != 0 and ready and (pop_ready == 0 or buf_valid != 0)
  push_ready = U1(ready)
  pop_valid = U1(push_valid != 0 or buf_valid != 0)
  pop_data = if buf_valid != 0 { buf_data } else { push_data }
  buf_valid = U1(capture or (buf_valid != 0 and pop_ready == 0))
  if capture {
    buf_data = push_data
  }
}
