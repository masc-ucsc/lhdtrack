// Select one packed 32-bit lane; ready reaches only the selected producer.
pub comb br_flow_mux_select_unstable(pop_ready:U1, push_data:U128, push_valid:U4, select:U2) -> (pop_data_unstable:U32, pop_valid_unstable:U1, push_ready:U4) {
  push_ready = pop_ready << select
  pop_valid_unstable = push_valid#[select]
  pop_data_unstable = (push_data >> (select*pop_data_unstable.[bits]))#[0..<pop_data_unstable.[bits]]
}
