const br_flow_checks_valid_data_impl_t = import("br_flow_checks_valid_data_impl.br_flow_checks_valid_data_impl")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")

pub mod br_flow_mux_select_unstable::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U128, push_valid:U4, rst:Reset, select:U2) -> (pop_data_unstable:U32@[], pop_valid_unstable:U1@[], push_ready:U4@[]) {
  const push_ready__w1 = (pop_ready << select)#[0..=3]
  const pop_valid_unstable__w1 = ((push_valid << 1) >> (select + 1)) & 1
  const pop_data_unstable__w1 = ((push_data << 32) >> ((select*32) + 32))#[0..=31]
  br_flow_checks_valid_data_impl_t::[name=br_flow_checks_valid_data_impl](clk=clk, rst=rst, valid=pop_valid_unstable__w1, ready=pop_ready, data=pop_data_unstable__w1)
  br_flow_checks_valid_data_intg_t::[name=br_flow_checks_valid_data_intg](clk=clk, rst=rst, valid=push_valid, ready=push_ready__w1, data=push_data)
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
  pop_data_unstable = pop_data_unstable__w1
}
