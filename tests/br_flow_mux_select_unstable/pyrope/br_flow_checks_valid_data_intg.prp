const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_flow_checks_valid_data_intg<NumFlows=4, Width=32, EnableCoverBackpressure=1, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U128, ready:U4, rst:U1, valid:U4) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 136) | (valid << 132) | (ready << 128) | data)
}
