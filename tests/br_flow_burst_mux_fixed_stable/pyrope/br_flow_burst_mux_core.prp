const br_arb_grant_hold_t = import("br_arb_grant_hold.br_arb_grant_hold")
const br_flow_mux_core_t = import("br_flow_mux_core.br_flow_mux_core")

pub mod br_flow_burst_mux_core<NumFlows=8, Width=32, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, grant_from_arb:U8, pop_ready:U1, push_data:U256, push_last:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), push_valid:U8, rst:Reset) -> (enable_priority_update:U1@[], pop_data_unstable:U32@[], pop_last_unstable:U1@[], pop_valid_unstable:U1@[], push_ready:U8@[], request:U8@[]) {
  wire push_payload_bits:U264 = nil
  wire push_payload:U264 = nil
  wire grant:U8 = nil
  wire enable_priority_update_from_mux:U1 = nil
  const t30 = ((push_last.e0 & 1) << 32) | push_data#[0..=31]
  push_payload_bits#[0..<33] = t30#[0..<33]
  const t99 = ((push_last.e1 & 1) << 32) | push_data#[32..=63]
  push_payload_bits#[33..<66] = t99#[0..<33]
  const t168 = ((push_last.e2 & 1) << 32) | push_data#[64..=95]
  push_payload_bits#[66..<99] = t168#[0..<33]
  const t237 = ((push_last.e3 & 1) << 32) | push_data#[96..=127]
  push_payload_bits#[99..<132] = t237#[0..<33]
  const t306 = ((push_last.e4 & 1) << 32) | push_data#[128..=159]
  push_payload_bits#[132..<165] = t306#[0..<33]
  const t375 = ((push_last.e5 & 1) << 32) | push_data#[160..=191]
  push_payload_bits#[165..<198] = t375#[0..<33]
  const t444 = ((push_last.e6 & 1) << 32) | push_data#[192..=223]
  push_payload_bits#[198..<231] = t444#[0..<33]
  const t513 = ((push_last.e7 & 1) << 32) | push_data#[224..=255]
  push_payload_bits#[231..<264] = t513#[0..<33]
  mut _b2i_1 = if enable_priority_update_from_mux != 0 and (grant & push_valid) != 0 { 1 } else { 0 }
  mut br_arb_grant_hold = br_arb_grant_hold_t::[name=br_arb_grant_hold](clk=clk, rst=rst, grant_hold=~(push_valid & ((push_last.e7 << 7) | (push_last.e6 << 6) | (push_last.e5 << 5) | (push_last.e4 << 4) | (push_last.e3 << 3) | (push_last.e2 << 2) | (push_last.e1 << 1) | push_last.e0))#[0..=7], enable_grant_hold_update=_b2i_1, grant_from_arb=grant_from_arb)
  grant = br_arb_grant_hold.grant
  mut br_flow_mux_core = br_flow_mux_core_t::[name=br_flow_mux_core](clk=clk, rst=rst, can_grant=grant, grant=grant, push_valid=push_valid, push_data=push_payload, pop_ready=pop_ready)
  enable_priority_update_from_mux = br_flow_mux_core.enable_priority_update
  push_payload = push_payload_bits
  request = br_flow_mux_core.request
  enable_priority_update = br_arb_grant_hold.enable_priority_update_to_arb
  push_ready = br_flow_mux_core.push_ready
  pop_valid_unstable = br_flow_mux_core.pop_valid_unstable
  pop_last_unstable = (br_flow_mux_core.pop_data_unstable >> 32) & 1
  pop_data_unstable = br_flow_mux_core.pop_data_unstable#[0..=31]
}
