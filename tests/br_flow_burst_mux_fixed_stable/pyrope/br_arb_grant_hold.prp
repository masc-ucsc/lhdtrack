pub mod br_arb_grant_hold<NumRequesters=8>::[timecheck=false](clk:Clock, enable_grant_hold_update:U1, grant_from_arb:U8, grant_hold:U8, rst:U1) -> (enable_priority_update_to_arb:U1@[], grant:U8@[]) {
  reg hold:U8:[async=false, initial=0, reset_pin=rst]
  // A live held grant overrides the arbiter, whose priority only moves once
  // nothing is held.
  const granted:U8 = if hold != 0 { hold } else { grant_from_arb }
  if rst == 0 and enable_grant_hold_update == 1 {
    hold = granted & grant_hold
  }
  grant = granted
  enable_priority_update_to_arb = U1(hold == 0 and enable_grant_hold_update == 1)
}
