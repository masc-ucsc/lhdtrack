pub comb br_arb_fixed_internal::[timecheck=false](request:u8) -> (can_grant:(e7:u1, e6:u1, e5:u1, e4:u1, e3:u1, e2:u1, e1:u1, e0:u1), grant:u8) {
  mut `can_grant__bpo.e0` = 0
  mut `can_grant__bpo.e1` = unsigned(not ((request & 1) != 0))
  mut `can_grant__bpo.e2` = unsigned(not (request#[0..=1] != 0))
  mut `can_grant__bpo.e3` = unsigned(not (request#[0..=2] != 0))
  mut `can_grant__bpo.e4` = unsigned(not (request#[0..=3] != 0))
  mut `can_grant__bpo.e5` = unsigned(not (request#[0..=4] != 0))
  mut `can_grant__bpo.e6` = unsigned(not (request#[0..=5] != 0))
  mut `can_grant__bpo.e7` = unsigned(not (request#[0..=6] != 0))
  can_grant.e7 = `can_grant__bpo.e7`
  can_grant.e6 = `can_grant__bpo.e6`
  can_grant.e5 = `can_grant__bpo.e5`
  can_grant.e4 = `can_grant__bpo.e4`
  can_grant.e3 = `can_grant__bpo.e3`
  can_grant.e2 = `can_grant__bpo.e2`
  can_grant.e1 = `can_grant__bpo.e1`
  can_grant.e0 = 1
  grant = request & ((`can_grant__bpo.e7` << 7) | (`can_grant__bpo.e6` << 6) | (`can_grant__bpo.e5` << 5) | (`can_grant__bpo.e4` << 4) | (`can_grant__bpo.e3` << 3) | (`can_grant__bpo.e2` << 2) | (`can_grant__bpo.e1` << 1) | 1)
}
