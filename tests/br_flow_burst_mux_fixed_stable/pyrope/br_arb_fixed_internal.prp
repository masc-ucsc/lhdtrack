// below#[i] = |v#[0..<i] (log-step prefix OR, constant shifts only)
comb or_below<N>(v:Unsigned(bits=N)) -> (below:Unsigned(bits=N)) {
  cassert(N <= 16)
  mut p:Unsigned(bits=N) = v#[0..<(N - 1)] << 1
  wrap p |= p << 1
  wrap p |= p << 2
  wrap p |= p << 4
  wrap p |= p << 8
  below = p
}

pub comb br_arb_fixed_internal<NumRequesters=8>::[timecheck=false](request:U8) -> (can_grant:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), grant:U8) {
  // Lowest index wins: a requester may be granted when no lower one requests.
  const cg:U8 = ~or_below<N=8>(v=request)
  grant = request & cg
  can_grant = (e7=cg#[7], e6=cg#[6], e5=cg#[5], e4=cg#[4], e3=cg#[3], e2=cg#[2], e1=cg#[1], e0=cg#[0])
}
