pub comb br_arb_fixed_internal<NumRequesters=8>::[timecheck=false](request:U8) -> (can_grant:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), grant:U8) {
  wire can_grant__bpr:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1) = nil
  mut `can_grant__bpo.e1` = U1(not ((request & 1) != 0))
  mut `can_grant__bpo.e2` = U1(not (request#[0..=1] != 0))
  mut `can_grant__bpo.e3` = U1(not (request#[0..=2] != 0))
  mut `can_grant__bpo.e4` = U1(not (request#[0..=3] != 0))
  mut `can_grant__bpo.e5` = U1(not (request#[0..=4] != 0))
  mut `can_grant__bpo.e6` = U1(not (request#[0..=5] != 0))
  mut `can_grant__bpo.e7` = U1(not (request#[0..=6] != 0))
  const grant__w1 = request & ((can_grant__bpr.e7 << 7) | (can_grant__bpr.e6 << 6) | (can_grant__bpr.e5 << 5) | (can_grant__bpr.e4 << 4) | (can_grant__bpr.e3 << 3) | (can_grant__bpr.e2 << 2) | (can_grant__bpr.e1 << 1) | can_grant__bpr.e0)
  const t54 = `can_grant__bpo.e7`
  can_grant__bpr.e7 = t54
  can_grant.e7 = t54
  const t55 = `can_grant__bpo.e6`
  can_grant__bpr.e6 = t55
  can_grant.e6 = t55
  const t56 = `can_grant__bpo.e5`
  can_grant__bpr.e5 = t56
  can_grant.e5 = t56
  const t57 = `can_grant__bpo.e4`
  can_grant__bpr.e4 = t57
  can_grant.e4 = t57
  const t58 = `can_grant__bpo.e3`
  can_grant__bpr.e3 = t58
  can_grant.e3 = t58
  const t59 = `can_grant__bpo.e2`
  can_grant__bpr.e2 = t59
  can_grant.e2 = t59
  const t60 = `can_grant__bpo.e1`
  can_grant__bpr.e1 = t60
  can_grant.e1 = t60
  can_grant__bpr.e0 = 1
  can_grant.e0 = 1
  grant = grant__w1
}
