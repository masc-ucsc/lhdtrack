const br_misc_unused_p3 = import("br_misc_unused_p3.br_misc_unused_p3")

pub mod br_flow_checks_valid_data_impl_p1::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u33) -> () {
  br_misc_unused_p3::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 35) | ((valid & 1) << 34) | ((ready & 1) << 33) | data)
}
