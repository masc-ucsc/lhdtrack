// OR all selected packed lanes, including multiple simultaneous selections.
const cfg = import("lhdtrack_cfg")

pub mod br_mux_onehot<NumSymbolsIn=8, SymbolWidth=33>::[timecheck=false](`in`:Unsigned(bits=NumSymbolsIn*SymbolWidth), select:Unsigned(bits=NumSymbolsIn)) -> (out:Unsigned(bits=SymbolWidth)@[]) {
  comptime const W = SymbolWidth
  if cfg.no_loop {
    cassert(NumSymbolsIn == 8)
    const lane0:Unsigned(bits=W) = if select#[0] == 1 { `in`#[(0*W)..+W] } else { 0 }
    const lane1:Unsigned(bits=W) = if select#[1] == 1 { `in`#[(1*W)..+W] } else { 0 }
    const lane2:Unsigned(bits=W) = if select#[2] == 1 { `in`#[(2*W)..+W] } else { 0 }
    const lane3:Unsigned(bits=W) = if select#[3] == 1 { `in`#[(3*W)..+W] } else { 0 }
    const lane4:Unsigned(bits=W) = if select#[4] == 1 { `in`#[(4*W)..+W] } else { 0 }
    const lane5:Unsigned(bits=W) = if select#[5] == 1 { `in`#[(5*W)..+W] } else { 0 }
    const lane6:Unsigned(bits=W) = if select#[6] == 1 { `in`#[(6*W)..+W] } else { 0 }
    const lane7:Unsigned(bits=W) = if select#[7] == 1 { `in`#[(7*W)..+W] } else { 0 }
    out = ((lane0 | lane1) | (lane2 | lane3)) | ((lane4 | lane5) | (lane6 | lane7))
  } else {
    // The one-lane reference passes payload even when its select bit is zero.
    if NumSymbolsIn == 1 {
      out = `in`
    } else {
      mut data:Unsigned(bits=W) = 0
      for lane in 0..<NumSymbolsIn {
        data |= if select#[lane] == 1 { `in`#[(lane*W)..+W] } else { 0 }
      }
      out = data
    }
  }
}
