pub mod br_flow_demux_select_unstable<NumFlows=4, Width=32, EnableCoverPushBackpressure=1, NumPopBackpressureCheckFlows=4, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertSelectStability=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U4, push_data:U32, push_valid:U1, rst:Reset, select:U2) -> (pop_data_unstable:U128@[], pop_valid_unstable:U4@[], push_ready:U1@[]) {
  pop_data_unstable = 0sb?
  const push_ready__w1 = ((pop_ready << 1) >> (select + 1)) & 1
  mut _mux_1:U4 = if push_valid != 0 { (push_valid << select)#[0..=3] } else { 0 }
  const pop_valid_unstable__w1 = _mux_1
  mut pop_data_unstable__w1 = pop_data_unstable
