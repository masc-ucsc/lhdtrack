// Round-robin arbitration step: the requester after last_grant has the highest
// priority, wrapping around. can_grant says which requesters would win if they
// requested. The caller owns last_grant and updates it with grant.
pub mod br_arb_rr_internal<NUM_REQUESTERS=2>(last_grant:unsigned(bits=NUM_REQUESTERS), request:unsigned(bits=NUM_REQUESTERS)) -> (
  can_grant:unsigned(bits=NUM_REQUESTERS)@[0],
  grant:unsigned(bits=NUM_REQUESTERS)@[0]
) {
  cassert(NUM_REQUESTERS >= 2, "a single requester needs no arbiter")
  comptime const ALL = (1 << NUM_REQUESTERS) - 1

  // Requesters at or below the last grant lose priority this round.
  mut priority_mask:unsigned(bits=NUM_REQUESTERS) = 0
  for i in 0..<NUM_REQUESTERS {
    priority_mask#[i] = last_grant#|[i..]
  }
  // Requesters above the last grant come first.
  const request_high = request & ~priority_mask & ALL

  mut can:unsigned(bits=NUM_REQUESTERS) = 0
  for i in 0..<NUM_REQUESTERS {
    comptime const below = (1 << i) - 1
    comptime const above = ALL & ~((1 << (i + 1)) - 1)
    // Requesters that come before i in the round-robin order.
    const ahead = if i == 0 or priority_mask#[i] == 1 { (request & below) | (request_high & above) } else { request_high & below }
    can#[i]     = u1(ahead == 0)
  }
  can_grant = can
  grant     = request & can
}
