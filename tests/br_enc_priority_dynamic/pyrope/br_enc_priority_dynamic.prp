// Round-robin style priority encoder: returns the one-hot of the first request
// above lowest_prio, wrapping around to the requests at or below it.
// clk and rst only fed the upstream assertions.
pub mod br_enc_priority_dynamic(clk:u1, rst:u1, `in`:u16, lowest_prio:u16) -> (out:u16@[0]) {
  comptime const N   = `in`.[bits]
  comptime const ALL = (1 << N) - 1

  // Requests at or below the lowest-priority position go last.
  mut priority_mask:u16 = 0
  for i in 0..<N {
    priority_mask#[i] = lowest_prio#|[i..]
  }
  const in_low  = `in` & priority_mask
  const in_high = `in` & ~priority_mask & ALL

  // Search the high requests (minus bit 0, which is always low) first, then the
  // low ones, as one 2N-1 bit vector; keep its lowest set bit.
  const ordered = (in_low << (N - 1)) | (in_high >> 1)
  const first   = ordered & -ordered

  out = (first >> (N - 1)) | ((first << 1) & ALL)
}
