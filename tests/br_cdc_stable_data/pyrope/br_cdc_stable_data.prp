const br_cdc_reg = import("br_cdc_reg.br_cdc_reg")
const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_cdc_stable_data::[timecheck=false](dst_clk:Clock, dst_rst:U1, src_clk:Clock, src_data:U32, src_rst:U1, src_valid:U1) -> (dst_data:U32@[], dst_updated:U1@[]) {
  reg dst_updated:U1:[async=false, clock_pin=dst_clk, initial=0, reset_pin=dst_rst]
  reg dst_data:U32:[async=false, clock_pin=dst_clk, initial=0, reset_pin=dst_rst]
  mut br_cdc_reg_inst = br_cdc_reg::[name=br_cdc_reg_inst](push_clk=src_clk, push_rst=src_rst, push_valid=src_valid, push_data=src_data, pop_clk=dst_clk, pop_rst=dst_rst, pop_ready=1)
  if not (dst_rst != 0) {
    dst_updated = br_cdc_reg_inst.pop_valid
  }
  if not (dst_rst != 0) {
    if br_cdc_reg_inst.pop_valid != 0 {
      dst_data = br_cdc_reg_inst.pop_data
    }
  }
  br_misc_unused_p1::[name=br_misc_unused_src_ready](`in`=br_cdc_reg_inst.push_ready)
}
