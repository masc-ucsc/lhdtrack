// Generated by tools/gen_testbench.py, then hand-adjusted for explicit DUT clocks. Simulation only.
//
// The Pyrope twin of br_cdc_stable_data_harness.sv: same LFSR, same fold, same seed, so all
// three simulators must agree on `checksum` or the test fails.
//
// This is GENERATED and assumes the DUT is a `mod` or `comb` with these port names. A
// hand-written idiomatic Pyrope module may present a different interface;
// adjusting this file is part of promoting the test to status.pyrope =
// "idiomatic".
// `file.entity`: import("br_cdc_stable_data") names the FILE, and calling it fails with
// "call to undefined function". The module inside it is br_cdc_stable_data.br_cdc_stable_data.
const dut = import("br_cdc_stable_data.br_cdc_stable_data")

pub mod br_cdc_stable_data_harness(clk:Clock, rst:U1) -> (checksum:U64@[0]) {
  reg lfsr:U64:[clock_pin=clk] = nil
  reg sum:U64:[clock_pin=clk] = nil

  checksum = sum

  mut nxt:U64 = lfsr
  wrap nxt = nxt ^ (nxt << 13)
  wrap nxt = nxt ^ (nxt >> 7)
  wrap nxt = nxt ^ (nxt << 17)

  const r = dut(src_clk=clk, dst_clk=clk, src_rst=rst, dst_rst=rst, src_valid=lfsr#[0], src_data=lfsr#[1..=32])

  mut acc:U64 = sum
  wrap acc = ((acc << 1) | acc#[63]) ^ r.dst_updated
  wrap acc = ((acc << 1) | acc#[63]) ^ r.dst_data

  if rst != 0 {
    lfsr = 2611923443488327891
    sum  = 0
  } else {
    lfsr = nxt
    sum  = acc
  }
}
