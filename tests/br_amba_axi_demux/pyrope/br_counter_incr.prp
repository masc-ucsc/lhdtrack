pub mod br_counter_incr::[timecheck=false](clk:u1, rst:u1, reinit:u1, initial_value:u1, incr_valid:u1, incr:u1) -> (value:u1@[], value_next:u1@[]) {
  reg value:u1
  mut _mux_1:u2 = if incr_valid != 0 { incr } else { 0 }
  mut _mux_2:u2 = if reinit != 0 { initial_value } else { (value + _mux_1)#[0..=1] }
  const value_next__w1 = _mux_2 & 1
  if rst != 0 {
    value = initial_value
  } elif (incr_valid != 0) or (reinit != 0) {
    value = value_next__w1
  }
  value_next = value_next__w1
}
