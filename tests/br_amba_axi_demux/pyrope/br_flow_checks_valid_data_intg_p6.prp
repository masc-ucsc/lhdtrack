const br_misc_unused_p8 = import("br_misc_unused_p8.br_misc_unused_p8")

pub mod br_flow_checks_valid_data_intg_p6::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u5) -> () {
  br_misc_unused_p8::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 7) | ((valid & 1) << 6) | ((ready & 1) << 5) | data)
}
