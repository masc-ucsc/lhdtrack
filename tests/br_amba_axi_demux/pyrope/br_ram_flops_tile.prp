const br_misc_unused_p10 = import("br_misc_unused_p10.br_misc_unused_p10")

pub mod br_ram_flops_tile::[timecheck=false](wr_clk:u1, wr_rst:u1, wr_valid:u1, wr_addr:u1, wr_data:u38, wr_word_en:u1, rd_clk:u1, rd_rst:u1, rd_addr_valid:u1, rd_addr:u1) -> (rd_data_valid:u1@[], rd_data:u38@[]) {
  reg mem:[2]u38:[ordering="old", clock_pin=ref wr_clk]
  rd_data = 0sb?
  if (wr_valid & 1) != 0 {
    mem[wr_addr & 1] = wr_data
  }
  br_misc_unused_p10::[name=gen_multi_entry_gen_unused_wr_word_en_br_misc_unused_wr_word_en](`in` = wr_word_en)
  mut rd_data__w1 = rd_data
  rd_data__w1#[0..=37] = mem[rd_addr & 1]#[0..=37]
  rd_data_valid = rd_addr_valid
  rd_data = rd_data__w1
}
