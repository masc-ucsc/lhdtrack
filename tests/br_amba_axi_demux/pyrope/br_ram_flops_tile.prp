pub mod br_ram_flops_tile<Depth=2, Width=38, NumWritePorts=1, NumReadPorts=1, EnablePartialWrite=0, WordWidth=38, EnableBypass=0, EnableReset=0, UseStructuredGates=0, EnableStructuredGatesDataQualification=1, EnableAssertFinalNotValid=1>::[timecheck=false](rd_addr:U1, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U1, wr_clk:Clock, wr_data:U38, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U38@[], rd_data_valid:U1@[]) {
  reg mem:[2]U38:[__store_clock_pin=wr_clk, __store_posclk=true, ordering="old"]
  rd_data = 0sb?
  if (wr_valid & 1) != 0 {
    mem[wr_addr & 1] = wr_data
  }
  mut rd_data__w1 = rd_data
  rd_data__w1#[0..=37] = mem[rd_addr & 1]
  rd_data_valid = rd_addr_valid
  rd_data = rd_data__w1
}
