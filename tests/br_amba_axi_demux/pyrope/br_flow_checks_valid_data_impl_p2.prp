const br_misc_unused_p3 = import("br_misc_unused_p3.br_misc_unused_p3")

pub mod br_flow_checks_valid_data_impl_p2::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u108) -> () {
  br_misc_unused_p3::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 112) | (valid << 110) | (ready << 108) | data)
}
