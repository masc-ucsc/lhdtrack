const br_flow_fork_select_multihot_t = import("br_flow_fork_select_multihot.br_flow_fork_select_multihot")

pub mod br_flow_fork::[timecheck=false](clk:u1, rst:u1, push_valid:u1, pop_ready:u3) -> (push_ready:u1@[], pop_valid_unstable:u3@[]) {
  mut br_flow_fork_select_multihot = br_flow_fork_select_multihot_t::[name=br_flow_fork_select_multihot](clk = clk, rst = rst, push_valid = push_valid, `push_select_multihot.e2` = 1, `push_select_multihot.e1` = 1, `push_select_multihot.e0` = 1, `pop_ready.e2` = (pop_ready >> 2) & 1, `pop_ready.e1` = (pop_ready >> 1) & 1, `pop_ready.e0` = pop_ready & 1)
  push_ready = br_flow_fork_select_multihot.push_ready
  pop_valid_unstable = (br_flow_fork_select_multihot.pop_valid_unstable.e2 << 2) | (br_flow_fork_select_multihot.pop_valid_unstable.e1 << 1) | br_flow_fork_select_multihot.pop_valid_unstable.e0
}
