const br_misc_unused_p12 = import("br_misc_unused_p12.br_misc_unused_p12")

pub mod br_flow_checks_valid_data_impl_p6::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u76) -> () {
  br_misc_unused_p12::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 80) | (valid << 78) | (ready << 76) | data)
}
