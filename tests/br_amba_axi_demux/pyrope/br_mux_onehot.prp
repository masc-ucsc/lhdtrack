pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=37, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U74, select:U2) -> (out:U37) {
  mut _rep_1:U37 = if (select & 1) != 0 { 0x1fffffffff } else { 0 }
  mut _rep_2:U37 = if ((select >> 1) & 1) != 0 { 0x1fffffffff } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=36])) | (_rep_2 & `in`#[37..=73])
}
