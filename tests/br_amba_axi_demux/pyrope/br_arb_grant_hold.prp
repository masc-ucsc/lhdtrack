pub mod br_arb_grant_hold<NumRequesters=2>::[timecheck=false](clk:Clock, enable_grant_hold_update:U1, grant_from_arb:U2, grant_hold:U2, rst:U1) -> (enable_priority_update_to_arb:U1@[], grant:U2@[]) {
  reg hold:U2:[async=false, initial=0, reset_pin=rst]
  mut _b2i_1 = if (not (hold != 0)) and enable_grant_hold_update != 0 { 1 } else { 0 }
  mut _mux_2:U2 = if hold != 0 { hold } else { grant_from_arb }
  const grant__w1 = _mux_2
  if not (rst != 0) {
    if enable_grant_hold_update != 0 {
      hold = grant__w1 & grant_hold
    }
  }
  enable_priority_update_to_arb = _b2i_1
  grant = grant__w1
}
