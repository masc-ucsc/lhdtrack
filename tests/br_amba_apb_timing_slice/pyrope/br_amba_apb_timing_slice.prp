pub mod br_amba_apb_timing_slice::[timecheck=false](clk:Clock, paddr_in:U32, penable_in:U1, pprot_in:U3, prdata_in:U32, pready_in:U1, psel_in:U1, pslverr_in:U1, pstrb_in:U4, pwdata_in:U32, pwrite_in:U1, rst:U1) -> (paddr_out:U32@[], penable_out:U1@[], pprot_out:U3@[], prdata_out:U32@[], pready_out:U1@[], psel_out:U1@[], pslverr_out:U1@[], pstrb_out:U4@[], pwdata_out:U32@[], pwrite_out:U1@[]) {
  reg prdata_out:U32
  reg pready_out:U1:[async=false, initial=0, reset_pin=rst]
  reg pslverr_out:U1
  reg paddr_out:U32
  reg psel_out:U1:[async=false, initial=0, reset_pin=rst]
  reg penable_out:U1:[async=false, initial=0, reset_pin=rst]
  reg pprot_out:U3
  reg pstrb_out:U4
  reg pwrite_out:U1
  reg pwdata_out:U32
  reg valid_handshake_d1:U1:[async=false, initial=0, reset_pin=rst]
  paddr_out = paddr_in
  pprot_out = pprot_in
  pstrb_out = pstrb_in
  pwrite_out = pwrite_in
  pwdata_out = pwdata_in
  pslverr_out = pslverr_in
  prdata_out = prdata_in
  mut _b2i_1 = if psel_out != 0 and penable_out != 0 and pready_in != 0 { 1 } else { 0 }
  const valid_handshake__w1 = _b2i_1
  mut _b2i_2 = if psel_in != 0 and valid_handshake__w1 == 0 and valid_handshake_d1 == 0 { 1 } else { 0 }
  mut _b2i_3 = if penable_in != 0 and valid_handshake__w1 == 0 and valid_handshake_d1 == 0 { 1 } else { 0 }
  mut _b2i_4 = if psel_out != 0 and penable_out != 0 and pready_in != 0 { 1 } else { 0 }
  if not (rst != 0) {
    psel_out = _b2i_2
  }
  if not (rst != 0) {
    penable_out = _b2i_3
  }
  if not (rst != 0) {
    pready_out = _b2i_4
  }
  if not (rst != 0) {
    valid_handshake_d1 = valid_handshake__w1
  }
}
