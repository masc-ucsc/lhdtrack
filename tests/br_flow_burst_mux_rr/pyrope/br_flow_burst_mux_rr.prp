const br_arb_rr_internal_t = import("br_arb_rr_internal.br_arb_rr_internal")
const br_flow_burst_mux_core_t = import("br_flow_burst_mux_core.br_flow_burst_mux_core")

pub mod br_flow_burst_mux_rr::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U128, push_last:U4, push_valid:U4, rst:Reset) -> (pop_data_unstable:U32@[], pop_last_unstable:U1@[], pop_valid_unstable:U1@[], push_ready:U4@[]) {
  wire request:U4 = nil
  wire enable_priority_update:U1 = nil
  mut br_arb_rr_internal = br_arb_rr_internal_t::[name=br_arb_rr_internal](clk=clk, rst=rst, enable_priority_update=enable_priority_update, request=request)
  mut br_flow_burst_mux_core = br_flow_burst_mux_core_t::[name=br_flow_burst_mux_core](clk=clk, rst=rst, grant_from_arb=br_arb_rr_internal.grant, push_valid=push_valid, `push_last.e3`=(push_last >> 3) & 1, `push_last.e2`=(push_last >> 2) & 1, `push_last.e1`=(push_last >> 1) & 1, `push_last.e0`=push_last & 1, push_data=push_data, pop_ready=pop_ready)
  request = br_flow_burst_mux_core.request
  enable_priority_update = br_flow_burst_mux_core.enable_priority_update
  push_ready = br_flow_burst_mux_core.push_ready
  pop_valid_unstable = br_flow_burst_mux_core.pop_valid_unstable
  pop_last_unstable = br_flow_burst_mux_core.pop_last_unstable
  pop_data_unstable = br_flow_burst_mux_core.pop_data_unstable
}
