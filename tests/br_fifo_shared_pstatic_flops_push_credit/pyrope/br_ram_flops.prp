// 32x32 flop RAM with one write and one read port. Both the write request and
// the read address go through one pipeline register (valid reset, address and
// data not), and the storage is read combinationally, so read data arrives one
// cycle after the address. Storage has no reset.
// Supported configuration: a single 32x32 tile, one address stage, no read
// data stages, full-word writes, no write-to-read bypass.
pub mod br_ram_flops(
  clk:u1,
  rst:u1,
  wr_valid:bool,
  wr_addr:u5,
  wr_data:u32,
  rd_addr_valid:bool,
  rd_addr:u5
) -> (rd_data_valid:bool@[], rd_data:u32@[]) {  // registered; @[] since they feed back into the controller
  reg wr_valid_q:bool  = false
  reg wr_addr_q:u5     = nil
  reg wr_data_q:u32    = nil
  reg rd_valid_q:bool  = false
  reg rd_addr_q:u5     = nil
  reg mem:[32]u32:[ordering="old"] = nil

  if wr_valid_q {
    mem[wr_addr_q] = wr_data_q
  }
  rd_data_valid = rd_valid_q
  rd_data       = mem[rd_addr_q]

  wr_valid_q = wr_valid
  if wr_valid {
    wr_addr_q = wr_addr
    wr_data_q = wr_data
  }
  rd_valid_q = rd_addr_valid
  if rd_addr_valid {
    rd_addr_q = rd_addr
  }
}
