const br_misc_unused_p10 = import("br_misc_unused_p10.br_misc_unused_p10")

pub mod br_flow_checks_valid_data_intg_p4::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u12) -> () {
  br_misc_unused_p10::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 16) | (valid << 14) | (ready << 12) | data)
}
