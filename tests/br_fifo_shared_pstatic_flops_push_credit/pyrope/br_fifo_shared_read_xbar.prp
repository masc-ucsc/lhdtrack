const br_delay_valid_p3 = import("br_delay_valid_p3.br_delay_valid_p3")
const br_demux_bin = import("br_demux_bin.br_demux_bin")
const br_flow_mux_core = import("br_flow_mux_core.br_flow_mux_core")
const cfg = import("lhdtrack_cfg")

// Read crossbar of a shared-RAM FIFO. Each FIFO's read request goes to the
// read port named by the low bits of its address (the only port when there is
// one); each read port lets the external arbiter pick one requesting FIFO,
// remembers which FIFO it served, and routes the RAM data back to that FIFO
// one cycle later. Per-FIFO and per-port buses are packed with index 0 in the
// low bits; the arbiter buses are [read port][FIFO] (bit p*NumFifos + f).
// Supported configuration: RAM read latency 1, an arbiter that always grants.
pub mod br_fifo_shared_read_xbar<NumFifos=2, NumReadPorts=1, RamReadLatency=1, Depth=32, Width=32, EnableAssertPushValidStability=1, ArbiterAlwaysGrants=1>::[timecheck=false](arb_can_grant:U2, arb_grant:U2, clk:Clock, pop_rd_data:U32, pop_rd_data_valid:U1, push_rd_addr:U10, push_rd_addr_valid:U2, rst:Reset) -> (arb_enable_priority_update:U1@[], arb_request:U2@[], pop_rd_addr:U5@[], pop_rd_addr_valid:U1@[], push_rd_addr_ready:U2@[], push_rd_data:U64@[], push_rd_data_valid:(e1:U1, e0:U1)@[]) {
  if cfg.no_loop {
    mut _mux_1:S32 = 0
    wire `demuxed_rd_addr_ready[0]`:U1 = nil
    wire `demuxed_rd_addr_ready[1]`:U1 = nil
    wire demuxed_rd_addr_ready:U2 = nil
    wire `mux_push_valid[0]`:U1 = nil
    wire `mux_push_valid[1]`:U1 = nil
    wire mux_push_valid:U2 = nil
    wire mux_push_data_bits:U12 = nil
    wire mux_push_data:U12 = nil
    wire pop_rd_addr_fifo_id:U1 = nil
    wire pop_rd_addr:U5 = nil
    wire `push_rd_data_valid__bpr.e1`:U1 = nil
    wire `push_rd_data_valid__bpr.e0`:U1 = nil
    mut pop_rd_addr_valid__wtmp:U1 = 0sb?
    wire pop_rd_addr_valid:U1 = nil
    mut arb_request__wtmp:U2 = 0sb?
    wire arb_request:U2 = nil
    mut arb_enable_priority_update__wtmp:U1 = 0sb?
    wire arb_enable_priority_update:U1 = nil
    mut demuxed_rd_data_valid__wtmp:U2 = 0sb?
    wire demuxed_rd_data_valid:U2 = nil
    mut demuxed_rd_data__wtmp:U64 = 0sb?
    wire demuxed_rd_data:U64 = nil
    mut pop_rd_data_fifo_id__wtmp:U1 = 0sb?
    wire pop_rd_data_fifo_id:U1 = nil
    mut pop_rd_data_fifo_id_valid__wtmp:U1 = 0sb?
    wire pop_rd_data_fifo_id_valid:U1 = nil
    _mux_1 = (Depth%NumReadPorts)#[0..=31]#sext[0..=31]
    _mux_1 = NumReadPorts#sext[0..=31]

    const push_rd_addr_ready__w1 = demuxed_rd_addr_ready
    `mux_push_valid[0]` = push_rd_addr_valid & 1
    const t17 = push_rd_addr#[0..=4] << 1
    mux_push_data_bits#[0..<6] = t17#[0..<6]
    `mux_push_valid[1]` = (push_rd_addr_valid >> 1) & 1
    const t33 = (push_rd_addr#[5..=9] << 1) | 1
    mux_push_data_bits#[6..<12] = t33#[0..<6]
    mut gen_read_port_mux_0_br_flow_mux_core_inst = br_flow_mux_core::[name=gen_read_port_mux_0_br_flow_mux_core_inst](clk=clk, rst=rst, can_grant=arb_can_grant, grant=arb_grant, push_valid=mux_push_valid, push_data=mux_push_data, pop_ready=1)
    arb_request__wtmp#[0..=1] = gen_read_port_mux_0_br_flow_mux_core_inst.request#[0..=1]
    arb_enable_priority_update__wtmp#[0] = gen_read_port_mux_0_br_flow_mux_core_inst.enable_priority_update & 1
    pop_rd_addr_valid__wtmp#[0] = gen_read_port_mux_0_br_flow_mux_core_inst.pop_valid_unstable & 1
    pop_rd_addr_fifo_id#[0] = gen_read_port_mux_0_br_flow_mux_core_inst.pop_data_unstable & 1
    pop_rd_addr#[0..=4] = (gen_read_port_mux_0_br_flow_mux_core_inst.pop_data_unstable >> 1)#[0..=4]
    mut gen_read_port_mux_0_br_delay_valid_fifo_id = br_delay_valid_p3::[name=gen_read_port_mux_0_br_delay_valid_fifo_id](clk=clk, rst=rst, in_valid=pop_rd_addr_valid & 1, `in`=pop_rd_addr_fifo_id & 1)
    pop_rd_data_fifo_id_valid__wtmp#[0] = gen_read_port_mux_0_br_delay_valid_fifo_id.out_valid & 1
    pop_rd_data_fifo_id__wtmp#[0] = gen_read_port_mux_0_br_delay_valid_fifo_id.out & 1
    mut gen_read_port_mux_0_br_demux_bin_rd_data = br_demux_bin::[name=gen_read_port_mux_0_br_demux_bin_rd_data](select=pop_rd_data_fifo_id & 1, in_valid=pop_rd_data_valid & 1, `in`=pop_rd_data)
    demuxed_rd_data_valid__wtmp#[0..=1] = gen_read_port_mux_0_br_demux_bin_rd_data.out_valid#[0..=1]
    demuxed_rd_data__wtmp#[0..=63] = gen_read_port_mux_0_br_demux_bin_rd_data.out#[0..=63]
    mut `push_rd_data_valid__bpo.e1` = (demuxed_rd_data_valid >> 1) & 1
    mut `push_rd_data_valid__bpo.e0` = demuxed_rd_data_valid & 1
    const push_rd_data__w1 = demuxed_rd_data
    `demuxed_rd_addr_ready[0]` = gen_read_port_mux_0_br_flow_mux_core_inst.push_ready & 1
    `demuxed_rd_addr_ready[1]` = (gen_read_port_mux_0_br_flow_mux_core_inst.push_ready >> 1) & 1
    demuxed_rd_addr_ready = (`demuxed_rd_addr_ready[1]` << 1) | `demuxed_rd_addr_ready[0]`
    mux_push_valid = (`mux_push_valid[1]` << 1) | `mux_push_valid[0]`
    mux_push_data = mux_push_data_bits
    pop_rd_addr_valid = pop_rd_addr_valid__wtmp
    arb_request = arb_request__wtmp
    arb_enable_priority_update = arb_enable_priority_update__wtmp
    demuxed_rd_data_valid = demuxed_rd_data_valid__wtmp
    demuxed_rd_data = demuxed_rd_data__wtmp
    pop_rd_data_fifo_id = pop_rd_data_fifo_id__wtmp
    pop_rd_data_fifo_id_valid = pop_rd_data_fifo_id_valid__wtmp
    const t80 = `push_rd_data_valid__bpo.e1`
    `push_rd_data_valid__bpr.e1` = t80
    push_rd_data_valid.e1 = t80
    const t81 = `push_rd_data_valid__bpo.e0`
    `push_rd_data_valid__bpr.e0` = t81
    push_rd_data_valid.e0 = t81
    push_rd_addr_ready = push_rd_addr_ready__w1
    push_rd_data = push_rd_data__w1
  } else {
    comptime const ADDR_WIDTH    = push_rd_addr.[bits] / NumFifos
    comptime const FIFO_ID_WIDTH = 1
    comptime const PORT_ID_WIDTH = 1
    cassert(NumReadPorts == 1 or (1 << PORT_ID_WIDTH) >= NumReadPorts)
    cassert((1 << FIFO_ID_WIDTH) >= NumFifos)

    // Route each FIFO's request to its read port; the arbiter's can_grant for
    // that port is the FIFO's ready. Two loops: in one rolled loop, addr_ready
    // (from can_grant) looks combinationally tied to request.
    mut request:U2 = 0
    for f in 0..<NumFifos {
      const port = if NumReadPorts == 1 { 0 } else { push_rd_addr#[(f*ADDR_WIDTH)..+PORT_ID_WIDTH] }
      for p in 0..<NumReadPorts {
        request#[p*NumFifos + f] = U1(push_rd_addr_valid#[f] == 1 and port == p)
      }
    }
    mut addr_ready:U2 = 0
    for f in 0..<NumFifos {
      const port     = if NumReadPorts == 1 { 0 } else { push_rd_addr#[(f*ADDR_WIDTH)..+PORT_ID_WIDTH] }
      addr_ready#[f] = arb_can_grant#[port*NumFifos + f]
    }

    // FIFO served by each read port in the previous cycle, for the returning data.
    reg served_fifo:U1 = nil
    mut next_served    = served_fifo

    mut rd_addr_valid:U1 = 0
    mut rd_addr:U5       = 0
    mut rd_data_valid:U2 = 0
    mut rd_data:U64      = 0
    for p in 0..<NumReadPorts {
      const grant = arb_grant#[(p*NumFifos)..+NumFifos]
      mut granted_addr:Unsigned(bits=ADDR_WIDTH)    = 0
      mut granted_fifo:Unsigned(bits=FIFO_ID_WIDTH) = 0
      for f in 0..<NumFifos {
        if grant#[f] == 1 {
          granted_addr |= push_rd_addr#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
          granted_fifo |= f
        }
      }
      const port_valid  = request#[(p*NumFifos)..+NumFifos] != 0
      rd_addr_valid#[p] = U1(port_valid)
      rd_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = granted_addr
      if port_valid {
        next_served#[(p*FIFO_ID_WIDTH)..+FIFO_ID_WIDTH] = granted_fifo
      }

      // Return this port's RAM data to the FIFO it served.
      const returning = served_fifo#[(p*FIFO_ID_WIDTH)..+FIFO_ID_WIDTH]
      for f in 0..<NumFifos {
        if pop_rd_data_valid#[p] == 1 and returning == f {
          rd_data_valid#[f]            = 1
          rd_data#[(f*Width)..+Width] |= pop_rd_data#[(p*Width)..+Width]
        }
      }
    }
    served_fifo = next_served

    push_rd_addr_ready         = addr_ready
    push_rd_data_valid         = (e1=rd_data_valid#[1], e0=rd_data_valid#[0])
    push_rd_data               = rd_data
    pop_rd_addr_valid          = rd_addr_valid
    pop_rd_addr                = rd_addr
    arb_request                = request
    arb_enable_priority_update = 1
  }
}
