// Read crossbar of a shared-RAM FIFO. Each FIFO's read request goes to the
// read port named by the low bits of its address (the only port when there is
// one, PORT_ID_WIDTH is then unused); each read port lets the
// external arbiter pick one requesting FIFO, remembers which FIFO it served,
// and routes the RAM data back to that FIFO one cycle later.
//
// Per-FIFO and per-port buses are packed with index 0 in the low bits; the
// arbiter buses are [read port][FIFO] (bit p*NUM_FIFOS + f).
// Supported configuration: RAM read latency 1, an arbiter that always grants.
pub mod br_fifo_shared_read_xbar<NUM_FIFOS=2, NUM_READ_PORTS=2, FIFO_ID_WIDTH=1, PORT_ID_WIDTH=1, ADDR_WIDTH=1, WIDTH=1>(
  clk:u1,
  rst:u1,
  push_rd_addr_valid:unsigned(bits=NUM_FIFOS),
  push_rd_addr:unsigned(bits=NUM_FIFOS * ADDR_WIDTH),
  pop_rd_data_valid:unsigned(bits=NUM_READ_PORTS),
  pop_rd_data:unsigned(bits=NUM_READ_PORTS * WIDTH),
  arb_can_grant:unsigned(bits=NUM_READ_PORTS * NUM_FIFOS),
  arb_grant:unsigned(bits=NUM_READ_PORTS * NUM_FIFOS)
) -> (
  push_rd_addr_ready:unsigned(bits=NUM_FIFOS)@[0],
  push_rd_data_valid:unsigned(bits=NUM_FIFOS)@[0],
  push_rd_data:unsigned(bits=NUM_FIFOS * WIDTH)@[0],
  pop_rd_addr_valid:unsigned(bits=NUM_READ_PORTS)@[0],
  pop_rd_addr:unsigned(bits=NUM_READ_PORTS * ADDR_WIDTH)@[0],
  arb_request:unsigned(bits=NUM_READ_PORTS * NUM_FIFOS)@[0],
  arb_enable_priority_update:unsigned(bits=NUM_READ_PORTS)@[0]
) {
  cassert(NUM_READ_PORTS == 1 or (1 << PORT_ID_WIDTH) >= NUM_READ_PORTS)
  cassert((1 << FIFO_ID_WIDTH) >= NUM_FIFOS)

  // Route each FIFO's request to its read port; the arbiter's can_grant for
  // that port is the FIFO's ready. Two loops: in one rolled loop, addr_ready
  // (from can_grant) looks combinationally tied to request, a false cycle
  // through the external arbiter in lhd sim.
  mut request:unsigned(bits=NUM_READ_PORTS * NUM_FIFOS) = 0
  for f in 0..<NUM_FIFOS {
    const port = if NUM_READ_PORTS == 1 { 0 } else { push_rd_addr#[(f*ADDR_WIDTH)..+PORT_ID_WIDTH] }
    for p in 0..<NUM_READ_PORTS {
      request#[p*NUM_FIFOS + f] = u1(push_rd_addr_valid#[f] == 1 and port == p)
    }
  }
  mut addr_ready:unsigned(bits=NUM_FIFOS) = 0
  for f in 0..<NUM_FIFOS {
    const port     = if NUM_READ_PORTS == 1 { 0 } else { push_rd_addr#[(f*ADDR_WIDTH)..+PORT_ID_WIDTH] }
    addr_ready#[f] = arb_can_grant#[port*NUM_FIFOS + f]
  }

  // FIFO served by each read port in the previous cycle, for the returning data.
  // Updated through next_served: a register both read and written inside a
  // rolled loop loses the write (LiveHD bug, suggestions2.md).
  reg served_fifo:unsigned(bits=NUM_READ_PORTS * FIFO_ID_WIDTH) = nil
  mut next_served = served_fifo

  mut rd_addr_valid:unsigned(bits=NUM_READ_PORTS)        = 0
  mut rd_addr:unsigned(bits=NUM_READ_PORTS * ADDR_WIDTH) = 0
  mut rd_data_valid:unsigned(bits=NUM_FIFOS)             = 0
  mut rd_data:unsigned(bits=NUM_FIFOS * WIDTH)           = 0
  for p in 0..<NUM_READ_PORTS {
    const grant = arb_grant#[(p*NUM_FIFOS)..+NUM_FIFOS]
    mut granted_addr:unsigned(bits=ADDR_WIDTH)    = 0
    mut granted_fifo:unsigned(bits=FIFO_ID_WIDTH) = 0
    for f in 0..<NUM_FIFOS {
      if grant#[f] == 1 {
        granted_addr |= push_rd_addr#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
        granted_fifo |= f
      }
    }
    const port_valid = request#[(p*NUM_FIFOS)..+NUM_FIFOS] != 0
    rd_addr_valid#[p] = u1(port_valid)
    rd_addr#[(p*ADDR_WIDTH)..+ADDR_WIDTH] = granted_addr
    if port_valid {
      next_served#[(p*FIFO_ID_WIDTH)..+FIFO_ID_WIDTH] = granted_fifo
    }

    // Return this port's RAM data to the FIFO it served.
    const returning = served_fifo#[(p*FIFO_ID_WIDTH)..+FIFO_ID_WIDTH]
    for f in 0..<NUM_FIFOS {
      if pop_rd_data_valid#[p] == 1 and returning == f {
        rd_data_valid#[f]            = 1
        rd_data#[(f*WIDTH)..+WIDTH] |= pop_rd_data#[(p*WIDTH)..+WIDTH]
      }
    }
  }

  served_fifo = next_served

  push_rd_addr_ready         = addr_ready
  push_rd_data_valid         = rd_data_valid
  push_rd_data               = rd_data
  pop_rd_addr_valid          = rd_addr_valid
  pop_rd_addr                = rd_addr
  arb_request                = request
  arb_enable_priority_update = (1 << NUM_READ_PORTS) - 1
}
