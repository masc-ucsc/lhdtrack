// Head/tail pointer manager of statically partitioned FIFOs sharing one RAM:
// FIFO f owns the entries config_base[f]..config_bound[f]. Tracks each FIFO's
// head pointer (wrapping at its bound), its full and empty flags, and the
// number of items it holds in the RAM.
//
// Per-FIFO buses are packed with FIFO 0 in the low bits. The tail pointers come
// from the push controller. Supported configuration: items are reconstructed
// from the pointers (not registered).
pub mod br_fifo_shared_pstatic_ptr_mgr<NUM_FIFOS=2, ADDR_WIDTH=1, COUNT_WIDTH=1>(
  clk:u1,
  rst:u1,
  config_base:unsigned(bits=NUM_FIFOS * ADDR_WIDTH),
  config_bound:unsigned(bits=NUM_FIFOS * ADDR_WIDTH),
  config_size:unsigned(bits=NUM_FIFOS * COUNT_WIDTH),
  advance_tail:unsigned(bits=NUM_FIFOS),
  tail_next:unsigned(bits=NUM_FIFOS * ADDR_WIDTH),
  tail:unsigned(bits=NUM_FIFOS * ADDR_WIDTH),
  head_ready:unsigned(bits=NUM_FIFOS)
) -> (
  push_full:unsigned(bits=NUM_FIFOS)@[0],
  head_valid:unsigned(bits=NUM_FIFOS)@[0],
  head:unsigned(bits=NUM_FIFOS * ADDR_WIDTH)@[0],
  empty:unsigned(bits=NUM_FIFOS)@[0],
  items:unsigned(bits=NUM_FIFOS * COUNT_WIDTH)@[0]
) {
  reg full:unsigned(bits=NUM_FIFOS)     = 0
  reg is_empty:unsigned(bits=NUM_FIFOS) = (1 << NUM_FIFOS) - 1
  // Resets to config_base (a runtime input), so the reset is written out.
  reg heads:unsigned(bits=NUM_FIFOS * ADDR_WIDTH) = nil

  mut next_full  = full
  mut next_empty = is_empty
  mut next_heads = heads
  for f in 0..<NUM_FIFOS {
    const h        = heads#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const t        = tail#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const base     = config_base#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const bound    = config_bound#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const adv_head = head_ready#[f] == 1 and is_empty#[f] == 0
    const adv_tail = advance_tail#[f] == 1

    // The head walks base..bound and wraps back to base.
    mut h_next:unsigned(bits=ADDR_WIDTH) = 0
    if adv_head and h == bound {
      h_next = base
    }
    else {
      wrap h_next = h + u1(adv_head)
    }
    if adv_head {
      next_heads#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = h_next
    }

    // A pop alone can only empty the FIFO; a push alone can only fill it.
    if adv_head and not adv_tail {
      next_full#[f]  = 0
      next_empty#[f] = u1(h_next == t)
    } elif adv_tail and not adv_head {
      next_full#[f]  = u1(tail_next#[(f*ADDR_WIDTH)..+ADDR_WIDTH] == h)
      next_empty#[f] = 0
    }
  }

  // Items between head and tail, wrapping within the FIFO's partition. A
  // separate loop: sharing the pointer loop above makes items look
  // combinationally dependent on head_ready (rolled-loop false cycle in lhd sim).
  mut count:unsigned(bits=NUM_FIFOS * COUNT_WIDTH) = 0
  for f in 0..<NUM_FIFOS {
    const h = heads#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const t = tail#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
    const size = config_size#[(f*COUNT_WIDTH)..+COUNT_WIDTH]
    mut n:unsigned(bits=COUNT_WIDTH) = 0
    if full#[f] == 1 {
      n = size
    } elif t >= h {
      wrap n = t - h // t >= h here, but the range check ignores the guard
    }
    else {
      mut gap:unsigned(bits=ADDR_WIDTH) = 0
      wrap gap = h - t
      wrap n = size - gap
    }
    count#[(f*COUNT_WIDTH)..+COUNT_WIDTH] = n
  }
  full     = next_full
  is_empty = next_empty
  heads    = if rst == 1 { config_base } else { next_heads }

  push_full  = full
  head_valid = ~is_empty & ((1 << NUM_FIFOS) - 1)
  head       = heads
  empty      = is_empty
  items      = count
}
