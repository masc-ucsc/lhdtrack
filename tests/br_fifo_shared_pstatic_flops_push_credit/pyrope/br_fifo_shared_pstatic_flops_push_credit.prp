const br_fifo_shared_pstatic_ctrl_push_credit = import("br_fifo_shared_pstatic_ctrl_push_credit.br_fifo_shared_pstatic_ctrl_push_credit")
const br_ram_flops                            = import("br_ram_flops.br_ram_flops")

// Two credit-based FIFOs statically partitioned inside one shared 32x32 flop
// RAM (see br_fifo_shared_pstatic_ctrl_push_credit). The RAM is held in reset
// while either this receiver or the push sender is in reset.
pub mod br_fifo_shared_pstatic_flops_push_credit(
  clk:u1,
  rst:u1,
  config_base:u10,
  config_bound:u10,
  push_sender_in_reset:u1,
  push_credit_stall:u2,
  push_valid:u1,
  push_data:u32,
  push_fifo_id:u1,
  credit_initial_push:u12,
  credit_withhold_push:u12,
  pop_ready:u2
) -> (
  config_error:u1@[],
  push_receiver_in_reset:u1@[],
  push_credit:u2@[],
  push_full:u2@[],
  credit_available_push:u12@[],
  credit_count_push:u12@[],
  pop_valid:u2@[],
  pop_data:u64@[],
  pop_empty:u2@[]
) {
  // RAM read data, returned to the controller below.
  wire rd_data_valid:bool = nil
  wire rd_data:u32        = nil

  const ctrl = br_fifo_shared_pstatic_ctrl_push_credit(
    clk=clk,
    rst=rst,
    config_base=config_base,
    config_bound=config_bound,
    push_sender_in_reset=push_sender_in_reset,
    push_credit_stall=push_credit_stall,
    push_valid=push_valid,
    push_data=push_data,
    push_fifo_id=push_fifo_id,
    credit_initial_push=credit_initial_push,
    credit_withhold_push=credit_withhold_push,
    pop_ready=pop_ready,
    ram_rd_data_valid=rd_data_valid,
    ram_rd_data=rd_data
  )
  const ram = br_ram_flops(
    clk=clk,
    rst=rst | push_sender_in_reset,
    wr_valid=ctrl.ram_wr_valid,
    wr_addr=ctrl.ram_wr_addr,
    wr_data=ctrl.ram_wr_data,
    rd_addr_valid=ctrl.ram_rd_addr_valid,
    rd_addr=ctrl.ram_rd_addr
  )
  rd_data_valid = ram.rd_data_valid
  rd_data       = ram.rd_data

  config_error           = ctrl.config_error
  push_receiver_in_reset = ctrl.push_receiver_in_reset
  push_credit            = ctrl.push_credit
  push_full              = ctrl.push_full
  credit_available_push  = ctrl.credit_available_push
  credit_count_push      = ctrl.credit_count_push
  pop_valid              = ctrl.pop_valid
  pop_data               = ctrl.pop_data
  pop_empty              = ctrl.pop_empty
}
