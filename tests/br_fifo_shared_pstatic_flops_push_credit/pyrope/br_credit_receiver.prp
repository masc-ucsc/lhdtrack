// Credit receiver of one flow: holds the credits of the receiving FIFO, sends
// one to the sender each cycle a credit is available (above the withheld
// amount) and not stalled, and takes one back whenever an entry is freed.
// The counter restarts at credit_initial whenever either side is in reset.
// Supported configuration: one credit per cycle each way, registered push
// outputs.
pub mod br_credit_receiver<COUNT_WIDTH=1>(
  clk:u1,
  rst:u1,
  push_sender_in_reset:bool,
  push_credit_stall:bool,
  pop_credit:u1,  // u1, not bool: a bool port in a generic breaks the LEC encoder (LiveHD bug)
  credit_initial:unsigned(bits=COUNT_WIDTH),
  credit_withhold:unsigned(bits=COUNT_WIDTH)
) -> (
  push_receiver_in_reset:bool@[],  // registered
  push_credit:bool@[],             // registered
  credit_count:unsigned(bits=COUNT_WIDTH)@[0],
  credit_available:unsigned(bits=COUNT_WIDTH)@[0]
) {
  const either_rst = rst == 1 or push_sender_in_reset

  // The reset value is a runtime input, so the reset is written out.
  reg count:unsigned(bits=COUNT_WIDTH) = nil
  mut with_returned:unsigned(bits=COUNT_WIDTH) = 0
  wrap with_returned = count + pop_credit
  mut available:unsigned(bits=COUNT_WIDTH) = 0
  if with_returned > credit_withhold {
    wrap available = with_returned - credit_withhold   // positive here; the range check ignores the guard
  }
  const send = not push_credit_stall and available != 0

  if either_rst {
    count = credit_initial
  } elif pop_credit == 1 or send {
    wrap count = with_returned - u1(send)
  }

  // Registered push-side outputs (reset by rst only).
  reg in_reset:bool = true
  reg credit:bool   = false
  in_reset = false
  credit   = send and not either_rst

  push_receiver_in_reset = in_reset
  push_credit            = credit
  credit_count           = count
  credit_available       = available
}
