const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")

// Staging buffer between a FIFO's RAM and its pop interface. It issues RAM
// reads while there is room for the returning data and stages up to two items:
// a one-entry skid buffer plus the registered pop output.
//
// Supported configuration: RAM read latency 1, two staged entries, registered
// pop outputs, no bypass path, total_items counts only the items still in RAM.
pub mod br_fifo_staging_buffer<WIDTH=1, COUNT_WIDTH=1>(
  clk:u1,
  rst:u1,
  total_items:unsigned(bits=COUNT_WIDTH),
  ram_rd_addr_ready:bool,
  ram_rd_data_valid:bool,
  ram_rd_data:unsigned(bits=WIDTH),
  pop_ready:bool
) -> (ram_rd_addr_valid:bool@[0], pop_valid:bool@[0], pop_data:unsigned(bits=WIDTH)@[0], pop_empty:bool@[0]) {
  comptime const BUFFER_DEPTH = 2

  // Items read from the RAM (or in flight) and not yet popped.
  reg staged_items:u2 = 0
  reg empty:bool      = true
  // Skid entry for RAM data the output register cannot take yet.
  reg buffer_valid:bool                = false
  reg buffer_data:unsigned(bits=WIDTH) = 0

  // The skid entry drains first; otherwise RAM data passes straight through.
  const out = br_flow_reg_fwd<WIDTH=WIDTH>(
    clk=clk,
    rst=rst,
    push_valid=buffer_valid or ram_rd_data_valid,
    push_data=if buffer_valid { buffer_data } else { ram_rd_data },
    pop_ready=pop_ready
  )
  const out_ready = out.push_ready

  // Read the RAM while items remain there and their data will have room.
  const pop_beat        = out.pop_valid and pop_ready
  const space_available = staged_items < BUFFER_DEPTH or pop_beat
  ram_rd_addr_valid     = space_available and total_items != 0
  const read_beat       = ram_rd_addr_valid and ram_rd_addr_ready

  if read_beat or pop_beat {
    mut next_items:u2 = 0
    wrap next_items = staged_items + u1(read_beat) - u1(pop_beat)
    staged_items = next_items
    empty        = next_items == 0
  }

  const buffer_valid_next = if buffer_valid {
    ram_rd_data_valid or not out_ready
  } else {
    ram_rd_data_valid and not out_ready
  }
  if buffer_valid_next and (not buffer_valid or out_ready) {
    buffer_data = ram_rd_data
  }
  buffer_valid = buffer_valid_next

  pop_valid = out.pop_valid
  pop_data  = out.pop_data
  pop_empty = empty
}
