const br_fifo_shared_pop_ctrl = import("br_fifo_shared_pop_ctrl.br_fifo_shared_pop_ctrl")
const br_fifo_shared_pstatic_ptr_mgr = import("br_fifo_shared_pstatic_ptr_mgr.br_fifo_shared_pstatic_ptr_mgr")
const br_fifo_shared_pstatic_push_ctrl_credit = import("br_fifo_shared_pstatic_push_ctrl_credit.br_fifo_shared_pstatic_push_ctrl_credit")
const br_fifo_shared_pstatic_size_calc_t = import("br_fifo_shared_pstatic_size_calc.br_fifo_shared_pstatic_size_calc")
const br_credit_receiver = import("br_credit_receiver.br_credit_receiver")
const cfg = import("lhdtrack_cfg")

// Controller of 2 credit-based FIFOs statically partitioned inside one shared
// 32-entry RAM: FIFO f owns entries config_base[f]..config_bound[f].
// Push side: one write port. push_fifo_id picks the FIFO; each FIFO has its
// own credit receiver and a tail pointer that wraps within its partition.
// Pop side: see br_fifo_shared_pop_ctrl. A freed entry returns a credit.
// Per-FIFO buses are packed with FIFO 0 in the low bits. One write port, one
// read port, RAM read latency 1, no bypass.
pub mod br_fifo_shared_pstatic_ctrl_push_credit<NumFifos=2, Depth=32, Width=32, NumWritePorts=1, NumReadPorts=1, StagingBufferDepth=2, RegisterPopOutputs=1, RamReadLatency=1, EnableBypass=0, RegisterPushOutputs=1, EnableCoverPushCreditStall=1, EnableCoverCreditWithhold=1, EnableCoverPushSenderInReset=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, config_base:U10, config_bound:U10, credit_initial_push:U12, credit_withhold_push:U12, pop_ready:U2, push_credit_stall:U2, push_data:U32, push_fifo_id:U1, push_sender_in_reset:U1, push_valid:U1, ram_rd_data:U32, ram_rd_data_valid:U1, rst:U1) -> (config_error:U1@[], credit_available_push:U12@[], credit_count_push:U12@[], pop_data:U64@[], pop_empty:U2@[], pop_valid:U2@[], push_credit:U2@[], push_full:U2@[], push_receiver_in_reset:U1@[], ram_rd_addr:U5@[], ram_rd_addr_valid:U1@[], ram_wr_addr:U5@[], ram_wr_data:U32@[], ram_wr_valid:U1@[]) {
  if cfg.no_loop {
    wire dealloc_valid:U2 = nil
    wire bypass_ready:U2 = nil
    wire head_ready:U2 = nil
    wire push_full:U2 = nil
    mut br_fifo_shared_pstatic_size_calc = br_fifo_shared_pstatic_size_calc_t::[name=br_fifo_shared_pstatic_size_calc](clk=clk, rst=rst, config_base=config_base, config_bound=config_bound)
    mut _b2i_1 = if rst != 0 or push_sender_in_reset != 0 { 1 } else { 0 }
    const either_rst = _b2i_1
    mut br_fifo_shared_pstatic_push_ctrl_credit_inst = br_fifo_shared_pstatic_push_ctrl_credit::[name=br_fifo_shared_pstatic_push_ctrl_credit_inst](clk=clk, rst=rst, config_size=br_fifo_shared_pstatic_size_calc.config_size, config_base=config_base, config_bound=config_bound, push_sender_in_reset=push_sender_in_reset, `push_credit_stall.e1`=(push_credit_stall >> 1) & 1, `push_credit_stall.e0`=push_credit_stall & 1, push_valid=push_valid, push_data=push_data, push_fifo_id=push_fifo_id, push_full=push_full, `bypass_ready.e1`=(bypass_ready >> 1) & 1, `bypass_ready.e0`=bypass_ready & 1, credit_initial_push=credit_initial_push, credit_withhold_push=credit_withhold_push, `dealloc_valid.e1`=(dealloc_valid >> 1) & 1, `dealloc_valid.e0`=dealloc_valid & 1)
    mut br_fifo_shared_pstatic_ptr_mgr_inst = br_fifo_shared_pstatic_ptr_mgr::[name=br_fifo_shared_pstatic_ptr_mgr_inst](clk=clk, rst=either_rst, config_base=config_base, config_bound=config_bound, config_size=br_fifo_shared_pstatic_size_calc.config_size, `advance_tail.e1`=(br_fifo_shared_pstatic_push_ctrl_credit_inst.advance_tail >> 1) & 1, `advance_tail.e0`=br_fifo_shared_pstatic_push_ctrl_credit_inst.advance_tail & 1, tail_next=br_fifo_shared_pstatic_push_ctrl_credit_inst.tail_next, tail=br_fifo_shared_pstatic_push_ctrl_credit_inst.tail, head_ready=head_ready)
    push_full = (br_fifo_shared_pstatic_ptr_mgr_inst.push_full.e1 << 1) | br_fifo_shared_pstatic_ptr_mgr_inst.push_full.e0
    mut br_fifo_shared_pop_ctrl_inst = br_fifo_shared_pop_ctrl::[name=br_fifo_shared_pop_ctrl_inst](clk=clk, rst=either_rst, head_valid=br_fifo_shared_pstatic_ptr_mgr_inst.head_valid, head=br_fifo_shared_pstatic_ptr_mgr_inst.head, ram_empty=(br_fifo_shared_pstatic_ptr_mgr_inst.empty.e1 << 1) | br_fifo_shared_pstatic_ptr_mgr_inst.empty.e0, ram_items=br_fifo_shared_pstatic_ptr_mgr_inst.items, bypass_valid_unstable=(br_fifo_shared_pstatic_push_ctrl_credit_inst.bypass_valid_unstable.e1 << 1) | br_fifo_shared_pstatic_push_ctrl_credit_inst.bypass_valid_unstable.e0, bypass_data_unstable=br_fifo_shared_pstatic_push_ctrl_credit_inst.bypass_data_unstable, pop_ready=pop_ready, data_ram_rd_data_valid=ram_rd_data_valid, data_ram_rd_data=ram_rd_data)
    head_ready = br_fifo_shared_pop_ctrl_inst.head_ready
    bypass_ready = br_fifo_shared_pop_ctrl_inst.bypass_ready
    dealloc_valid = br_fifo_shared_pop_ctrl_inst.dealloc_valid
    config_error = br_fifo_shared_pstatic_size_calc.config_error
    push_receiver_in_reset = br_fifo_shared_pstatic_push_ctrl_credit_inst.push_receiver_in_reset
    push_credit = (br_fifo_shared_pstatic_push_ctrl_credit_inst.push_credit.e1 << 1) | br_fifo_shared_pstatic_push_ctrl_credit_inst.push_credit.e0
    credit_available_push = br_fifo_shared_pstatic_push_ctrl_credit_inst.credit_available_push
    credit_count_push = br_fifo_shared_pstatic_push_ctrl_credit_inst.credit_count_push
    pop_valid = br_fifo_shared_pop_ctrl_inst.pop_valid
    pop_data = br_fifo_shared_pop_ctrl_inst.pop_data
    pop_empty = br_fifo_shared_pop_ctrl_inst.pop_empty
    ram_wr_valid = br_fifo_shared_pstatic_push_ctrl_credit_inst.ram_wr_valid
    ram_wr_addr = br_fifo_shared_pstatic_push_ctrl_credit_inst.ram_wr_addr
    ram_wr_data = br_fifo_shared_pstatic_push_ctrl_credit_inst.ram_wr_data
    ram_rd_addr_valid = br_fifo_shared_pop_ctrl_inst.data_ram_rd_addr_valid
    ram_rd_addr = br_fifo_shared_pop_ctrl_inst.data_ram_rd_addr
  } else {
    comptime const NUM_FIFOS   = push_full.[bits]
    comptime const ADDR_WIDTH  = config_base.[bits] / NUM_FIFOS
    comptime const COUNT_WIDTH = credit_initial_push.[bits] / NUM_FIFOS

    const either_rst = rst == 1 or push_sender_in_reset == 1

    // Partition sizes and configuration errors: a partition must not be empty
    // and must start after the previous one ends.
    mut size:U12 = 0
    mut bad      = false
    for f in 0..<NUM_FIFOS {
      const base  = config_base#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      const bound = config_bound#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      mut s:Unsigned(bits=COUNT_WIDTH) = 0
      wrap s = bound + 1 - base
      size#[(f*COUNT_WIDTH)..+COUNT_WIDTH] = s
      bad = bad or base > bound
      if f > 0 {
        bad = bad or base <= config_bound#[((f - 1)*ADDR_WIDTH)..+ADDR_WIDTH]
      }
    }
    config_error = U1(bad)

    // Pointer manager outputs used by the push side and the pop side.
    wire full:U2       = nil
    wire dealloc:U2    = nil
    wire head_ready:U2 = nil

    // Push side: steer the write to the selected FIFO unless it is full; its
    // tail pointer walks base..bound and wraps back to base.
    reg tails:U10         = nil
    mut next_tails        = tails
    mut tail_next:U10     = 0
    mut advance:U2        = 0
    mut wr_addr:U5        = 0
    mut credits:U2        = 0
    mut receiver_in_reset = false
    mut available:U12     = 0
    mut count:U12         = 0
    for f in 0..<NUM_FIFOS {
      const t     = tails#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      const base  = config_base#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      const bound = config_bound#[(f*ADDR_WIDTH)..+ADDR_WIDTH]
      const write = push_valid == 1 and push_fifo_id == f and full#[f] == 0

      mut t_next:Unsigned(bits=ADDR_WIDTH) = 0
      if write and t == bound {
        t_next = base
      } else {
        wrap t_next = t + U1(write)
      }
      if write {
        next_tails#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = t_next
        wr_addr |= t
      }
      tail_next#[(f*ADDR_WIDTH)..+ADDR_WIDTH] = t_next
      advance#[f] = U1(write)

      const receiver = br_credit_receiver(
        clk=clk,
        rst=rst,
        push_sender_in_reset=push_sender_in_reset,
        push_credit_stall=push_credit_stall#[f],
        push_valid=U1(push_valid == 1 and push_fifo_id == f),
        push_data=push_data,
        pop_credit=dealloc#[f],
        credit_initial=credit_initial_push#[(f*COUNT_WIDTH)..+COUNT_WIDTH],
        credit_withhold=credit_withhold_push#[(f*COUNT_WIDTH)..+COUNT_WIDTH]
      )
      credits#[f] = receiver.push_credit
      // Every receiver leaves reset together; FIFO 0 reports it.
      if f == 0 {
        receiver_in_reset = receiver.push_receiver_in_reset == 1
      }
      available#[(f*COUNT_WIDTH)..+COUNT_WIDTH] = receiver.credit_available
      count#[(f*COUNT_WIDTH)..+COUNT_WIDTH]     = receiver.credit_count
    }
    tails = if either_rst { config_base } else { next_tails }

    const ptrs = br_fifo_shared_pstatic_ptr_mgr(
      clk=clk,
      rst=U1(either_rst),
      config_base=config_base,
      config_bound=config_bound,
      config_size=size,
      `advance_tail.e1`=advance#[1],
      `advance_tail.e0`=advance#[0],
      tail_next=tail_next,
      tail=tails,
      head_ready=head_ready
    )
    full = (ptrs.push_full.e0#[0], ptrs.push_full.e1#[0])#[..]

    const pop = br_fifo_shared_pop_ctrl(
      clk=clk,
      rst=either_rst,
      head_valid=ptrs.head_valid,
      head=ptrs.head,
      ram_empty=(ptrs.empty.e0#[0], ptrs.empty.e1#[0])#[..],
      ram_items=ptrs.items,
      pop_ready=pop_ready,
      bypass_valid_unstable=0,
      bypass_data_unstable=0,
      data_ram_rd_data_valid=ram_rd_data_valid,
      data_ram_rd_data=ram_rd_data
    )
    dealloc    = pop.dealloc_valid
    head_ready = pop.head_ready

    push_receiver_in_reset = U1(receiver_in_reset)
    push_credit            = credits
    push_full              = full
    credit_available_push  = available
    credit_count_push      = count
    pop_valid              = pop.pop_valid
    pop_data               = pop.pop_data
    pop_empty              = pop.pop_empty
    ram_wr_valid           = U1(advance != 0)
    ram_wr_addr            = wr_addr
    ram_wr_data            = if advance != 0 { push_data } else { 0 }
    ram_rd_addr_valid      = pop.data_ram_rd_addr_valid
    ram_rd_addr            = pop.data_ram_rd_addr
  }
}
