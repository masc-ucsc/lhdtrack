const br_flow_arb_rr  = import("br_flow_arb_rr.br_flow_arb_rr")
const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")

// Two-flow valid/ready join: the joined beat is valid when both sides are, and
// each side is ready only when the other one is valid too.
comb join2(a_valid:bool, b_valid:bool, pop_ready:bool) -> (a_ready:bool, b_ready:bool, pop_valid:bool) {
  a_ready   = pop_ready and b_valid
  b_ready   = pop_ready and a_valid
  pop_valid = a_valid and b_valid
}

// AXI4-Lite write arbiter: two upstream initiators share one downstream
// target. Each initiator's AW and W beats are joined into one write request, a
// round-robin arbiter picks one, and the picked request forks into registered
// AW and W channels plus an owner register. The owner routes the single
// outstanding write response back to the initiator that issued the write.
//
// Per-initiator buses are packed with initiator 0 in the low bits. Supported
// configuration: one outstanding write (the owner FIFO for more is not
// implemented). clk only fed the upstream assertions.
pub mod br_amba_axil_write_arbiter(
  clk:u1,
  rst:u1,
  upstream_awaddr:u80,
  upstream_awprot:u6,
  upstream_awuser:u2,
  upstream_awvalid:u2,
  upstream_wdata:u128,
  upstream_wstrb:u16,
  upstream_wuser:u2,
  upstream_wvalid:u2,
  upstream_bready:u2,
  downstream_awready:u1,
  downstream_wready:u1,
  downstream_bresp:u2,
  downstream_buser:u1,
  downstream_bvalid:u1
) -> (
  upstream_awready:u2@[0],
  upstream_wready:u2@[0],
  upstream_bresp:u4@[0],
  upstream_buser:u2@[0],
  upstream_bvalid:u2@[0],
  downstream_awaddr:u40@[0],
  downstream_awprot:u3@[0],
  downstream_awuser:u1@[0],
  downstream_awvalid:u1@[0],
  downstream_wdata:u64@[0],
  downstream_wstrb:u8@[0],
  downstream_wuser:u1@[0],
  downstream_wvalid:u1@[0],
  downstream_bready:u1@[0]
) {
  comptime const NUM_INITIATORS = upstream_awvalid.[bits]
  cassert(NUM_INITIATORS == 2, "the owner is one bit wide")

  type Aw = (addr:u40, prot:u3, user:u1)
  type W = (data:u64, strb:u8, user:u1)

  // Request side: an initiator requests once both its AW and W beats are valid.
  wire request_ready:u2 = nil
  mut request_valid:u2  = 0
  mut awready:u2        = 0
  mut wready:u2         = 0
  for i in 0..<NUM_INITIATORS {
    const join        = join2(a_valid=upstream_awvalid#[i] == 1, b_valid=upstream_wvalid#[i] == 1, pop_ready=request_ready#[i] == 1)
    request_valid#[i] = u1(join.pop_valid)
    awready#[i]       = u1(join.a_ready)
    wready#[i]        = u1(join.b_ready)
  }
  upstream_awready = awready
  upstream_wready  = wready

  wire request_pop_ready:bool = nil
  const arb = br_flow_arb_rr<NUM_FLOWS=NUM_INITIATORS>(rst=rst, push_valid=request_valid, pop_ready=request_pop_ready)
  request_ready               = arb.push_ready

  // The granted initiator's request; its index is the owner of the write.
  mut aw_request:Aw    = (addr=0, prot=0, user=0)
  mut w_request:W      = (data=0, strb=0, user=0)
  mut owner_request:u1 = 0
  for i in 0..<NUM_INITIATORS {
    if arb.grant#[i] == 1 {
      aw_request    = (addr=upstream_awaddr#[(i*40)..+40], prot=upstream_awprot#[(i*3)..+3], user=upstream_awuser#[i])
      w_request     = (data=upstream_wdata#[(i*64)..+64], strb=upstream_wstrb#[(i*8)..+8], user=upstream_wuser#[i])
      owner_request = i
    }
  }

  // Fork the request into the AW, W and owner stages: each stage takes it only
  // when the other two can take it in the same cycle.
  wire aw_ready:bool      = nil
  wire w_ready:bool       = nil
  wire owner_ready:bool   = nil
  const request_valid_out = arb.pop_valid_unstable
  request_pop_ready       = aw_ready and w_ready and owner_ready

  const aw_stage = br_flow_reg_fwd<T=Aw>(
    rst=rst, push_valid=request_valid_out and w_ready and owner_ready, push_data=aw_request, pop_ready=downstream_awready == 1
  )
  const w_stage = br_flow_reg_fwd<T=W>(
    rst=rst, push_valid=request_valid_out and aw_ready and owner_ready, push_data=w_request, pop_ready=downstream_wready == 1
  )
  wire owner_pop_ready:bool = nil
  const owner_stage         = br_flow_reg_fwd<T=u1>(
    rst=rst, push_valid=request_valid_out and aw_ready and w_ready, push_data=owner_request, pop_ready=owner_pop_ready
  )
  aw_ready    = aw_stage.push_ready
  w_ready     = w_stage.push_ready
  owner_ready = owner_stage.push_ready

  downstream_awaddr  = aw_stage.pop_data.addr
  downstream_awprot  = aw_stage.pop_data.prot
  downstream_awuser  = aw_stage.pop_data.user
  downstream_awvalid = u1(aw_stage.pop_valid)
  downstream_wdata   = w_stage.pop_data.data
  downstream_wstrb   = w_stage.pop_data.strb
  downstream_wuser   = w_stage.pop_data.user
  downstream_wvalid  = u1(w_stage.pop_valid)

  // Response side: a B beat is routed to the recorded owner. Every initiator
  // sees the response payload; only the owner sees it valid.
  const owner          = owner_stage.pop_data
  const response_ready = upstream_bready#[owner] == 1
  const response       = join2(a_valid=downstream_bvalid == 1, b_valid=owner_stage.pop_valid, pop_ready=response_ready)
  downstream_bready    = u1(response.a_ready)
  owner_pop_ready      = response.b_ready

  upstream_bvalid = if response.pop_valid { 1 << owner } else { 0 }
  mut bresp:u4    = 0
  mut buser:u2    = 0
  for i in 0..<NUM_INITIATORS {
    bresp#[(i*2)..+2] = downstream_bresp
    buser#[i]         = downstream_buser
  }
  upstream_bresp = bresp
  upstream_buser = buser
}
