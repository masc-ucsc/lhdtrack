const br_flow_demux_select_unstable = import("br_flow_demux_select_unstable.br_flow_demux_select_unstable")
const br_flow_fork_t = import("br_flow_fork.br_flow_fork")
const br_flow_join = import("br_flow_join.br_flow_join")
const br_flow_mux_rr_t = import("br_flow_mux_rr.br_flow_mux_rr")
const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")
const br_flow_reg_fwd_p1 = import("br_flow_reg_fwd_p1.br_flow_reg_fwd_p1")
const br_flow_reg_fwd_p2 = import("br_flow_reg_fwd_p2.br_flow_reg_fwd_p2")
const br_amba = import("br_amba")
const br_arb_rr_internal_t = import("br_arb_rr_internal.br_arb_rr_internal")
const cfg = import("lhdtrack_cfg")

// AXI4-Lite write arbiter: two upstream initiators share one downstream
// target. Each initiator's AW and W beats are joined into one write request, a
// round-robin arbiter picks one, and the picked request forks into registered
// AW and W channels plus an owner register. The owner routes the single
// outstanding write response back to the initiator that issued the write.
// Per-initiator buses are packed with initiator 0 in the low bits.
pub mod br_amba_axil_write_arbiter::[timecheck=false](clk:Clock, downstream_awready:U1, downstream_bresp:U2, downstream_buser:U1, downstream_bvalid:U1, downstream_wready:U1, rst:Reset, upstream_awaddr:U80, upstream_awprot:U6, upstream_awuser:U2, upstream_awvalid:U2, upstream_bready:U2, upstream_wdata:U128, upstream_wstrb:U16, upstream_wuser:U2, upstream_wvalid:U2) -> (downstream_awaddr:U40@[], downstream_awprot:U3@[], downstream_awuser:U1@[], downstream_awvalid:U1@[], downstream_bready:U1@[], downstream_wdata:U64@[], downstream_wstrb:U8@[], downstream_wuser:U1@[], downstream_wvalid:U1@[], upstream_awready:U2@[], upstream_bresp:U4@[], upstream_buser:U2@[], upstream_bvalid:U2@[], upstream_wready:U2@[]) {
  if cfg.no_loop {
    wire `upstream_awready[0]`:U1 = nil
    wire `upstream_awready[1]`:U1 = nil
    wire upstream_awready:U2 = nil
    wire `upstream_wready[0]`:U1 = nil
    wire `upstream_wready[1]`:U1 = nil
    wire upstream_wready:U2 = nil
    wire upstream_bresp_bits:U4 = nil
    wire upstream_bresp:U4 = nil
    wire `upstream_buser[0]`:U1 = nil
    wire `upstream_buser[1]`:U1 = nil
    wire upstream_buser:U2 = nil
    wire `request_push_valid[0]`:U1 = nil
    wire `request_push_valid[1]`:U1 = nil
    wire request_push_valid:U2 = nil
    wire request_push_data_bits:U236 = nil
    wire request_push_data:U236 = nil
    wire request_fork_ready_bits:U3 = nil
    wire request_fork_ready:U3 = nil
    wire request_push_ready:U2 = nil
    wire request_pop_ready:U1 = nil
    wire owner_ready:U1 = nil
    wire response_push_valid:U1 = nil
    const t38 = 0 | ((upstream_wuser & 1) << 1) | (upstream_wstrb#[0..=7] << 2) | (upstream_wdata#[0..=63] << 10) | ((upstream_awuser & 1) << 0x4a) | (upstream_awprot#[0..=2] << 0x4b) | (upstream_awaddr#[0..=39] << 0x4e)
    request_push_data_bits#[0..<64] = t38#[0..<64]
    request_push_data_bits#[64] = (t38 >> 0x40) & 1
    request_push_data_bits#[65] = (t38 >> 0x41) & 1
    request_push_data_bits#[66] = (t38 >> 0x42) & 1
    request_push_data_bits#[67] = (t38 >> 0x43) & 1
    request_push_data_bits#[68] = (t38 >> 0x44) & 1
    request_push_data_bits#[69] = (t38 >> 0x45) & 1
    request_push_data_bits#[70] = (t38 >> 0x46) & 1
    request_push_data_bits#[71] = (t38 >> 0x47) & 1
    request_push_data_bits#[72] = (t38 >> 0x48) & 1
    request_push_data_bits#[73] = (t38 >> 0x49) & 1
    request_push_data_bits#[74] = (t38 >> 0x4a) & 1
    request_push_data_bits#[75] = (t38 >> 0x4b) & 1
    request_push_data_bits#[76] = (t38 >> 0x4c) & 1
    request_push_data_bits#[77] = (t38 >> 0x4d) & 1
    request_push_data_bits#[78] = (t38 >> 0x4e) & 1
    request_push_data_bits#[79] = (t38 >> 0x4f) & 1
    request_push_data_bits#[80] = (t38 >> 0x50) & 1
    request_push_data_bits#[81] = (t38 >> 0x51) & 1
    request_push_data_bits#[82] = (t38 >> 0x52) & 1
    request_push_data_bits#[83] = (t38 >> 0x53) & 1
    request_push_data_bits#[84] = (t38 >> 0x54) & 1
    request_push_data_bits#[85] = (t38 >> 0x55) & 1
    request_push_data_bits#[86] = (t38 >> 0x56) & 1
    request_push_data_bits#[87] = (t38 >> 0x57) & 1
    request_push_data_bits#[88] = (t38 >> 0x58) & 1
    request_push_data_bits#[89] = (t38 >> 0x59) & 1
    request_push_data_bits#[90] = (t38 >> 0x5a) & 1
    request_push_data_bits#[91] = (t38 >> 0x5b) & 1
    request_push_data_bits#[92] = (t38 >> 0x5c) & 1
    request_push_data_bits#[93] = (t38 >> 0x5d) & 1
    request_push_data_bits#[94] = (t38 >> 0x5e) & 1
    request_push_data_bits#[95] = (t38 >> 0x5f) & 1
    request_push_data_bits#[96] = (t38 >> 0x60) & 1
    request_push_data_bits#[97] = (t38 >> 0x61) & 1
    request_push_data_bits#[98] = (t38 >> 0x62) & 1
    request_push_data_bits#[99] = (t38 >> 0x63) & 1
    request_push_data_bits#[100] = (t38 >> 0x64) & 1
    request_push_data_bits#[101] = (t38 >> 0x65) & 1
    request_push_data_bits#[102] = (t38 >> 0x66) & 1
    request_push_data_bits#[103] = (t38 >> 0x67) & 1
    request_push_data_bits#[104] = (t38 >> 0x68) & 1
    request_push_data_bits#[105] = (t38 >> 0x69) & 1
    request_push_data_bits#[106] = (t38 >> 0x6a) & 1
    request_push_data_bits#[107] = (t38 >> 0x6b) & 1
    request_push_data_bits#[108] = (t38 >> 0x6c) & 1
    request_push_data_bits#[109] = (t38 >> 0x6d) & 1
    request_push_data_bits#[110] = (t38 >> 0x6e) & 1
    request_push_data_bits#[111] = (t38 >> 0x6f) & 1
    request_push_data_bits#[112] = (t38 >> 0x70) & 1
    request_push_data_bits#[113] = (t38 >> 0x71) & 1
    request_push_data_bits#[114] = (t38 >> 0x72) & 1
    request_push_data_bits#[115] = (t38 >> 0x73) & 1
    request_push_data_bits#[116] = (t38 >> 0x74) & 1
    request_push_data_bits#[117] = (t38 >> 0x75) & 1
    const t293 = 1 | (((upstream_wuser >> 1) & 1) << 1) | (upstream_wstrb#[8..=15] << 2) | (upstream_wdata#[64..=127] << 10) | (((upstream_awuser >> 1) & 1) << 0x4a) | (upstream_awprot#[3..=5] << 0x4b) | (upstream_awaddr#[40..=79] << 0x4e)
    request_push_data_bits#[118..<182] = t293#[0..<64]
    request_push_data_bits#[182] = (t293 >> 0x40) & 1
    request_push_data_bits#[183] = (t293 >> 0x41) & 1
    request_push_data_bits#[184] = (t293 >> 0x42) & 1
    request_push_data_bits#[185] = (t293 >> 0x43) & 1
    request_push_data_bits#[186] = (t293 >> 0x44) & 1
    request_push_data_bits#[187] = (t293 >> 0x45) & 1
    request_push_data_bits#[188] = (t293 >> 0x46) & 1
    request_push_data_bits#[189] = (t293 >> 0x47) & 1
    request_push_data_bits#[190] = (t293 >> 0x48) & 1
    request_push_data_bits#[191] = (t293 >> 0x49) & 1
    request_push_data_bits#[192] = (t293 >> 0x4a) & 1
    request_push_data_bits#[193] = (t293 >> 0x4b) & 1
    request_push_data_bits#[194] = (t293 >> 0x4c) & 1
    request_push_data_bits#[195] = (t293 >> 0x4d) & 1
    request_push_data_bits#[196] = (t293 >> 0x4e) & 1
    request_push_data_bits#[197] = (t293 >> 0x4f) & 1
    request_push_data_bits#[198] = (t293 >> 0x50) & 1
    request_push_data_bits#[199] = (t293 >> 0x51) & 1
    request_push_data_bits#[200] = (t293 >> 0x52) & 1
    request_push_data_bits#[201] = (t293 >> 0x53) & 1
    request_push_data_bits#[202] = (t293 >> 0x54) & 1
    request_push_data_bits#[203] = (t293 >> 0x55) & 1
    request_push_data_bits#[204] = (t293 >> 0x56) & 1
    request_push_data_bits#[205] = (t293 >> 0x57) & 1
    request_push_data_bits#[206] = (t293 >> 0x58) & 1
    request_push_data_bits#[207] = (t293 >> 0x59) & 1
    request_push_data_bits#[208] = (t293 >> 0x5a) & 1
    request_push_data_bits#[209] = (t293 >> 0x5b) & 1
    request_push_data_bits#[210] = (t293 >> 0x5c) & 1
    request_push_data_bits#[211] = (t293 >> 0x5d) & 1
    request_push_data_bits#[212] = (t293 >> 0x5e) & 1
    request_push_data_bits#[213] = (t293 >> 0x5f) & 1
    request_push_data_bits#[214] = (t293 >> 0x60) & 1
    request_push_data_bits#[215] = (t293 >> 0x61) & 1
    request_push_data_bits#[216] = (t293 >> 0x62) & 1
    request_push_data_bits#[217] = (t293 >> 0x63) & 1
    request_push_data_bits#[218] = (t293 >> 0x64) & 1
    request_push_data_bits#[219] = (t293 >> 0x65) & 1
    request_push_data_bits#[220] = (t293 >> 0x66) & 1
    request_push_data_bits#[221] = (t293 >> 0x67) & 1
    request_push_data_bits#[222] = (t293 >> 0x68) & 1
    request_push_data_bits#[223] = (t293 >> 0x69) & 1
    request_push_data_bits#[224] = (t293 >> 0x6a) & 1
    request_push_data_bits#[225] = (t293 >> 0x6b) & 1
    request_push_data_bits#[226] = (t293 >> 0x6c) & 1
    request_push_data_bits#[227] = (t293 >> 0x6d) & 1
    request_push_data_bits#[228] = (t293 >> 0x6e) & 1
    request_push_data_bits#[229] = (t293 >> 0x6f) & 1
    request_push_data_bits#[230] = (t293 >> 0x70) & 1
    request_push_data_bits#[231] = (t293 >> 0x71) & 1
    request_push_data_bits#[232] = (t293 >> 0x72) & 1
    request_push_data_bits#[233] = (t293 >> 0x73) & 1
    request_push_data_bits#[234] = (t293 >> 0x74) & 1
    request_push_data_bits#[235] = (t293 >> 0x75) & 1
    mut gen_request_0_br_flow_join_aw_w = br_flow_join::[name=gen_request_0_br_flow_join_aw_w](clk=clk, rst=rst, push_valid=((upstream_awvalid & 1) << 1) | (upstream_wvalid & 1), pop_ready=request_push_ready & 1)
    `upstream_wready[0]` = gen_request_0_br_flow_join_aw_w.push_ready & 1
    `upstream_awready[0]` = (gen_request_0_br_flow_join_aw_w.push_ready >> 1) & 1
    `request_push_valid[0]` = gen_request_0_br_flow_join_aw_w.pop_valid & 1
    mut gen_request_1_br_flow_join_aw_w = br_flow_join::[name=gen_request_1_br_flow_join_aw_w](clk=clk, rst=rst, push_valid=(((upstream_awvalid >> 1) & 1) << 1) | ((upstream_wvalid >> 1) & 1), pop_ready=(request_push_ready >> 1) & 1)
    `upstream_wready[1]` = gen_request_1_br_flow_join_aw_w.push_ready & 1
    `upstream_awready[1]` = (gen_request_1_br_flow_join_aw_w.push_ready >> 1) & 1
    `request_push_valid[1]` = gen_request_1_br_flow_join_aw_w.pop_valid & 1
    mut br_flow_mux_rr = br_flow_mux_rr_t::[name=br_flow_mux_rr](clk=clk, rst=rst, push_valid=request_push_valid, push_data=request_push_data, pop_ready=request_pop_ready)
    request_push_ready = br_flow_mux_rr.push_ready
    mut `request_pop_data.awaddr` = br_flow_mux_rr.pop_data_unstable#[78..=117]
    mut `request_pop_data.awprot` = br_flow_mux_rr.pop_data_unstable#[75..=77]
    mut `request_pop_data.awuser` = (br_flow_mux_rr.pop_data_unstable >> 0x4a) & 1
    mut `request_pop_data.wdata` = br_flow_mux_rr.pop_data_unstable#[10..=73]
    mut `request_pop_data.wstrb` = br_flow_mux_rr.pop_data_unstable#[2..=9]
    mut `request_pop_data.wuser` = (br_flow_mux_rr.pop_data_unstable >> 1) & 1
    mut `request_pop_data.owner` = br_flow_mux_rr.pop_data_unstable & 1
    mut br_flow_fork = br_flow_fork_t::[name=br_flow_fork](clk=clk, rst=rst, push_valid=br_flow_mux_rr.pop_valid_unstable, pop_ready=request_fork_ready)
    request_pop_ready = br_flow_fork.push_ready
    mut br_flow_reg_fwd_aw = br_flow_reg_fwd::[name=br_flow_reg_fwd_aw](clk=clk, rst=rst, push_valid=(br_flow_fork.pop_valid_unstable >> 0) & 1, push_data=(`request_pop_data.awaddr`#[0..=39] << 4) | (`request_pop_data.awprot`#[0..=2] << 1) | (`request_pop_data.awuser` & 1), pop_ready=downstream_awready)
    request_fork_ready_bits#[0] = br_flow_reg_fwd_aw.push_ready & 1
    mut br_flow_reg_fwd_w = br_flow_reg_fwd_p1::[name=br_flow_reg_fwd_w](clk=clk, rst=rst, push_valid=(br_flow_fork.pop_valid_unstable >> 1) & 1, push_data=(`request_pop_data.wdata`#[0..=63] << 9) | (`request_pop_data.wstrb`#[0..=7] << 1) | (`request_pop_data.wuser` & 1), pop_ready=downstream_wready)
    request_fork_ready_bits#[1] = br_flow_reg_fwd_w.push_ready & 1
    mut gen_owner_reg_br_flow_reg_fwd_owner = br_flow_reg_fwd_p2::[name=gen_owner_reg_br_flow_reg_fwd_owner](clk=clk, rst=rst, push_valid=(br_flow_fork.pop_valid_unstable >> 2) & 1, push_data=`request_pop_data.owner`, pop_ready=owner_ready)
    request_fork_ready_bits#[2] = gen_owner_reg_br_flow_reg_fwd_owner.push_ready & 1
    mut br_flow_demux_select_unstable_b = br_flow_demux_select_unstable::[name=br_flow_demux_select_unstable_b](clk=clk, rst=rst, select=gen_owner_reg_br_flow_reg_fwd_owner.pop_data, push_valid=response_push_valid, push_data=(downstream_bresp << 1) | (downstream_buser & 1), pop_ready=upstream_bready)
    upstream_bresp_bits#[0] = br_flow_demux_select_unstable_b.pop_data_unstable#[0..=2]#[1..=2] & 1
    upstream_bresp_bits#[1] = (br_flow_demux_select_unstable_b.pop_data_unstable#[0..=2]#[1..=2] >> 1) & 1
    `upstream_buser[0]` = br_flow_demux_select_unstable_b.pop_data_unstable#[0..=2] & 1
    upstream_bresp_bits#[2] = br_flow_demux_select_unstable_b.pop_data_unstable#[3..=5]#[1..=2] & 1
    upstream_bresp_bits#[3] = (br_flow_demux_select_unstable_b.pop_data_unstable#[3..=5]#[1..=2] >> 1) & 1
    `upstream_buser[1]` = br_flow_demux_select_unstable_b.pop_data_unstable#[3..=5] & 1
    mut br_flow_join_owner_b = br_flow_join::[name=br_flow_join_owner_b](clk=clk, rst=rst, push_valid=((downstream_bvalid & 1) << 1) | (gen_owner_reg_br_flow_reg_fwd_owner.pop_valid & 1), pop_ready=br_flow_demux_select_unstable_b.push_ready)
    owner_ready = br_flow_join_owner_b.push_ready & 1
    response_push_valid = br_flow_join_owner_b.pop_valid
    upstream_awready = (`upstream_awready[1]` << 1) | `upstream_awready[0]`
    upstream_wready = (`upstream_wready[1]` << 1) | `upstream_wready[0]`
    upstream_bresp = upstream_bresp_bits
    upstream_buser = (`upstream_buser[1]` << 1) | `upstream_buser[0]`
    request_push_valid = (`request_push_valid[1]` << 1) | `request_push_valid[0]`
    request_push_data = request_push_data_bits
    request_fork_ready = request_fork_ready_bits
    upstream_bvalid = br_flow_demux_select_unstable_b.pop_valid_unstable
    downstream_awaddr = (br_flow_reg_fwd_aw.pop_data >> 4)#[0..=39]
    downstream_awprot = (br_flow_reg_fwd_aw.pop_data >> 1)#[0..=2]
    downstream_awuser = br_flow_reg_fwd_aw.pop_data & 1
    downstream_awvalid = br_flow_reg_fwd_aw.pop_valid
    downstream_wdata = (br_flow_reg_fwd_w.pop_data >> 9)#[0..=63]
    downstream_wstrb = (br_flow_reg_fwd_w.pop_data >> 1)#[0..=7]
    downstream_wuser = br_flow_reg_fwd_w.pop_data & 1
    downstream_wvalid = br_flow_reg_fwd_w.pop_valid
    downstream_bready = (br_flow_join_owner_b.push_ready >> 1) & 1
  } else {
    comptime const NUM_INITIATORS = upstream_awvalid.[bits]
    cassert(NUM_INITIATORS == 2, "the owner is one bit wide")

    // Request side: an initiator requests once both its AW and W beats are valid,
    // and each beat is ready only when the other one is valid too.
    wire request_ready:U2 = nil
    mut request_valid:U2  = 0
    mut awready:U2        = 0
    mut wready:U2         = 0
    for i in 0..<NUM_INITIATORS {
      request_valid#[i] = U1(upstream_awvalid#[i] == 1 and upstream_wvalid#[i] == 1)
      awready#[i]       = U1(request_ready#[i] == 1 and upstream_wvalid#[i] == 1)
      wready#[i]        = U1(request_ready#[i] == 1 and upstream_awvalid#[i] == 1)
    }
    upstream_awready = awready
    upstream_wready  = wready

    // Round-robin arbitration; the priority advances only when the fork accepts.
    wire request_pop_ready:U1 = nil
    mut br_arb_rr_internal = br_arb_rr_internal_t::[name=br_arb_rr_internal](clk=clk, rst=rst, enable_priority_update=request_pop_ready, request=request_valid)
    const can_grant:U2      = (br_arb_rr_internal.can_grant.e0#[0], br_arb_rr_internal.can_grant.e1#[0])#[..]
    request_ready           = if request_pop_ready == 1 { can_grant } else { 0 }
    const request_valid_out = request_valid != 0

    // The granted initiator's request; its index is the owner of the write.
    // AW packs (user, prot, addr) and W packs (user, strb, data) from the LSB.
    mut aw_request:U44   = 0
    mut w_request:U73    = 0
    mut owner_request:U1 = 0
    for i in 0..<NUM_INITIATORS {
      if br_arb_rr_internal.grant#[i] == 1 {
        aw_request    = (upstream_awuser#[i], upstream_awprot#[(i*3)..+3], upstream_awaddr#[(i*40)..+40])#[..]
        w_request     = (upstream_wuser#[i], upstream_wstrb#[(i*8)..+8], upstream_wdata#[(i*64)..+64])#[..]
        owner_request = i
      }
    }

    // Fork the request into the AW, W and owner stages: each stage takes it only
    // when the other two can take it in the same cycle.
    wire aw_ready:U1        = nil
    wire w_ready:U1         = nil
    wire owner_ready:U1     = nil
    wire owner_pop_ready:U1 = nil
    request_pop_ready       = U1(aw_ready == 1 and w_ready == 1 and owner_ready == 1)
    mut br_flow_reg_fwd_aw = br_flow_reg_fwd::[name=br_flow_reg_fwd_aw](clk=clk, rst=rst, push_valid=U1(request_valid_out and w_ready == 1 and owner_ready == 1), push_data=aw_request, pop_ready=downstream_awready)
    mut br_flow_reg_fwd_w = br_flow_reg_fwd_p1::[name=br_flow_reg_fwd_w](clk=clk, rst=rst, push_valid=U1(request_valid_out and aw_ready == 1 and owner_ready == 1), push_data=w_request, pop_ready=downstream_wready)
    mut gen_owner_reg_br_flow_reg_fwd_owner = br_flow_reg_fwd_p2::[name=gen_owner_reg_br_flow_reg_fwd_owner](clk=clk, rst=rst, push_valid=U1(request_valid_out and aw_ready == 1 and w_ready == 1), push_data=owner_request, pop_ready=owner_pop_ready)
    aw_ready    = br_flow_reg_fwd_aw.push_ready
    w_ready     = br_flow_reg_fwd_w.push_ready
    owner_ready = gen_owner_reg_br_flow_reg_fwd_owner.push_ready

    downstream_awaddr  = br_flow_reg_fwd_aw.pop_data#[4..<44]
    downstream_awprot  = br_flow_reg_fwd_aw.pop_data#[1..<4]
    downstream_awuser  = br_flow_reg_fwd_aw.pop_data#[0]
    downstream_awvalid = br_flow_reg_fwd_aw.pop_valid
    downstream_wdata   = br_flow_reg_fwd_w.pop_data#[9..<73]
    downstream_wstrb   = br_flow_reg_fwd_w.pop_data#[1..<9]
    downstream_wuser   = br_flow_reg_fwd_w.pop_data#[0]
    downstream_wvalid  = br_flow_reg_fwd_w.pop_valid

    // Response side: a B beat is routed to the recorded owner. Every initiator
    // sees the response payload; only the owner sees it valid.
    const owner          = gen_owner_reg_br_flow_reg_fwd_owner.pop_data
    const owner_valid    = gen_owner_reg_br_flow_reg_fwd_owner.pop_valid == 1
    const response_ready = upstream_bready#[owner] == 1
    downstream_bready    = U1(response_ready and owner_valid)
    owner_pop_ready      = U1(response_ready and downstream_bvalid == 1)
    upstream_bvalid      = if downstream_bvalid == 1 and owner_valid { 1 << owner } else { 0 }

    mut bresp:U4 = 0
    mut buser:U2 = 0
    for i in 0..<NUM_INITIATORS {
      bresp#[(i*2)..+2] = downstream_bresp
      buser#[i]         = downstream_buser
    }
    upstream_bresp = bresp
    upstream_buser = buser
  }
}
