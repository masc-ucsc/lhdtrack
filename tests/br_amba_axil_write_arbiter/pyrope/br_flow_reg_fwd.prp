// One-entry forward-registered valid/ready stage: the pop side is a register,
// so pop_valid and pop_data never depend combinationally on the push side.
// A new beat is accepted whenever the stage is empty or being drained. The
// data register has no reset and only loads on an accepted beat.
pub mod br_flow_reg_fwd<T=u1>(rst:u1, push_valid:bool, push_data:T, pop_ready:bool) -> (
  push_ready:bool@[0],
  pop_valid:bool@[0],
  pop_data:T@[0]
) {
  reg valid:bool:[reset_pin = ref rst] = false
  reg data:T = nil

  push_ready = pop_ready or not valid
  valid      = push_valid or not push_ready
  if push_ready and push_valid {
    data = push_data
  }
  pop_valid = valid
  pop_data  = data
}
