const cfg = import("lhdtrack_cfg")

// Round-robin priority state: remembers the last grant and derives the mask of
// requesters at or below it (the ones that lose priority next cycle).
pub mod br_rr_state_internal<NumRequesters=2>::[timecheck=false](clk:Clock, grant:U2, rst:U1, update_priority:U1) -> (last_grant:U2@[], priority_mask:(e1:U1, e0:U1)@[]) {
  reg last_grant:U2
  if cfg.no_loop {
    wire `last_grant_init[0]`:U1 = nil
    wire `last_grant_init[1]`:U1 = nil
    wire last_grant_init:U2 = nil
    wire `priority_mask__bpr.e1`:U1 = nil
    wire `priority_mask__bpr.e0`:U1 = nil
    mut _b2i_1 = if last_grant != 0 { 1 } else { 0 }
    mut `priority_mask__bpo.e0` = _b2i_1
    mut _b2i_2 = if ((last_grant >> 1) & 1) != 0 { 1 } else { 0 }
    mut `priority_mask__bpo.e1` = _b2i_2
    `last_grant_init[1]` = 1
    `last_grant_init[0]` = 0
    if rst != 0 {
      last_grant = last_grant_init
    } elif update_priority != 0 {
      last_grant = grant
    }
    last_grant_init = (`last_grant_init[1]` << 1) | `last_grant_init[0]`
    const t11 = `priority_mask__bpo.e1`
    `priority_mask__bpr.e1` = t11
    priority_mask.e1 = t11
    const t12 = `priority_mask__bpo.e0`
    `priority_mask__bpr.e0` = t12
    priority_mask.e0 = t12
  } else {
    // After reset the top requester counts as last granted, so requester 0 leads.
    if rst != 0 {
      last_grant = 1 << (NumRequesters - 1)
    } elif update_priority != 0 {
      last_grant = grant
    }

    mut mask:U2 = 0
    for i in 0..<NumRequesters {
      mask#[i] = last_grant#|[i..]
    }
    priority_mask = (e1=mask#[1], e0=mask#[0])
  }
}
