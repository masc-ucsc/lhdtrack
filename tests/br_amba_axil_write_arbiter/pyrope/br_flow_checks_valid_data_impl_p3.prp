const br_misc_unused_p5 = import("br_misc_unused_p5.br_misc_unused_p5")

pub mod br_flow_checks_valid_data_impl_p3::[timecheck=false](clk:u1, rst:u1, valid:u3, ready:u3, data:u3) -> () {
  br_misc_unused_p5::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 9) | (valid << 6) | (ready << 3) | data)
}
