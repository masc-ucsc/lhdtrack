pub comb br_mux_onehot::[timecheck=false](select:u2, `in`:u236) -> (out:u118) {
  mut _rep_1:u118 = if (select & 1) != 0 { 0x3fffffffffffffffffffffffffffff } else { 0 }
  mut _rep_2:u118 = if ((select >> 1) & 1) != 0 { 0x3fffffffffffffffffffffffffffff } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=117])) | (_rep_2 & `in`#[118..=235])
}
