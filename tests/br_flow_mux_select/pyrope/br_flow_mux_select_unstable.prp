pub mod br_flow_mux_select_unstable<NumFlows=4, Width=32, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertSelectStability=0, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U128, push_valid:U4, rst:Reset, select:U2) -> (pop_data_unstable:U32@[], pop_valid_unstable:U1@[], push_ready:U4@[]) {
  const push_ready__w1 = (pop_ready << select)#[0..=3]
  const pop_valid_unstable__w1 = ((push_valid << 1) >> (select + 1)) & 1
  const pop_data_unstable__w1 = ((push_data << 32) >> ((select*32) + 32))#[0..=31]
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
  pop_data_unstable = pop_data_unstable__w1
}
