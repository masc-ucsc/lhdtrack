const br_flow_mux_select_unstable_t = import("br_flow_mux_select_unstable.br_flow_mux_select_unstable")
const br_flow_reg_fwd_t = import("br_flow_reg_fwd.br_flow_reg_fwd")

pub mod br_flow_mux_select::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U128, push_valid:U4, rst:Reset, select:U2) -> (pop_data:U32@[], pop_valid:U1@[], push_ready:U4@[]) {
  wire internal_ready:U1 = nil
  mut br_flow_mux_select_unstable = br_flow_mux_select_unstable_t::[name=br_flow_mux_select_unstable](clk=clk, rst=rst, select=select, push_valid=push_valid, push_data=push_data, pop_ready=internal_ready)
  mut br_flow_reg_fwd = br_flow_reg_fwd_t::[name=br_flow_reg_fwd](clk=clk, rst=rst, push_valid=br_flow_mux_select_unstable.pop_valid_unstable, push_data=br_flow_mux_select_unstable.pop_data_unstable, pop_ready=pop_ready)
  internal_ready = br_flow_reg_fwd.push_ready
  push_ready = br_flow_mux_select_unstable.push_ready
  pop_valid = br_flow_reg_fwd.pop_valid
  pop_data = br_flow_reg_fwd.pop_data
}
