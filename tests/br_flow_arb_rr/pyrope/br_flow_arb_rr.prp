// Round-robin flow arbiter, 16 push flows into one pop flow.
// A flow may push only while the pop side is ready and no flow that currently
// outranks it is valid. The pop side is valid whenever any push is valid.
// Requester 0 starts highest; after a handshake the winner becomes lowest and
// the next index (mod 16) highest. The rotation only advances on pop_ready.
pub mod br_flow_arb_rr(clk:Clock, pop_ready:U1, push_valid:U16, rst:Reset) -> (pop_valid_unstable:U1@[], push_ready:U16@[]) {
  comptime const N = push_valid.[bits]

  // One-hot index of the last grant; N-1 initially so that requester 0 leads.
  reg last_grant:Unsigned(bits=N) = 1 << (N - 1)

  // mask#[i] is set for every index at or below the last grant.
  mut mask:Unsigned(bits=N) = 0
  for i in 0..<N {
    mask#[i] = last_grant#|[i..]
  }

  // Valid flows above the last grant outrank all the others.
  const high = push_valid & ~mask

  // can_grant#[i]: no valid flow outranks i (the ones below it when the last
  // grant is at or above i, plus the ones above it already passed over).
  mut can_grant:Unsigned(bits=N) = 0
  for i in 0..<N {
    const blocked = if i == 0 { high#[1..] != 0 } elif mask#[i] == 1 { push_valid#[0..<i] != 0 or high#[(i + 1)..] != 0 } else { high#[0..<i] != 0 }
    can_grant#[i] = U1(not blocked)
  }

  pop_valid_unstable = U1(push_valid != 0)
  push_ready = if pop_ready == 1 { can_grant } else { 0 }

  if pop_ready == 1 and push_valid != 0 {
    last_grant = push_valid & can_grant
  }
}
