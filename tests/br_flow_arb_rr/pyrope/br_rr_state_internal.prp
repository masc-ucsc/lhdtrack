pub mod br_rr_state_internal::[timecheck=false](clk:u1, rst:u1, update_priority:u1, grant:u16) -> (last_grant:u16@[], priority_mask:(e15:u1, e14:u1, e13:u1, e12:u1, e11:u1, e10:u1, e9:u1, e8:u1, e7:u1, e6:u1, e5:u1, e4:u1, e3:u1, e2:u1, e1:u1, e0:u1)@[]) {
  reg last_grant:u16
  mut last_grant_init:u16 = 0
  last_grant_init = 0sb?
  mut `priority_mask__bpo.e0` = unsigned(last_grant != 0)
  mut `priority_mask__bpo.e1` = unsigned(last_grant#[1..=15] != 0)
  mut `priority_mask__bpo.e2` = unsigned(last_grant#[2..=15] != 0)
  mut `priority_mask__bpo.e3` = unsigned(last_grant#[3..=15] != 0)
  mut `priority_mask__bpo.e4` = unsigned(last_grant#[4..=15] != 0)
  mut `priority_mask__bpo.e5` = unsigned(last_grant#[5..=15] != 0)
  mut `priority_mask__bpo.e6` = unsigned(last_grant#[6..=15] != 0)
  mut `priority_mask__bpo.e7` = unsigned(last_grant#[7..=15] != 0)
  mut `priority_mask__bpo.e8` = unsigned(last_grant#[8..=15] != 0)
  mut `priority_mask__bpo.e9` = unsigned(last_grant#[9..=15] != 0)
  mut `priority_mask__bpo.e10` = unsigned(last_grant#[10..=15] != 0)
  mut `priority_mask__bpo.e11` = unsigned(last_grant#[11..=15] != 0)
  mut `priority_mask__bpo.e12` = unsigned(last_grant#[12..=15] != 0)
  mut `priority_mask__bpo.e13` = unsigned(last_grant#[13..=15] != 0)
  mut `priority_mask__bpo.e14` = unsigned(last_grant#[14..=15] != 0)
  mut `priority_mask__bpo.e15` = unsigned(((last_grant >> 15) & 1) != 0)
  if rst != 0 {
    last_grant = 0x8000
  } elif update_priority != 0 {
    last_grant = grant
  }
  priority_mask.e15 = `priority_mask__bpo.e15`
  priority_mask.e14 = `priority_mask__bpo.e14`
  priority_mask.e13 = `priority_mask__bpo.e13`
  priority_mask.e12 = `priority_mask__bpo.e12`
  priority_mask.e11 = `priority_mask__bpo.e11`
  priority_mask.e10 = `priority_mask__bpo.e10`
  priority_mask.e9 = `priority_mask__bpo.e9`
  priority_mask.e8 = `priority_mask__bpo.e8`
  priority_mask.e7 = `priority_mask__bpo.e7`
  priority_mask.e6 = `priority_mask__bpo.e6`
  priority_mask.e5 = `priority_mask__bpo.e5`
  priority_mask.e4 = `priority_mask__bpo.e4`
  priority_mask.e3 = `priority_mask__bpo.e3`
  priority_mask.e2 = `priority_mask__bpo.e2`
  priority_mask.e1 = `priority_mask__bpo.e1`
  priority_mask.e0 = `priority_mask__bpo.e0`
}
