pub comb br_shift_rotate::[timecheck=false](`in`:u16, right:u1, rotate:u4) -> (out:u16) {
  const inv_rotate:u4 = if rotate == 0 { 0 } else { (16 - rotate)#[0..=3] }
  const left_rotate:u4 = if right { inv_rotate } else { rotate }
  const stage1:u16 = if left_rotate#[0] != 0 { (`in`#[0..=14] << 1) | `in`#[15] } else { `in` }
  const stage2:u16 = if left_rotate#[1] != 0 { (stage1#[0..=13] << 2) | stage1#[14..=15] } else { stage1 }
  const stage3:u16 = if left_rotate#[2] != 0 { (stage2#[0..=11] << 4) | stage2#[12..=15] } else { stage2 }
  const stage4:u16 = if left_rotate#[3] != 0 { (stage3#[0..=7] << 8) | stage3#[8..=15] } else { stage3 }
  out = stage4
}
