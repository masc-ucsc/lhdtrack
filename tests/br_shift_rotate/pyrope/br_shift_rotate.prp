// Rotator over 16 one-bit symbols: left by `rotate`, or right when `right` is set.
// A right rotate by r is a left rotate by (16 - r) mod 16, which is -r in 4 bits.
pub comb br_shift_rotate(`in`:U16, right:U1, rotate:U4) -> (out:U16) {
  comptime const N = `in`.[bits]
  mut left:U4 = rotate
  if right != 0 {
    wrap left = 0 - rotate
  }
  // Shift into a double-width word and fold the overflow back into the low half.
  const wide:Unsigned(bits=2*N) = `in` << left
  out = wide#[0..<N] | wide#[N..<2*N]
}
