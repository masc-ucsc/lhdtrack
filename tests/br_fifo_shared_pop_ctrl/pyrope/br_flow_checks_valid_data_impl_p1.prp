const br_misc_unused_p4 = import("br_misc_unused_p4.br_misc_unused_p4")

pub mod br_flow_checks_valid_data_impl_p1::[timecheck=false](clk:u1, rst:u1, valid:u1, ready:u1, data:u1) -> () {
  br_misc_unused_p4::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 3) | ((valid & 1) << 2) | ((ready & 1) << 1) | (data & 1))
}
