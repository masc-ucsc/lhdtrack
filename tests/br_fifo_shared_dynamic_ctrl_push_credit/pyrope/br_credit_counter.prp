pub mod br_credit_counter::[timecheck=false](clk:u1, rst:u1, incr_valid:u1, incr:u2, decr_valid:u1, decr:u2, initial_value:u6, withhold:u6) -> (decr_ready:u1@[], value:u6@[], available:u6@[]) {
  reg value:u6
  mut _mux_1:u2 = if incr_valid != 0 { incr } else { 0 }
  mut _mux_2:u2 = if decr_valid != 0 { decr } else { 0 }
  const decr_internal__w1 = _mux_2
  const value_plus_incr__w1 = (value + _mux_1)#[0..=5]
  mut _mux_3:u6 = if value_plus_incr__w1 > withhold { (value_plus_incr__w1 - withhold)#[0..=5] } else { 0 }
  const available__w1 = _mux_3
  const decr_ready__w1 = unsigned(decr_internal__w1 <= available__w1)
  mut _mux_5:u6 = if decr_ready__w1 != 0 { decr_internal__w1 } else { 0 }
  const value_next__w1 = (value_plus_incr__w1 - _mux_5)#[0..=5]
  if rst != 0 {
    value = initial_value
  } elif unsigned((incr_valid != 0) or ((decr_valid != 0) and (decr_ready__w1 != 0))) != 0 {
    value = value_next__w1
  }
  decr_ready = decr_ready__w1
  available = available__w1
}
