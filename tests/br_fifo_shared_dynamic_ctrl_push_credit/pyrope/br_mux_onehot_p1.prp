pub comb br_mux_onehot_p1<NumSymbolsIn=2, SymbolWidth=6, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U12, select:U2) -> (out:U6) {
  mut _rep_1:U6 = if (select & 1) != 0 { 63 } else { 0 }
  mut _rep_2:U6 = if ((select >> 1) & 1) != 0 { 63 } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=5])) | (_rep_2 & `in`#[6..=11])
}
