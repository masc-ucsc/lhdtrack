const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_multi_xfer_checks_sendable_data_impl<NumSymbols=2, SymbolWidth=5, EnableCoverBackpressure=1, EnableAssertDataStability=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U10, receivable:U2, rst:U1, sendable:U2) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 14) | (receivable << 12) | (sendable << 10) | data)
}
