  pop_credit = br_fifo_shared_dynamic_push_ctrl.dealloc_count
  push_data_comb = push_data_comb_bits
  internal_push_data = internal_push_data_bits
  internal_push_fifo_id = (`internal_push_fifo_id[1]` << 1) | `internal_push_fifo_id[0]`
  push_receiver_in_reset = br_credit_receiver.push_receiver_in_reset
  push_credit = br_credit_receiver.push_credit
  push_full = br_fifo_shared_dynamic_push_ctrl.push_full
  credit_available_push = br_credit_receiver.credit_available
  credit_count_push = br_credit_receiver.credit_count
  data_ram_wr_valid = (br_fifo_shared_dynamic_push_ctrl.data_ram_wr_valid.e1 << 1) | br_fifo_shared_dynamic_push_ctrl.data_ram_wr_valid.e0
  data_ram_wr_addr = br_fifo_shared_dynamic_push_ctrl.data_ram_wr_addr
  data_ram_wr_data = br_fifo_shared_dynamic_push_ctrl.data_ram_wr_data
  next_tail_valid = br_fifo_shared_dynamic_push_ctrl.next_tail_valid
  next_tail = br_fifo_shared_dynamic_push_ctrl.next_tail
