const br_credit_receiver_t = import("br_credit_receiver.br_credit_receiver")
const br_fifo_shared_dynamic_push_ctrl_t = import("br_fifo_shared_dynamic_push_ctrl.br_fifo_shared_dynamic_push_ctrl")
pub mod br_fifo_shared_dynamic_push_ctrl_credit<NumWritePorts=2, NumReadPorts=2, NumFifos=2, Depth=32, Width=32, RegisterPushOutputs=1, EnableCoverPushCreditStall=1, EnableCoverCreditWithhold=1, EnableCoverPushSenderInReset=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertUniqueDeallocEntryId=1>::[timecheck=false](clk:Clock, credit_initial_push:U6, credit_withhold_push:U6, dealloc_entry_id:U10, dealloc_valid:U2, push_credit_stall:U1, push_data:U64, push_fifo_id:(e1:U1, e0:U1), push_sender_in_reset:U1, push_valid:U2, rst:U1) -> (credit_available_push:U6@[], credit_count_push:U6@[], data_ram_wr_addr:U10@[], data_ram_wr_data:U64@[], data_ram_wr_valid:U2@[], next_tail:U20@[], next_tail_valid:U4@[], push_credit:U2@[], push_full:U1@[], push_receiver_in_reset:U1@[]) {
  wire push_data_comb_bits:U66 = nil
  wire push_data_comb:U66 = nil
  wire internal_push_data_bits:U64 = nil
  wire internal_push_data:U64 = nil
  wire `internal_push_fifo_id[0]`:U1 = nil
  wire `internal_push_fifo_id[1]`:U1 = nil
  wire internal_push_fifo_id:U2 = nil
  wire pop_credit:U2 = nil
  wire internal_push_data_comb:U66 = nil
  mut _b2i_1 = if push_sender_in_reset != 0 or rst != 0 { 1 } else { 0 }
  const t11 = ((push_fifo_id.e0 & 1) << 32) | push_data#[0..=31]
  push_data_comb_bits#[0..<33] = t11#[0..<33]
  const t80 = ((push_fifo_id.e1 & 1) << 32) | push_data#[32..=63]
  push_data_comb_bits#[33..<66] = t80#[0..<33]
  internal_push_data_bits#[0..<32] = internal_push_data_comb#[0..=32]#[0..=31]#[0..<32]
  `internal_push_fifo_id[0]` = (internal_push_data_comb#[0..=32] >> 32) & 1
  internal_push_data_bits#[32..<64] = internal_push_data_comb#[33..=65]#[0..=31]#[0..<32]
  `internal_push_fifo_id[1]` = (internal_push_data_comb#[33..=65] >> 32) & 1
  mut br_credit_receiver = br_credit_receiver_t::[name=br_credit_receiver](clk=clk, rst=rst, push_sender_in_reset=push_sender_in_reset, push_credit_stall=push_credit_stall, push_valid=push_valid, push_data=push_data_comb, pop_credit=pop_credit, credit_initial=credit_initial_push, credit_withhold=credit_withhold_push)
  internal_push_data_comb = br_credit_receiver.pop_data
