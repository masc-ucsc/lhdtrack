const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_flow_checks_valid_data_intg::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u10) -> () {
  br_misc_unused_p1::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 14) | (valid << 12) | (ready << 10) | data)
}
