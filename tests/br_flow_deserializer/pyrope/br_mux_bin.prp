pub comb br_mux_bin::[timecheck=false](select:u1, `in`:u16) -> (out:u8, out_valid:u1) {
  mut _rep_2:u8 = if (unsigned(select == 0) & 1) != 0 { 0xff } else { 0 }
  mut _rep_4:u8 = if (unsigned(select == 1) & 1) != 0 { 0xff } else { 0 }
  out = (0 | (_rep_2 & `in`#[0..=7])) | (_rep_4 & `in`#[8..=15])
  out_valid = unsigned(select < 2)
}
