pub comb br_mux_bin<NumSymbolsIn=2, SymbolWidth=8>::[timecheck=false](`in`:U16, select:U1) -> (out:U8, out_valid:U1) {
  mut _rep_2:U8 = if (U1(select == 0) & 1) != 0 { 0xff } else { 0 }
  mut _rep_4:U8 = if (U1(select == 1) & 1) != 0 { 0xff } else { 0 }
  out = (0 | (_rep_2 & `in`#[0..=7])) | (_rep_4 & `in`#[8..=15])
  out_valid = U1(select < NumSymbolsIn)
}
