pub comb br_shift_rotate_p1<NumSymbols=4, SymbolWidth=1, MaxRotate=1>::[timecheck=false](`in`:U4, right:U1, rotate:U1) -> (out:U4) {
  wire stages_bits:U12 = nil
  mut _mux_1:U2 = if rotate == 0 { 0 } else { (NumSymbols - rotate)#[0..=31]#[0..=2]#[0..=1] }
  mut _mux_2:U2 = if right != 0 { _mux_1 } else { rotate }
  const left_rotate = _mux_2
  stages_bits#[0..<4] = `in`#[0..<4]
  const out__w1 = (stages_bits#[11] << 3) | (stages_bits#[10] << 2) | (stages_bits#[9] << 1) | stages_bits#[8]
  mut _mux_3:U4 = if (left_rotate & 1) != 0 {
    (((stages_bits#[2] << 2) | (stages_bits#[1] << 1) | stages_bits#[0]) << 1) | (stages_bits#[3] & 1)
  } else {
    (stages_bits#[3] << 3) | (stages_bits#[2] << 2) | (stages_bits#[1] << 1) | stages_bits#[0]
  }
  stages_bits#[4..<8] = _mux_3#[0..<4]
  mut _mux_4:U4 = if ((left_rotate >> 1) & 1) != 0 {
    (((stages_bits#[5] << 1) | stages_bits#[4]) << 2) | ((stages_bits#[7] << 1) | stages_bits#[6])
  } else {
    (stages_bits#[7] << 3) | (stages_bits#[6] << 2) | (stages_bits#[5] << 1) | stages_bits#[4]
  }
  stages_bits#[8..<12] = _mux_4#[0..<4]
  out = out__w1
}
