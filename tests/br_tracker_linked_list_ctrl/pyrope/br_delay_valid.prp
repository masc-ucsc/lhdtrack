pub mod br_delay_valid::[timecheck=false](clk:u1, rst:u1, in_valid:u1, `in`:u4) -> (out_valid:u1@[], out:u4@[], out_valid_stages:u3@[], out_stages:u12@[]) {
  reg stage_valid___q:u3
  mut stage_valid:u3 = 0
  reg stage___q:u12
  mut `stage`:u12 = 0
  stage_valid = stage_valid___q
  `stage` = stage___q
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = `stage`
  stage__w1#[0..=3] = `in`
  if rst != 0 {
    stage_valid___q#[1] = 0
  } else {
    stage_valid___q#[1] = stage_valid__w1 & 1
  }
  if (stage_valid__w1 & 1) != 0 {
    stage___q#[4..=7] = stage__w1#[0..=3]
  }
  if rst != 0 {
    stage_valid___q#[2] = 0
  } else {
    stage_valid___q#[2] = (stage_valid__w1 >> 1) & 1
  }
  if ((stage_valid__w1 >> 1) & 1) != 0 {
    stage___q#[8..=11] = stage__w1#[4..=7]
  }
  out_valid = (stage_valid__w1 >> 2) & 1
  out = stage__w1#[8..=11]
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
