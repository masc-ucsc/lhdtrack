pub mod br_delay_valid::[timecheck=false](clk:u1, rst:u1, in_valid:u1, `in`:u4) -> (out_valid:u1@[], out:u4@[], out_valid_stages:u3@[], out_stages:u12@[]) {
  reg stage_valid:u3
  reg `stage`:[3]u4:[ordering="old"]
  stage_valid#[0] = in_valid & 1
  `stage`[0] = `in`
  if rst != 0 {
    stage_valid#[1] = 0
  } else {
    stage_valid#[1] = stage_valid & 1
  }
  if (stage_valid & 1) != 0 {
    `stage`[1] = `stage`[0]
  }
  if rst != 0 {
    stage_valid#[2] = 0
  } else {
    stage_valid#[2] = (stage_valid >> 1) & 1
  }
  if ((stage_valid >> 1) & 1) != 0 {
    `stage`[2] = `stage`[1]
  }
  out_valid = (stage_valid >> 2) & 1
  out = `stage`[2]
  out_valid_stages = stage_valid
  out_stages = `stage`
}
