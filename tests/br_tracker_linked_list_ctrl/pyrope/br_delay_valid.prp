pub mod br_delay_valid<Width=4, NumStages=2, FirstStageUngated=0, EnableAssertFinalNotValid=1>::[timecheck=false](clk:Clock, `in`:U4, in_valid:U1, rst:U1) -> (out:U4@[], out_stages:U12@[], out_valid:U1@[], out_valid_stages:U3@[]) {
  reg stage_valid___q:U3
  mut stage_valid__composite:U3 = 0
  wire stage_valid:U3 = nil
  reg stage___q:U12
  mut stage__composite:U12 = 0
  wire `stage`:U12 = nil
  stage_valid__composite = stage_valid___q
  stage__composite = stage___q
  mut stage_valid__composite__w1 = stage_valid__composite
  stage_valid__composite__w1#[0] = in_valid & 1
  mut stage__composite__w1 = stage__composite
  stage__composite__w1#[0..=3] = `in`
  if rst != 0 {
    stage_valid___q#[1] = 0
  } else {
    stage_valid___q#[1] = stage_valid & 1
  }
  if (stage_valid & 1) != 0 {
    stage___q#[4..=7] = `stage`#[0..=3]
  }
  if rst != 0 {
    stage_valid___q#[2] = 0
  } else {
    stage_valid___q#[2] = (stage_valid >> 1) & 1
  }
  if ((stage_valid >> 1) & 1) != 0 {
    stage___q#[8..=11] = `stage`#[4..=7]
  }
  const out_valid__w1 = (stage_valid >> NumStages) & 1
  const out__w1 = (`stage` >> (NumStages*4))#[0..=3]
  const out_valid_stages__w1 = stage_valid
  const out_stages__w1 = `stage`
  stage_valid = stage_valid__composite__w1
  `stage` = stage__composite__w1
  out_valid = out_valid__w1
  out = out__w1
  out_valid_stages = out_valid_stages__w1
  out_stages = out_stages__w1
}
