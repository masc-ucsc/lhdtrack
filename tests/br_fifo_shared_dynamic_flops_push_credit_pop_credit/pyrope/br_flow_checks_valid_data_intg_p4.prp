const br_misc_unused_p7 = import("br_misc_unused_p7.br_misc_unused_p7")

pub mod br_flow_checks_valid_data_intg_p4::[timecheck=false](clk:u1, rst:u1, valid:u2, ready:u2, data:u12) -> () {
  br_misc_unused_p7::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 16) | (valid << 14) | (ready << 12) | data)
}
