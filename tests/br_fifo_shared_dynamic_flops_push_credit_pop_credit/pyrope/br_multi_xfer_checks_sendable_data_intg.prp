const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_multi_xfer_checks_sendable_data_intg<NumSymbols=2, SymbolWidth=5, EnableCoverBackpressure=1, EnableAssertDataStability=0, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U10, receivable:U2, rst:U1, sendable:U2) -> () {
