// Round-robin state for 2 requesters: remembers the last grant (reset makes
// requester 1 the last winner) and exposes the priority mask derived from it.
pub mod br_rr_state_internal<NumRequesters=2>::[timecheck=false](clk:Clock, grant:U2, rst:U1, update_priority:U1) -> (last_grant:U2@[], priority_mask:(e1:U1, e0:U1)@[]) {
  reg last_grant:U2 = nil
  if rst == 1 {
    last_grant = 0ub10
  } elif update_priority == 1 {
    last_grant = grant
  }
  // Requester i has priority below the last winner: mask bit i = last_grant#[i..] != 0.
  priority_mask.e0 = U1(last_grant != 0)
  priority_mask.e1 = last_grant#[1]
}
