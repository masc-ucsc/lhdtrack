// Round-robin valid/ready mux with a stable (registered) pop interface.
const br_arb_rr_internal_t = import("br_arb_rr_internal.br_arb_rr_internal")
const br_flow_mux_core_stable_t = import("br_flow_mux_core_stable.br_flow_mux_core_stable")

pub mod br_flow_mux_rr_stable<NumFlows=2, Width=42, RegisterPopReady=0, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U84, push_valid:U2, rst:Reset) -> (pop_data:U42@[], pop_valid:U1@[], push_ready:U2@[]) {
  wire request:U2 = nil
  wire enable_priority_update:U1 = nil
  const br_arb_rr_internal = br_arb_rr_internal_t(enable_priority_update, request)
  const can_grant:U2 = (br_arb_rr_internal.can_grant.e1 << 1) | br_arb_rr_internal.can_grant.e0
  const br_flow_mux_core_stable = br_flow_mux_core_stable_t(can_grant, grant=br_arb_rr_internal.grant, push_valid, push_data, pop_ready)
  request = br_flow_mux_core_stable.request
  enable_priority_update = br_flow_mux_core_stable.enable_priority_update
  push_ready = br_flow_mux_core_stable.push_ready
  pop_valid = br_flow_mux_core_stable.pop_valid
  pop_data = br_flow_mux_core_stable.pop_data
}
