// Arbitrated valid/ready mux with a forward register on the pop side, so the
// pop interface is stable.
const br_flow_mux_core_t = import("br_flow_mux_core.br_flow_mux_core")
const br_flow_reg_fwd = import("br_flow_reg_fwd.br_flow_reg_fwd")

pub mod br_flow_mux_core_stable<NumFlows=2, Width=42, RegisterPopReady=0, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=1, EnableAssertPushDataKnown=1, EnableAssertFinalNotValid=1, ArbiterAlwaysGrants=1, EnableAssertNoPushBackpressure=0>::[timecheck=false](can_grant:U2, clk:Clock, grant:U2, pop_ready:U1, push_data:U84, push_valid:U2, rst:Reset) -> (enable_priority_update:U1@[], pop_data:U42@[], pop_valid:U1@[], push_ready:U2@[], request:U2@[]) {
  wire internal_pop_ready:U1 = nil
  const br_flow_mux_core = br_flow_mux_core_t(can_grant, grant, push_valid, push_data, pop_ready=internal_pop_ready)
  const gen_flow_reg_fwd_br_flow_reg_fwd = br_flow_reg_fwd(rst=U1(rst), push_valid=br_flow_mux_core.pop_valid_unstable, push_data=br_flow_mux_core.pop_data_unstable, pop_ready)
  internal_pop_ready = gen_flow_reg_fwd_br_flow_reg_fwd.push_ready
  pop_valid = gen_flow_reg_fwd_br_flow_reg_fwd.pop_valid
  pop_data = gen_flow_reg_fwd_br_flow_reg_fwd.pop_data
  request = br_flow_mux_core.request
  enable_priority_update = br_flow_mux_core.enable_priority_update
  push_ready = br_flow_mux_core.push_ready
}
