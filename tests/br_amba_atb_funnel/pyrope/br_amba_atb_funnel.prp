// ATB funnel: round-robin merges 2 ATB sources into one destination, with a
// forward register stage on the output.
const br_flow_mux_rr_stable_t = import("br_flow_mux_rr_stable.br_flow_mux_rr_stable")

pub mod br_amba_atb_funnel::[timecheck=false](clk:Clock, dst_atready:U1, rst:Reset, src_atbytes:U4, src_atdata:U64, src_atid:U14, src_atuser:U2, src_atvalid:U2) -> (dst_atbytes:U2@[], dst_atdata:U32@[], dst_atid:U7@[], dst_atuser:U1@[], dst_atvalid:U1@[], src_atready:U2@[]) {
  // Packet lanes from the LSB: atuser:U1, atbytes:U2, atdata:U32, atid:U7.
  const packet0:U42 = (src_atuser#[0], src_atbytes#[0..<2], src_atdata#[0..<32], src_atid#[0..<7])#[..]
  const packet1:U42 = (src_atuser#[1], src_atbytes#[2..<4], src_atdata#[32..<64], src_atid#[7..<14])#[..]
  const br_flow_mux_rr_stable = br_flow_mux_rr_stable_t(push_valid=src_atvalid, push_data=(packet0, packet1)#[..], pop_ready=dst_atready)
  src_atready = br_flow_mux_rr_stable.push_ready
  dst_atvalid = br_flow_mux_rr_stable.pop_valid
  const packet = br_flow_mux_rr_stable.pop_data
  dst_atuser = packet#[0]
  dst_atbytes = packet#[1..<3]
  dst_atdata = packet#[3..<35]
  dst_atid = packet#[35..<42]
}
