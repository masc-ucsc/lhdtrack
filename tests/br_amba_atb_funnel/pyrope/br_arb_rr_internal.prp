// Round-robin arbiter core for 2 requesters: requests not masked by the
// priority mask win first, otherwise the lowest index wins.
const br_rr_state_internal = import("br_rr_state_internal.br_rr_state_internal")

pub mod br_arb_rr_internal<NumRequesters=2>::[timecheck=false](clk:Clock, enable_priority_update:U1, request:U2, rst:Reset) -> (can_grant:(e1:U1, e0:U1)@[], grant:U2@[]) {
  wire mask:U2 = nil
  const request_high:U2 = request & ~mask
  can_grant.e0 = U1(request_high#[1] == 0)
  can_grant.e1 = U1((if mask#[1] == 1 { request#[0] } else { request_high#[0] }) == 0)
  grant = request & (can_grant.e0, can_grant.e1)#[..]

  const gen_n_req_rr_state_internal = br_rr_state_internal(rst=U1(rst), update_priority=U1(enable_priority_update == 1 and request != 0), grant)
  mask = (gen_n_req_rr_state_internal.priority_mask.e1 << 1) | gen_n_req_rr_state_internal.priority_mask.e0
}
