// Forward-registered valid/ready stage: accepts a push whenever the output
// register is empty or being popped.
pub mod br_flow_reg_fwd<Width=42, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertPushDataStability=0, EnableAssertPushDataKnown=1, EnableCoverPopBackpressure=1, EnableAssertFinalNotValid=1, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false](clk:Clock, pop_ready:U1, push_data:U42, push_valid:U1, rst:U1) -> (pop_data:U42@[], pop_valid:U1@[], push_ready:U1@[]) {
  const rst_b = rst == 1
  reg pop_valid:U1:[reset_pin=rst_b] = 0
  reg pop_data:U42 = nil
  const ready = pop_ready == 1 or pop_valid == 0
  push_ready = U1(ready)
  if ready {
    pop_valid = push_valid
    if push_valid == 1 {
      pop_data = push_data
    }
  }
}
