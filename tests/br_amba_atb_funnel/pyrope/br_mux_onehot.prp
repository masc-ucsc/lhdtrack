// One-hot mux: ORs together the lanes whose select bit is set (a multi-hot
// select ORs the lanes). Unrolled for the 2-lane configuration this design uses.
pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=42>(`in`:Unsigned(bits=NumSymbolsIn*SymbolWidth), select:Unsigned(bits=NumSymbolsIn)) -> (out:Unsigned(bits=SymbolWidth)) {
  cassert(NumSymbolsIn == 2)
  comptime const W = SymbolWidth
  comptime const ONES = (1 << W) - 1
  const s0:Unsigned(bits=W) = `in`#[0..+W] & (if select#[0] == 1 { ONES } else { 0 })
  const s1:Unsigned(bits=W) = `in`#[W..+W] & (if select#[1] == 1 { ONES } else { 0 })
  out = s0 | s1
}
