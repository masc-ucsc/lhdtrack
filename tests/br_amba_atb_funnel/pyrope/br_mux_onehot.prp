pub comb br_mux_onehot<NumSymbolsIn=2, SymbolWidth=42, EnableAssertSelectOnehot=1>::[timecheck=false](`in`:U84, select:U2) -> (out:U42) {
  mut _rep_1:U42 = if (select & 1) != 0 { 0x3ffffffffff } else { 0 }
  mut _rep_2:U42 = if ((select >> 1) & 1) != 0 { 0x3ffffffffff } else { 0 }
  out = (0 | (_rep_1 & `in`#[0..=41])) | (_rep_2 & `in`#[42..=83])
}
