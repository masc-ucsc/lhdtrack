// Valid/ready wrapper around an always-granting arbiter: every push valid
// requests, and a flow is ready when the pop side is ready and it can be granted.
pub mod br_flow_arb_core<NumFlows=2, EnableCoverPushBackpressure=1, EnableAssertPushValidStability=1, EnableAssertFinalNotValid=1, EnableCoverPopBackpressure=1, ArbiterAlwaysGrants=1, EnableAssertNoPushBackpressure=0, EnableAssertNoPopBackpressure=0>::[timecheck=false](can_grant:U2, clk:Clock, grant:U2, pop_ready:U1, push_valid:U2, rst:Reset) -> (enable_priority_update:U1@[], pop_valid_unstable:U1@[], push_ready:U2@[], request:U2@[]) {
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = if pop_ready == 1 { can_grant } else { 0 }
  pop_valid_unstable = U1(push_valid != 0)
}
