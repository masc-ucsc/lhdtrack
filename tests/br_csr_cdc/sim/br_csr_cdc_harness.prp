// Generated by tools/gen_testbench.py, then hand-adjusted for explicit DUT clocks. Simulation only.
//
// The Pyrope twin of br_csr_cdc_harness.sv: same LFSR, same fold, same seed, so all
// three simulators must agree on `checksum` or the test fails.
//
// This is GENERATED and assumes the DUT is a `mod` with these port names. A
// hand-written idiomatic Pyrope module may present a different interface;
// adjusting this file is part of promoting the test to status.pyrope =
// "idiomatic".
// `file.entity`: import("br_csr_cdc") names the FILE, and calling it fails with
// "call to undefined function". The module inside it is br_csr_cdc.br_csr_cdc.
const dut = import("br_csr_cdc.br_csr_cdc")

pub mod br_csr_cdc_harness(clk:u1, rst:u1) -> (checksum:u64@[0]) {
  reg lfsr:u64:[clock_pin=ref clk] = nil
  reg sum:u64:[clock_pin=ref clk] = nil

  checksum = sum

  mut nxt:u64 = lfsr
  wrap nxt = nxt ^ (nxt << 13)
  wrap nxt = nxt ^ (nxt >> 7)
  wrap nxt = nxt ^ (nxt << 17)

  const r = dut(upstream_clk=clk, downstream_clk=clk, upstream_rst=rst, downstream_rst=rst, upstream_req_valid=lfsr#[0], upstream_req_write=lfsr#[1], upstream_req_addr=lfsr#[2..=17], upstream_req_wdata=lfsr#[18..=49], upstream_req_wstrb=lfsr#[50..=53], upstream_req_secure=lfsr#[54], upstream_req_privileged=lfsr#[55], upstream_req_abort=lfsr#[56], downstream_resp_valid=lfsr#[57], downstream_resp_rdata=lfsr#[58..=63], downstream_resp_slverr=lfsr#[26], downstream_resp_decerr=lfsr#[27])

  mut acc:u64 = sum
  wrap acc = ((acc << 1) | acc#[63]) ^ r.upstream_resp_valid
  wrap acc = ((acc << 1) | acc#[63]) ^ r.upstream_resp_rdata
  wrap acc = ((acc << 1) | acc#[63]) ^ r.upstream_resp_slverr
  wrap acc = ((acc << 1) | acc#[63]) ^ r.upstream_resp_decerr
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_valid
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_write
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_addr
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_wdata
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_wstrb
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_secure
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_privileged
  wrap acc = ((acc << 1) | acc#[63]) ^ r.downstream_req_abort

  if rst != 0 {
    lfsr = 2611923443488327891
    sum  = 0
  } else {
    lfsr = nxt
    sum  = acc
  }
}
