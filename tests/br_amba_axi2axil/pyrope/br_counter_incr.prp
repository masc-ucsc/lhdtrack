pub mod br_counter_incr::[timecheck=false](clk:u1, rst:u1, reinit:u1, initial_value:u8, incr_valid:u1, incr:u1) -> (value:u8@[], value_next:u8@[]) {
  reg value:u8
  {
  }
  mut _mux_2:u9 = if incr_valid != 0 { incr } else { 0 }
  mut _mux_3:u9 = if reinit != 0 { initial_value } else { (value + _mux_2)#[0..=8] }
  const value_next__w1 = _mux_3#[0..=7]
  if rst != 0 {
    value = initial_value
  } elif (incr_valid != 0) or (reinit != 0) {
