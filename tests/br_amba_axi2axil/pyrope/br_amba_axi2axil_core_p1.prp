const br_flow_reg_both = import("br_flow_reg_both.br_flow_reg_both")
const br_amba = import("br_amba")

pub mod br_amba_axi2axil_core_p1<AddrWidth=32, DataWidth=32, IdWidth=4, ReqUserWidth=8, RespUserWidth=8, ReqDataUserWidth=1, MaxOutstandingReqs=4, IsReadNotWrite=1>::[timecheck=false](axi_req_addr:U32, axi_req_burst:U2, axi_req_data:U32, axi_req_data_last:U1, axi_req_data_strb:U4, axi_req_data_user:U1, axi_req_data_valid:U1, axi_req_id:U4, axi_req_len:U8, axi_req_prot:U3, axi_req_size:U3, axi_req_user:U8, axi_req_valid:U1, axi_resp_ready:U1, axil_req_data_ready:U1, axil_req_ready:U1, axil_resp_data:U32, axil_resp_resp:U2, axil_resp_user:U8, axil_resp_valid:U1, clk:Clock, rst:U1) -> (axi_req_data_ready:U1@[], axi_req_ready:U1@[], axi_resp_data:U32@[], axi_resp_data_last:U1@[], axi_resp_id:U4@[], axi_resp_resp:U2@[], axi_resp_user:U8@[], axi_resp_valid:U1@[], axil_req_addr:U32@[], axil_req_data:U32@[], axil_req_data_strb:U4@[], axil_req_data_user:U1@[], axil_req_data_valid:U1@[], axil_req_prot:U3@[], axil_req_user:U8@[], axil_req_valid:U1@[], axil_resp_ready:U1@[]) {
  mut _mux_11:U32 = 0
  reg resp:U2:[async=false, initial=0, reset_pin=rst]
  wire resp_fifo_pop_valid:U1 = nil
  wire resp_next:U2 = nil
  wire axi_resp_handshake:U1 = nil
  wire axil_resp_handshake:U1 = nil
  wire resp_fifo_push_data:U5 = nil
  wire resp_fifo_push_ready:U1 = nil
  wire resp_fifo_pop_ready:U1 = nil
  wire is_last_req_beat:U1 = nil
  wire flow_reg_pop_ready:U1 = nil
  wire axi_resp_valid:U1 = nil
  wire axil_req_valid:U1 = nil
  wire axil_resp_ready:U1 = nil
  mut next_address:U32 = 0
  mut base_address:U32 = 0
  mut wrap_mask:U32 = 0
  mut align_mask:U32 = 0
  if not (rst != 0) {
    if axi_resp_handshake != 0 or axil_resp_handshake != 0 {
      resp = resp_next
    }
  }
  mut br_flow_reg_both_req = br_flow_reg_both::[name=br_flow_reg_both_req](clk=clk, rst=rst, push_valid=axi_req_valid, push_data=(axi_req_addr << 28) | (axi_req_id << 24) | (axi_req_len << 16) | (axi_req_size << 13) | (axi_req_burst << 11) | (axi_req_prot << 8) | axi_req_user, pop_ready=flow_reg_pop_ready)
  const axi_req_len_reg = (br_flow_reg_both_req.pop_data >> 16)#[0..=7]
  mut _b2i_2 = if br_flow_reg_both_req.pop_valid != 0 and flow_reg_pop_ready != 0 { 1 } else { 0 }
  mut _b2i_3 = if axi_resp_valid != 0 and axi_resp_ready != 0 { 1 } else { 0 }
  axi_resp_handshake = _b2i_3
  mut _b2i_4 = if axil_req_valid != 0 and axil_req_ready != 0 { 1 } else { 0 }
  mut _b2i_5 = if axil_resp_valid != 0 and axil_resp_ready != 0 { 1 } else { 0 }
  axil_resp_handshake = _b2i_5
  mut br_flow_fork_flow_reg_pop = br_flow_fork::[name=br_flow_fork_flow_reg_pop](clk=clk, rst=rst, push_valid=br_flow_reg_both_req.pop_valid, pop_ready=((axil_req_ready & 1) << 1) | (resp_fifo_push_ready & 1))
  axil_req_valid = (br_flow_fork_flow_reg_pop.pop_valid_unstable >> 1) & 1
  mut _b2i_6 = if br_flow_fork_flow_reg_pop.push_ready != 0 and is_last_req_beat != 0 { 1 } else { 0 }
  flow_reg_pop_ready = _b2i_6
  mut br_counter_incr_req = br_counter_incr::[name=br_counter_incr_req](clk=clk, rst=rst, reinit=_b2i_2, initial_value=0, incr_valid=_b2i_4, incr=1)
  is_last_req_beat = U1(br_counter_incr_req.value == axi_req_len_reg)
  const start_addr = (br_flow_reg_both_req.pop_data >> 28)#[0..=31]
  const size = (br_flow_reg_both_req.pop_data >> 13)#[0..=2]
  const burst_type = (br_flow_reg_both_req.pop_data >> 11)#[0..=1]
  const index = br_counter_incr_req.value
  next_address = 0sb?
  base_address = 0sb?
  wrap_mask = 0sb?
  align_mask = 0sb?
  const incr_address = (start_addr + (index << size)#[0..=31])#[0..=31]
  match burst_type {
    == br_amba.AxiBurstIncr {
      align_mask = (0xffffffff << size)#[0..=31]
      _mux_11 = if index == 0 { start_addr } else { incr_address & align_mask }
      next_address = _mux_11
    }
    == br_amba.AxiBurstWrap {
      wrap_mask = (((axi_req_len_reg + 1) << size)#[0..=31] - 1)#[0..=31]
      base_address = start_addr & (~wrap_mask)
      next_address = base_address | (incr_address & wrap_mask)
    }
    else {
      next_address = start_addr
    }
  }
  mut br_fifo_flops_resp_tracker = br_fifo_flops::[name=br_fifo_flops_resp_tracker](clk=clk, rst=rst, push_valid=br_flow_fork_flow_reg_pop.pop_valid_unstable & 1, push_data=resp_fifo_push_data, pop_ready=resp_fifo_pop_ready)
  resp_fifo_push_ready = br_fifo_flops_resp_tracker.push_ready
  resp_fifo_pop_valid = br_fifo_flops_resp_tracker.pop_valid
  resp_fifo_push_data = ((br_flow_reg_both_req.pop_data >> 24)#[0..=3] << 1) | (is_last_req_beat & 1)
  mut _mux_12:U2 = if resp == br_amba.AxiRespOkay and axil_resp_resp != br_amba.AxiRespOkay { axil_resp_resp } else { resp }
  mut _mux_13:U2 = if axi_resp_handshake != 0 { br_amba.AxiRespOkay#[0..=1] } else { _mux_12 }
  resp_next = _mux_13
  mut br_flow_join_axi_resp = br_flow_join::[name=br_flow_join_axi_resp](clk=clk, rst=rst, push_valid=((axil_resp_valid & 1) << 1) | (resp_fifo_pop_valid & 1), pop_ready=axi_resp_ready)
  resp_fifo_pop_ready = br_flow_join_axi_resp.push_ready & 1
  axil_resp_ready = (br_flow_join_axi_resp.push_ready >> 1) & 1
  axi_resp_valid = br_flow_join_axi_resp.pop_valid
  axi_req_ready = br_flow_reg_both_req.push_ready
  axi_req_data_ready = axil_req_data_ready
  axi_resp_id = (br_fifo_flops_resp_tracker.pop_data >> 1)#[0..=3]
  axi_resp_user = axil_resp_user
  axi_resp_resp = axil_resp_resp
  axi_resp_data = axil_resp_data
  axi_resp_data_last = br_fifo_flops_resp_tracker.pop_data & 1
  axil_req_addr = next_address
  axil_req_prot = (br_flow_reg_both_req.pop_data >> 8)#[0..=2]
  axil_req_user = br_flow_reg_both_req.pop_data#[0..=7]
  axil_req_data = axi_req_data
  axil_req_data_strb = axi_req_data_strb
  axil_req_data_user = axi_req_data_user
  axil_req_data_valid = axi_req_data_valid
}
