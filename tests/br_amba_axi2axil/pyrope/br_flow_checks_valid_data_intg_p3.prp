const br_misc_unused_p2 = import("br_misc_unused_p2.br_misc_unused_p2")

pub mod br_flow_checks_valid_data_intg_p3<NumFlows=2, Width=1, EnableCoverBackpressure=1, EnableAssertValidStability=1, EnableAssertDataStability=1, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=0>::[timecheck=false](clk:Clock, data:U2, ready:U2, rst:U1, valid:U2) -> () {
  br_misc_unused_p2::[name=br_misc_unused_all_unused](`in`=((rst & 1) << 6) | (valid << 4) | (ready << 2) | data)
}
