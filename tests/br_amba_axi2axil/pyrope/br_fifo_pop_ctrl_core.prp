  const pop_valid__w1 = unsigned(empty == 0)
  br_misc_unused_p5::[name=gen_no_buffer_gen_no_bypass_br_misc_unused_bypass_signals](`in` = ((bypass_valid_unstable & 1) << 5) | bypass_data_unstable)
