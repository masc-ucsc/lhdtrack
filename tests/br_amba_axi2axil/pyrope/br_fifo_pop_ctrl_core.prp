pub mod br_fifo_pop_ctrl_core::[timecheck=false](clk:u1, rst:u1, pop_ready:u1, bypass_valid_unstable:u1, bypass_data_unstable:u5, ram_rd_data_valid:u1, ram_rd_data:u5, empty:u1, items:u2) -> (pop_valid:u1@[], pop_data:u5@[], bypass_ready:u1@[], ram_rd_addr_valid:u1@[], ram_rd_addr:u1@[], pop_beat:u1@[]) {
