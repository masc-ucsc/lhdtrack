const br_flow_reg_fwd_t = import("br_flow_reg_fwd.br_flow_reg_fwd")
const br_flow_reg_rev_t = import("br_flow_reg_rev.br_flow_reg_rev")
const br_amba = import("br_amba")

pub mod br_flow_reg_both::[timecheck=false](clk:u1, rst:u1, push_valid:u1, push_data:u60, pop_ready:u1) -> (push_ready:u1@[], pop_valid:u1@[], pop_data:u60@[]) {
  wire internal_ready:u1
  mut br_flow_reg_rev = br_flow_reg_rev_t::[name=br_flow_reg_rev](clk = clk, rst = rst, push_valid = push_valid, push_data = push_data, pop_ready = internal_ready)
  mut br_flow_reg_fwd = br_flow_reg_fwd_t::[name=br_flow_reg_fwd](clk = clk, rst = rst, push_valid = br_flow_reg_rev.pop_valid, push_data = br_flow_reg_rev.pop_data, pop_ready = pop_ready)
  internal_ready = br_flow_reg_fwd.push_ready
  push_ready = br_flow_reg_rev.push_ready
  pop_valid = br_flow_reg_fwd.pop_valid
  pop_data = br_flow_reg_fwd.pop_data
}
