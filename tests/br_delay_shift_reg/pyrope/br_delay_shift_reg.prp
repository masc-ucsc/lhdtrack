pub mod br_delay_shift_reg::[timecheck=false](clk:Clock, initial_value:U64, reinit:U1, rst:U1, shift_en:U1, shift_in:U64) -> (shift_out:U64@[], value:U64@[]) {
  reg stages:[1]U64:[ordering="old"]
  mut _mux_1:U64 = if reinit != 0 { initial_value } else { stages#[0..=63] }
  mut _mux_2:U64 = if shift_en != 0 { shift_in } else { _mux_1 }
  if rst != 0 {
    stages = initial_value
  } elif shift_en != 0 or reinit != 0 {
    stages = _mux_2
  }
  value = stages#[0..=63]
  shift_out = stages[0]
}
