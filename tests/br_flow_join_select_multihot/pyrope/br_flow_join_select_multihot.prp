pub mod br_flow_join_select_multihot::[timecheck=false](clk:u1, rst:u1, select_multihot:u1, push_valid:u1, pop_ready:u1) -> (push_ready:u1@[], pop_valid_unstable:u1@[]) {
  push_ready = 0ub?
  mut push_ready__w1 = push_ready
  push_ready__w1#[0] = unsigned((pop_ready != 0) and ((select_multihot & 1) != 0)) & 1
  push_ready = push_ready__w1
  const pop_valid_unstable__w1 = unsigned((push_valid != 0) and (((push_valid | ((~select_multihot) & 1)) & 1) == 1))
  /* TODO: result 'br_flow_checks_valid_data_impl' of zero-output module 'br_flow_checks_valid_data_impl' is read */
  /* TODO: result 'br_flow_checks_valid_data_intg' of zero-output module 'br_flow_checks_valid_data_intg' is read */
  pop_valid_unstable = pop_valid_unstable__w1
}
