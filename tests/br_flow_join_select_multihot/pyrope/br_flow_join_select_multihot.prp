// Join selected flows; each producer waits for all other selected producers.
pub comb br_flow_join_select_multihot(pop_ready:U1, push_valid:U16, select_multihot:U16) -> (pop_valid_unstable:U1, push_ready:U16) {
  const selected:U16 = select_multihot
  const present:U16 = push_valid | ~selected
  pop_valid_unstable = U1(push_valid != 0 and present#&[..] == 1)
  for lane in 0..<push_valid.[bits] {
    const others:U16 = present | (1 << lane)
    push_ready#[lane] = U1(pop_ready != 0 and selected#[lane] == 1 and others#&[..] == 1)
  }
}
