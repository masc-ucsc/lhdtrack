// Round-robin state: the thermometer mask of every index at or below the
// last grant. Requester 0 leads after reset.
pub mod br_rr_state_internal<NumRequesters=16>(clk:Clock, rst:Reset, update_priority:U1, grant:Unsigned(bits=NumRequesters))
    -> (priority_mask:Unsigned(bits=NumRequesters)@[0]) {
  comptime const N = NumRequesters
  // One-hot index of the last grant.
  reg last_grant:Unsigned(bits=N) = 1 << (N - 1)
  if update_priority == 1 {
    last_grant = grant
  }

  // priority_mask#[i] = last_grant#|[i..]: smear every set bit downward.
  mut m:Unsigned(bits=N) = last_grant
  m |= m >> 1
  m |= m >> 2
  m |= m >> 4
  m |= m >> 8
  priority_mask = m
}
