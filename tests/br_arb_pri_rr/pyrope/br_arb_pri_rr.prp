// Two-level priority round-robin arbiter, 16 requesters, zero latency.
// High-priority requests (request_priority == 1) beat low-priority ones; within
// a level the round-robin order starts just above the last grant.
const br_rr_state_internal = import("br_rr_state_internal.br_rr_state_internal")

pub mod br_arb_pri_rr::[synth.color="x"](clk:Clock, enable_priority_update:U1, request:U16, request_priority:U16, rst:Reset) -> (grant:U16@[]) {
  wire winner:U16 = nil
  const rr_state_internal = br_rr_state_internal::[name=rr_state_internal](update_priority=U1(enable_priority_update == 1 and request != 0), grant=winner)
  const above = ~rr_state_internal        // indices past the last grant go first

  // Scan order, lowest lane first: high priority above the last grant, then
  // anything above it or of high priority, then any request.
  const first:U16 = request & request_priority & above
  const second:U16 = request & (request_priority | above)
  const scan:U48 = (first, second, request)#[..]

  // The first set bit of scan wins. Each lane includes the previous one, so a
  // bit only needs to look 16 positions down (prefix-OR, no adder).
  mut lower:U48 = 0
  wrap lower = scan << 1
  wrap lower |= lower << 1
  wrap lower |= lower << 2
  wrap lower |= lower << 4
  wrap lower |= lower << 8
  const won:U48 = scan & ~lower
  winner = won#[0..<16] | won#[16..<32] | won#[32..<48]
  grant = winner
}
