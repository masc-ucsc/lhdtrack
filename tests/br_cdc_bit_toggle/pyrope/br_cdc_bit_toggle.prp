// Two-flop clock-domain-crossing synchronizer (NumStages = 2, no source flop).
// src_bit is sampled directly by dst_clk; there is no reset on the flops
// (dst_rst is unused). src_clk and src_rst exist only for the Verilog
// interface: without the optional source flop nothing runs in the source domain.
//
// dst_bit is declared @[] because it is two stages behind src_bit and the
// generated harnesses mix it with same-cycle values.
comptime const NUM_STAGES = 2

pub mod br_cdc_bit_toggle(dst_clk:Clock, dst_rst:U1, src_bit:U1, src_clk:Clock, src_rst:U1) -> (dst_bit:U1@[]) {
  // sync#[0] is the first synchronizer flop, sync#[NUM_STAGES-1] the last.
  reg sync:Unsigned(bits=NUM_STAGES):[clock_pin=dst_clk] = nil
  wrap sync = (sync << 1) | src_bit
  dst_bit = sync#[NUM_STAGES - 1]
}
