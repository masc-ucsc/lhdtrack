// Generated by tools/gen_testbench.py, then hand-adjusted for explicit DUT clocks. Simulation only.
//
// The Pyrope twin of br_cdc_bit_toggle_harness.sv: same LFSR, same fold, same seed, so all
// three simulators must agree on `checksum` or the test fails.
//
// This is GENERATED and assumes the DUT is a `mod` with these port names. A
// hand-written idiomatic Pyrope module may present a different interface;
// adjusting this file is part of promoting the test to status.pyrope =
// "idiomatic".
// `file.entity`: import("br_cdc_bit_toggle") names the FILE, and calling it fails with
// "call to undefined function". The module inside it is br_cdc_bit_toggle.br_cdc_bit_toggle.
const dut = import("br_cdc_bit_toggle.br_cdc_bit_toggle")

pub mod br_cdc_bit_toggle_harness(clk:u1, rst:u1) -> (checksum:u64@[0]) {
  reg lfsr:u64:[clock_pin=ref clk] = nil
  reg sum:u64:[clock_pin=ref clk] = nil

  checksum = sum

  mut nxt:u64 = lfsr
  wrap nxt = nxt ^ (nxt << 13)
  wrap nxt = nxt ^ (nxt >> 7)
  wrap nxt = nxt ^ (nxt << 17)

  const r = dut(src_clk=clk, dst_clk=clk, src_rst=rst, dst_rst=rst, src_bit=lfsr#[0])

  mut acc:u64 = sum
  wrap acc = ((acc << 1) | acc#[63]) ^ r

  if rst != 0 {
    lfsr = 2611923443488327891
    sum  = 0
  } else {
    lfsr = nxt
    sum  = acc
  }
}
