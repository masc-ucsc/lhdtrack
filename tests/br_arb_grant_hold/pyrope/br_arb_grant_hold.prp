// Hold an arbiter grant until its owner releases the selected hold bit.
pub mod br_arb_grant_hold(clk:Clock, enable_grant_hold_update:U1, grant_from_arb:U16, grant_hold:U16, rst:U1) -> (enable_priority_update_to_arb:U1@[], grant:U16@[]) {
  reg hold:U16:[reset_pin=rst] = 0
  grant = if hold != 0 { hold } else { grant_from_arb }
  enable_priority_update_to_arb = U1(hold == 0 and enable_grant_hold_update != 0)
  if enable_grant_hold_update != 0 {
    hold = grant & grant_hold
  }
}
