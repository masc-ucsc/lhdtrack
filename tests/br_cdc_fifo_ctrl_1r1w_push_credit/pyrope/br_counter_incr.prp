pub mod br_counter_incr::[timecheck=false](clk:u1, rst:u1, reinit:u1, initial_value:u6, incr_valid:u1, incr:u1) -> (value:u6@[], value_next:u6@[]) {
  reg value:u6
  mut _mux_1:u7 = if reinit != 0 { initial_value } else { value }
  mut _mux_2:u7 = if incr_valid != 0 { incr } else { 0 }
  const value_next__w1 = (_mux_1 + _mux_2)#[0..=6]#[0..=5]
  if rst != 0 {
    value = initial_value
  } elif (incr_valid != 0) or (reinit != 0) {
    value = value_next__w1
  }
  value_next = value_next__w1
}
