const br_misc_unused_p4 = import("br_misc_unused_p4.br_misc_unused_p4")

pub mod br_flow_checks_valid_data_intg_p1::[timecheck=false](clk:u1, rst:u1, valid:u8, ready:u8, data:u256) -> () {
  br_misc_unused_p4::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 272) | (valid << 264) | (ready << 256) | data)
}
