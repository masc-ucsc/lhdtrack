const br_flow_checks_valid_data_impl_p1 = import("br_flow_checks_valid_data_impl_p1.br_flow_checks_valid_data_impl_p1")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")
const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_flow_arb_core::[timecheck=false](clk:u1, rst:u1, can_grant:u8, grant:u8, push_valid:u8, pop_ready:u1) -> (request:u8@[], enable_priority_update:u1@[], push_ready:u8@[], pop_valid_unstable:u1@[]) {
  mut _rep_1:u8 = if (pop_ready & 1) != 0 { 0xff } else { 0 }
  const push_ready__w1 = _rep_1 & can_grant
  const pop_valid_unstable__w1 = unsigned(push_valid != 0)
  br_misc_unused_p1::[name=br_misc_unused_grant](`in` = grant)
  br_flow_checks_valid_data_impl_p1::[name=br_flow_checks_valid_data_impl](clk = clk, rst = rst, valid = pop_valid_unstable__w1, ready = pop_ready, data = 0)
  /* TODO: result 'br_flow_checks_valid_data_intg' of zero-output module 'br_flow_checks_valid_data_intg' is read */
  request = push_valid
  enable_priority_update = pop_ready
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
}
