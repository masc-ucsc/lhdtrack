// Fixed-priority flow mux: the lowest numbered valid lane wins.
// Ready also reaches idle lanes ahead of that winner, as in the reference.
pub mod br_flow_mux_fixed_stable(clk:Clock, pop_ready:U1, push_data:U256, push_valid:U8, rst:U1) -> (pop_data:U32@[0], pop_valid:U1@[0], push_ready:U8@[0]) {
  comptime const lanes = push_valid.[bits]
  comptime const width = push_data.[bits]/lanes
  reg valid:Bool:[reset_pin=rst] = false
  reg data:U32 = nil
  const ready = pop_ready != 0 or not valid
  mut seen:Bool = false
  mut selected:U32 = 0
  for lane in 0..<lanes {
    push_ready#[lane] = U1(ready and not seen)
    if not seen and push_valid#[lane] != 0 {
      selected = push_data#[(lane*width)..+width]
    }
    seen = seen or push_valid#[lane] != 0
  }
  // Unreset payload changes only on an accepted valid beat.
  if ready and seen {
    data = selected
  }
  valid = seen or not ready
  pop_valid = U1(valid)
  pop_data = data
}
