const br_enc_priority_encoder = import("br_enc_priority_encoder.br_enc_priority_encoder")

// Priority encoder whose order rotates: the requester just above the one-hot
// `lowest_prio` has the highest priority and `lowest_prio` itself the lowest.
// Results are packed like br_enc_priority_encoder.
pub mod br_enc_priority_dynamic<NUM_REQUESTERS=2, NUM_RESULTS=1>(
  `in`:unsigned(bits=NUM_REQUESTERS),
  lowest_prio:unsigned(bits=NUM_REQUESTERS)
) -> (out:unsigned(bits=NUM_RESULTS * NUM_REQUESTERS)@[0]) {
  comptime const N = NUM_REQUESTERS

  // Requesters at or below lowest_prio come after the ones above it.
  mut wrapped:unsigned(bits=N) = 0
  for i in 0..<N {
    wrapped#[i] = lowest_prio#|[i..]
  }
  const in_low  = `in` & wrapped
  const in_high = `in` & ~wrapped

  // Unroll the ring into one 2N-1 bit vector, high-priority requesters first.
  // in_high[0] is dropped: bit 0 is in the low half whenever lowest_prio != 0.
  comptime const RING = 2*N - 1
  const unrolled      = (in_low << (N - 1)) | (in_high >> 1)
  const ordered       = br_enc_priority_encoder<NUM_REQUESTERS=RING,NUM_RESULTS=NUM_RESULTS>(`in`=unrolled)

  // Fold each result back onto the N requesters.
  mut results:unsigned(bits=NUM_RESULTS * N) = 0
  for k in 0..<NUM_RESULTS {
    const pick          = ordered#[(k*RING)..+RING]
    results#[(k*N)..+N] = pick#[(N - 1)..] | (pick#[0..<(N - 1)] << 1)
  }
  out = results
}
