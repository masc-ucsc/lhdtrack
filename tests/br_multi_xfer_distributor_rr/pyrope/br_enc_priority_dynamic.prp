  mut br_enc_priority_encoder_inst = br_enc_priority_encoder::[name=br_enc_priority_encoder_inst](clk = clk, rst = rst, `in.e30` = (t58 >> 30) & 1, `in.e29` = (t58 >> 29) & 1, `in.e28` = (t58 >> 28) & 1, `in.e27` = (t58 >> 27) & 1, `in.e26` = (t58 >> 26) & 1, `in.e25` = (t58 >> 25) & 1, `in.e24` = (t58 >> 24) & 1, `in.e23` = (t58 >> 23) & 1, `in.e22` = (t58 >> 22) & 1, `in.e21` = (t58 >> 21) & 1, `in.e20` = (t58 >> 20) & 1, `in.e19` = (t58 >> 19) & 1, `in.e18` = (t58 >> 18) & 1, `in.e17` = (t58 >> 17) & 1, `in.e16` = (t58 >> 16) & 1, `in.e15` = (t58 >> 15) & 1, `in.e14` = (t58 >> 14) & 1, `in.e13` = (t58 >> 13) & 1, `in.e12` = (t58 >> 12) & 1, `in.e11` = (t58 >> 11) & 1, `in.e10` = (t58 >> 10) & 1, `in.e9` = (t58 >> 9) & 1, `in.e8` = (t58 >> 8) & 1, `in.e7` = (t58 >> 7) & 1, `in.e6` = (t58 >> 6) & 1, `in.e5` = (t58 >> 5) & 1, `in.e4` = (t58 >> 4) & 1, `in.e3` = (t58 >> 3) & 1, `in.e2` = (t58 >> 2) & 1, `in.e1` = (t58 >> 1) & 1, `in.e0` = t58 & 1)
