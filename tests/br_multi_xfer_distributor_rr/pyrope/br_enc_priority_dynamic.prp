pub mod br_enc_priority_dynamic::[timecheck=false](clk:u1, rst:u1, `in`:u16, lowest_prio:u16) -> (out:u64@[]) {
  mut priority_mask:u16 = 0
  priority_mask = 0sb?
  out = 0sb?
