// Multi-transfer distributor datapath: up to 4 symbols per cycle are sent to
// the flows granted by the arbiter. Symbol k goes to the flow granted k-th, so
// flow f takes the OR of the symbols whose ordered grant has bit f set.
const br_mux_onehot = import("br_mux_onehot.br_mux_onehot")

// Data for flow F: bit k of its select is ordered grant k's bit F.
comb flow_data<F=0>(grant_ordered:U64, push_data:U256) -> (data:U64) {
  const select:U4 = (grant_ordered#[F], grant_ordered#[16 + F], grant_ordered#[32 + F], grant_ordered#[48 + F])#[..]
  data = br_mux_onehot<NumSymbolsIn=4, SymbolWidth=64>(select=select, `in`=push_data)
}

pub mod br_multi_xfer_distributor_core(clk:Clock, grant:U16, grant_count:U3, grant_ordered:U64, pop_ready:U16, push_data:U256, push_sendable:U3, rst:Reset) -> (enable_priority_update:U1@[], grant_allowed:U3@[], pop_data:U1024@[], pop_valid:U16@[], push_receivable:U3@[], request:U16@[]) {
  const d0  = flow_data<F=0>(grant_ordered=grant_ordered, push_data=push_data)
  const d1  = flow_data<F=1>(grant_ordered=grant_ordered, push_data=push_data)
  const d2  = flow_data<F=2>(grant_ordered=grant_ordered, push_data=push_data)
  const d3  = flow_data<F=3>(grant_ordered=grant_ordered, push_data=push_data)
  const d4  = flow_data<F=4>(grant_ordered=grant_ordered, push_data=push_data)
  const d5  = flow_data<F=5>(grant_ordered=grant_ordered, push_data=push_data)
  const d6  = flow_data<F=6>(grant_ordered=grant_ordered, push_data=push_data)
  const d7  = flow_data<F=7>(grant_ordered=grant_ordered, push_data=push_data)
  const d8  = flow_data<F=8>(grant_ordered=grant_ordered, push_data=push_data)
  const d9  = flow_data<F=9>(grant_ordered=grant_ordered, push_data=push_data)
  const d10 = flow_data<F=10>(grant_ordered=grant_ordered, push_data=push_data)
  const d11 = flow_data<F=11>(grant_ordered=grant_ordered, push_data=push_data)
  const d12 = flow_data<F=12>(grant_ordered=grant_ordered, push_data=push_data)
  const d13 = flow_data<F=13>(grant_ordered=grant_ordered, push_data=push_data)
  const d14 = flow_data<F=14>(grant_ordered=grant_ordered, push_data=push_data)
  const d15 = flow_data<F=15>(grant_ordered=grant_ordered, push_data=push_data)
  pop_data = (d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15)#[..]

  pop_valid = grant
  push_receivable = grant_count
  request = pop_ready
  grant_allowed = push_sendable
  enable_priority_update = 1
}
