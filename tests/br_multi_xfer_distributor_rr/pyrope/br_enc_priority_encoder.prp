// Pick the NUM_RESULTS lowest-numbered set bits of `in`, one per result, each
// as a one-hot mask. Result k is packed at bits [k*N, k*N + N); a result is
// zero when fewer than k + 1 bits are set.
pub mod br_enc_priority_encoder<NUM_REQUESTERS=2, NUM_RESULTS=1>(`in`:unsigned(bits=NUM_REQUESTERS)) -> (
  out:unsigned(bits=NUM_RESULTS * NUM_REQUESTERS)@[0]
) {
  comptime const N = NUM_REQUESTERS

  mut remaining:unsigned(bits=N)             = `in`
  mut results:unsigned(bits=NUM_RESULTS * N) = 0
  for k in 0..<NUM_RESULTS {
    const lowest        = remaining & -remaining
    results#[(k*N)..+N] = lowest
    remaining           = remaining & ~lowest
  }
  out = results
}
