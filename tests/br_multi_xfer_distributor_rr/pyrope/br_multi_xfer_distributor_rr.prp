const br_arb_multi_rr = import("br_arb_multi_rr.br_arb_multi_rr")
const br_multi_xfer_distributor_core = import("br_multi_xfer_distributor_core.br_multi_xfer_distributor_core")
const cfg = import("lhdtrack_cfg")

// Distribute up to 4 of the 64-bit push symbols per cycle across 16 pop flows,
// round-robin among the ready flows. Symbols are packed with symbol/flow 0 in
// the low bits.
pub mod br_multi_xfer_distributor_rr::[timecheck=false](clk:Clock, pop_ready:U16, push_data:U256, push_sendable:U3, rst:Reset) -> (pop_data:U1024@[], pop_valid:U16@[], push_receivable:U3@[]) {
  if cfg.no_loop {
    wire grant:U16 = nil
    wire grant_ordered:U64 = nil
    wire grant_count:U3 = nil
    mut br_multi_xfer_distributor_core_inst = br_multi_xfer_distributor_core::[name=br_multi_xfer_distributor_core_inst](clk=clk, rst=rst, push_sendable=push_sendable, push_data=push_data, pop_ready=pop_ready, grant=grant, grant_ordered=grant_ordered, grant_count=grant_count)
    mut br_arb_multi_rr_inst = br_arb_multi_rr::[name=br_arb_multi_rr_inst](clk=clk, rst=rst, enable_priority_update=br_multi_xfer_distributor_core_inst.enable_priority_update, request=br_multi_xfer_distributor_core_inst.request, grant_allowed=br_multi_xfer_distributor_core_inst.grant_allowed)
    grant = br_arb_multi_rr_inst.grant
    grant_ordered = br_arb_multi_rr_inst.grant_ordered
    grant_count = br_arb_multi_rr_inst.grant_count
    push_receivable = br_multi_xfer_distributor_core_inst.push_receivable
    pop_valid = br_multi_xfer_distributor_core_inst.pop_valid
    pop_data = br_multi_xfer_distributor_core_inst.pop_data
  } else {
    comptime const NUM_FLOWS    = pop_ready.[bits]
    comptime const SYMBOL_WIDTH = pop_data.[bits] / NUM_FLOWS
    comptime const NUM_SYMBOLS  = push_data.[bits] / SYMBOL_WIDTH

    const br_arb_multi_rr_inst = br_arb_multi_rr(clk=clk, rst=U1(rst), enable_priority_update=1, request=pop_ready, grant_allowed=push_sendable)

    // Flow i receives symbol k when it holds the k-th grant.
    mut data:U1024 = 0
    for i in 0..<NUM_FLOWS {
      mut symbol:U64 = 0
      for k in 0..<NUM_SYMBOLS {
        if br_arb_multi_rr_inst.grant_ordered#[k*NUM_FLOWS + i] == 1 {
          symbol |= push_data#[(k*SYMBOL_WIDTH)..+SYMBOL_WIDTH]
        }
      }
      data#[(i*SYMBOL_WIDTH)..+SYMBOL_WIDTH] = symbol
    }

    push_receivable = br_arb_multi_rr_inst.grant_count
    pop_valid       = br_arb_multi_rr_inst.grant
    pop_data        = data
  }
}
