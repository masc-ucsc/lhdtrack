// OR all selected packed lanes, including multiple simultaneous selections.
const cfg = import("lhdtrack_cfg")

pub comb br_mux_onehot<NumSymbolsIn=4, SymbolWidth=64>(`in`:Unsigned(bits=NumSymbolsIn*SymbolWidth), select:Unsigned(bits=NumSymbolsIn)) -> (out:Unsigned(bits=SymbolWidth)) {
  comptime const W = SymbolWidth
  // The one-lane reference passes payload even when its select bit is zero.
  if NumSymbolsIn == 1 {
    out = `in`
  } else {
    mut data:Unsigned(bits=W) = 0
    if cfg.no_loop {
      // Supports 1 or 4 lanes (the configurations this design uses).
      cassert(NumSymbolsIn == 4)
      wrap data = (`in`#[0..<W] & select#sext[0..=0]) | (`in`#[W..<(2*W)] & select#sext[1..=1])
                | (`in`#[(2*W)..<(3*W)] & select#sext[2..=2]) | (`in`#[(3*W)..<(4*W)] & select#sext[3..=3])
    } else {
      comptime const ONES = (1 << W) - 1
      for lane in 0..<NumSymbolsIn {
        data |= `in`#[(lane*W)..+W] & (if select#[lane] == 1 { ONES } else { 0 })
      }
    }
    out = data
  }
}
