const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_impl::[timecheck=false](clk:u1, rst:u1, valid:u16, ready:u16, data:u1024) -> () {
  br_misc_unused::[name=br_misc_unused_all_unused](`in` = ((rst & 1) << 1056) | (valid << 1040) | (ready << 1024) | data)
}
