const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_flow_checks_valid_data_impl<NumFlows=16, Width=0x40, EnableCoverBackpressure=0, NumBackpressureCheckFlows=16, EnableAssertValidStability=0, EnableAssertDataStability=0, EnableAssertDataKnown=1, EnableAssertFinalNotValid=1, EnableAssertNoBackpressure=1>::[timecheck=false](clk:Clock, data:U1024, ready:U16, rst:U1, valid:U16) -> () {
