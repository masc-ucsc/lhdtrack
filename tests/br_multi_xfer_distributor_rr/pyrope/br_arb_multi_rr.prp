const br_enc_priority_dynamic = import("br_enc_priority_dynamic.br_enc_priority_dynamic")

// Round-robin arbiter granting up to `grant_allowed` (at most MAX_GRANTS)
// requesters per cycle. grant_ordered packs the grants in priority order,
// grant k at bits [k*N, k*N + N). The last requester granted becomes the
// lowest priority for the next cycle.
pub mod br_arb_multi_rr<NUM_REQUESTERS=2, MAX_GRANTS=2, COUNT_WIDTH=2, SELECT_WIDTH=1>(
  rst:u1,
  enable_priority_update:bool,
  request:unsigned(bits=NUM_REQUESTERS),
  grant_allowed:unsigned(bits=COUNT_WIDTH)
) -> (
  grant:unsigned(bits=NUM_REQUESTERS)@[0],
  grant_ordered:unsigned(bits=MAX_GRANTS * NUM_REQUESTERS)@[0],
  grant_count:unsigned(bits=COUNT_WIDTH)@[0]
) {
  comptime const N = NUM_REQUESTERS
  cassert(MAX_GRANTS >= 2 and MAX_GRANTS <= N)
  cassert((1 << COUNT_WIDTH) > MAX_GRANTS and (1 << SELECT_WIDTH) >= MAX_GRANTS)

  // After reset the top requester is the lowest priority, so requester 0 leads.
  reg lowest_prio:unsigned(bits=N):[reset_pin = ref rst] = 1 << (N - 1)

  const all_grants = br_enc_priority_dynamic<NUM_REQUESTERS=N,NUM_RESULTS=MAX_GRANTS>(`in`=request, lowest_prio=lowest_prio)

  const request_count = request#+[..]
  mut count:unsigned(bits=COUNT_WIDTH) = 0
  wrap count = if request_count <= grant_allowed { request_count } else { grant_allowed }

  mut ordered:unsigned(bits=MAX_GRANTS * N) = 0
  mut granted:unsigned(bits=N)              = 0
  for k in 0..<MAX_GRANTS {
    if grant_allowed > k {
      ordered#[(k*N)..+N] = all_grants#[(k*N)..+N]
      granted            |= all_grants#[(k*N)..+N]
    }
  }

  // The last grant of this cycle becomes the lowest priority.
  mut last:unsigned(bits=SELECT_WIDTH) = 0
  wrap last = count - 1
  mut last_grant:unsigned(bits=N) = 0
  for k in 0..<MAX_GRANTS {
    if last == k {
      last_grant = all_grants#[(k*N)..+N]
    }
  }
  if enable_priority_update and request != 0 and grant_allowed > 0 {
    lowest_prio = last_grant
  }

  grant         = granted
  grant_ordered = ordered
  grant_count   = count
}
