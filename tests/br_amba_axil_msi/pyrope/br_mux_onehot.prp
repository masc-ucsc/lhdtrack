// OR all selected packed lanes, including multiple simultaneous selections.
pub comb br_mux_onehot<NumSymbolsIn=4, SymbolWidth=33>::[synth.abc_pre="&synch2 -K 6 -C 500; &dch -C 500"](`in`:Unsigned(bits=NumSymbolsIn*SymbolWidth), select:Unsigned(bits=NumSymbolsIn)) -> (out:Unsigned(bits=SymbolWidth)) {
  cassert(NumSymbolsIn == 4)
  comptime const W = SymbolWidth
  out = (`in`#[0..<W] & select#sext[0..=0]) | (`in`#[W..<(2*W)] & select#sext[1..=1])
      | (`in`#[(2*W)..<(3*W)] & select#sext[2..=2]) | (`in`#[(3*W)..<(4*W)] & select#sext[3..=3])
}
