const br_arb_rr_internal_t = import("br_arb_rr_internal.br_arb_rr_internal")
const br_flow_mux_core_stable_t = import("br_flow_mux_core_stable.br_flow_mux_core_stable")

pub mod br_flow_mux_rr_stable::[timecheck=false](clk:u1, rst:u1, push_valid:u4, push_data:u132, pop_ready:u1) -> (push_ready:u4@[], pop_valid:u1@[], pop_data:u33@[]) {
  wire request:u4
  wire enable_priority_update:u1
  mut br_arb_rr_internal = br_arb_rr_internal_t::[name=br_arb_rr_internal](clk = clk, rst = rst, enable_priority_update = enable_priority_update, request = request)
  mut br_flow_mux_core_stable = br_flow_mux_core_stable_t::[name=br_flow_mux_core_stable](clk = clk, rst = rst, can_grant = (br_arb_rr_internal.can_grant.e3 << 3) | (br_arb_rr_internal.can_grant.e2 << 2) | (br_arb_rr_internal.can_grant.e1 << 1) | br_arb_rr_internal.can_grant.e0, grant = br_arb_rr_internal.grant, push_valid = push_valid, push_data = push_data, pop_ready = pop_ready)
  request = br_flow_mux_core_stable.request
  enable_priority_update = br_flow_mux_core_stable.enable_priority_update
  push_ready = br_flow_mux_core_stable.push_ready
  pop_valid = br_flow_mux_core_stable.pop_valid
  pop_data = br_flow_mux_core_stable.pop_data
}
