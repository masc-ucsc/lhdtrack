pub mod br_counter_decr<MaxValueWidth=32, MaxDecrementWidth=32, MaxValue=15, MaxDecrement=1, EnableReinitAndDecr=1, EnableSaturate=1, EnableAssertFinalNotValid=1, EnableCoverReinit=1, EnableCoverReinitAndDecr=1, EnableCoverReinitNoDecr=1, EnableCoverZeroDecrement=1>::[timecheck=false](clk:Clock, decr:U1, decr_valid:U1, initial_value:U4, reinit:U1, rst:U1) -> (value:U4@[], value_next:U4@[]) {
  reg value:U4
  mut _mux_2:U4 = if reinit != 0 { initial_value } else { value }
  const gen_reinit_and_decr_base_value = _mux_2
  mut _mux_3:U4 = if decr_valid != 0 { decr } else { 0 }
  mut _b2i_4 = if decr_valid != 0 and decr > gen_reinit_and_decr_base_value { 1 } else { 0 }
  mut _mux_5:U4 = if _b2i_4 != 0 { 0 } else { (gen_reinit_and_decr_base_value - _mux_3)#[0..=3] }
  const value_next__w1 = _mux_5
  if rst != 0 {
    value = initial_value
  } elif decr_valid != 0 or reinit != 0 {
    value = value_next__w1
  }
  value_next = value_next__w1
}
