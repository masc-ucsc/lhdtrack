pub mod br_rr_state_internal<NumRequesters=4>::[timecheck=false](clk:Clock, grant:U4, rst:U1, update_priority:U1) -> (last_grant:U4@[], priority_mask:(e3:U1, e2:U1, e1:U1, e0:U1)@[]) {
  reg last_grant:U4
  wire last_grant_init_bits:U4 = nil
  wire last_grant_init:U4 = nil
  wire `priority_mask__bpr.e3`:U1 = nil
  wire `priority_mask__bpr.e2`:U1 = nil
  wire `priority_mask__bpr.e1`:U1 = nil
  wire `priority_mask__bpr.e0`:U1 = nil
  mut _b2i_1 = if last_grant != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e0` = _b2i_1
  mut _b2i_2 = if last_grant#[1..=3] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e1` = _b2i_2
  mut _b2i_3 = if last_grant#[2..=3] != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e2` = _b2i_3
  mut _b2i_4 = if ((last_grant >> 3) & 1) != 0 { 1 } else { 0 }
  mut `priority_mask__bpo.e3` = _b2i_4
  last_grant_init_bits#[3] = 1
  last_grant_init_bits#[0] = 0
  last_grant_init_bits#[1] = 0
  last_grant_init_bits#[2] = 0
  if rst != 0 {
    last_grant = last_grant_init
  } elif update_priority != 0 {
    last_grant = grant
  }
  last_grant_init = last_grant_init_bits
  const t21 = `priority_mask__bpo.e3`
  `priority_mask__bpr.e3` = t21
  priority_mask.e3 = t21
  const t22 = `priority_mask__bpo.e2`
  `priority_mask__bpr.e2` = t22
  priority_mask.e2 = t22
  const t23 = `priority_mask__bpo.e1`
  `priority_mask__bpr.e1` = t23
  priority_mask.e1 = t23
  const t24 = `priority_mask__bpo.e0`
  `priority_mask__bpr.e0` = t24
  priority_mask.e0 = t24
}
