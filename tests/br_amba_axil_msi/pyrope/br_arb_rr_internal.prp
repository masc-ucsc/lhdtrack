const br_rr_state_internal = import("br_rr_state_internal.br_rr_state_internal")

pub mod br_arb_rr_internal::[timecheck=false](clk:u1, rst:u1, enable_priority_update:u1, request:u4) -> (can_grant:(e3:u1, e2:u1, e1:u1, e0:u1)@[], grant:u4@[]) {
  mut gen_n_req_request_priority:u16 = 0
  wire grant:u4
  gen_n_req_request_priority = 0sb?
  mut gen_n_req_request_priority__w1 = gen_n_req_request_priority
  gen_n_req_request_priority__w1#[5] = 0
  mut gen_n_req_request_priority__w2 = gen_n_req_request_priority__w1
  gen_n_req_request_priority__w2#[10] = 0
  mut rr_state_internal = br_rr_state_internal::[name=rr_state_internal](clk = clk, rst = rst, update_priority = unsigned((enable_priority_update != 0) and (request != 0)), grant = grant)
  const gen_n_req_priority_mask__w1 = (rr_state_internal.priority_mask.e3 << 3) | (rr_state_internal.priority_mask.e2 << 2) | (rr_state_internal.priority_mask.e1 << 1) | rr_state_internal.priority_mask.e0
  const gen_n_req_request_high__w1 = request & (~gen_n_req_priority_mask__w1)#[0..=3]
  mut gen_n_req_request_priority__w3 = gen_n_req_request_priority__w2
  gen_n_req_request_priority__w3#[0..=3] = gen_n_req_request_high__w1#[1..=3] << 1
  mut _mux_2:u4 = if ((gen_n_req_priority_mask__w1 >> 3) & 1) != 0 { request#[0..=2] } else { gen_n_req_request_high__w1#[0..=2] }
  mut gen_n_req_request_priority__w4 = gen_n_req_request_priority__w3
  gen_n_req_request_priority__w4#[12..=15] = _mux_2
  mut _mux_3:u1 = if ((gen_n_req_priority_mask__w1 >> 1) & 1) != 0 { request & 1 } else { gen_n_req_request_high__w1 & 1 }
  mut gen_n_req_request_priority__w5 = gen_n_req_request_priority__w4
  gen_n_req_request_priority__w5#[4] = _mux_3 & 1
  mut _mux_4:u2 = if ((gen_n_req_priority_mask__w1 >> 1) & 1) != 0 { gen_n_req_request_high__w1#[2..=3] } else { 0 }
  mut gen_n_req_request_priority__w6 = gen_n_req_request_priority__w5
  gen_n_req_request_priority__w6#[6..=7] = _mux_4
  mut _mux_5:u2 = if ((gen_n_req_priority_mask__w1 >> 2) & 1) != 0 { request#[0..=1] } else { gen_n_req_request_high__w1#[0..=1] }
  mut gen_n_req_request_priority__w7 = gen_n_req_request_priority__w6
  gen_n_req_request_priority__w7#[8..=9] = _mux_5
  mut _mux_6:u1 = if ((gen_n_req_priority_mask__w1 >> 2) & 1) != 0 { (gen_n_req_request_high__w1 >> 3) & 1 } else { 0 }
  mut gen_n_req_request_priority__w8 = gen_n_req_request_priority__w7
  gen_n_req_request_priority__w8#[11] = _mux_6 & 1
  mut `can_grant__bpo.e0` = unsigned(not (gen_n_req_request_priority__w8#[0..=3] != 0))
  mut `can_grant__bpo.e1` = unsigned(not (gen_n_req_request_priority__w8#[4..=7] != 0))
  mut `can_grant__bpo.e2` = unsigned(not (gen_n_req_request_priority__w8#[8..=11] != 0))
  mut `can_grant__bpo.e3` = unsigned(not (gen_n_req_request_priority__w8#[12..=15] != 0))
  grant = request & ((`can_grant__bpo.e3` << 3) | (`can_grant__bpo.e2` << 2) | (`can_grant__bpo.e1` << 1) | `can_grant__bpo.e0`)
  can_grant.e3 = `can_grant__bpo.e3`
  can_grant.e2 = `can_grant__bpo.e2`
  can_grant.e1 = `can_grant__bpo.e1`
  can_grant.e0 = `can_grant__bpo.e0`
}
