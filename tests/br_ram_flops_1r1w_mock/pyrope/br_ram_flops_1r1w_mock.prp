const br_delay_valid = import("br_delay_valid.br_delay_valid")
const br_delay_valid_p1 = import("br_delay_valid_p1.br_delay_valid_p1")
const br_delay_valid_p2 = import("br_delay_valid_p2.br_delay_valid_p2")
const br_misc_unused = import("br_misc_unused.br_misc_unused")

pub mod br_ram_flops_1r1w_mock::[timecheck=false](rd_addr:U4, rd_addr_valid:U1, rd_clk:Clock, rd_rst:U1, wr_addr:U4, wr_clk:Clock, wr_data:U32, wr_rst:U1, wr_valid:U1, wr_word_en:U1) -> (rd_data:U32@[], rd_data_valid:U1@[]) {
  reg mem:[16]U32:[__store_clock_pin=wr_clk, __store_posclk=true, ordering="old"]
  mut br_delay_valid_wr = br_delay_valid::[name=br_delay_valid_wr](clk=wr_clk, rst=wr_rst, in_valid=wr_valid, `in`=(wr_addr << 32) | wr_data)
  mut br_delay_valid_rd_addr = br_delay_valid_p1::[name=br_delay_valid_rd_addr](clk=rd_clk, rst=rd_rst, in_valid=rd_addr_valid, `in`=rd_addr)
  if br_delay_valid_wr.out_valid != 0 {
    mem[(br_delay_valid_wr.out >> 32)#[0..=3]] = br_delay_valid_wr.out#[0..=31]
  }
  br_misc_unused::[name=gen_no_partial_write_br_misc_unused_wr_word_en](`in`=wr_word_en)
  mut br_delay_valid_rd_data = br_delay_valid_p2::[name=br_delay_valid_rd_data](clk=rd_clk, rst=rd_rst, in_valid=br_delay_valid_rd_addr.out_valid, `in`=mem[br_delay_valid_rd_addr.out])
  rd_data_valid = br_delay_valid_rd_data.out_valid
  rd_data = br_delay_valid_rd_data.out
}
