// Route valid to one consumer and broadcast the payload to every lane.
pub comb br_flow_demux_select_unstable(pop_ready:U4, push_data:U32, push_valid:U1, select:U2) -> (pop_data_unstable:U128, pop_valid_unstable:U4, push_ready:U1) {
  push_ready = pop_ready#[select]
  pop_valid_unstable = push_valid << select
  for lane in 0..<pop_ready.[bits] {
    pop_data_unstable#[(lane*push_data.[bits])..+push_data.[bits]] = push_data
  }
}
