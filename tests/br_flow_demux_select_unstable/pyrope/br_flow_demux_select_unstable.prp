const br_flow_checks_valid_data_impl_t = import("br_flow_checks_valid_data_impl.br_flow_checks_valid_data_impl")
const br_flow_checks_valid_data_intg_t = import("br_flow_checks_valid_data_intg.br_flow_checks_valid_data_intg")

pub mod br_flow_demux_select_unstable::[timecheck=false](clk:Clock, pop_ready:U4, push_data:U32, push_valid:U1, rst:Reset, select:U2) -> (pop_data_unstable:U128@[], pop_valid_unstable:U4@[], push_ready:U1@[]) {
  pop_data_unstable = 0sb?
  const push_ready__w1 = ((pop_ready << 1) >> (select + 1)) & 1
  mut _mux_1:U4 = if push_valid != 0 { (push_valid << select)#[0..=3] } else { 0 }
  const pop_valid_unstable__w1 = _mux_1
  mut pop_data_unstable__w1 = pop_data_unstable
  pop_data_unstable__w1#[0..=31] = push_data
  mut pop_data_unstable__w2 = pop_data_unstable__w1
  pop_data_unstable__w2#[32..=63] = push_data
  mut pop_data_unstable__w3 = pop_data_unstable__w2
  pop_data_unstable__w3#[64..=95] = push_data
  mut pop_data_unstable__w4 = pop_data_unstable__w3
  pop_data_unstable__w4#[96..=127] = push_data
  br_flow_checks_valid_data_impl_t::[name=br_flow_checks_valid_data_impl](clk=clk, rst=rst, valid=pop_valid_unstable__w1, ready=pop_ready, data=pop_data_unstable__w4)
  br_flow_checks_valid_data_intg_t::[name=br_flow_checks_valid_data_intg](clk=clk, rst=rst, valid=push_valid, ready=push_ready__w1, data=push_data)
  push_ready = push_ready__w1
  pop_valid_unstable = pop_valid_unstable__w1
  pop_data_unstable = pop_data_unstable__w4
}
