// Forward register: accept a beat whenever empty or the consumer is ready.
// Payload is unreset and still captures during reset when a beat is accepted.
pub mod br_flow_reg_fwd(clk:Clock, pop_ready:U1, push_data:U32, push_valid:U1, rst:U1) -> (pop_data:U32@[], pop_valid:U1@[], push_ready:U1@[]) {
  reg pop_valid:U1:[reset_pin=rst] = 0
  reg pop_data:U32 = nil
  const ready = pop_ready != 0 or pop_valid == 0
  push_ready = U1(ready)
  pop_valid = U1(push_valid != 0 or not ready)
  if ready and push_valid != 0 {
    pop_data = push_data
  }
}
