// Select count requesters in priority order; slot zero is the low n bits.
// high reverses priority within each slot without changing the external lane order.
pub comb br_enc_priority_encoder<n=32, count=2, high=false>(request:Unsigned(bits=n)) -> (out:Unsigned(bits=n*count)) {
  cassert(n >= 1 and count >= 1 and count <= n)
  mut remaining:Unsigned(bits=n) = 0
  for bit in 0..<n {
    remaining#[bit] = request#[if high { n - 1 - bit } else { bit }]
  }
  for slot in 0..<count {
    const winner:Unsigned(bits=n) = remaining & -remaining
    for bit in 0..<n {
      out#[(slot*n) + bit] = winner#[if high { n - 1 - bit } else { bit }]
    }
    remaining ^= winner
  }
}
