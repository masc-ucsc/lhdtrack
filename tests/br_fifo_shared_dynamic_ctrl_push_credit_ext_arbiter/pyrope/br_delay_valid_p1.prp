pub mod br_delay_valid_p1::[timecheck=false](clk:Clock, `in`:U1, in_valid:U1, rst:U1) -> (out:U1@[], out_stages:U2@[], out_valid:U1@[], out_valid_stages:U2@[]) {
  reg stage_valid___q:U2 = nil
  mut stage_valid:U2 = 0
  reg stage___q:U2 = nil
  mut `stage`:U2 = 0
  stage_valid = stage_valid___q
  `stage` = stage___q
  mut stage_valid__w1 = stage_valid
  stage_valid__w1#[0] = in_valid & 1
  mut stage__w1 = `stage`
  stage__w1#[0] = `in` & 1
  if rst != 0 {
    stage_valid___q#[1] = 0
  } else {
    stage_valid___q#[1] = stage_valid__w1 & 1
  }
  if (stage_valid__w1 & 1) != 0 {
    stage___q#[1] = stage__w1 & 1
  }
  out_valid = (stage_valid__w1 >> 1) & 1
  out = (stage__w1 >> 1) & 1
  out_valid_stages = stage_valid__w1
  out_stages = stage__w1
}
