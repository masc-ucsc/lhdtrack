pub mod br_counter::[timecheck=false](clk:Clock, decr:U2, decr_valid:U1, incr:U2, incr_valid:U1, initial_value:U6, reinit:U1, rst:U1) -> (value:U6@[], value_next:U6@[]) {
  reg value:U6 = nil
  mut _mux_1:U2 = if incr_valid != 0 { incr } else { 0 }
  mut _mux_2:U2 = if decr_valid != 0 { decr } else { 0 }
  mut _mux_3:U6 = if reinit != 0 { initial_value } else { value }
  const value_next__w1 = ((_mux_3 + _mux_1)#[0..=5] - _mux_2)#[0..=5]
  if rst != 0 {
    value = initial_value
  } elif Unsigned(reinit != 0 or incr_valid != 0 or decr_valid != 0) != 0 {
    value = value_next__w1
  }
  value_next = value_next__w1
}
