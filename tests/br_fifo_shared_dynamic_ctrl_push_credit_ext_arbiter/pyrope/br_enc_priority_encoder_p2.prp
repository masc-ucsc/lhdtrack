pub comb br_enc_priority_encoder_p2::[timecheck=false](clk:u1, rst:u1, `in`:(e1:u1, e0:u1)) -> (out:u2) {
  mut in_internal:u2 = 0
  mut out_internal:u2 = 0
  in_internal = 0sb?
  out_internal = 0sb?
  out = 0sb?
  mut in_internal__w1 = in_internal
  in_internal__w1#[0] = `in`.e1 & 1
  mut in_internal__w2 = in_internal__w1
  in_internal__w2#[1] = `in`.e0 & 1
  const gen_out_internal_0_in_masked__w1 = in_internal__w2
  mut out_internal__w1 = out_internal
  out_internal__w1#[0] = gen_out_internal_0_in_masked__w1 & 1
  mut out_internal__w2 = out_internal__w1
  out_internal__w2#[1] = unsigned((((gen_out_internal_0_in_masked__w1 >> 1) & 1) != 0) and ((gen_out_internal_0_in_masked__w1 & 1) == 0)) & 1
  mut out__w1 = out
  out__w1#[0] = (out_internal__w2#[0..=1] >> 1) & 1
  mut out__w2 = out__w1
  out__w2#[1] = out_internal__w2#[0..=1] & 1
  out = out__w2
}
