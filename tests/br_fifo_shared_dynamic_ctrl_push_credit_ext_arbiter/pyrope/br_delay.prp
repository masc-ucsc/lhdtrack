pub mod br_delay::[timecheck=false](clk:Clock, `in`:U2, rst:U1) -> (out:U2@[], out_stages:U4@[]) {
  reg stages___q:U4 = nil
  mut stages:U4 = 0
  stages = stages___q
  mut stages__w1 = stages
  stages__w1#[0..=1] = `in`
  if rst != 0 {
    stages___q#[2..=3] = 0
  } else {
    stages___q#[2..=3] = stages__w1#[0..=1]
  }
  out = stages__w1#[2..=3]
  out_stages = stages__w1
}
