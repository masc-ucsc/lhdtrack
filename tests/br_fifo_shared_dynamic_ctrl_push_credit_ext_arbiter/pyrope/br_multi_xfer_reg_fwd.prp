const br_shift_left = import("br_shift_left.br_shift_left")
const br_shift_right = import("br_shift_right.br_shift_right")

pub mod br_multi_xfer_reg_fwd::[timecheck=false](clk:Clock, pop_receivable:U2, push_data:U10, push_sendable:U2, rst:U1) -> (pop_data:U10@[], pop_sendable:U2@[], push_receivable:U2@[]) {
  reg pop_sendable:U2 = nil
  reg pop_data:U10 = nil
  mut push_data_qual:U10 = 0
  push_data_qual = 0sb?
  mut _mux_1:U2 = if pop_sendable < pop_receivable { pop_sendable } else { pop_receivable }
  const pop_xfer_count__w1 = _mux_1
  const pop_sendable_after_xfer__w1 = (pop_sendable - pop_xfer_count__w1)#[0..=1]
  const push_receivable__w1 = (2 - pop_sendable_after_xfer__w1)#[0..=31]#[0..=1]
  mut _mux_2:U2 = if push_sendable < push_receivable__w1 { push_sendable } else { push_receivable__w1 }
  const push_xfer_count__w1 = _mux_2
  const pop_sendable_next__w1 = (pop_sendable_after_xfer__w1 + push_xfer_count__w1)#[0..=1]
  mut br_shift_right_data = br_shift_right::[name=br_shift_right_data](`in`=pop_data, shift=pop_xfer_count__w1 & 1, fill=0)
  mut _mux_3:U10 = if pop_xfer_count__w1 == 2 { 0 } else { br_shift_right_data.out#[0..=9] }
  mut _mux_4:U5 = if push_sendable > 0 { push_data#[0..=4] } else { 0 }
  mut push_data_qual__w1 = push_data_qual
  push_data_qual__w1#[0..=4] = _mux_4
  mut _mux_5:U5 = if push_sendable > 1 { push_data#[5..=9] } else { 0 }
  mut push_data_qual__w2 = push_data_qual__w1
  push_data_qual__w2#[5..=9] = _mux_5
  mut br_shift_left_data = br_shift_left::[name=br_shift_left_data](`in`=push_data_qual__w2, shift=pop_sendable_after_xfer__w1 & 1, fill=0)
  mut _mux_6:U10 = if pop_sendable_after_xfer__w1 == 2 { 0 } else { br_shift_left_data.out#[0..=9] }
  const pop_update__w1 = Unsigned(push_xfer_count__w1 != 0 or pop_xfer_count__w1 != 0)
  if rst != 0 {
    pop_sendable = 0
  } elif pop_update__w1 != 0 {
    pop_sendable = pop_sendable_next__w1
  }
  if rst != 0 {
    pop_data = 0
  } elif pop_update__w1 != 0 {
    pop_data = _mux_3 | _mux_6
  }
  push_receivable = push_receivable__w1
}
