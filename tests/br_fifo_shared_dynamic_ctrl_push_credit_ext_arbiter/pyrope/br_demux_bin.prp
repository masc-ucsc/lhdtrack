pub comb br_demux_bin::[timecheck=false](`in`:U5, in_valid:U1, select:U1) -> (out:U10, out_valid:U2) {
  out_valid = 0sb?
  mut out_valid__w1 = out_valid
  out_valid__w1#[0] = Unsigned(in_valid != 0 and select == 0) & 1
  mut out_valid__w2 = out_valid__w1
  out_valid__w2#[1] = Unsigned(in_valid != 0 and select == 1) & 1
  const t10 = `in`
  out_valid = out_valid__w2
  out = t10 | (t10 << 5)
}
