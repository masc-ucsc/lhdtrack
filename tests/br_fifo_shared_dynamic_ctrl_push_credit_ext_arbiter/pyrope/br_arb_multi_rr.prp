const br_enc_countones = import("br_enc_countones.br_enc_countones")
const br_enc_priority_dynamic = import("br_enc_priority_dynamic.br_enc_priority_dynamic")
const br_mux_bin = import("br_mux_bin.br_mux_bin")

pub mod br_arb_multi_rr::[timecheck=false](clk:Clock, enable_priority_update:U1, grant_allowed:U2, request:U2, rst:U1) -> (grant:U2@[], grant_count:U2@[], grant_ordered:U4@[]) {
  reg lowest_prio:U2 = nil
  mut grant_valid:U2 = 0
  grant_valid = 0sb?
  grant_ordered = 0sb?
  mut grant_valid__w1 = grant_valid
  grant_valid__w1#[0] = Unsigned(grant_allowed > 0) & 1
  mut grant_valid__w2 = grant_valid__w1
  grant_valid__w2#[1] = Unsigned(grant_allowed > 1) & 1
  mut u_enc_priority_dynamic = br_enc_priority_dynamic::[name=u_enc_priority_dynamic](clk=clk, rst=rst, `in`=request, lowest_prio=lowest_prio)
  const all_grants__w1 = u_enc_priority_dynamic
  mut br_enc_countones_inst = br_enc_countones::[name=br_enc_countones_inst](`in`=request)
  const request_count__w1 = br_enc_countones_inst
  mut _mux_4:U2 = if Unsigned(request_count__w1 <= grant_allowed) != 0 { request_count__w1#[0..=1] } else { grant_allowed }
  const grant_count__w1 = _mux_4
  mut br_mux_bin_last_grant = br_mux_bin::[name=br_mux_bin_last_grant](select=(grant_count__w1 - 1)#[0..=1] & 1, `in`=all_grants__w1)
  if rst != 0 {
    lowest_prio = 2
  } elif Unsigned(enable_priority_update != 0 and request != 0 and grant_allowed > 0) != 0 {
    lowest_prio = br_mux_bin_last_grant.out
  }
  mut _mux_6:U2 = if (grant_valid__w2 & 1) != 0 { all_grants__w1#[0..=1] } else { 0 }
  mut grant_ordered__w1 = grant_ordered
  grant_ordered__w1#[0..=1] = _mux_6
  mut _mux_7:U2 = if ((grant_valid__w2 >> 1) & 1) != 0 { all_grants__w1#[2..=3] } else { 0 }
  mut grant_ordered__w2 = grant_ordered__w1
  grant_ordered__w2#[2..=3] = _mux_7
  grant = (0 | grant_ordered__w2#[0..=1]) | grant_ordered__w2#[2..=3]
  grant_ordered = grant_ordered__w2
  grant_count = grant_count__w1
}
