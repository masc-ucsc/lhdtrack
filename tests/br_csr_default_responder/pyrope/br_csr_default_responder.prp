const br_csr_checks_intg = import("br_csr_checks_intg.br_csr_checks_intg")
const br_misc_unused_p1 = import("br_misc_unused_p1.br_misc_unused_p1")

pub mod br_csr_default_responder::[timecheck=false](clk:Clock, req_abort:U1, req_addr:U16, req_privileged:U1, req_secure:U1, req_valid:U1, req_wdata:U32, req_write:U1, req_wstrb:U4, rst:U1) -> (resp_decerr:U1@[], resp_rdata:U32@[], resp_slverr:U1@[], resp_valid:U1@[]) {
  reg resp_valid:U1:[async=false, initial=0, reset_pin=rst]
  br_csr_checks_intg::[name=br_csr_checks_intg_inst](clk=clk, rst=rst, req_valid=req_valid, req_write=req_write, req_addr=req_addr, req_wdata=req_wdata, req_wstrb=req_wstrb, req_secure=req_secure, req_privileged=req_privileged, req_abort=req_abort, resp_valid=resp_valid)
  if not (rst != 0) {
    resp_valid = req_valid
  }
  br_misc_unused_p1::[name=br_misc_unused_unused_request](`in`=((req_write & 1) << 55) | (req_addr << 39) | (req_wdata << 7) | (req_wstrb << 3) | ((req_privileged & 1) << 2) | ((req_secure & 1) << 1) | (req_abort & 1))
  resp_rdata = 0
  resp_slverr = 0
  resp_decerr = resp_valid
}
